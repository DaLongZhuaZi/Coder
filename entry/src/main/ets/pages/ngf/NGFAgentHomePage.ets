  @Builder
  private buildWorkspaceChangeCompactStatusLabel(item: AgentHomeWorkspaceChangeItem): void {
    Text() {
      Span(this.workspaceChangeActionText(item))
        .fontSize(11)
        .fontColor(this.workspaceChangeStatusColor(item))
      if (this.isWorkspaceDirectoryChange(item)) {
        Span(' ' + this.workspaceChangeFileCountText(item))
          .fontSize(11)
          .fontColor(this.workspaceChangeStatusColor(item))
      }
      if (item.additions > 0) {
        Span(' +' + String(item.additions))
          .fontSize(11)
          .fontColor($r('app.color.tag_green'))
      }
      if (item.deletions > 0) {
        Span(' -' + String(item.deletions))
          .fontSize(11)
          .fontColor($r('app.color.tag_red'))
      }
      if (!this.isWorkspaceDirectoryChange(item) && item.additions === 0 && item.deletions === 0) {
        Span(' 0')
          .fontSize(11)
          .fontColor(this.workspaceChangeStatusColor(item))
      }
    }
    .maxLines(1)
    .textOverflow({ overflow: TextOverflow.Ellipsis })
  }

  private shouldWaitForStartupHistorySync(): boolean {
    if (!this.isPersistentStateLoading) {
      return false;
    }
    if (this.bridgeEndpoint.trim().length === 0 || !this.activeHostCredentialAvailable) {
      return false;
    }
    const session = this.currentSession();
    if (!session || session.bridgeSessionId.length === 0) {
      return false;
    }
    if (session.providerId !== AgentBridgeProviderId.CODEX && session.providerId !== AgentBridgeProviderId.CLAUDE) {
      return false;
    }
    const provider = this.providerOptionForId(session.providerId);
    if (!provider || !provider.supportsHistory) {
      return false;
    }
    return true;
  }

  private beginStartupHistorySyncWait(localSessionId: string): void {
    if (!this.isPersistentStateLoading || localSessionId.length === 0) {
      return;
    }
    this.startupHistoryImportSessionId = localSessionId;
    this.schedulePersistentStateLoadingTimeout();
  }

  private finishStartupHistorySyncIfNeeded(localSessionId: string): void {
    if (this.startupHistoryImportSessionId.length === 0 || this.startupHistoryImportSessionId === localSessionId) {
      this.finishPersistentStateLoading();
    }
  }

  private schedulePersistentStateLoadingTimeout(): void {
    this.clearPersistentStateLoadingTimeout();
    this.persistentStateLoadingTimeoutTimer = setTimeout((): void => {
      logger.warn(TAG, 'startup history sync wait timed out');
      this.finishPersistentStateLoading();
    }, AGENT_HOME_STARTUP_HISTORY_SYNC_TIMEOUT_MS);
  }

  private finishPersistentStateLoading(): void {
    this.clearPersistentStateLoadingTimeout();
    this.isPersistentStateLoading = false;
    this.startupHistoryImportSessionId = '';
    this.consumeNotificationTapRouteIfReady();
  }

  private onNotificationTapSequenceChanged(): void {
    this.consumeNotificationTapRouteIfReady();
  }

  private consumeNotificationTapRouteIfReady(): void {
    if (!this.agentHomePageVisible || this.isPersistentStateLoading) {
      return;
    }
    if (this.notificationTapSequence <= 0 ||
      this.notificationTapSequence === this.lastConsumedNotificationTapSequence ||
      this.notificationTapAction.length === 0) {
      return;
    }
    const action = this.notificationTapAction;
    const payloadJson = this.notificationTapPayloadJson;
    const hostProfileId = AgentBridgeIncomingParser.extractStringProperty(payloadJson, 'hostProfileId');
    if (hostProfileId.length > 0 && hostProfileId !== this.activeHostProfileId) {
      if (this.findHostProfile(hostProfileId) !== null) {
        this.requestHostSwitch(hostProfileId);
        return;
      }
      this.lastConsumedNotificationTapSequence = this.notificationTapSequence;
      this.notificationTapAction = '';
      this.notificationTapPayloadJson = '';
      return;
    }
    const sessionId = AgentBridgeIncomingParser.extractStringProperty(payloadJson, 'sessionId');
    const requestId = AgentBridgeIncomingParser.extractStringProperty(payloadJson, 'requestId');
    const planId = AgentBridgeIncomingParser.extractStringProperty(payloadJson, 'planId');
    const notificationId = AgentBridgeIncomingParser.extractStringProperty(payloadJson, 'notificationId');
    const terminalId = AgentBridgeIncomingParser.extractStringProperty(payloadJson, 'terminalId');
    let routed = false;
    if (action === AgentHomeNotificationTapAction.OPEN_REQUEST) {
      routed = this.openNotificationRequestRoute(sessionId, requestId);
    } else if (action === AgentHomeNotificationTapAction.OPEN_PLAN) {
      routed = this.openNotificationPlanRoute(sessionId, planId);
    } else if (action === AgentHomeNotificationTapAction.OPEN_SESSION) {
      routed = this.activateNotificationSessionRoute(sessionId);
    } else if (action === AgentHomeNotificationTapAction.OPEN_TERMINAL) {
      routed = this.openNotificationTerminalRoute(sessionId, terminalId);
    }
    this.markBridgeNotificationOpened(notificationId);
    this.lastConsumedNotificationTapSequence = this.notificationTapSequence;
    this.notificationTapAction = '';
    this.notificationTapPayloadJson = '';
    if (routed) {
      logger.info(TAG, 'notification tap route consumed: action=' + action + ', session=' + sessionId);
    } else {
      logger.warn(TAG, 'notification tap route target unavailable: action=' + action + ', session=' + sessionId);
    }
  }

  private activateNotificationSessionRoute(sessionId: string): boolean {
    const localSessionId = this.resolveNotificationLocalSessionId(sessionId);
    if (localSessionId.length === 0) {
      return false;
    }
    this.mainPageIndex = AgentHomeMainPageIndex.CHAT;
    this.activateSession(localSessionId);
    return true;
  }

  private openNotificationRequestRoute(sessionId: string, requestId: string): boolean {
    const localSessionId = this.resolveNotificationLocalSessionId(sessionId);
    const requestIndex = this.findNotificationRequestIndex(localSessionId, requestId);
    if (requestIndex < 0) {
      return this.activateNotificationSessionRoute(sessionId);
    }
    const item = this.userRequests[requestIndex];
    this.activateNotificationSessionRoute(item.sessionId);
    this.openUserRequestSheet(item);
    return true;
  }

  private openNotificationPlanRoute(sessionId: string, planId: string): boolean {
    const localSessionId = this.resolveNotificationLocalSessionId(sessionId);
    const planIndex = this.findNotificationPlanIndex(localSessionId, planId);
    if (planIndex < 0) {
      return this.activateNotificationSessionRoute(sessionId);
    }
    const item = this.plans[planIndex];
    this.activateNotificationSessionRoute(item.sessionId);
    this.activePlanId = item.id;
    this.openSheet(AgentHomeSheetKey.PLAN_DETAIL);
    return true;
  }

  private openNotificationTerminalRoute(sessionId: string, terminalId: string): boolean {
    const sessionRouted = sessionId.length > 0 ? this.activateNotificationSessionRoute(sessionId) : false;
    if (terminalId.length === 0) {
      return sessionRouted;
    }
    const terminal = this.findTerminalSession(terminalId);
    if (terminal === null) {
      this.refreshBridgeTerminalsIfAvailable();
      return sessionRouted;
    }
    this.selectRuntimeTerminal(terminalId);
    this.openSheet(AgentHomeSheetKey.RUNTIME);
    return true;
  }

  private resolveNotificationLocalSessionId(sessionId: string): string {
    if (sessionId.length === 0) {
      return '';
    }
    for (let index = 0; index < this.sessions.length; index++) {
      const item = this.sessions[index];
      if (item.id === sessionId || item.bridgeSessionId === sessionId) {
        return item.id;
      }
    }
    return '';
  }

  private findNotificationRequestIndex(sessionId: string, requestId: string): number {
    if (requestId.length === 0) {
      return -1;
    }
    for (let index = 0; index < this.userRequests.length; index++) {
      const item = this.userRequests[index];
      const sessionMatches = sessionId.length === 0 || item.sessionId === sessionId;
      if (sessionMatches && (item.requestId === requestId || item.id === requestId)) {
        return index;
      }
    }
    return -1;
  }

  private findNotificationPlanIndex(sessionId: string, planId: string): number {
    if (planId.length === 0) {
      return -1;
    }
    for (let index = 0; index < this.plans.length; index++) {
      const item = this.plans[index];
      const sessionMatches = sessionId.length === 0 || item.sessionId === sessionId;
      if (sessionMatches && (item.planId === planId || item.id === planId)) {
        return index;
      }
    }
    return -1;
  }

  private clearPersistentStateLoadingTimeout(): void {
    if (this.persistentStateLoadingTimeoutTimer >= 0) {
      clearTimeout(this.persistentStateLoadingTimeoutTimer);
      this.persistentStateLoadingTimeoutTimer = -1;
    }
  }

