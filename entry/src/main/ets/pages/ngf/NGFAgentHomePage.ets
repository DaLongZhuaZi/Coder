  private async retryRuntimeFileTransfer(item: AgentBridgeFileTransferState): Promise<void> {
    if (item.localPath.length === 0 || item.path.length === 0) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_retry_unavailable')));
      return;
    }
    await this.uploadFilePathToWorkspace(item.localPath, item.path);
  }

  private async uploadFilePathToWorkspace(sourcePath: string, targetPath: string): Promise<void> {
    if (!this.canUseBridgeFileTransferBinary()) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_feature_unavailable')));
      return;
    }
    if (sourcePath.length === 0 || targetPath.length === 0) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_path_required')));
      return;
    }
    const data = this.readUploadFileBytes(sourcePath);
    if (data.byteLength <= 0) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_read_failed')));
      return;
    }
    const fileName = this.lastPathSegment(this.pathFromAttachmentUri(sourcePath));
    const resolvedTargetPath = this.resolveUploadTargetPath(targetPath, fileName);
    const digest = await securityToolkit.shaHashBytes(data);
    const requestId = 'upload_' + String(Date.now()) + '_' + this.safeIdPart(fileName.length > 0 ? fileName : 'file');
    const metadata = new AgentBridgeFileTransferMetadata();
    metadata.requestId = requestId;
    metadata.direction = 'upload';
    metadata.workspaceId = this.activeWorkspaceId;
    metadata.path = resolvedTargetPath;
    metadata.fileName = fileName.length > 0 ? fileName : this.lastPathSegment(resolvedTargetPath);
    metadata.mediaType = this.mediaTypeForUploadPath(metadata.fileName);
    metadata.size = data.byteLength;
    metadata.sizeBytes = data.byteLength;
    metadata.sha256 = digest;
    metadata.modifiedAt = Date.now();
    metadata.createdAt = new Date().toISOString();

    const state = new AgentBridgeFileTransferState();
    state.requestId = requestId;
    state.direction = 'upload';
    state.status = 'running';
    state.path = resolvedTargetPath;
    state.fileName = metadata.fileName;
    state.mediaType = metadata.mediaType;
    state.totalBytes = data.byteLength;
    state.sha256 = digest;
    state.localPath = sourcePath;
    state.updatedAt = Date.now();
    this.upsertFileTransferState(state);

    this.client.prepareBinaryFileUpload(requestId, this.activeWorkspaceId, resolvedTargetPath, data.byteLength, digest, true);
    if (!this.client.sendFileUploadBegin(metadata)) {
      this.failIncomingFileTransfer(requestId, resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_send_failed')));
      return;
    }
    let offset = 0;
    while (offset < data.byteLength) {
      const end = Math.min(offset + AGENT_HOME_FILE_UPLOAD_CHUNK_BYTES, data.byteLength);
      const chunk = this.copyUploadChunk(data, offset, end - offset);
      if (!this.client.sendFileUploadChunk(requestId, chunk)) {
        this.failIncomingFileTransfer(requestId, resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_send_failed')));
        return;
      }
      offset = end;
      state.transferredBytes = offset;
      state.updatedAt = Date.now();
      this.upsertFileTransferState(state);
    }
    if (!this.client.sendFileUploadEnd(requestId)) {
      this.failIncomingFileTransfer(requestId, resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_send_failed')));
      return;
    }
    this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_upload_requested')));
  }

  private readUploadFileBytes(sourcePath: string): ArrayBuffer {
    const data = FileUtils.readBytes(sourcePath);
    if (data.byteLength > 0) {
      return data;
    }
    if (sourcePath.startsWith('file:///')) {
      const localPath = this.pathFromAttachmentUri(sourcePath);
      if (localPath.length > 0 && localPath !== sourcePath) {
        return FileUtils.readBytes(localPath);
      }
    }
    return data;
  }

  private copyUploadChunk(data: ArrayBuffer, start: number, length: number): ArrayBuffer {
    if (length <= 0 || start < 0 || start >= data.byteLength) {
      return new ArrayBuffer(0);
    }
    const safeLength = Math.min(length, data.byteLength - start);
    const source = new Uint8Array(data);
    const output = new Uint8Array(safeLength);
    for (let index = 0; index < safeLength; index++) {
      output[index] = source[start + index];
    }
    return output.buffer;
  }

  private resolveUploadTargetPath(targetPath: string, fileName: string): string {
    let normalized = this.normalizeWorkspaceFilePath(targetPath);
    if (normalized.length === 0) {
      return fileName;
    }
    if ((normalized.endsWith('/') || normalized.endsWith('\\')) && fileName.length > 0) {
      normalized = normalized + fileName;
    }
    return normalized;
  }

  private mediaTypeForUploadPath(pathValue: string): string {
    const lower = pathValue.toLowerCase();
    if (lower.endsWith('.png')) {
      return 'image/png';
    }
    if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
      return 'image/jpeg';
    }
    if (lower.endsWith('.gif')) {
      return 'image/gif';
    }
    if (lower.endsWith('.json')) {
      return 'application/json';
    }
    if (lower.endsWith('.pdf')) {
      return 'application/pdf';
    }
    return 'application/octet-stream';
  }

  private cancelRuntimeFileTransfer(requestId: string): void {
    if (requestId.length === 0) {
      return;
    }
    this.client.sendFileTransferCancelFrame(
      requestId,
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_cancelled'))
    );
    this.client.cancelFileTransfer(requestId);
    const state = this.findFileTransferState(requestId);
    if (state !== null) {
      state.status = 'failed';
      state.errorMessage = resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_cancelled'));
      state.updatedAt = Date.now();
      this.upsertFileTransferState(state);
    }
  }

  private fileTransferStatusText(item: AgentBridgeFileTransferState): string {
    const total = item.totalBytes > 0 ? item.totalBytes : 0;
    const transferred = item.transferredBytes > 0 ? item.transferredBytes : 0;
    if (total > 0) {
      return item.status + ' ' + String(transferred) + '/' + String(total);
    }
    if (item.errorMessage.length > 0) {
      return item.status + ' ' + item.errorMessage;
    }
    return item.status.length > 0 ? item.status : item.direction;
  }

  private projectBridgeWorkspaceRecord(record: AgentBridgeWorkspaceRecord): void {
    if (record.workspaceId.length === 0) {
      return;
    }
    if (record.status === 'archived' || record.archivedAt.length > 0) {
      return;
    }
    const localWorkspaceId = this.localWorkspaceIdForBridgeWorkspace(record.workspaceId, record.cwd);
    const title = record.title.length > 0 ? record.title : (record.displayName.length > 0 ? record.displayName : this.lastPathSegment(record.cwd));
    const workspace = new AgentHomeWorkspaceItem(
      localWorkspaceId,
      title.length > 0 ? title : record.workspaceId,
      record.cwd,
      this.resolveWorkspaceInitial(title.length > 0 ? title : record.workspaceId),
      this.resolveWorkspaceAccentColor(localWorkspaceId),
      record.branch.length > 0 ? record.branch : this.currentBranchName(),
      true
    );
    this.upsertWorkspace(workspace);
    this.persistence.saveWorkspace(workspace, this.activeHostProfileId).catch((error: Error): void => {
      logger.error(TAG, 'persist v2 projected workspace failed: ' + this.errorToString(error));
    });
  }

  private projectBridgeAgentIntoLocalSession(agent: AgentBridgeAgentRecord, preferActive: boolean): void {
    if (agent.id.length === 0) {
      return;
    }
    const localWorkspaceId = this.localWorkspaceIdForBridgeWorkspace(agent.workspaceId, agent.cwd);
    const workspaceTitle = this.bridgeAgentWorkspaceTitle(agent);
    if (localWorkspaceId.length > 0) {
      const workspace = new AgentHomeWorkspaceItem(
        localWorkspaceId,
        workspaceTitle,
        agent.cwd,
        this.resolveWorkspaceInitial(workspaceTitle),
        this.resolveWorkspaceAccentColor(localWorkspaceId),
        this.currentBranchName(),
        agent.archivedAt.length === 0
      );
      this.upsertWorkspace(workspace);
      this.persistence.saveWorkspace(workspace, this.activeHostProfileId).catch((error: Error): void => {
        logger.error(TAG, 'persist v2 agent workspace failed: ' + this.errorToString(error));
      });
    }
    const sessionId = this.localSessionIdForBridgeAgent(agent.id);
    const session = new AgentHomeSessionItem(
      sessionId,
      localWorkspaceId.length > 0 ? localWorkspaceId : this.activeWorkspaceId,
      agent.title.length > 0 ? agent.title : workspaceTitle,
      this.currentBranchName(),
      agent.provider.length > 0 ? agent.provider : this.selectedProviderId,
      agent.modelId.length > 0 ? agent.modelId : this.selectedModelId,
      agent.lastModeId.length > 0 ? agent.lastModeId : this.selectedSpeedMode,
      agent.thinkingOptionId.length > 0 ? agent.thinkingOptionId : this.selectedReasoningMode,
      agent.providerSessionId,
      this.epochFromBridgeIso(agent.updatedAt)
    );
    this.upsertSession(session);
    this.persistSession(session);
    if (preferActive && this.activeSessionId.length === 0) {
      this.activeSessionId = session.id;
      this.updateActiveWorkspaceId(session.workspaceId);
      this.persistProfile();
    }
  }

  private projectBridgeTimelineItem(agentId: string, item: AgentBridgeAgentTimelineRecord): void {
    if (item.kind === 'message') {
      this.upsertV2TimelineMessage(agentId, item);
      return;
    }
    if (item.kind === 'tool') {
      this.upsertV2TimelineTool(agentId, item);
      return;
    }
    if (item.kind === 'permission') {
      this.upsertV2TimelineRequest(agentId, item);
    }
  }

  private upsertV2TimelineMessage(agentId: string, item: AgentBridgeAgentTimelineRecord): void {
    const sessionId = this.localSessionIdForBridgeAgent(agentId);
    const projected = item.projectedJson;
    const text = AgentBridgeIncomingParser.cleanJsonText(
      AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'text', 'content')
    );
    const role = AgentBridgeIncomingParser.extractStringProperty(projected, 'role');
    if (sessionId.length === 0 || (text.length === 0 && role.length === 0)) {
      return;
    }
    const projectionId = AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'projectionId', 'messageId');
    const messageId = projectionId.length > 0 ? projectionId : 'seq_' + String(item.seq);
    const localMessageId = 'v2_msg_' + this.safeIdPart(sessionId) + '_' + this.safeIdPart(messageId);
    const createdAt = item.createdAt > 0 ? item.createdAt : Date.now();
    const chatItem = new AgentHomeChatItem(
      localMessageId,
      sessionId,
      role.length > 0 ? role : AgentHomeMessageRole.ASSISTANT,
      '',
      text,
      '',
      createdAt,
      '',
      messageId,
      AgentBridgeIncomingParser.extractStringProperty(projected, 'agentName'),
      AgentBridgeIncomingParser.extractArrayProperty(projected, 'contentNodes'),
      item.epoch,
      item.seq
    );
    this.upsertV2ChatItem(chatItem);
  }

  private upsertV2ChatItem(chatItem: AgentHomeChatItem): void {
    const nextItems: Array<AgentHomeChatItem> = [];
    let replaced = false;
    for (let index = 0; index < this.messages.length; index++) {
      if (this.messages[index].id === chatItem.id) {
        nextItems.push(chatItem);
        replaced = true;
      } else {
        nextItems.push(this.messages[index]);
      }
    }
    if (!replaced) {
      nextItems.push(chatItem);
    }
    nextItems.sort((left: AgentHomeChatItem, right: AgentHomeChatItem): number => {
      return left.createdAt - right.createdAt;
    });
    this.messages = nextItems;
    this.persistMessage(chatItem);
    if (chatItem.sessionId === this.activeSessionId) {
      this.scheduleConversationRenderReady(chatItem.sessionId);
    }
  }

  private upsertV2TimelineTool(agentId: string, item: AgentBridgeAgentTimelineRecord): void {
    const sessionId = this.localSessionIdForBridgeAgent(agentId);
    const projected = item.projectedJson;
    const toolCallId = AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'toolCallId', 'projectionId');
    if (sessionId.length === 0 || toolCallId.length === 0) {
      return;
    }
    const status = this.normalizeToolCallStatus(AgentBridgeIncomingParser.extractStringProperty(projected, 'status'));
    const now = item.createdAt > 0 ? item.createdAt : Date.now();
    const toolItem = new AgentHomeToolCallItem(
      'v2_tool_' + this.safeIdPart(sessionId) + '_' + this.safeIdPart(toolCallId),
      sessionId,
      this.providerIdForLocalSession(sessionId),
      AgentBridgeIncomingParser.extractStringProperty(projected, 'messageId'),
      toolCallId,
      AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'name', 'toolName'),
      status,
      AgentBridgeIncomingParser.cleanJsonText(
        AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'inputText', 'input')
      ),
      AgentBridgeIncomingParser.cleanJsonText(
        AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'outputText', 'output')
      ),
      AgentBridgeIncomingParser.cleanJsonText(
        AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'errorText', 'error')
      ),
      projected,
      now,
      status === AgentHomeToolCallStatus.RUNNING ? 0 : now,
      now
    );
    this.upsertV2ToolItem(toolItem);
  }

  private upsertV2ToolItem(toolItem: AgentHomeToolCallItem): void {
    const nextItems: Array<AgentHomeToolCallItem> = [];
    let replaced = false;
    for (let index = 0; index < this.toolCalls.length; index++) {
      if (this.toolCalls[index].id === toolItem.id) {
        nextItems.push(toolItem);
        replaced = true;
      } else {
        nextItems.push(this.toolCalls[index]);
      }
    }
    if (!replaced) {
      nextItems.push(toolItem);
    }
    this.toolCalls = nextItems;
    this.persistence.saveToolCall(toolItem, this.activeHostProfileId).catch((error: Error): void => {
      logger.error(TAG, 'persist v2 tool item failed: ' + this.errorToString(error));
    });
    this.syncPlanFromToolCall(toolItem);
  }

  private upsertV2TimelineRequest(agentId: string, item: AgentBridgeAgentTimelineRecord): void {
    const sessionId = this.localSessionIdForBridgeAgent(agentId);
    const projected = item.projectedJson;
    const requestId = AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'requestId', 'projectionId');
    if (sessionId.length === 0 || requestId.length === 0) {
      return;
    }
    const now = item.createdAt > 0 ? item.createdAt : Date.now();
    const requestItem = new AgentHomeUserRequestItem(
      'v2_request_' + this.safeIdPart(sessionId) + '_' + this.safeIdPart(requestId),
      sessionId,
      this.providerIdForLocalSession(sessionId),
      requestId,
      AgentBridgeIncomingParser.extractStringProperty(projected, 'kind'),
      AgentBridgeIncomingParser.extractStringProperty(projected, 'title'),
      AgentBridgeIncomingParser.cleanJsonText(
        AgentBridgeIncomingParser.extractFirstStringProperty(projected, 'prompt', 'message')
      ),
      AgentBridgeIncomingParser.extractArrayProperty(projected, 'options'),
      true,
      AgentBridgeIncomingParser.extractStringProperty(projected, 'status'),
      AgentBridgeIncomingParser.cleanJsonText(AgentBridgeIncomingParser.extractStringProperty(projected, 'answer')),
      AgentBridgeIncomingParser.extractStringProperty(projected, 'optionId'),
      projected,
      now,
      now
    );
    this.upsertV2RequestItem(requestItem);
  }

  private upsertV2RequestItem(requestItem: AgentHomeUserRequestItem): void {
    const nextItems: Array<AgentHomeUserRequestItem> = [];
    let replaced = false;
    for (let index = 0; index < this.userRequests.length; index++) {
      if (this.userRequests[index].id === requestItem.id) {
        nextItems.push(requestItem);
        replaced = true;
      } else {
        nextItems.push(this.userRequests[index]);
      }
    }
    if (!replaced) {
      nextItems.push(requestItem);
    }
    this.userRequests = nextItems;
    this.persistence.saveUserRequest(requestItem, this.activeHostProfileId).catch((error: Error): void => {
      logger.error(TAG, 'persist v2 user request failed: ' + this.errorToString(error));
    });
  }

  private localSessionIdForBridgeAgent(agentId: string): string {
    if (agentId.length === 0) {
      return '';
    }
    const expected = 'v2_agent_' + this.safeIdPart(this.activeHostProfileId) + '_' +
      this.safeIdPart(this.activeDeviceId) + '_' + this.safeIdPart(this.currentBridgeServerId) + '_' + this.safeIdPart(agentId);
    for (let index = 0; index < this.sessions.length; index++) {
      if (this.sessions[index].id === expected) {
        return expected;
      }
    }
    return expected;
  }

  private localWorkspaceIdForBridgeWorkspace(workspaceId: string, cwd: string): string {
    if (workspaceId.length > 0) {
      return 'v2_workspace_' + this.safeIdPart(this.activeHostProfileId) + '_' +
        this.safeIdPart(this.activeDeviceId) + '_' + this.safeIdPart(this.currentBridgeServerId) + '_' + this.safeIdPart(workspaceId);
    }
    if (cwd.length > 0) {
      return this.workspaceIdForPath(cwd);
    }
    return this.activeWorkspaceId;
  }

  private bridgeAgentWorkspaceTitle(agent: AgentBridgeAgentRecord): string {
    if (agent.cwd.length > 0) {
      return this.lastPathSegment(agent.cwd);
    }
    if (agent.workspaceId.length > 0) {
      return agent.workspaceId;
    }
    return this.currentWorkspaceTitle();
  }

  private epochFromBridgeIso(value: string): number {
    if (value.length === 0) {
      return Date.now();
    }
    const parsed = Date.parse(value);
    if (Number.isNaN(parsed)) {
      return Date.now();
    }
    return parsed;
  }

  private appendAssistantReasoning(parsed: AgentBridgeParsedMessage): void {
    const text = this.resolveReasoningText(parsed);
    if (text.length === 0) {
      return;
    }
    this.markAssistantResponseStarted();
    const streamKey = this.streamKeyForParsedMessage(parsed);
    const targetIndex = this.resolveAppendableAssistantMessageIndex(streamKey);
    const nextItems: Array<AgentHomeChatItem> = [];
    let updatedItem: AgentHomeChatItem | null = null;
    let appended = false;
    for (let index = 0; index < this.messages.length; index++) {
      const item = this.messages[index];
      if (
        index === targetIndex &&
          item.sessionId === this.activeSessionId &&
          item.role === AgentHomeMessageRole.ASSISTANT
      ) {
        updatedItem = new AgentHomeChatItem(
          item.id,
          item.sessionId,
          item.role,
          item.title,
          item.text,
          item.durationText,
          item.createdAt,
          this.mergeStreamText(item.reasoningText, text),
          this.resolveMessageNodeId(item, parsed),
          this.resolveAgentNameForParsedItem(parsed, item.agentName),
          item.contentNodesJson,
          item.timelineEpoch,
          item.timelineSeq
        );
        nextItems.push(updatedItem);
        appended = true;
      } else {
        nextItems.push(item);
      }
    }
    if (!appended) {
      updatedItem = new AgentHomeChatItem(
        'agent_home_message_' + String(Date.now()) + '_' + String(this.messageSequence + 1),
        this.activeSessionId,
        AgentHomeMessageRole.ASSISTANT,
        '',
        '',
        '',
        Date.now(),
        text,
        parsed.messageId,
        parsed.agentName,
        ''
      );
      nextItems.push(updatedItem);
      this.messageSequence = this.messageSequence + 1;
    }
    this.messages = nextItems;
    if (updatedItem) {
      this.rememberActiveAssistantStream(streamKey, updatedItem.id);
      if (updatedItem.text.length > 0) {
        this.collapseReasoningMessage(updatedItem.id);
      } else {
        this.expandReasoningMessage(updatedItem.id);
      }
      this.persistMessage(updatedItem);
      this.scheduleConversationScrollForNewContent();
    }
  }

  private appendAssistantDelta(parsed: AgentBridgeParsedMessage): void {
