  private beginBrowserRequest(
    action: string,
    requestId: string,
    workspaceId: string,
    hostId: string = '',
    instanceId: string = '',
    pageId: string = ''
  ): void {
    if (requestId.length === 0) {
      this.browserAutomationPending = this.browserRequestCoordinator.pendingCount() > 0;
      if (!this.browserAutomationPending) {
        this.pendingBrowserAction = '';
      }
      return;
    }
    const accepted = this.browserRequestCoordinator.begin(new AgentHomeBrowserRequestScope(
      requestId,
      action,
      workspaceId,
      hostId,
      instanceId,
      pageId
    ));
    if (!accepted) {
      return;
    }
    this.pendingBrowserAction = action;
    this.browserErrorText = '';
    this.browserAutomationPending = true;
  }

  private completeBrowserRequest(parsed: AgentBridgeParsedMessage, result: AgentBridgeBrowserResult): boolean {
    const requestId = parsed.requestId.length > 0 ? parsed.requestId : result.requestId;
    const match = this.browserRequestCoordinator.consume(requestId, result);
    this.completedBrowserAction = match.action;
    this.browserAutomationPending = this.browserRequestCoordinator.pendingCount() > 0;
    if (match.staleScope) {
      logger.debug(TAG, 'ignored stale browser response scope: requestId=' + match.requestId);
    }
    if (!match.matched) {
      return false;
    }
    return true;
  }

  private clearBrowserRequests(): void {
    this.browserRequestCoordinator.clear();
    this.browserAutomationPending = false;
    this.pendingBrowserAction = '';
    this.completedBrowserAction = '';
    this.pendingBrowserActionPayload = null;
  }

  private clearBrowserWorkspaceState(): void {
    this.clearBrowserRequests();
    this.resetBrowserPermissionState();
    this.browserHosts = [];
    this.browserInstances = [];
    this.browserPages = [];
    this.browserLogs = [];
    this.browserDownloads = [];
    this.browserScreenshotDataUrl = '';
    this.browserStatusText = '';
    this.browserErrorText = '';
    this.selectedBrowserHostId = '';
    this.selectedBrowserInstanceId = '';
    this.selectedBrowserPageId = '';
  }

  private applyBrowserScreenshotPreview(result: AgentBridgeBrowserResult): void {
    const encoded = result.screenshot.dataBase64.trim();
    const mime = result.screenshot.mimeType.trim().toLowerCase();
    const supportedMimes: Array<string> = [
      'image/png',
      'image/jpeg',
      'image/webp'
    ];
    let supported: boolean = false;
    for (let index = 0; index < supportedMimes.length; index++) {
      if (supportedMimes[index] === mime) {
        supported = true;
        break;
      }
    }
    if (!supported || encoded.length === 0 || encoded.length > 8 * 1024 * 1024) {
      this.browserScreenshotDataUrl = '';
      return;
    }
    this.browserScreenshotDataUrl = 'data:' + mime + ';base64,' + encoded;
  }

  private selectedBrowserHost(): AgentBridgeBrowserHostRecord | null {
    for (let index = 0; index < this.browserHosts.length; index++) {
      if (this.browserHosts[index].hostId === this.selectedBrowserHostId) return this.browserHosts[index];
    }
    return null;
  }

  private selectedBrowserPage(): AgentBridgeBrowserPageRecord | null {
    for (let index = 0; index < this.browserPages.length; index++) {
      if (this.browserPages[index].pageId === this.selectedBrowserPageId) return this.browserPages[index];
    }
    return null;
  }

  private browserHostIsReady(host: AgentBridgeBrowserHostRecord): boolean {
    return AgentHomeBrowserCapabilityPolicy.isReady(
      host,
      this.browserCapabilityMetadataEnabled(),
      this.browserPlatformHostEnabled()
    );
  }

  private browserHasReadyHost(): boolean {
    for (let index = 0; index < this.browserHosts.length; index++) {
      if (this.browserHostIsReady(this.browserHosts[index])) return true;
    }
    return false;
  }

  private browserHostMetadataText(host: AgentBridgeBrowserHostRecord): string {
    const parts: Array<string> = [];
    if (host.hostKind.length > 0) parts.push(host.hostKind);
    if (host.runtime.length > 0) parts.push(host.runtime);
    if (host.capabilitySource.length > 0) parts.push(host.capabilitySource);
    if (host.readiness.length > 0) parts.push(host.readiness);
    if (host.supportedPlatforms.length > 0) parts.push(host.supportedPlatforms.join('/'));
    return parts.join(' · ');
  }

  private browserFailureSummary(result: AgentBridgeBrowserResult): string {
    const category: string = result.failureCategory;
    let message: ResourceStr = $r('app.string.agent_home_browser_error_generic');
    if (category === 'browser_host_not_ready') {
      message = $r('app.string.agent_home_browser_error_not_ready');
    } else if (category === 'browser_action_unavailable' || category === 'browser_host_capability_unverified') {
      message = $r('app.string.agent_home_browser_error_capability');
    } else if (category === 'browser_workspace_scope' || category === 'browser_upload_path_invalid') {
      message = $r('app.string.agent_home_browser_error_scope');
    } else if (category === 'browser_permission_denied' || category === 'browser_domain_not_allowed') {
      message = $r('app.string.agent_home_browser_error_permission');
    }
    const localized: string = resolveResourceString(this.getUIContext().getHostContext(), message);
    const remediation: string = result.remediation.length > 0
      ? resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_browser_error_retry'))
      : '';
    return remediation.length > 0 ? localized + ' · ' + remediation : localized;
  }

  private browserSupportsBrowserCommand(command: string): boolean {
    const host = this.selectedBrowserHost();
    if (host === null || !this.browserHostIsReady(host)) return false;
    return host.supportedCommands.includes(command);
  }

  private browserSupportsBrowserAction(action: string): boolean {
    const host = this.selectedBrowserHost();
    if (host === null || !this.browserHostIsReady(host) || !host.supportedCommands.includes('page.action')) return false;
    if (!host.actionCapabilitiesExplicit) return true;
    return host.supportedActions.includes(action);
  }

  private hasBrowserHost(hostId: string): boolean {
    for (let index = 0; index < this.browserHosts.length; index++) {
      if (this.browserHosts[index].hostId === hostId) return true;
    }
    return false;
  }

  private firstUsableBrowserHostId(hosts: Array<AgentBridgeBrowserHostRecord>): string {
    for (let index = 0; index < hosts.length; index++) {
      if (this.browserHostIsReady(hosts[index])) return hosts[index].hostId;
    }
    return hosts.length > 0 ? hosts[0].hostId : '';
  }

  private hasBrowserInstance(instanceId: string): boolean {
    for (let index = 0; index < this.browserInstances.length; index++) {
      if (this.browserInstances[index].instanceId === instanceId) return true;
    }
    return false;
  }

  private findBrowserPage(pageId: string): AgentBridgeBrowserPageRecord | null {
    for (let index = 0; index < this.browserPages.length; index++) {
      if (this.browserPages[index].pageId === pageId) return this.browserPages[index];
    }
    return null;
  }

  private selectBrowserHost(hostId: string): void {
    if (hostId.length === 0 || hostId === this.selectedBrowserHostId) return;
    this.selectedBrowserHostId = hostId;
    this.selectedBrowserInstanceId = '';
    this.selectedBrowserPageId = '';
    this.browserInstances = [];
    this.browserPages = [];
    this.browserLogs = [];
    this.browserDownloads = [];
    this.browserScreenshotDataUrl = '';
    this.browserErrorText = '';
    this.clearBrowserRequests();
    this.refreshBrowserAutomation();
  }

  private selectBrowserInstance(instanceId: string): void {
    if (instanceId.length === 0 || instanceId === this.selectedBrowserInstanceId) return;
    this.selectedBrowserInstanceId = instanceId;
    this.selectedBrowserPageId = '';
    this.browserPages = [];
    const workspaceId = this.browserWorkspaceId();
    const requestId = this.client.listBrowserPages(workspaceId, this.currentBridgeAgentId(), this.selectedBrowserHostId, instanceId);
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_LIST,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      instanceId
    );
  }

  private selectBrowserPage(page: AgentBridgeBrowserPageRecord): void {
    this.selectedBrowserPageId = page.pageId;
    this.selectedBrowserInstanceId = page.instanceId;
    this.selectedBrowserHostId = page.hostId.length > 0 ? page.hostId : this.selectedBrowserHostId;
    this.browserNavigationUrlDraft = page.url;
    this.browserAutomationResult = new AgentBridgeBrowserResult();
    this.browserLogs = [];
    this.browserDownloads = [];
    this.browserScreenshotDataUrl = '';
    this.browserErrorText = '';
  }

  private createBrowserInstanceFromPanel(): void {
    const workspaceId = this.browserWorkspaceId();
    if (workspaceId.length === 0 || !this.browserSupportsBrowserCommand('instance.create') || this.browserAutomationPending) return;
    const requestId = this.client.createBrowserInstance(workspaceId, this.currentBridgeAgentId(), this.selectedBrowserHostId);
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_INSTANCE_CREATE,
      requestId,
      workspaceId,
      this.selectedBrowserHostId
    );
  }

  private previewCloseBrowserInstance(instance: AgentBridgeBrowserInstanceRecord): void {
    const workspaceId = this.browserWorkspaceId();
    if (workspaceId.length === 0 || instance.instanceId.length === 0 || this.browserAutomationPending ||
      !this.browserSupportsBrowserCommand('instance.close')) return;
    const requestId = this.client.closeBrowserInstance(workspaceId, instance.instanceId, this.selectedBrowserHostId, this.currentBridgeAgentId());
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_INSTANCE_CLOSE,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      instance.instanceId
    );
  }

  private previewCloseBrowserPage(page: AgentBridgeBrowserPageRecord): void {
    const workspaceId = this.browserWorkspaceId();
    if (workspaceId.length === 0 || page.pageId.length === 0 || this.browserAutomationPending ||
      !this.browserSupportsBrowserCommand('page.close')) return;
    this.selectedBrowserPageId = page.pageId;
    const requestId = this.client.closeBrowserPage(workspaceId, page.pageId, this.currentBridgeAgentId(), this.selectedBrowserHostId, page.instanceId);
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_CLOSE,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      page.instanceId,
      page.pageId
    );
  }

  private navigateSelectedBrowserPage(operation: string): void {
    const page = this.selectedBrowserPage();
    const workspaceId = this.browserWorkspaceId();
    if (page === null || workspaceId.length === 0 || this.browserAutomationPending ||
      !this.browserSupportsBrowserCommand('page.navigate')) return;
    if (operation === 'navigate' && this.browserNavigationUrlDraft.trim().length === 0) return;
    const requestId = this.client.navigateBrowserPage(
      workspaceId,
      page.pageId,
      operation,
      operation === 'navigate' ? this.browserNavigationUrlDraft.trim() : '',
      this.selectedBrowserHostId,
      this.currentBridgeAgentId(),
      page.instanceId
    );
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_NAVIGATE,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      page.instanceId,
      page.pageId
    );
  }

  private requestBrowserPageLogs(): void {
    const page = this.selectedBrowserPage();
    const workspaceId = this.browserWorkspaceId();
    if (page === null || workspaceId.length === 0 || this.browserAutomationPending ||
      !this.browserSupportsBrowserCommand('page.logs')) return;
    const requestId = this.client.requestBrowserLogs(workspaceId, page.pageId, 100, this.selectedBrowserHostId, this.currentBridgeAgentId(), page.instanceId);
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_LOGS,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      page.instanceId,
      page.pageId
    );
  }

  private waitSelectedBrowserPage(): void {
    const page = this.selectedBrowserPage();
    const workspaceId = this.browserWorkspaceId();
    const textValue = this.browserWaitTextDraft.trim();
    const urlValue = this.browserWaitUrlDraft.trim();
    if (page === null || workspaceId.length === 0 || this.browserAutomationPending ||
      !this.browserSupportsBrowserCommand('page.wait')) return;
    if ((textValue.length === 0 && urlValue.length === 0) || (textValue.length > 0 && urlValue.length > 0)) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_browser_wait_invalid')));
      return;
    }
    const requestId = this.client.waitBrowserPage(
      workspaceId,
      page.pageId,
      textValue,
      urlValue,
      30000,
      this.selectedBrowserHostId,
      this.currentBridgeAgentId(),
      page.instanceId
    );
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_WAIT,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      page.instanceId,
      page.pageId
    );
  }

  private requestBrowserDownloads(): void {
    const page = this.selectedBrowserPage();
    const workspaceId = this.browserWorkspaceId();
    if (workspaceId.length === 0 || this.browserAutomationPending ||
      !this.browserSupportsBrowserCommand('download.list')) return;
    const requestId = this.client.listBrowserDownloads(
      workspaceId,
      page === null ? '' : page.pageId,
      this.selectedBrowserHostId,
      this.currentBridgeAgentId(),
      page === null ? this.selectedBrowserInstanceId : page.instanceId
    );
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_DOWNLOAD_LIST,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      page === null ? this.selectedBrowserInstanceId : page.instanceId,
      page === null ? '' : page.pageId
    );
  }

  private workspaceBrowserUploadPath(relativePath: string): string {
    const value = AgentHomeBrowserUploadPolicy.normalizeRelativePath(relativePath);
    if (value.length === 0) return '';
    const root = this.currentWorkspacePath().replace(/[\\/]$/, '');
    return root.length > 0 ? root + '/' + value : '';
  }

  private selectedWorkspaceFileForBrowserUpload(): string {
    return AgentHomeBrowserUploadPolicy.resolveSelectedFilePath(
      this.workspaceFiles,
      this.selectedWorkspaceFilePath,
      this.browserWorkspaceId()
    );
  }

  private applySelectedWorkspaceFileToBrowserUpload(): void {
    const selectedPath = this.selectedWorkspaceFileForBrowserUpload();
    if (selectedPath.length === 0) {
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(),
        $r('app.string.agent_home_browser_action_selected_file_unavailable')
      ));
      return;
    }
    this.browserActionFilePathDraft = selectedPath;
    this.showTransientStatus(resolveResourceString(
      this.getUIContext().getHostContext(),
      $r('app.string.agent_home_browser_action_selected_file_applied')
    ));
  }

  private previewBrowserActionFromPanel(): void {
    const page = this.selectedBrowserPage();
    const workspaceId = this.browserWorkspaceId();
    if (page === null || workspaceId.length === 0 || this.browserAutomationPending || !this.browserSupportsBrowserAction(this.browserActionDraft)) return;
    const payload = new AgentBridgeBrowserPayload();
    payload.workspaceId = workspaceId;
    payload.agentId = this.currentBridgeAgentId();
    payload.hostId = this.selectedBrowserHostId;
    payload.instanceId = page.instanceId;
    payload.pageId = page.pageId;
    payload.action = this.browserActionDraft;
    if (this.browserActionDraft === 'click' || this.browserActionDraft === 'fill' || this.browserActionDraft === 'type' ||
      this.browserActionDraft === 'keypress' || this.browserActionDraft === 'hover' || this.browserActionDraft === 'select' ||
      this.browserActionDraft === 'download') payload.ref = this.browserActionRefDraft.trim();
    if (this.browserActionDraft === 'fill' || this.browserActionDraft === 'select') payload.value = this.browserActionValueDraft;
    if (this.browserActionDraft === 'type') payload.text = this.browserActionTextDraft;
    if (this.browserActionDraft === 'keypress') payload.key = this.browserActionKeyDraft.trim();
    if (this.browserActionDraft === 'drag') {
      payload.sourceRef = this.browserActionSourceRefDraft.trim();
      payload.targetRef = this.browserActionTargetRefDraft.trim();
    }
    if (this.browserActionDraft === 'upload') {
      const path = this.workspaceBrowserUploadPath(this.browserActionFilePathDraft);
      if (path.length === 0 || this.browserActionRefDraft.trim().length === 0) {
        this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_browser_action_file_placeholder')));
        return;
      }
      payload.ref = this.browserActionRefDraft.trim();
      payload.filePaths = [path];
    }
    if (this.browserActionDraft === 'scroll') {
      payload.deltaX = Number.parseInt(this.browserActionDeltaXDraft, 10) || 0;
      payload.deltaY = Number.parseInt(this.browserActionDeltaYDraft, 10) || 0;
    }
    if (this.browserActionDraft === 'evaluate') payload.functionSource = this.browserActionFunctionDraft;
    this.pendingBrowserActionPayload = payload;
    const requestId = this.client.runBrowserAction(payload);
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_ACTION,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      page.instanceId,
      page.pageId
    );
  }

  private showBrowserActionPreview(result: AgentBridgeBrowserResult): void {
    const hostContext = this.getUIContext().getHostContext();
    const targetSummary = this.browserActionTargetSummary(result);
    const warning = result.warnings.length > 0 ? '\n' + result.warnings.join('\n') : '';
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_confirm_title')),
      message: resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_confirm_message')) + targetSummary + warning,
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_confirm')),
        action: (): void => {
          this.browserActionConfirmPayload(result.planId);
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {
          this.clearBrowserRequests();
          this.pendingBrowserAction = '';
        }
      }
    });
  }

  private browserActionTargetSummary(result: AgentBridgeBrowserResult): string {
    const target = result.target;
    const hostContext = this.getUIContext().getHostContext();
    const parts: Array<string> = [];
    if (target.workspaceId.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_target_workspace')) + ': ' + target.workspaceId);
    }
    if (target.agentId.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_target_agent')) + ': ' + target.agentId);
    }
    if (target.hostId.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_target_host')) + ': ' + target.hostId);
    }
    if (target.instanceId.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_target_instance')) + ': ' + target.instanceId);
    }
    if (target.pageId.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_target_page')) + ': ' + target.pageId);
    }
    if (target.action.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_target_kind')) + ': ' + target.action);
    }
    if (parts.length === 0) return '';
    return '\n\n' + resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_target_summary')) + '\n' + parts.join('\n');
  }

  private showBrowserClosePreview(result: AgentBridgeBrowserResult): void {
    const hostContext = this.getUIContext().getHostContext();
    const isInstance = this.completedBrowserAction === AgentBridgeRequestType.BROWSER_INSTANCE_CLOSE;
    const workspaceId = this.browserWorkspaceId();
    const hostId = this.selectedBrowserHostId;
    const instanceId = this.selectedBrowserInstanceId;
    const pageId = this.selectedBrowserPageId;
    const agentId = this.currentBridgeAgentId();
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, isInstance ? $r('app.string.agent_home_browser_close_instance') : $r('app.string.agent_home_browser_close_page')),
      message: result.warnings.length > 0 ? result.warnings.join('\n') : resolveResourceString(hostContext, $r('app.string.agent_home_browser_action_confirm_message')),
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_confirm')),
        action: (): void => {
          if (isInstance) {
            const requestId = this.client.closeBrowserInstance(workspaceId, instanceId, hostId, agentId, result.planId, true);
            this.beginBrowserRequest(AgentBridgeRequestType.BROWSER_INSTANCE_CLOSE, requestId, workspaceId, hostId, instanceId);
          } else {
            const requestId = this.client.closeBrowserPage(workspaceId, pageId, agentId, hostId, instanceId, result.planId, true);
            this.beginBrowserRequest(AgentBridgeRequestType.BROWSER_PAGE_CLOSE, requestId, workspaceId, hostId, instanceId, pageId);
          }
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {
          this.clearBrowserRequests();
          this.pendingBrowserAction = '';
        }
      }
    });
  }

  private browserActionConfirmPayload(planId: string): void {
    const source = this.pendingBrowserActionPayload;
    if (source === null || planId.length === 0) return;
    const payload = new AgentBridgeBrowserPayload();
    payload.workspaceId = source.workspaceId;
    payload.agentId = source.agentId;
    payload.hostId = source.hostId;
    payload.instanceId = source.instanceId;
    payload.pageId = source.pageId;
    payload.action = source.action;
    payload.ref = source.ref;
    payload.sourceRef = source.sourceRef;
    payload.targetRef = source.targetRef;
    payload.value = source.value;
    payload.text = source.text;
    payload.key = source.key;
    payload.functionSource = source.functionSource;
    payload.deltaX = source.deltaX;
    payload.deltaY = source.deltaY;
    payload.timeoutMs = source.timeoutMs;
    payload.maxEntries = source.maxEntries;
    payload.fullPage = source.fullPage;
    for (let index = 0; index < source.filePaths.length; index++) {
      payload.filePaths.push(source.filePaths[index]);
    }
    for (let index = 0; index < source.domains.length; index++) {
      payload.domains.push(source.domains[index]);
    }
    payload.planId = planId;
    payload.confirm = true;
    this.pendingBrowserActionPayload = null;
    const requestId = this.client.runBrowserAction(payload);
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_ACTION,
      requestId,
      payload.workspaceId,
      payload.hostId,
      payload.instanceId,
      payload.pageId
    );
  }

  private refreshBrowserAutomation(): void {
    if (!this.canUseBridgeBrowserAutomation() || this.browserAutomationPending) return;
    const workspaceId = this.browserWorkspaceId();
    if (workspaceId.length === 0) return;
    const hostRequestId = this.client.listBrowserHosts(workspaceId);
    this.beginBrowserRequest(AgentBridgeRequestType.BROWSER_HOST_LIST, hostRequestId, workspaceId);
    const permissionRequestId = this.client.requestBrowserPermission(workspaceId);
    this.beginBrowserRequest(AgentBridgeRequestType.BROWSER_PERMISSION_GET, permissionRequestId, workspaceId);
  }

  private requestBrowserHostChildren(workspaceId: string): void {
    const instanceRequestId = this.client.listBrowserInstances(workspaceId, this.currentBridgeAgentId(), this.selectedBrowserHostId);
    this.beginBrowserRequest(AgentBridgeRequestType.BROWSER_INSTANCE_LIST, instanceRequestId, workspaceId, this.selectedBrowserHostId);
    const pageRequestId = this.client.listBrowserPages(
      workspaceId,
      this.currentBridgeAgentId(),
      this.selectedBrowserHostId,
      this.selectedBrowserInstanceId
    );
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_LIST,
      pageRequestId,
      workspaceId,
      this.selectedBrowserHostId,
      this.selectedBrowserInstanceId
    );
    const downloadRequestId = this.client.listBrowserDownloads(
      workspaceId,
      '',
      this.selectedBrowserHostId,
      this.currentBridgeAgentId(),
      this.selectedBrowserInstanceId
    );
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_DOWNLOAD_LIST,
      downloadRequestId,
      workspaceId,
      this.selectedBrowserHostId,
      this.selectedBrowserInstanceId
    );
  }

  private createBrowserPageFromDraft(): void {
    if (!this.canUseBridgeBrowserAutomation() || this.browserAutomationPending ||
      !this.browserSupportsBrowserCommand('page.create')) return;
    const workspaceId = this.browserWorkspaceId();
    const url = this.browserUrlDraft.trim();
    if (workspaceId.length === 0 || url.length === 0) return;
    const requestId = this.client.createBrowserPage(
      workspaceId,
      url,
      this.currentBridgeAgentId(),
      this.selectedBrowserHostId,
      this.selectedBrowserInstanceId
    );
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_CREATE,
      requestId,
      workspaceId,
      this.selectedBrowserHostId,
      this.selectedBrowserInstanceId
    );
  }

  private previewBrowserPermissionUpdate(): void {
    if (!this.canUseBridgeBrowserAutomation() || this.browserAutomationPending) return;
    const workspaceId = this.browserWorkspaceId();
    const domain = this.browserDomainDraft.trim();
    if (workspaceId.length === 0 || domain.length === 0) return;
    const requestId = this.client.setBrowserPermission(workspaceId, [domain]);
    this.beginBrowserRequest(AgentBridgeRequestType.BROWSER_PERMISSION_SET, requestId, workspaceId);
  }

  private showBrowserPermissionPreview(result: AgentBridgeBrowserResult): void {
    if (!result.preview || result.planId.length === 0) return;
    const workspaceId = this.browserWorkspaceId();
    const domains = result.domains;
    const hostContext = this.getUIContext().getHostContext();
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_browser_permission_confirm_title')),
      message: resolveResourceString(hostContext, $r('app.string.agent_home_browser_permission_confirm_message')),
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_confirm')),
        action: (): void => {
          const requestId = this.client.setBrowserPermission(workspaceId, domains, result.planId, true);
          this.beginBrowserRequest(AgentBridgeRequestType.BROWSER_PERMISSION_SET, requestId, workspaceId);
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {
          this.clearBrowserRequests();
          this.pendingBrowserAction = '';
        }
      }
    });
  }

  private requestBrowserPageSnapshot(pageId: string): void {
    if (!this.canUseBridgeBrowserAutomation() || this.browserAutomationPending || pageId.length === 0 ||
      !this.browserSupportsBrowserCommand('page.snapshot')) return;
    const workspaceId = this.browserWorkspaceId();
    if (workspaceId.length === 0) return;
    const page = this.findBrowserPage(pageId);
    this.selectedBrowserPageId = pageId;
    const requestId = this.client.requestBrowserSnapshot(workspaceId, pageId, page === null ? this.selectedBrowserHostId : page.hostId);
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_SNAPSHOT,
      requestId,
      workspaceId,
      page === null ? this.selectedBrowserHostId : page.hostId,
      page === null ? this.selectedBrowserInstanceId : page.instanceId,
      pageId
    );
  }

  private requestBrowserPageScreenshot(pageId: string): void {
    if (!this.canUseBridgeBrowserAutomation() || this.browserAutomationPending || pageId.length === 0 ||
      !this.browserSupportsBrowserCommand('page.screenshot')) return;
    const workspaceId = this.browserWorkspaceId();
    if (workspaceId.length === 0) return;
    const page = this.findBrowserPage(pageId);
    this.selectedBrowserPageId = pageId;
    const requestId = this.client.requestBrowserScreenshot(
      workspaceId,
      pageId,
      this.browserScreenshotFullPage,
      page === null ? this.selectedBrowserHostId : page.hostId
    );
    this.beginBrowserRequest(
      AgentBridgeRequestType.BROWSER_PAGE_SCREENSHOT,
      requestId,
      workspaceId,
      page === null ? this.selectedBrowserHostId : page.hostId,
      page === null ? this.selectedBrowserInstanceId : page.instanceId,
      pageId
    );
  }

  private resetBrowserPermissionState(): void {
    this.browserPermission = new AgentBridgeBrowserPermissionState();
  }

  private applyBrowserPermissionState(result: AgentBridgeBrowserResult): void {
    const workspaceId: string = result.permission.workspaceId.length > 0
      ? result.permission.workspaceId
      : result.workspaceId;
    const currentWorkspaceId: string = this.browserWorkspaceId();
    if (workspaceId.length === 0 || currentWorkspaceId.length === 0 || workspaceId !== currentWorkspaceId) {
      return;
    }
    const next = new AgentBridgeBrowserPermissionState();
    next.workspaceId = workspaceId;
    for (let index = 0; index < result.domains.length; index++) {
      next.domains.push(result.domains[index]);
    }
    next.downloadDirectoryConfigured = result.permission.downloadDirectoryConfigured || result.downloadDirectoryConfigured;
    next.updatedAt = result.permission.updatedAt.length > 0 ? result.permission.updatedAt : result.updatedAt;
    this.browserPermission = next;
  }

  private applyBrowserAutomationResult(source: string, parsed: AgentBridgeParsedMessage): void {
    if (parsed.eventType === AgentBridgeEventType.BROWSER_UPDATED) {
      const eventResult: AgentBridgeBrowserResult = AgentBridgeIncomingParser.parseBrowserResult(source);
      if (!this.browserEventScopeCoordinator.accepts(
        eventResult,
        this.agentHomePageVisible,
        this.browserWorkspaceId(),
        this.selectedBrowserHostId,
        this.selectedBrowserInstanceId,
        this.selectedBrowserPageId
      )) {
        logger.debug(TAG, 'ignored stale or out-of-scope browser lifecycle event: ' + eventResult.eventKind);
        return;
      }
      if (eventResult.permission.workspaceId.length > 0 || eventResult.workspaceId.length > 0) {
        this.applyBrowserPermissionState(eventResult);
      }
      if (this.canUseBridgeBrowserAutomation() && !this.browserAutomationPending) this.refreshBrowserAutomation();
      return;
    }
    const result = AgentBridgeIncomingParser.parseBrowserResult(source);
    if (!this.completeBrowserRequest(parsed, result)) {
      return;
    }
    this.browserAutomationResult = result;
    if (this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PERMISSION_GET ||
      (this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PERMISSION_SET && result.confirmed)) {
      this.applyBrowserPermissionState(result);
    }
    if (result.screenshot.dataBase64.length > 0) {
      this.applyBrowserScreenshotPreview(result);
    } else if (this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_SCREENSHOT) {
      this.browserScreenshotDataUrl = '';
    }
    if (result.hosts.length > 0 || source.indexOf('"hosts":[]') >= 0) {
      this.browserHosts = result.hosts;
      if (this.selectedBrowserHostId.length === 0 || !this.hasBrowserHost(this.selectedBrowserHostId)) {
        this.selectedBrowserHostId = this.firstUsableBrowserHostId(result.hosts);
        this.selectedBrowserInstanceId = '';
        this.selectedBrowserPageId = '';
      }
      if (this.selectedBrowserHostId.length > 0 && this.completedBrowserAction === AgentBridgeRequestType.BROWSER_HOST_LIST) {
        this.requestBrowserHostChildren(this.browserWorkspaceId());
      }
    }
    if (result.instances.length > 0 || source.indexOf('"instances":[]') >= 0) {
      const instances: Array<AgentBridgeBrowserInstanceRecord> = [];
      for (let index = 0; index < result.instances.length; index++) {
        const instance = result.instances[index];
        if (instance.hostId.length === 0) instance.hostId = result.hostId.length > 0 ? result.hostId : this.selectedBrowserHostId;
        instances.push(instance);
      }
      this.browserInstances = instances;
      if (this.selectedBrowserInstanceId.length > 0 && !this.hasBrowserInstance(this.selectedBrowserInstanceId)) {
        this.selectedBrowserInstanceId = '';
      }
    }
    if (result.pages.length > 0 || source.indexOf('"pages":[]') >= 0) {
      const pages: Array<AgentBridgeBrowserPageRecord> = [];
      for (let index = 0; index < result.pages.length; index++) {
        const page = result.pages[index];
        if (page.hostId.length === 0) page.hostId = result.hostId.length > 0 ? result.hostId : this.selectedBrowserHostId;
        if (page.instanceId.length === 0) page.instanceId = this.selectedBrowserInstanceId;
        pages.push(page);
      }
      this.browserPages = pages;
    }
    if (result.page.pageId.length > 0) {
      const next: Array<AgentBridgeBrowserPageRecord> = [];
      let replaced = false;
      for (let index = 0; index < this.browserPages.length; index++) {
        const item = this.browserPages[index];
        if (item.pageId === result.page.pageId) {
          next.push(result.page);
          replaced = true;
        } else {
          next.push(item);
        }
      }
      if (!replaced) next.push(result.page);
      this.browserPages = next;
      this.selectedBrowserPageId = result.page.pageId;
      this.selectedBrowserHostId = result.page.hostId.length > 0 ? result.page.hostId : this.selectedBrowserHostId;
      this.selectedBrowserInstanceId = result.page.instanceId.length > 0 ? result.page.instanceId : this.selectedBrowserInstanceId;
      this.browserNavigationUrlDraft = result.page.url;
    }
    if (result.instance.instanceId.length > 0) {
      const nextInstances: Array<AgentBridgeBrowserInstanceRecord> = [];
      let replaced = false;
      for (let index = 0; index < this.browserInstances.length; index++) {
        if (this.browserInstances[index].instanceId === result.instance.instanceId) {
          nextInstances.push(result.instance);
          replaced = true;
        } else {
          nextInstances.push(this.browserInstances[index]);
        }
      }
      if (!replaced) nextInstances.push(result.instance);
      this.browserInstances = nextInstances;
      this.selectedBrowserInstanceId = result.instance.instanceId;
    }
    if (result.logs.length > 0 || source.indexOf('"logs":[]') >= 0) this.browserLogs = result.logs;
    if (result.downloads.length > 0 || source.indexOf('"downloads":[]') >= 0) this.browserDownloads = result.downloads;
    if (!result.ok && result.failureCategory.length > 0) {
      this.browserErrorText = this.browserFailureSummary(result);
    }
    if (result.preview && this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PERMISSION_SET) {
      this.showBrowserPermissionPreview(result);
      return;
    }
    if (result.preview && (this.completedBrowserAction === AgentBridgeRequestType.BROWSER_INSTANCE_CLOSE ||
      this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_CLOSE)) {
      this.showBrowserClosePreview(result);
      return;
    }
    if (result.preview && this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_ACTION) {
      this.showBrowserActionPreview(result);
      return;
    }
    if (result.confirmed && this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PERMISSION_SET) {
      if (!this.browserAutomationPending) this.pendingBrowserAction = '';
      this.requestBrowserHostChildren(this.browserWorkspaceId());
      return;
    }
    if (result.confirmed && (this.completedBrowserAction === AgentBridgeRequestType.BROWSER_INSTANCE_CLOSE ||
      this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_CLOSE)) {
      if (!this.browserAutomationPending) this.pendingBrowserAction = '';
      this.selectedBrowserPageId = '';
      this.requestBrowserHostChildren(this.browserWorkspaceId());
      return;
    }
    if (result.ok && this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_CREATE) {
      if (!this.browserAutomationPending) this.pendingBrowserAction = '';
      this.requestBrowserHostChildren(this.browserWorkspaceId());
      return;
    }
    if (result.ok && this.completedBrowserAction === AgentBridgeRequestType.BROWSER_INSTANCE_CREATE) {
      if (!this.browserAutomationPending) this.pendingBrowserAction = '';
      this.requestBrowserHostChildren(this.browserWorkspaceId());
      return;
    }
    if (result.ok && this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_ACTION) {
      this.browserStatusText = resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_browser_result_summary'));
      if (!this.browserAutomationPending) this.pendingBrowserAction = '';
      this.requestBrowserHostChildren(this.browserWorkspaceId());
      return;
    }
    if (result.ok && (this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_NAVIGATE ||
      this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_WAIT ||
      this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_LOGS ||
      this.completedBrowserAction === AgentBridgeRequestType.BROWSER_DOWNLOAD_LIST ||
      this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_SNAPSHOT ||
      this.completedBrowserAction === AgentBridgeRequestType.BROWSER_PAGE_SCREENSHOT)) {
      if (!this.browserAutomationPending) this.pendingBrowserAction = '';
      return;
    }
    if (!result.preview && !this.browserAutomationPending) this.pendingBrowserAction = '';
  }

  private refreshProviderDirectory(): void {
    const url = this.providerDirectoryUrlDraft.trim();
    if (url.length === 0 || this.providerDirectoryPending) { return; }
    this.providerDirectoryPending = true;
    this.client.refreshRemoteProviderDirectory(url);
  }

  private previewProviderDirectoryInstall(item: AgentBridgeProviderDirectoryEntry): void {
    if (!this.providerDirectoryPending) { this.providerDirectoryPending = true; this.client.installRemoteProvider(item.providerId); }
