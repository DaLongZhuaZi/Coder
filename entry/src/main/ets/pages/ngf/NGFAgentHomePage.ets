  private toggleDiagnosticsGroup(groupId: string): void {
    const next: Array<string> = [];
    let found = false;
    for (let index = 0; index < this.expandedDiagnosticsGroupIds.length; index++) {
      if (this.expandedDiagnosticsGroupIds[index] === groupId) {
        found = true;
      } else {
        next.push(this.expandedDiagnosticsGroupIds[index]);
      }
    }
    if (!found) {
      next.push(groupId);
    }
    this.expandedDiagnosticsGroupIds = next;
  }

  private isDiagnosticsGroupExpanded(groupId: string): boolean {
    return this.expandedDiagnosticsGroupIds.includes(groupId);
  }

  private isKnownDiagnosticsAction(actionId: string): boolean {
    return AgentHomeDiagnosticsActionPolicy.normalize(actionId).length > 0;
  }

  private runDiagnosticsAction(actionId: string): void {
    const normalized = AgentHomeDiagnosticsActionPolicy.normalize(actionId);
    if (normalized === AgentHomeDiagnosticsActionPolicy.OPEN_PROVIDER_SETTINGS ||
      normalized === AgentHomeDiagnosticsActionPolicy.OPEN_SECURE_STORAGE_HELP) {
      this.openSheet(AgentHomeSheetKey.SETTINGS);
    } else if (normalized === AgentHomeDiagnosticsActionPolicy.OPEN_TERMINAL_SETTINGS) {
      this.openSheet(AgentHomeSheetKey.RUNTIME);
      this.refreshBridgeTerminalsIfAvailable();
    } else if (normalized === AgentHomeDiagnosticsActionPolicy.OPEN_DAEMON_SETTINGS) {
      this.openSheet(AgentHomeSheetKey.GLOBAL_SETTINGS);
      this.refreshDaemonStatus();
    } else if (normalized === AgentHomeDiagnosticsActionPolicy.REVIEW_MESSAGE_QUEUE) {
      this.openSheet(AgentHomeSheetKey.SESSION_DETAILS);
      this.client.requestMessageQueue(this.currentBridgeSessionId());
    } else if (normalized === AgentHomeDiagnosticsActionPolicy.OPEN_USAGE_SETTINGS) {
      this.openSheet(AgentHomeSheetKey.SESSION_DETAILS);
      this.refreshCurrentUsageScope();
    } else if (normalized === AgentHomeDiagnosticsActionPolicy.REFRESH_REMOTE_CONFIG) {
      this.client.requestDaemonConfigStatus(this.activeHostProfileId);
    } else if (normalized === AgentHomeDiagnosticsActionPolicy.REPAIR_PERSISTENCE) {
      this.openSheet(AgentHomeSheetKey.GLOBAL_SETTINGS);
    }
  }

