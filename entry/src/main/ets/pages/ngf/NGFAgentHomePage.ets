    }
    if (sheetKey === AgentHomeSheetKey.WORKSPACE_BROWSER) {
      return this.isWorkspaceBrowserSheetOpen;
    }
    if (sheetKey === AgentHomeSheetKey.TOOL_DETAIL) {
