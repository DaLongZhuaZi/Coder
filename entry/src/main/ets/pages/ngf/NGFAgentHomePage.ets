  private openCurrentSessionWindow(): void {
    const session = this.currentSession();
    if (session === null || this.activeHostProfileId.length === 0) {
      return;
    }
    const target = new AgentHomeSessionWindowTarget(
      this.activeHostProfileId,
      session.workspaceId,
      this.currentBridgeAgentId(),
      session.id
    );
    const plan: AgentHomeSessionWindowOpenPlan = this.sessionWindowCoordinator.planOpen(target);
    if (plan.action === AgentHomeSessionWindowOpenAction.FOCUS) {
      ngfPlatformWindowManagerFacade.focusSubWindow(plan.windowName).then((focused: boolean): void => {
        if (focused) {
          return;
        }
        agentHomeSessionWindowRuntimeRegistry.release(plan.target.instanceId);
        this.sessionWindowCoordinator.markClosed(plan.windowName, plan.target.instanceId);
        this.openCurrentSessionWindow();
      }).catch((error: Error): void => {
        logger.warn(TAG, 'focus session subwindow failed: ' + this.errorToString(error));
        agentHomeSessionWindowRuntimeRegistry.release(plan.target.instanceId);
        this.sessionWindowCoordinator.markClosed(plan.windowName, plan.target.instanceId);
      });
      return;
    }
    if (plan.action !== AgentHomeSessionWindowOpenAction.CREATE) {
      return;
    }
    ngfPlatformWindowManagerFacade.createSubWindow(plan.windowName)
      .then((subWindow: window.Window): Promise<void> => {
        if (!this.sessionWindowCoordinator.acceptsEvent(plan.windowName, plan.target.instanceId)) {
          return ngfPlatformWindowManagerFacade.destroySubWindow(plan.windowName);
        }
        return AgentHomeSessionWindowContentLoader.load(subWindow, plan.windowName, plan.target);
      })
      .then((): void => {
        if (!this.sessionWindowCoordinator.markOpened(plan)) {
          this.closeSessionWindowPlan(new AgentHomeSessionWindowClosePlan(
            true,
            plan.windowName,
            plan.target.instanceId,
            'stale_open'
          ));
        }
      })
      .catch((error: Error): void => {
        logger.error(TAG, 'open session subwindow failed: ' + this.errorToString(error));
        this.sessionWindowCoordinator.markOpenFailed(plan, this.errorToString(error));
        agentHomeSessionWindowRuntimeRegistry.release(plan.target.instanceId);
        ngfPlatformWindowManagerFacade.destroySubWindow(plan.windowName).catch((destroyError: Error): void => {
          logger.warn(TAG, 'cleanup failed session subwindow failed: ' + this.errorToString(destroyError));
        });
        this.showTransientStatus(resolveResourceString(
          this.getUIContext().getHostContext(),
          $r('app.string.agent_home_session_window_failed')
        ));
      });
  }

  private handleSessionWindowDestroyed(windowName: string): void {
    const record: AgentHomeSessionWindowRecord | null = this.sessionWindowCoordinator.recordForWindow(windowName);
    if (record !== null) {
      agentHomeSessionWindowRuntimeRegistry.release(record.target.instanceId);
    }
    this.sessionWindowCoordinator.markClosedWindow(windowName);
  }

  private closeSessionWindowPlan(plan: AgentHomeSessionWindowClosePlan): void {
    if (!plan.shouldClose || plan.windowName.length === 0) {
      return;
    }
    agentHomeSessionWindowRuntimeRegistry.release(plan.instanceId);
    ngfPlatformWindowManagerFacade.destroySubWindow(plan.windowName).then((): void => {
      this.sessionWindowCoordinator.markClosed(plan.windowName, plan.instanceId);
    }).catch((error: Error): void => {
      logger.warn(TAG, 'close session subwindow failed: ' + this.errorToString(error));
      this.sessionWindowCoordinator.markClosed(plan.windowName, plan.instanceId);
    });
  }

  private closeSessionWindowPlans(plans: Array<AgentHomeSessionWindowClosePlan>): void {
    for (let index = 0; index < plans.length; index++) {
      this.closeSessionWindowPlan(plans[index]);
    }
  }

  private closeSessionWindowsForHost(hostProfileId: string, reason: string): void {
    if (hostProfileId.length === 0) {
      return;
    }
    this.closeSessionWindowPlans(this.sessionWindowCoordinator.invalidateHost(hostProfileId, reason));
  }

  private closeSessionWindowsForWorkspace(hostProfileId: string, workspaceId: string, reason: string): void {
    if (hostProfileId.length === 0 || workspaceId.length === 0) {
      return;
    }
    this.closeSessionWindowPlans(
      this.sessionWindowCoordinator.invalidateWorkspace(hostProfileId, workspaceId, reason)
    );
  }

  private closeSessionWindowForSession(hostProfileId: string, sessionId: string, reason: string): void {
    if (hostProfileId.length === 0 || sessionId.length === 0) {
      return;
    }
    this.closeSessionWindowPlan(
      this.sessionWindowCoordinator.invalidateSession(hostProfileId, sessionId, reason)
    );
  }

  private closeAllSessionWindows(reason: string): void {
    const records: Array<AgentHomeSessionWindowRecord> = this.sessionWindowCoordinator.activeRecords();
    for (let index = 0; index < records.length; index++) {
      this.closeSessionWindowPlan(
        this.sessionWindowCoordinator.planCloseWindow(records[index].windowName, reason)
      );
    }
  }

