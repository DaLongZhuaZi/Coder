  private gitPlanPreviewMessage(result: AgentBridgeGitActionResult): string {
    const hostContext = this.getUIContext().getHostContext();
    const parts: Array<string> = [];
    parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_preview_message')));
    if (result.affectedPaths.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_affected_paths')) + ': ' +
        this.gitPlanPathsText(result.affectedPaths));
    }
    if (result.untrackedPaths.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_untracked_paths')) + ': ' +
        this.gitPlanPathsText(result.untrackedPaths));
    }
    if (result.targetRef.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_target')) + ': ' + result.targetRef);
    }
    if (result.remoteName.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_remote')) + ': ' + result.remoteName);
    }
    parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_ahead_behind')) + ': ' +
      String(result.ahead) + '/' + String(result.behind));
    if (result.forceRisk) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_force_risk')));
    }
    if (result.overwriteRisk) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_overwrite_risk')));
    }
    if (result.conflictPossible) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_conflict_risk')));
    }
    if (result.risks.length > 0) {
      const riskTexts: Array<string> = [];
      for (let index = 0; index < result.risks.length && index < 6; index++) {
        const risk: AgentBridgeGitRiskRecord = result.risks[index];
        let riskText = risk.message.length > 0 ? risk.message : risk.code;
        if (risk.remediation.length > 0) {
          riskText = riskText + ' (' + risk.remediation + ')';
        }
        riskTexts.push(riskText);
      }
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_risks')) + ': ' + riskTexts.join(' / '));
    }
    return parts.join('\n');
  }

  private showGitPlanPreviewDialog(result: AgentBridgeGitActionResult): void {
    const hostContext = this.getUIContext().getHostContext();
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_git_plan_preview_title')),
      message: this.gitPlanPreviewMessage(result),
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_confirm')),
        action: (): void => {
          this.requestPendingGitPlanConfirm(result.planId);
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {
          this.clearPendingGitPlan();
        }
      }
    });
  }

  private requestPendingGitPlanConfirm(planId: string): void {
    if (planId.length === 0 || this.pendingGitPlanOperation.length === 0) {
      this.clearPendingGitPlan();
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_git_plan_expired')
      ));
      return;
    }
    const sessionId = this.pendingGitPlanSessionId;
    const workspaceId = this.pendingGitPlanWorkspaceId;
    const agentId = this.currentBridgeAgentId();
    if (this.pendingGitPlanOperation === 'discard') {
      this.client.discardWorkspacePaths(sessionId, workspaceId, this.pendingGitPlanPaths.slice(), agentId, planId, true);
    } else if (this.pendingGitPlanOperation === 'pull') {
      this.client.gitPull(sessionId, workspaceId, this.pendingGitPlanRemote, this.pendingGitPlanBranch,
        this.pendingGitPlanFfOnly, agentId, planId, true);
    } else if (this.pendingGitPlanOperation === 'merge') {
      this.client.gitMerge(sessionId, workspaceId, this.pendingGitPlanRef, this.pendingGitPlanNoCommit,
        this.pendingGitPlanFfOnly, agentId, planId, true);
    } else if (this.pendingGitPlanOperation === 'push.force') {
      this.client.gitPush(sessionId, workspaceId, this.pendingGitPlanRemote, this.pendingGitPlanBranch,
        true, agentId, planId, true);
    } else if (this.pendingGitPlanOperation === 'branch.delete') {
      this.client.gitBranch(sessionId, workspaceId, 'delete', this.pendingGitPlanName, this.pendingGitPlanStartPoint,
        this.pendingGitPlanForce, agentId, planId, true);
    } else if (this.pendingGitPlanOperation === 'stash.pop' || this.pendingGitPlanOperation === 'stash.drop') {
      const action = this.pendingGitPlanOperation === 'stash.pop' ? 'pop' : 'drop';
      this.client.gitStash(sessionId, workspaceId, action, this.pendingGitPlanMessage, this.pendingGitPlanRef,
        this.pendingGitPlanIncludeUntracked, agentId, planId, true);
    } else {
      this.clearPendingGitPlan();
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_git_plan_confirm_failed')
      ));
    }
  }

