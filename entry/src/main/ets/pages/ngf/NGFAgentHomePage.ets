  @Builder
  private buildDaemonDiagnosticRow(label: ResourceStr, value: string): void {
    Row({ space: 8 }) {
      Text(label)
        .fontSize(11)
        .fontColor($r('app.color.text_secondary'))
        .width(92)
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
      Text(value.length > 0 ? value : this.resolveDetailEmptyText())
        .fontSize(11)
        .fontColor($r('app.color.text_body'))
        .layoutWeight(1)
        .maxLines(2)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
    }
    .width('100%')
  }

