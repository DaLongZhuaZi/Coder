  }

  private parseM7PositiveInteger(source: string, fallbackValue: number, maximum: number): number {
    const parsed = Number.parseInt(source.trim());
    if (!Number.isFinite(parsed) || parsed <= 0) {
      return fallbackValue;
    }
    return Math.min(parsed, maximum);
  }

  private isBridgeM7Message(source: string, parsed: AgentBridgeParsedMessage): boolean {
    if (parsed.eventType === AgentBridgeEventType.SCHEDULE_UPDATED ||
      parsed.eventType === AgentBridgeEventType.SCHEDULE_RUN_UPDATED ||
      parsed.eventType === AgentBridgeEventType.LOOP_UPDATED ||
      parsed.eventType === AgentBridgeEventType.LOOP_ROUND_UPDATED ||
      parsed.eventType === AgentBridgeEventType.CHAT_ROOM_UPDATED ||
      parsed.eventType === AgentBridgeEventType.CHAT_ROOM_MESSAGE_CREATED ||
      parsed.eventType === AgentBridgeEventType.CHAT_ROOM_ACK_UPDATED) {
      return true;
    }
    return source.indexOf('"action":"schedule.') >= 0 ||
      source.indexOf('"action":"loop.') >= 0 ||
      source.indexOf('"action":"chat.room.') >= 0;
  }

  private upsertMessageQueueItem(item: AgentBridgeMessageQueueItem): void {
    if (item.queueId.length === 0 ||
      (item.hostProfileId.length > 0 && item.hostProfileId !== this.activeHostProfileId) ||
      (item.sessionId.length > 0 && item.sessionId !== this.currentBridgeSessionId())) {
      return;
    }
    const nextItems: Array<AgentBridgeMessageQueueItem> = [];
    let replaced = false;
    for (let index = 0; index < this.messageQueueItems.length; index++) {
      if (this.messageQueueItems[index].queueId === item.queueId) {
        nextItems.push(item);
        replaced = true;
      } else {
        nextItems.push(this.messageQueueItems[index]);
      }
    }
    if (!replaced) {
      nextItems.push(item);
    }
    this.messageQueueItems = nextItems;
  }

  private upsertUsageEvent(item: AgentBridgeUsageEventRecord): void {
    if (item.eventId.length === 0 ||
      (item.hostProfileId.length > 0 && item.hostProfileId !== this.activeHostProfileId) ||
      (item.sessionId.length > 0 && item.sessionId !== this.currentBridgeSessionId())) {
      return;
    }
    const nextItems: Array<AgentBridgeUsageEventRecord> = [];
    let replaced = false;
    for (let index = 0; index < this.usageEventItems.length; index++) {
      if (this.usageEventItems[index].eventId === item.eventId) {
        nextItems.push(item);
        replaced = true;
      } else {
        nextItems.push(this.usageEventItems[index]);
      }
    }
    if (!replaced) {
      nextItems.push(item);
    }
    this.usageEventItems = nextItems;
  }

  private mergeUsageBudgetWarnings(items: Array<AgentBridgeUsageBudgetWarningRecord>): void {
    const nextItems: Array<AgentBridgeUsageBudgetWarningRecord> = [];
    for (let index = 0; index < this.usageBudgetWarnings.length; index++) {
      const existing = this.usageBudgetWarnings[index];
      if (this.isUsageBudgetWarningForCurrentScope(existing)) {
        nextItems.push(existing);
      }
    }
    for (let index = 0; index < items.length; index++) {
      const item = items[index];
      if (!this.isUsageBudgetWarningForCurrentScope(item)) {
        continue;
      }
      let replaced = false;
      for (let targetIndex = 0; targetIndex < nextItems.length; targetIndex++) {
        if (nextItems[targetIndex].window === item.window &&
          nextItems[targetIndex].windowStartAt === item.windowStartAt &&
          nextItems[targetIndex].sessionId === item.sessionId && nextItems[targetIndex].agentId === item.agentId) {
          nextItems[targetIndex] = item;
          replaced = true;
          break;
        }
      }
      if (!replaced) {
        nextItems.push(item);
      }
    }
    this.usageBudgetWarnings = nextItems;
  }

  private isUsageBudgetWarningForCurrentScope(item: AgentBridgeUsageBudgetWarningRecord): boolean {
    return (item.hostProfileId.length === 0 || item.hostProfileId === this.activeHostProfileId) &&
      (item.sessionId.length === 0 || item.sessionId === this.currentBridgeSessionId()) &&
      (item.agentId.length === 0 || item.agentId === this.currentBridgeAgentId());
  }

  private saveCurrentUsageBudget(): void {
    const tokenText = this.usageTokenBudgetDraft.trim();
    const costText = this.usageCostBudgetDraft.trim();
    const thresholdText = this.usageBudgetWarningThresholdDraft.trim();
    const tokenLimit = tokenText.length > 0 ? Number(tokenText) : -1;
    const costLimit = costText.length > 0 ? Number(costText) : -1;
    const warningThreshold = thresholdText.length > 0 ? Number(thresholdText) : 0.8;
    if ((tokenText.length > 0 && (!Number.isFinite(tokenLimit) || tokenLimit < 0)) ||
      (costText.length > 0 && (!Number.isFinite(costLimit) || costLimit < 0)) ||
      !Number.isFinite(warningThreshold) || warningThreshold <= 0 || warningThreshold > 1) {
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_budget_invalid')
      ));
      return;
    }
    if (tokenText.length === 0 && costText.length === 0) {
      this.client.clearUsageBudget(this.currentBridgeSessionId(), this.currentBridgeAgentId(), this.usageBudgetWindowDraft);
      return;
    }
    const currency = this.usageBudgetCurrencyDraft.trim().toUpperCase();
    if (costLimit >= 0 && currency.length === 0) {
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_budget_invalid')
      ));
      return;
    }
    this.client.setUsageBudget(
      this.currentBridgeSessionId(), tokenLimit, costLimit, currency, this.usageBudgetWindowDraft,
      warningThreshold, this.currentBridgeAgentId()
    );
  }

  private queueSummaryText(): string {
    return resolveResourceString(
      this.getUIContext().getHostContext(), $r('app.string.agent_home_queue_count', String(this.messageQueueItems.length))
    );
  }

  private copyTextToPasteboard(text: string): void {
    if (text.length === 0) {
      return;
    }
    pasteboard.getSystemPasteboard().setData(
      pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN, text)
    ).then((): void => {
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_metadata_copied')
      ));
    }).catch((error: Error): void => {
      logger.error(TAG, 'copy metadata suggestion failed: ' + this.errorToString(error));
    });
  }

  private requestMetadataSuggestion(kind: string): void {
    if (!this.supportsMetadataGeneration()) {
      return;
    }
    if (this.pendingMetadataRequestId.length > 0) {
      this.client.cancelMetadataGeneration(this.pendingMetadataRequestId, this.currentBridgeSessionId(),
        this.currentBridgeAgentId(), this.activeHostProfileId);
    }
    this.metadataSuggestionKind = kind;
    this.pendingMetadataRequestId = this.client.generateMetadata(this.currentBridgeSessionId(), this.currentBridgeAgentId(), kind,
      this.currentSessionTitle(), this.workspaceDiffSummaryText());
  }

  private cancelPendingMetadataGeneration(): void {
    if (this.pendingMetadataRequestId.length === 0) {
      return;
    }
    this.client.cancelMetadataGeneration(this.pendingMetadataRequestId, this.currentBridgeSessionId(),
      this.currentBridgeAgentId(), this.activeHostProfileId);
    this.pendingMetadataRequestId = '';
  }

  private applyMetadataSuggestion(): void {
    const value = this.metadataSuggestionDraft.trim();
    if (value.length === 0) {
      return;
    }
    if (this.metadataSuggestionKind === 'sessionTitle') {
      const session = this.currentSession();
      if (session !== null) {
        this.activeSessionActionId = session.id;
        this.renameSessionDraft = value;
        this.applySessionRename();
      }
    } else if (this.metadataSuggestionKind === 'branchName') {
      this.gitBranchDraft = value;
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_metadata_branch_ready')));
    } else if (this.metadataSuggestionKind === 'commitMessage') {
      this.commitMessageDraft = value;
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_metadata_commit_ready')));
    } else if (this.metadataSuggestionKind === 'pullRequest') {
      this.githubTitleDraft = value.split('\n')[0];
      this.githubBodyDraft = value;
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_metadata_pr_ready')));
    }
    this.metadataSuggestionDraft = '';
  }

  private workspaceDiffSummaryText(): string {
    const parts: Array<string> = [];
    for (let index = 0; index < this.workspaceChanges.length && index < 50; index++) {
      const item = this.workspaceChanges[index];
      parts.push(item.status + ' ' + item.path + ' +' + String(item.additions) + ' -' + String(item.deletions));
    }
    return parts.join('\n');
  }

  private applyBridgeDaemonConfig(source: string): void {
    if (!this.canUseBridgeRemoteDaemonConfig()) {
      return;
    }
    const result = AgentBridgeIncomingParser.parseDaemonConfigResult(source);
    if (result.action.length === 0) {
      return;
    }
    this.daemonConfigResult = result;
    this.daemonConfigBusy = result.preview;
    this.daemonConfigLastError = result.failureCategory.length > 0
      ? result.failureCategory + (result.message.length > 0 ? ': ' + result.message : '')
      : '';
    if (result.preview && result.planId.length > 0) {
      const hostContext = this.getUIContext().getHostContext();
      const isRollback: boolean = result.action === AgentBridgeRequestType.DAEMON_CONFIG_ROLLBACK;
      this.getUIContext().showAlertDialog({
        title: resolveResourceString(hostContext, $r('app.string.agent_home_daemon_remote_config_preview_title')),
        message: this.daemonConfigPreviewMessage(result),
        primaryButton: { value: resolveResourceString(hostContext, isRollback
          ? $r('app.string.agent_home_daemon_remote_config_confirm_rollback')
          : $r('app.string.agent_home_daemon_remote_config_confirm_apply')), action: (): void => {
          this.daemonConfigBusy = true;
          this.daemonConfigLastError = '';
          let requestId: string = '';
          if (isRollback) {
            requestId = this.client.rollbackDaemonConfig(result.planId, true, this.activeHostProfileId);
          } else {
            requestId = this.client.applyDaemonConfig(result.planId, true, this.activeHostProfileId);
          }
          if (requestId.length === 0) {
            this.daemonConfigBusy = false;
            this.daemonConfigLastError = resolveResourceString(
              this.getUIContext().getHostContext(), $r('app.string.agent_home_feature_unavailable')
            );
          }
        } },
        secondaryButton: { value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')), action: (): void => {
          this.daemonConfigBusy = false;
        } }
      });
      return;
    }
    if (result.confirmed) {
      this.refreshDaemonConfigStatus();
    }
  }

  private daemonConfigPreviewMessage(result: AgentBridgeDaemonConfigResult): string {
    const hostContext = this.getUIContext().getHostContext();
    const lines: Array<string> = [];
    lines.push(resolveResourceString(hostContext, $r('app.string.agent_home_daemon_remote_config_preview_version')) + ': ' +
      (result.configVersion.length > 0 ? result.configVersion : this.resolveDetailEmptyText()));
    if (result.scopeKind.length > 0) {
      lines.push(resolveResourceString(hostContext, $r('app.string.agent_home_daemon_remote_config_preview_scope')) + ': ' + result.scopeKind);
    }
    if (result.manifestDigest.length > 0) {
      const digestPreview: string = result.manifestDigest.length > 16
        ? result.manifestDigest.substring(0, 16) + '...'
        : result.manifestDigest;
      lines.push(resolveResourceString(hostContext, $r('app.string.agent_home_daemon_remote_config_preview_digest')) + ': ' + digestPreview);
    }
    if (result.overriddenFieldsJson.length > 0) {
      lines.push(resolveResourceString(hostContext, $r('app.string.agent_home_daemon_remote_config_preview_overrides')) + ': ' +
        result.overriddenFieldsJson);
    }
    if (result.requiresRestart) {
      lines.push(resolveResourceString(hostContext, $r('app.string.agent_home_daemon_remote_config_restart_required')));
    }
    return lines.join('\n');
  }

  private canUseBridgeGitHubAssetUpload(): boolean {
    const serverInfo: AgentBridgeServerInfo | null = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.githubAssetUpload;
  }

  private applyBridgeProviderDirectoryResult(source: string): void {
    if (!this.canUseBridgeRemoteProviderDirectory()) { return; }
    const result = AgentBridgeIncomingParser.parseProviderDirectoryResult(source);
    this.providerDirectoryPending = false;
    if (result.providers.length > 0 || source.indexOf('"providers":[]') >= 0) { this.providerDirectoryResult = result; }
    if (result.preview && result.providerId.length > 0 && result.planId.length > 0) {
      const hostContext = this.getUIContext().getHostContext();
      const previewVersion: string = result.version.length > 0 ? result.version : result.targetVersion;
      this.getUIContext().showAlertDialog({
        title: resolveResourceString(hostContext, $r('app.string.agent_home_provider_directory_confirm_title')),
        message: resolveResourceString(hostContext, $r('app.string.agent_home_provider_directory_confirm_message')) + '\n' + result.providerId + ' · ' + previewVersion,
        primaryButton: { value: resolveResourceString(hostContext, $r('app.string.agent_home_action_confirm')), action: (): void => {
          this.providerDirectoryPending = true;
          if (result.installStatus === 'rollback_preview') {
            this.client.rollbackRemoteProvider(result.providerId, result.planId, true);
          } else if (result.installStatus === 'remove_preview') {
            this.client.removeRemoteProvider(result.providerId, result.profileId, result.planId, true);
          } else {
            this.client.installRemoteProvider(result.providerId, result.planId, true);
          }
        } },
        secondaryButton: { value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')), action: (): void => {} }
      });
    } else if (result.confirmed) {
      this.client.listRemoteProviderDirectory(this.providerDirectorySearchDraft);
      this.client.listProviderProfiles();
      this.client.requestProviderCatalog('', '', true);
    }
  }

  private confirmGitHubPreviewResult(result: AgentBridgeGitHubResult): void {
    const hostContext = this.getUIContext().getHostContext();
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_github_title')),
      message: result.action + '\n' + result.repository,
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_github_merge_confirm')),
        action: (): void => {
          if (result.action === AgentBridgeRequestType.GITHUB_PR_UPDATE) {
            this.client.updateGitHubPullRequest(this.currentBridgeSessionId(), this.activeWorkspaceId,
              this.currentWorkspacePath(), result.number, this.githubTitleDraft, true, result.planId, true);
          } else if (result.action === AgentBridgeRequestType.GITHUB_PR_REVIEWERS_UPDATE) {
            const reviewers: Array<string> = [this.githubReviewerDraft.trim()];
            this.client.updateGitHubPullRequestReviewers(this.currentBridgeSessionId(), this.activeWorkspaceId,
              this.currentWorkspacePath(), result.number, reviewers, result.planId, true);
          } else if (result.action === AgentBridgeRequestType.GITHUB_PR_LABELS_UPDATE) {
            const labels: Array<string> = [this.githubLabelDraft.trim()];
            this.client.updateGitHubPullRequestLabels(this.currentBridgeSessionId(), this.activeWorkspaceId,
              this.currentWorkspacePath(), result.number, labels, result.planId, true);
          } else if (result.action === AgentBridgeRequestType.GITHUB_ATTACHMENT_PREVIEW) {
            this.client.uploadGitHubAttachment(this.currentBridgeSessionId(), this.activeWorkspaceId,
              this.currentWorkspacePath(), result.planId);
          }
        }
      },
      secondaryButton: { value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')), action: (): void => {} }
    });
  }

  private canUseBridgeRemoteProviderDirectory(): boolean {
