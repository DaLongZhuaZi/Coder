  private daemonFleetHealthSummaryText(): string {
    const parts: Array<string> = [];
    if (this.daemonFleetSummary.healthy > 0) {
      parts.push(this.daemonFleetHealthLabel('healthy') + ': ' + String(this.daemonFleetSummary.healthy));
    }
    if (this.daemonFleetSummary.degraded > 0) {
      parts.push(this.daemonFleetHealthLabel('degraded') + ': ' + String(this.daemonFleetSummary.degraded));
    }
    if (this.daemonFleetSummary.unreachable > 0) {
      parts.push(this.daemonFleetHealthLabel('unreachable') + ': ' + String(this.daemonFleetSummary.unreachable));
    }
    if (this.daemonFleetSummary.incompatible > 0) {
      parts.push(this.daemonFleetHealthLabel('incompatible') + ': ' + String(this.daemonFleetSummary.incompatible));
    }
    if (this.daemonFleetSummary.updating > 0) {
      parts.push(this.daemonFleetHealthLabel('updating') + ': ' + String(this.daemonFleetSummary.updating));
    }
    if (this.daemonFleetSummary.isolated > 0) {
      parts.push(this.daemonFleetHealthLabel('isolated') + ': ' + String(this.daemonFleetSummary.isolated));
    }
    if (this.daemonFleetSummary.unknown > 0) {
      parts.push(this.daemonFleetHealthLabel('unknown') + ': ' + String(this.daemonFleetSummary.unknown));
    }
    return parts.length > 0 ? parts.join(' / ') : this.resolveDetailEmptyText();
  }

  private daemonFleetHealthLabel(health: string): string {
    const hostContext = this.getUIContext().getHostContext();
    if (health === 'healthy') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_health_healthy'));
    }
    if (health === 'degraded') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_health_degraded'));
    }
    if (health === 'unreachable') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_health_unreachable'));
    }
    if (health === 'incompatible') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_health_incompatible'));
    }
    if (health === 'updating') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_health_updating'));
    }
    if (health === 'isolated') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_health_isolated'));
    }
    return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_health_unknown'));
  }

  private daemonFleetDistributionText(items: Array<AgentHomeDaemonFleetDistribution>): string {
    if (items.length === 0) {
      return this.resolveDetailEmptyText();
    }
    let text = '';
    for (let index = 0; index < items.length; index++) {
      if (index > 0) {
        text += ' / ';
      }
      const value = items[index].value === 'unavailable' ?
        this.resolveDetailEmptyText() : items[index].value;
      text += value + ': ' + String(items[index].count);
    }
    return text;
  }

  private daemonFleetHealthColor(health: string): ResourceColor {
    if (health === 'healthy') {
      return $r('app.color.tag_green');
    }
    if (health === 'degraded' || health === 'updating') {
      return $r('app.color.button_warning');
    }
    if (health === 'incompatible' || health === 'unreachable' || health === 'isolated') {
      return $r('app.color.tag_red');
    }
    return $r('app.color.text_secondary');
  }

