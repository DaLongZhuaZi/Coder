      this.buildWorkspaceRegistryInlineStatus(item)

      if (item.id === this.activeWorkspaceId) {
        Column({ space: 4 }) {
          if (this.sessionsForWorkspace(item.id).length === 0) {
            Text($r('app.string.agent_home_no_sessions_in_workspace'))
              .width('100%')
