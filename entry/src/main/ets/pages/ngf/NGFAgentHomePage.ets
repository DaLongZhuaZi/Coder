  private isRelayUrlDraftValid(): boolean {
    return AgentHomeRelayUiPolicy.isSafeRelayUrl(this.relayUrlDraft);
  }

  private relayBooleanText(value: boolean): string {
    return value ?
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_status_yes')) :
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_status_no'));
