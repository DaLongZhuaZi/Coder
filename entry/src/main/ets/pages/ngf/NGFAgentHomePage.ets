  @Builder
  private buildHostWorkspaceGroups(): void {
    Column({ space: 8 }) {
      Text($r('app.string.agent_home_host_workspace_groups_title'))
        .width('100%')
        .fontSize(14)
        .fontWeight(FontWeight.Medium)
        .fontColor($r('app.color.text_body'))
      ForEach(this.hostWorkspaceGroups, (group: AgentHomeHostWorkspaceGroup) => {
        this.buildHostWorkspaceGroup(group)
      }, (group: AgentHomeHostWorkspaceGroup): string => group.hostProfileId)
    }
