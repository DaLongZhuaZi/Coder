    if (!this.canUseBridgeProviderProfiles()) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_feature_unavailable')));
      return;
    }
    const displayName = this.providerProfileNameDraft.trim();
    const providerId = this.providerProfileProviderDraft.trim();
    if (displayName.length === 0 || providerId.length === 0) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_profile_required')));
      return;
    }
    const envText = this.providerProfileEnvDraft.trim();
    const envProvided = envText.length > 0;
    if (envProvided && !this.canUseBridgeProviderSecretStorage()) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_feature_unavailable')));
      return;
    }
    const envObject = this.providerProfileEnvObjectFromDraft();
