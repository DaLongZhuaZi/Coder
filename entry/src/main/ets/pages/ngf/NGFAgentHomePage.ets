  aboutToAppear(): void {
    this.agentHomePageVisible = true;
    this.voiceRequestCoordinator.reset(this.activeHostProfileId, this.connectionEpoch);
    this.voiceTtsPlaybackCoordinator.reset(this.activeHostProfileId, this.connectionEpoch);
    ngfVoicePlatformFacade.setListener(this.voiceListener);
    this.voiceSnapshot = ngfVoicePlatformFacade.getSnapshot();
    const uiContext = this.getUIContext();
    if (uiContext) {
      uiContextManager.bindUIContext(uiContext);
    }
    NGFPageWindowSupport.apply(NGFPageWindowName.AGENT_HOME);
    this.readInsets();
    this.isPersistentStateLoading = this.workspaces.length === 0 && this.sessions.length === 0 && this.messages.length === 0;
    this.initializeDefaults();
    this.loadExperienceDisplaySettings();
    this.loadOnboardingRichContentIconDataUrl();
    this.scheduleOnboardingRichContentRender();
    this.startSessionStatusPulse();
    this.syncPermissionRequestFlowLight();
    this.bindBridgeHandlersForEpoch('', this.connectionEpoch);
    ngfPlatformWindowManagerFacade.subscribeSubWindowLifecycle(
      AGENT_HOME_SESSION_WINDOW_LIFECYCLE_LISTENER_ID,
      this.sessionWindowLifecycleObserver
    );
    ngfPushManagerFacade.setStatusListener((status: NGFPushStatus): void => {
      this.handleLocalPushStatusChanged(status);
    });
    ngfPushManagerFacade.onMessageReceived((message: NGFPushPayloadRecord): void => {
      this.handlePushBackgroundMessage(message);
    });
    this.loadAppBuildVersion().then((): void => {
      this.loadPersistentState().catch((error: Error): void => {
        logger.error(TAG, 'load persistent state task failed: ' + this.errorToString(error));
      });
    }).catch((error: Error): void => {
      logger.error(TAG, 'load App build version task failed: ' + this.errorToString(error));
    });
    this.consumeNotificationTapRouteIfReady();
  }

  aboutToDisappear(): void {
    this.agentHomePageVisible = false;
    this.voiceTtsPlaybackCoordinator.invalidate();
    this.clearBrowserRequests();
    this.voiceRequestCoordinator.reset('', this.connectionEpoch);
    this.browserScreenshotDataUrl = '';
    this.cancelDaemonFleetRolling('page_disappear');
    this.daemonFleetConnectionPool.stop();
    ngfVoicePlatformFacade.setListener(null);
    ngfVoicePlatformFacade.release().catch((error: Error): void => {
      logger.warn(TAG, 'release voice platform failed: ' + this.errorToString(error));
    });
    this.closeAllSessionWindows('page_disappear');
    ngfPlatformWindowManagerFacade.unsubscribeSubWindowLifecycle(
      AGENT_HOME_SESSION_WINDOW_LIFECYCLE_LISTENER_ID
    );
    this.clearTransientStatusTimer();
    this.clearComposerSettleTimer();
    this.clearConversationAutoScrollTimer();
    this.clearConversationScrollGuardTimer();
    this.clearConversationRenderTimers();
    this.clearRichContentRenderTimer();
    this.clearOnboardingRichContentRenderTimer();
    this.clearOnboardingRichContentProbeTimer();
    this.clearVisibleRefreshReleaseTimer();
    this.visibleScopeCoordinator.clearHost(this.activeHostProfileId);
    this.controlKeyDown = false;
    this.metaKeyDown = false;
    this.altKeyDown = false;
    this.shiftKeyDown = false;
    this.clearSessionStatusPulse();
    this.stopPermissionRequestFlowLight();
    this.finishPersistentStateLoading();
    this.isConversationRenderPending = false;
    this.conversationRenderOverlayOpacity = 0;
    this.conversationRenderSessionId = '';
    this.publishAgentTaskInterruptedNotification(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_notification_interrupted_content'))
    );
    this.cancelAgentRequestNotification();
    this.stopAgentContinuousTask();
    this.stopActiveTurnTimer();
    this.destroyTrackedHostHttpRequests();
    if (this.githubWatchEnabled && this.lastGitHubResult.watchId.length > 0) {
      this.client.setGitHubWatch(this.currentBridgeSessionId(), this.activeWorkspaceId, this.currentWorkspacePath(),
        this.parseGitHubPrNumberDraft(), 'agent-home', false, this.lastGitHubResult.watchId);
      this.githubWatchEnabled = false;
    }
    this.releaseRelayLifecycleState();
    this.client.clearHandlers();
    ngfPushManagerFacade.setStatusListener(null);
    ngfPushManagerFacade.clearMessageListener();
    uiContextManager.clearUIContext();
  }

  build() {
    HdsNavigation(this.pathStack) {
      this.buildRootNavigationContent()
    }
    .titleBar(this.shouldUseWorkspaceTitleBarContrast()
      ? NGFHdsTitleBarOptionsFactory.buildTransparentWhiteSurfaceWithMenu(
        $r('app.string.agent_home_app_title'),
        this.agentHomeTitleSubtitle(),
        this.normalizedHdsMaterialLevel(),
        this.agentHomeTitleBarMenuActions(),
        3,
        true,
        false
      )
      : NGFHdsTitleBarOptionsFactory.buildTransparentSurfaceWithMenu(
        $r('app.string.agent_home_app_title'),
        this.agentHomeTitleSubtitle(),
        this.normalizedHdsMaterialLevel(),
        this.agentHomeTitleBarMenuActions(),
        3,
        true,
        false
      ))
    .titleMode(HdsNavigationTitleMode.MINI)
    .mode(this.agentHomeNavigationMode())
    .navBarWidth(this.workbenchScopePaneWidthVp)
    .navBarWidthRange({ minWidth: 296, maxWidth: 380 })
    .minContentWidth(560)
    .navDestination(this.buildAgentHomeNavDestination)
    .onNavigationModeChange((mode: NavigationMode): void => {
      this.handleNavigationModeChange(mode);
    })
    .onAreaChange((_oldValue: Area, newValue: Area): void => {
      this.updateWorkbenchLayoutFromArea(newValue);
    })
    .focusable(true)
    .onKeyEvent((event: KeyEvent): boolean => {
      return this.handleAgentHomeKeyEvent(event);
    })
    .hideBackButton(true)
    .bindToScrollable([this.conversationScroller])
    .width('100%')
    .height('100%')
    .backgroundColor($r('app.color.background_primary'))
    .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.TOP])
    .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP])
  }

  @Builder
  private buildRootNavigationContent(): void {
    if (this.isLargeScreenNavigation) {
      this.buildLargeScreenNavigationPane()
    } else {
      this.buildAgentHomeMainSurface()
    }
  }

  @Builder
  private buildAgentHomeNavDestination(name: string, pageInfos: Object): void {
    if (name === AGENT_HOME_MAIN_DESTINATION_NAME) {
      NavDestination() {
        this.buildAgentHomeMainSurface()
      }
      .hideTitleBar(true)
      .onBackPressed((): boolean => {
        return this.isLargeScreenNavigation;
      })
    }
  }

  @Builder
  private buildAgentHomeMainSurface(): void {
    Stack() {
      if (this.workbenchMode === AgentHomeWorkbenchMode.EXPANDED) {
        this.buildExpandedWorkbench()
      } else {
        Column() {
          this.buildMainPager()
        }
        .width('100%')
        .height('100%')
        .id(AGENT_HOME_MIDDLE_PANE_FOCUS_KEY)
        .focusable(true)
      }
      this.buildAgentHomeSheetHosts()
      if (this.commandPaletteVisible) {
        this.buildCommandPalette()
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor($r('app.color.background_primary'))
    .ignoreLayoutSafeArea([LayoutSafeAreaType.SYSTEM], [LayoutSafeAreaEdge.TOP])
    .expandSafeArea([SafeAreaType.SYSTEM], [SafeAreaEdge.TOP])
  }

  @Builder
  private buildExpandedWorkbench(): void {
    Row() {
      Column() {
        this.buildMainPager()
      }
      .layoutWeight(1)
      .height('100%')
      .constraintSize({ minWidth: AgentHomeWorkbenchCoordinator.EXPANDED_CONVERSATION_MIN_WIDTH_VP })
      .id(AGENT_HOME_MIDDLE_PANE_FOCUS_KEY)
      .focusable(true)

      this.buildExpandedRightPane()
    }
    .width('100%')
    .height('100%')
  }

  @Builder
  private buildExpandedRightPane(): void {
    Column({ space: 8 }) {
      Row({ space: 6 }) {
        this.buildExpandedRightPaneTab(
          AgentHomeVisibleRightPane.DETAILS,
          $r('sys.symbol.info_circle'),
          $r('app.string.agent_home_status_detail_title')
        )
        this.buildExpandedRightPaneTab(
          AgentHomeVisibleRightPane.TERMINAL,
          $r('sys.symbol.AI_keyboard'),
          $r('app.string.agent_home_runtime_terminal_title')
        )
        this.buildExpandedRightPaneTab(
          AgentHomeVisibleRightPane.DOCTOR,
          $r('sys.symbol.stethoscope'),
          $r('app.string.agent_home_daemon_diagnostics_title')
        )
      }
      .width('100%')
      .height(42)

      if (this.workbenchRightPaneTab === AgentHomeVisibleRightPane.TERMINAL) {
        this.buildRuntimeSheet()
      } else if (this.workbenchRightPaneTab === AgentHomeVisibleRightPane.DOCTOR) {
        Scroll() {
          Column({ space: 10 }) {
            this.buildDaemonDiagnosticsPanel()
          }
          .width('100%')
          .padding({ left: 10, right: 10, bottom: this.bottomInsetVp + 12 })
        }
        .width('100%')
        .layoutWeight(1)
        .scrollBar(BarState.Off)
        .edgeEffect(EdgeEffect.Spring)
      } else {
        this.buildSessionDetailsSheet()
      }
    }
    .width(this.workbenchDetailPaneWidthVp)
    .height('100%')
    .padding({ left: 8, right: 8, top: 8 })
    .backgroundColor($r('app.color.background_primary'))
    .border({ width: { left: 1 }, color: $r('app.color.card_border') })
    .id(AGENT_HOME_RIGHT_PANE_FOCUS_KEY)
    .focusable(true)
  }

  @Builder
  private buildExpandedRightPaneTab(tab: string, symbol: Resource, title: ResourceStr): void {
    Button() {
      Row({ space: 5 }) {
        SymbolGlyph(symbol)
          .fontSize(15)
          .fontColor([this.workbenchRightPaneTab === tab ? $r('app.color.tag_blue') : this.agentHomeReadableSecondaryColor()])
        Text(title)
          .fontSize(11)
          .fontColor(this.workbenchRightPaneTab === tab ? $r('app.color.tag_blue') : this.agentHomeReadableSecondaryColor())
          .maxLines(1)
      }
    }
    .layoutWeight(1)
    .height(36)
    .borderRadius(8)
    .buttonStyle(ButtonStyleMode.NORMAL)
    .backgroundColor(this.workbenchRightPaneTab === tab ? $r('app.color.background_surface') : Color.Transparent)
    .onClick((): void => {
      this.workbenchRightPaneTab = tab;
      if (tab === AgentHomeVisibleRightPane.TERMINAL) {
        this.refreshBridgeTerminalsIfAvailable();
      } else if (tab === AgentHomeVisibleRightPane.DOCTOR) {
        this.refreshDaemonStatus();
        if (this.supportsDiagnosticsExport()) {
          this.client.exportDiagnostics('json');
        }
      }
    })
  }

