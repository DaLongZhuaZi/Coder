          item.role === AgentHomeMessageRole.ASSISTANT
      ) {
        updatedItem = new AgentHomeChatItem(
          item.id,
          item.sessionId,
          item.role,
          item.title,
          item.text + text,
          item.durationText,
          item.createdAt,
          item.reasoningText,
