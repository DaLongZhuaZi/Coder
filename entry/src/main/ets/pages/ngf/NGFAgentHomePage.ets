  @Builder
  private buildHostWorkspaceGroup(group: AgentHomeHostWorkspaceGroup): void {
    Column({ space: 6 }) {
      Button() {
        Row({ space: 6 }) {
          Text(group.hostDisplayName)
            .fontSize(13)
            .fontWeight(FontWeight.Medium)
            .fontColor($r('app.color.text_body'))
            .layoutWeight(1)
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
          Text(group.connected ? this.resolveConnectionStatusPlainText() :
            resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_host_offline')))
            .fontSize(10)
            .fontColor(group.connected ? $r('app.color.tag_green') : $r('app.color.text_secondary'))
        }
        .width('100%')
      }
      .width('100%')
      .height(38)
      .padding({ left: 8, right: 8 })
      .borderRadius(8)
      .backgroundColor($r('app.color.background_secondary'))
      .onClick((): void => {
        this.requestHostSwitch(group.hostProfileId)
      })
      ForEach(group.workspaces, (item: AgentBridgeWorkspaceRecord) => {
        Button() {
          Column({ space: 2 }) {
            Text(item.title.length > 0 ? item.title : item.displayName)
              .width('100%')
              .fontSize(12)
              .fontColor($r('app.color.text_body'))
              .maxLines(1)
              .textOverflow({ overflow: TextOverflow.Ellipsis })
            Text(item.cwd)
              .width('100%')
              .fontSize(10)
              .fontColor($r('app.color.text_secondary'))
              .maxLines(1)
              .textOverflow({ overflow: TextOverflow.Ellipsis })
          }
          .alignItems(HorizontalAlign.Start)
        }
        .width('100%')
        .height(48)
        .padding({ left: 12, right: 8 })
        .backgroundColor(Color.Transparent)
        .onClick((): void => {
          this.requestHostSwitch(group.hostProfileId, item.workspaceId)
        })
      }, (item: AgentBridgeWorkspaceRecord): string => group.hostProfileId + ':' + item.workspaceId)
    }
    .width('100%')
    .padding(8)
    .backgroundColor($r('app.color.background_surface'))
    .borderRadius(8)
  }

