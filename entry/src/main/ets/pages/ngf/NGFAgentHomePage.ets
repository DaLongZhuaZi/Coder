      if (item.status === 'running') {
        Button($r('app.string.agent_home_runtime_file_transfer_cancel'))
          .height(30)
          .fontSize(11)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.tag_red'))
          .onClick((): void => {
            this.cancelRuntimeFileTransfer(item.requestId);
          })
      } else if (item.status === 'failed' && item.direction === 'upload') {
        Button($r('app.string.agent_home_runtime_file_transfer_retry'))
          .height(30)
          .fontSize(11)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .onClick((): void => {
            this.retryRuntimeFileTransfer(item).catch((error: Error): void => {
              logger.error(TAG, 'retry file upload failed: ' + this.errorToString(error));
              this.showTransientStatus(this.errorToString(error));
            });
          })
      }
    }
    .width('100%')
    .padding({ left: 12, right: 12, top: 10, bottom: 10 })
    .borderRadius(12)
    .backgroundColor($r('app.color.background_surface'))
  }

