  private relayConnectionStateText(): string {
    const hostContext = this.getUIContext().getHostContext();
    if (this.relayStatus.state === AgentBridgeRelayConnectionState.DISABLED) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_relay_state_disabled'));
    }
    if (this.relayStatus.state === AgentBridgeRelayConnectionState.PAIRING) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_relay_state_pairing'));
    }
    if (this.relayStatus.state === AgentBridgeRelayConnectionState.CONNECTING) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_relay_state_connecting'));
    }
    if (this.relayStatus.state === AgentBridgeRelayConnectionState.CONNECTED) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_relay_state_connected'));
    }
    if (this.relayStatus.state === AgentBridgeRelayConnectionState.DEGRADED) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_relay_state_degraded'));
    }
    if (this.relayStatus.state === AgentBridgeRelayConnectionState.REVOKED) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_relay_state_revoked'));
    }
    return resolveResourceString(hostContext, $r('app.string.agent_home_relay_state_disconnected'));
  }

  private relayTransportText(): string {
    if (this.relayStatus.transport.length > 0) {
      return this.normalizeTransientStatusText(this.relayStatus.transport);
    }
    if (this.relayStatus.relayUrl.length > 0) {
      return 'WSS';
    }
    return '';
  }

  private relayDeviceFallbackName(): string {
    return resolveResourceString(
      this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_device_unknown')
    );
  }

  private relayDeviceSummary(item: AgentBridgeRelayDeviceRecord): string {
    const parts: Array<string> = [];
    if (item.platform.length > 0) {
      parts.push(item.platform);
    }
    if (item.publicKeyFingerprint.length > 0) {
      const fingerprint = item.publicKeyFingerprint.length > 16 ?
        item.publicKeyFingerprint.substring(0, 16) : item.publicKeyFingerprint;
      parts.push(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_device_fingerprint')
      ) + ': ' + fingerprint);
    }
    if (item.lastSeenAt.length > 0) {
      parts.push(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_device_last_seen')
      ) + ': ' + item.lastSeenAt);
    }
    if (item.revoked) {
      parts.push(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_device_revoked')
      ));
    }
    return parts.join(' · ');
  }

  private relayFailureDisplayText(): string {
    const parts: Array<string> = [];
    if (this.relayFailureCategory.length > 0) {
      parts.push(this.relayFailureCategory);
    }
    if (this.relayRemediation.length > 0) {
      parts.push(this.relayRemediation);
    }
    return this.normalizeTransientStatusText(parts.join(': '));
  }

  private refreshRelayState(): void {
    if (!this.canUseBridgeRelay() || this.relayRefreshBusy || this.relayOperationBusy) {
      return;
    }
    this.relayRefreshBusy = true;
    this.relayFailureCategory = '';
    this.relayRemediation = '';
    this.pendingRelayStatusRequestId = this.client.requestRelayStatus();
    if (this.canUseBridgeRelayDeviceManagement()) {
      this.pendingRelayDeviceListRequestId = this.client.listRelayDevices(true);
    }
  }

  private startRelayPairingOffer(): void {
    if (!this.canUseBridgeRelay() || this.relayOperationBusy || !this.isRelayUrlDraftValid()) {
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_url_invalid')
      ));
      return;
    }
    this.beginRelayOperation(AgentBridgeRequestType.RELAY_PAIRING_START);
    this.pendingRelayOperationRequestId = this.client.startRelayPairing(
      this.relayUrlDraft.trim(), this.relayStatus.relayId, 300000, true
    );
  }

  private cancelRelayPairingOffer(): void {
    if (!this.canUseBridgeRelay() || this.relayOperationBusy || this.pendingRelayOfferId.length === 0) {
      return;
    }
    this.beginRelayOperation(AgentBridgeRequestType.RELAY_PAIRING_CANCEL);
    this.pendingRelayOperationRequestId = this.client.cancelRelayPairing(this.pendingRelayOfferId, true);
  }

  private connectBridgeRelay(): void {
    if (!this.canUseBridgeRelay() || this.relayOperationBusy || !this.isRelayUrlDraftValid()) {
      return;
    }
    this.beginRelayOperation(AgentBridgeRequestType.RELAY_CONNECT);
    this.pendingRelayOperationRequestId = this.client.connectBridgeRelay(
      this.relayUrlDraft.trim(), this.relayStatus.relayId, true
    );
  }

  private disconnectBridgeRelay(): void {
    if (!this.canUseBridgeRelay() || this.relayOperationBusy || !this.relayStatus.connected) {
      return;
    }
    this.beginRelayOperation(AgentBridgeRequestType.RELAY_DISCONNECT);
    this.pendingRelayOperationRequestId = this.client.disconnectBridgeRelay(true);
  }

  private previewRelayDeviceRevocation(deviceId: string): void {
    if (!this.canUseBridgeRelayDeviceManagement() || this.relayOperationBusy || deviceId.length === 0) {
      return;
    }
    this.pendingRelayDeviceId = deviceId;
    this.beginRelayOperation(AgentBridgeRequestType.RELAY_DEVICE_REVOKE);
    this.pendingRelayOperationRequestId = this.client.revokeRelayDevice(deviceId, '', false);
  }

  private previewRelayIdentityRotation(): void {
    if (!this.canUseBridgeRelayDeviceManagement() || this.relayOperationBusy) {
      return;
    }
    this.beginRelayOperation(AgentBridgeRequestType.RELAY_IDENTITY_ROTATE);
    this.pendingRelayOperationRequestId = this.client.rotateRelayIdentity('', false);
  }

  private beginRelayOperation(action: string): void {
    this.relayOperationBusy = true;
    this.pendingRelayOperationAction = action;
    this.pendingRelayOperationRequestId = '';
    this.pendingRelayPlanId = '';
    this.relayFailureCategory = '';
    this.relayRemediation = '';
  }

  private clearRelayOperation(): void {
    this.relayOperationBusy = false;
    this.pendingRelayOperationRequestId = '';
    this.pendingRelayOperationAction = '';
    this.pendingRelayPlanId = '';
    this.pendingRelayDeviceId = '';
  }

  private clearRelayPairingOffer(): void {
    this.clearRelayPairingExpiryTimer();
    this.relayPairingOfferAvailable = false;
    this.relayPairingUserCode = '';
    this.relayPairingExpiresAt = '';
    this.pendingRelayOfferId = '';
    this.pendingRelayOfferUri = '';
  }

  private scheduleRelayPairingOfferExpiry(expiresAt: string): void {
    this.clearRelayPairingExpiryTimer();
    const expiresAtEpochMs: number = Date.parse(expiresAt);
    if (!Number.isFinite(expiresAtEpochMs) || expiresAtEpochMs <= Date.now()) {
      this.clearRelayPairingOffer();
      return;
    }
    const delayMs: number = expiresAtEpochMs - Date.now() + 100;
    this.relayPairingExpiryTimer = setTimeout((): void => {
      this.relayPairingExpiryTimer = -1;
      this.clearRelayPairingOffer();
    }, delayMs);
  }

  private clearRelayPairingExpiryTimer(): void {
    if (this.relayPairingExpiryTimer >= 0) {
      clearTimeout(this.relayPairingExpiryTimer);
      this.relayPairingExpiryTimer = -1;
    }
  }

  private copyRelayPairingOffer(): void {
    const offerUri = this.pendingRelayOfferUri;
    if (offerUri.length === 0) {
      return;
    }
    pasteboard.getSystemPasteboard().setData(
      pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN, offerUri)
    ).then((): void => {
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_pairing_copied')
      ));
    }).catch((error: Error): void => {
      logger.error(TAG, 'copy relay pairing offer failed: ' + this.errorToString(error));
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_operation_failed')
      ));
    });
  }

  private findRelayDevice(deviceId: string): AgentBridgeRelayDeviceRecord | null {
    for (let index = 0; index < this.relayDevices.length; index++) {
      if (this.relayDevices[index].deviceId === deviceId) {
        return this.relayDevices[index];
      }
    }
    return null;
  }

  private findHostProfileByEndpoint(endpoint: string): AgentHomeHostProfile | null {
    const expected: string = endpoint.trim();
    for (let index: number = 0; index < this.hostProfiles.length; index++) {
      if (this.hostProfiles[index].endpoint.trim() === expected) {
        return this.hostProfiles[index];
      }
    }
    return null;
  }

  private showRelayPreviewConfirmation(result: AgentBridgeRelayResult): void {
    if (result.planId.length === 0 || !result.preview) {
      this.clearRelayOperation();
      return;
    }
    this.pendingRelayPlanId = result.planId;
    this.relayOperationBusy = false;
    const hostContext = this.getUIContext().getHostContext();
    if (result.action === AgentBridgeRequestType.RELAY_DEVICE_REVOKE) {
      const device = this.findRelayDevice(this.pendingRelayDeviceId);
      const deviceName = device !== null && device.displayName.length > 0 ?
        device.displayName : this.relayDeviceFallbackName();
      this.getUIContext().showAlertDialog({
        title: resolveResourceString(hostContext, $r('app.string.agent_home_relay_revoke_title')),
        message: resolveResourceString(hostContext, $r('app.string.agent_home_relay_revoke_message')) + ': ' + deviceName,
        primaryButton: {
          value: resolveResourceString(hostContext, $r('app.string.agent_home_relay_revoke_action')),
          action: (): void => {
            if (this.pendingRelayPlanId.length === 0 || this.pendingRelayDeviceId.length === 0) {
              return;
            }
            this.relayOperationBusy = true;
            this.pendingRelayOperationAction = AgentBridgeRequestType.RELAY_DEVICE_REVOKE;
            this.pendingRelayOperationRequestId = this.client.revokeRelayDevice(
              this.pendingRelayDeviceId, this.pendingRelayPlanId, true
            );
          }
        },
        secondaryButton: {
          value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
          action: (): void => {
            this.clearRelayOperation();
          }
        }
      });
      return;
    }
    if (result.action === AgentBridgeRequestType.RELAY_IDENTITY_ROTATE) {
      this.getUIContext().showAlertDialog({
        title: resolveResourceString(hostContext, $r('app.string.agent_home_relay_rotate_title')),
        message: resolveResourceString(hostContext, $r('app.string.agent_home_relay_rotate_message')),
        primaryButton: {
          value: resolveResourceString(hostContext, $r('app.string.agent_home_relay_rotate_action')),
          action: (): void => {
            if (this.pendingRelayPlanId.length === 0) {
              return;
            }
            this.relayOperationBusy = true;
            this.pendingRelayOperationAction = AgentBridgeRequestType.RELAY_IDENTITY_ROTATE;
            this.pendingRelayOperationRequestId = this.client.rotateRelayIdentity(this.pendingRelayPlanId, true);
          }
        },
        secondaryButton: {
          value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
          action: (): void => {
            this.clearRelayOperation();
          }
        }
      });
    }
  }

  private applyRelayResult(source: string, parsed: AgentBridgeParsedMessage): void {
    const result = AgentBridgeIncomingParser.parseRelayResult(source);
    const relayStatusApplied: boolean = result.status.action.length > 0 || result.status.configured ||
      result.status.available ||
      result.action === AgentBridgeRequestType.RELAY_STATUS || result.action === AgentBridgeRequestType.RELAY_CONNECT ||
      result.action === AgentBridgeRequestType.RELAY_DISCONNECT;
    if (relayStatusApplied) {
      this.relayStatus = result.status;
      if (result.status.relayUrl.length > 0 &&
        (this.relayUrlDraft.length === 0 || result.action === AgentBridgeRequestType.RELAY_STATUS)) {
        this.relayUrlDraft = result.status.relayUrl;
      }
    }
    if (result.action === AgentBridgeRequestType.RELAY_DEVICE_LIST || result.devices.length > 0) {
      this.relayDevices = result.devices;
    }
    if (result.device.deviceId.length > 0) {
      this.upsertRelayDeviceState(result.device);
    }
    if (result.pairingOffer.offerId.length > 0 && result.pairingOffer.pairingUri.length > 0) {
      const verifiedOffer: AgentBridgeRelayPairingOffer = AgentBridgeClient.parseRelayPairingUri(
        result.pairingOffer.pairingUri
      );
      if (verifiedOffer.offerId === result.pairingOffer.offerId) {
        this.pendingRelayOfferId = verifiedOffer.offerId;
        this.pendingRelayOfferUri = verifiedOffer.pairingUri;
        this.relayPairingOfferAvailable = true;
        this.relayPairingUserCode = result.pairingOffer.userCode;
        this.relayPairingExpiresAt = verifiedOffer.expiresAt;
        this.scheduleRelayPairingOfferExpiry(verifiedOffer.expiresAt);
      }
    }
    if (result.action === AgentBridgeRequestType.RELAY_PAIRING_CANCEL && result.ok) {
      this.clearRelayPairingOffer();
    }
    const pairingCompletedByDeviceEvent: boolean = this.pendingRelayOfferId.length > 0 &&
      parsed.eventType === AgentBridgeEventType.RELAY_DEVICE_UPDATED &&
      result.device.deviceId.length > 0 && !result.device.revoked;
    if (pairingCompletedByDeviceEvent) {
      this.completeRelayPairing(result.device);
    } else if (this.pendingRelayOfferId.length > 0 && relayStatusApplied && !result.status.pairingActive) {
      this.clearRelayPairingOffer();
    }
    if (result.failure.failureCategory.length > 0) {
      this.relayFailureCategory = result.failure.failureCategory;
      this.relayRemediation = result.failure.remediation;
    } else if (result.ok) {
      this.relayFailureCategory = '';
      this.relayRemediation = '';
    }
    if (parsed.requestId === this.pendingRelayStatusRequestId ||
      result.action === AgentBridgeRequestType.RELAY_STATUS) {
      this.pendingRelayStatusRequestId = '';
    }
    if (parsed.requestId === this.pendingRelayDeviceListRequestId ||
      result.action === AgentBridgeRequestType.RELAY_DEVICE_LIST) {
      this.pendingRelayDeviceListRequestId = '';
    }
    this.relayRefreshBusy = this.pendingRelayStatusRequestId.length > 0 ||
      this.pendingRelayDeviceListRequestId.length > 0;
    if (result.preview && (result.action === AgentBridgeRequestType.RELAY_DEVICE_REVOKE ||
      result.action === AgentBridgeRequestType.RELAY_IDENTITY_ROTATE)) {
      this.showRelayPreviewConfirmation(result);
      return;
    }
    if (parsed.requestId === this.pendingRelayOperationRequestId ||
      result.action === this.pendingRelayOperationAction) {
      if (result.confirmed || result.ok || result.failure.failureCategory.length > 0) {
        this.clearRelayOperation();
      }
    }
    if (result.pairingResult.paired && result.pairingResult.ok) {
      this.completeRelayPairing(result.pairingResult.device);
    }
    if (result.confirmed && (result.action === AgentBridgeRequestType.RELAY_DEVICE_REVOKE ||
      result.action === AgentBridgeRequestType.RELAY_IDENTITY_ROTATE)) {
      this.refreshRelayState();
    }
  }

  private completeRelayPairing(device: AgentBridgeRelayDeviceRecord): void {
    this.upsertRelayDeviceState(device);
    this.clearRelayPairingOffer();
    this.showTransientStatus(resolveResourceString(
      this.getUIContext().getHostContext(),
      $r('app.string.agent_home_relay_pairing_completed')
    ));
    if (this.canUseBridgeRelay()) {
      this.refreshRelayState();
    }
  }

  private upsertRelayDeviceState(device: AgentBridgeRelayDeviceRecord): void {
    if (device.deviceId.length === 0) {
      return;
    }
    const nextItems: Array<AgentBridgeRelayDeviceRecord> = [];
    let replaced: boolean = false;
    for (let index: number = 0; index < this.relayDevices.length; index++) {
      if (this.relayDevices[index].deviceId === device.deviceId) {
        nextItems.push(device);
        replaced = true;
      } else {
        nextItems.push(this.relayDevices[index]);
      }
    }
    if (!replaced) {
      nextItems.push(device);
    }
    this.relayDevices = nextItems;
  }

  private async completePendingRelayHostProfile(): Promise<void> {
    const hostProfileId: string = this.pendingRelayHostProfileId;
    const publicEndpoint: string = this.pendingRelayPublicEndpoint;
    if (hostProfileId.length === 0 || publicEndpoint.length === 0 ||
      hostProfileId !== this.activeHostProfileId || this.bridgeEndpoint !== publicEndpoint) {
      return;
    }
    const profile: AgentHomeHostProfile | null = this.findHostProfile(hostProfileId);
    if (profile === null || !AgentHomeRelayUiPolicy.isRelayPublicEndpoint(profile.endpoint)) {
      return;
    }
    profile.autoConnectOnLaunch = true;
    profile.updatedAt = Date.now();
    profile.lastUsedAt = Date.now();
    await this.persistence.saveHostProfile(profile);
    this.upsertHostProfileState(profile);
    this.clearPendingRelayPairingConnection();
    this.showTransientStatus(resolveResourceString(
      this.getUIContext().getHostContext(),
      $r('app.string.agent_home_relay_pairing_connected')
    ));
  }

  private clearPendingRelayPairingConnection(): void {
    this.clearRelayHostPairingExpiryTimer();
    this.pendingRelayPublicEndpoint = '';
    this.pendingRelayHostProfileId = '';
    this.pendingOpenSessionsSheetAfterBridgeQrConnect = false;
  }

  private scheduleRelayHostPairingExpiry(expiresAt: string): boolean {
    this.clearRelayHostPairingExpiryTimer();
    const expiresAtEpochMs: number = Date.parse(expiresAt);
    if (!Number.isFinite(expiresAtEpochMs) || expiresAtEpochMs <= Date.now()) {
      return false;
    }
    const delayMs: number = expiresAtEpochMs - Date.now() + 100;
    this.relayHostPairingExpiryTimer = setTimeout((): void => {
      this.relayHostPairingExpiryTimer = -1;
      if (this.pendingRelayHostProfileId.length > 0) {
        this.client.disconnect();
        this.clearPendingRelayPairingConnection();
        this.showTransientStatus(resolveResourceString(
          this.getUIContext().getHostContext(),
          $r('app.string.agent_home_relay_pairing_qr_invalid')
        ));
      }
    }, delayMs);
    return true;
  }

  private clearRelayHostPairingExpiryTimer(): void {
    if (this.relayHostPairingExpiryTimer >= 0) {
      clearTimeout(this.relayHostPairingExpiryTimer);
      this.relayHostPairingExpiryTimer = -1;
    }
  }

  private releaseRelayLifecycleState(): void {
    if (this.pendingRelayOfferId.length > 0 &&
      this.connectionStatus === AgentBridgeConnectionStatus.CONNECTED) {
      this.client.cancelRelayPairing(this.pendingRelayOfferId, true);
    }
    if (this.pendingRelayHostProfileId.length > 0) {
      this.client.disconnect();
    }
    this.clearPendingRelayPairingConnection();
    this.clearRelayPairingOffer();
    this.clearRelayOperation();
    this.pendingRelayStatusRequestId = '';
    this.pendingRelayDeviceListRequestId = '';
    this.relayRefreshBusy = false;
  }

  private resetRelayRuntimeState(): void {
    this.relayStatus = new AgentBridgeRelayStatus();
    this.relayDevices = [];
    this.relayUrlDraft = '';
    this.relayRefreshBusy = false;
    this.relayFailureCategory = '';
    this.relayRemediation = '';
    this.pendingRelayStatusRequestId = '';
    this.pendingRelayDeviceListRequestId = '';
    this.clearRelayOperation();
    this.clearRelayPairingOffer();
    this.clearPendingRelayPairingConnection();
  }

  private canUseBridgeDaemonManagement(): boolean {
    if (!this.hasTrustedBridgeV2Server()) {
      return false;
    }
    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.daemonManagement;
  }

  private canUseBridgeDaemonSupervisor(): boolean {
    if (!this.hasTrustedBridgeV2Server()) {
      return false;
    }
    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.daemonSupervisor;
  }

  /**
   * Fleet panel availability is an App-local decision: every saved host
   * profile is queried and operated through its own independent connection,
   * so the currently active Bridge's own capability advertisement must not
   * hide other saved hosts. Per-target write eligibility is still enforced
   * by each snapshot's fleetTargetSupported/rollingEligible gates.
   */
  private canUseBridgeDaemonFleet(): boolean {
    return AgentHomeDaemonFleetAvailabilityPolicy.isFleetPanelAvailable(this.hostProfiles);
  }

  private canUseBridgeDaemonAutostartInstaller(): boolean {
    if (!this.hasTrustedBridgeV2Server()) {
      return false;
