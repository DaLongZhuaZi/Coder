  private previewAddChatRoomAgent(): void {
    const agentId = this.chatRoomAgentIdDraft.trim();
    if (!this.canUseBridgeChatRooms() || this.m7Busy || this.selectedChatRoomId.length === 0 || agentId.length === 0) {
