    ));
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.OPEN_TERMINAL, 'terminal', resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_title')),
      ['terminal', 'runtime'], 'terminal', AgentHomeActionKey.OPEN_RUNTIME, 'Ctrl/Meta+Shift+T', this.activeSessionId.length > 0
    ));
    items.push(new AgentHomeCommandDefinition(
      'settings', 'settings', resolveResourceString(hostContext, $r('app.string.agent_home_global_settings_title')),
      ['settings', 'display'], 'settings', AgentHomeActionKey.OPEN_GLOBAL_SETTINGS
    ));
    items.push(new AgentHomeCommandDefinition(
      'doctor', 'doctor', resolveResourceString(hostContext, $r('app.string.agent_home_daemon_diagnostics_title')),
      ['doctor', 'diagnostics'], 'doctor', 'diagnostics', '', this.supportsDiagnosticsExport()
    ));
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.REFRESH_VISIBLE_SCOPE, 'refresh', resolveResourceString(hostContext, $r('app.string.agent_home_refresh_current_scope')),
      ['refresh', 'reload'], 'refresh', 'refresh', 'Ctrl/Meta+R', this.connectionStatus === AgentBridgeConnectionStatus.CONNECTED
    ));
