          .height(30)
          .fontSize(10)
          .borderRadius(8)
          .fontColor($r('app.color.tag_red'))
          .backgroundColor($r('app.color.background_surface'))
          .enabled(item.status === 'running' && !this.workspaceServicePending)
          .onClick((): void => { this.previewWorkspaceServiceStop(item.serviceId); })
      }
      .width('100%')
      Divider().color($r('app.color.card_border'))
    }
    .width('100%')
