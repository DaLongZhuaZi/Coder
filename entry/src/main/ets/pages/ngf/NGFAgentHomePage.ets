  private handleComposerTextChanged(value: string): void {
    this.draftText = value;
    const markerIndex = value.lastIndexOf('@');
    if (markerIndex < 0 || (markerIndex > 0 && value.charAt(markerIndex - 1) !== ' ' && value.charAt(markerIndex - 1) !== '\n')) {
      this.composerMentionQuery = '';
      return;
    }
    const suffix = value.substring(markerIndex + 1);
    if (suffix.indexOf(' ') >= 0 || suffix.indexOf('\n') >= 0) {
      this.composerMentionQuery = '';
      return;
    }
    this.composerMentionQuery = suffix.toLowerCase();
    this.composerMentionSelectedIndex = 0;
  }

  private shouldShowComposerMentionMenu(): boolean {
    return this.draftText.lastIndexOf('@') >= 0 && this.composerMentionSuggestions().length > 0;
  }

  private composerMentionSuggestions(): Array<AgentHomeComposerToken> {
    const items: Array<AgentHomeComposerToken> = [];
    const query = this.composerMentionQuery;
    for (let index = 0; index < this.workspaces.length && items.length < 8; index++) {
      const workspace = this.workspaces[index];
      if (query.length === 0 || workspace.title.toLowerCase().indexOf(query) >= 0) {
        items.push(new AgentHomeComposerToken('workspace_' + workspace.id, 'workspace', workspace.title,
          workspace.id, this.activeHostProfileId, workspace.id));
      }
    }
    for (let index = 0; index < this.workspaceFiles.length && items.length < 8; index++) {
      const file = this.workspaceFiles[index];
      if (file.workspaceId === this.activeWorkspaceId && (query.length === 0 || file.path.toLowerCase().indexOf(query) >= 0)) {
        items.push(new AgentHomeComposerToken('file_' + file.id, 'file', file.path,
          file.path, this.activeHostProfileId, this.activeWorkspaceId));
      }
    }
    for (let index = 0; index < this.bridgeAgentRecords.length && items.length < 8; index++) {
      const agent = this.bridgeAgentRecords[index];
      const title = agent.title.length > 0 ? agent.title : agent.id;
      if ((agent.workspaceId.length === 0 || agent.workspaceId === this.activeWorkspaceId) &&
        (query.length === 0 || title.toLowerCase().indexOf(query) >= 0)) {
        items.push(new AgentHomeComposerToken('agent_' + agent.id, 'agent', title,
          agent.id, this.activeHostProfileId, this.activeWorkspaceId));
      }
    }
    return items;
  }

  private selectComposerMention(item: AgentHomeComposerToken): void {
    const markerIndex = this.draftText.lastIndexOf('@');
    if (markerIndex < 0) {
      return;
    }
    this.draftText = this.draftText.substring(0, markerIndex) + '@' + item.label + ' ';
    const next: Array<AgentHomeComposerToken> = [];
    for (let index = 0; index < this.composerTokens.length; index++) {
      if (this.composerTokens[index].id !== item.id) {
        next.push(this.composerTokens[index]);
      }
    }
    next.push(item);
    this.composerTokens = next;
    this.composerMentionQuery = '';
  }

