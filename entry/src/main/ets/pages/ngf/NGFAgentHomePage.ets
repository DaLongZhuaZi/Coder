  private previewUpdateChatRoomMember(member: AgentBridgeChatRoomMember, role: string): void {
    if (!this.canUseBridgeChatRooms() || this.m7Busy || this.selectedChatRoomId.length === 0) {
      return;
    }
    const nextMember = new AgentBridgeChatRoomMember();
    nextMember.memberId = member.memberId;
    nextMember.type = member.type;
