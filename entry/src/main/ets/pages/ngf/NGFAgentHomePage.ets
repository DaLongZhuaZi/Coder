      return this.isAttachmentSheetOpen;
    }
    if (sheetKey === AgentHomeSheetKey.PREVIEW) {
      return this.isPreviewSheetOpen;
    }
    if (sheetKey === AgentHomeSheetKey.SESSION_DETAILS) {
