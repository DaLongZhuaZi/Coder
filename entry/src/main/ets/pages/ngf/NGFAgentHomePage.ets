  private requestDiagnosticsFileExport(format: string): void {
    const normalized = format === 'text' ? 'text' : 'json';
    this.pendingDiagnosticsExportFormat = normalized;
    this.pendingDiagnosticsExportRequestId = this.client.exportDiagnostics(normalized);
  }

  private diagnosticsReportContent(format: string): string {
    if (format === 'text' && this.diagnosticsReport.text.length > 0) {
      return this.diagnosticsReport.text;
    }
    return JSON.stringify(this.diagnosticsReport);
  }

  private async saveDiagnosticsReportToFile(format: string): Promise<void> {
    const normalized = format === 'text' ? 'text' : 'json';
    const content = this.diagnosticsReportContent(normalized);
    if (content.length === 0) {
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_diagnostics_export_failed')
      ));
      return;
    }
    const options = new picker.DocumentSaveOptions();
    const extension = normalized === 'text' ? '.txt' : '.json';
    options.newFileNames = ['agent-bridge-diagnostics-' + String(Date.now()) + extension];
    options.fileSuffixChoices = normalized === 'text' ? ['Text|.txt'] : ['JSON|.json'];
    try {
      const documentPicker = new picker.DocumentViewPicker();
      const uris: Array<string> = await documentPicker.save(options);
      if (uris.length === 0 || !FileUtils.writeText(uris[0], content)) {
        this.showTransientStatus(resolveResourceString(
          this.getUIContext().getHostContext(), $r('app.string.agent_home_diagnostics_export_failed')
        ));
        return;
      }
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_diagnostics_export_saved')
      ));
    } catch (error) {
      logger.warn(TAG, 'diagnostics document export cancelled or failed: ' + this.errorToString(error));
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_diagnostics_export_failed')
      ));
    }
  }

