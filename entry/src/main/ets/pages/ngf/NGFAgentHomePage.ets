    this.pushSlashCommandDefinitions(items);
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.CLOSE_TOP_OVERLAY, 'navigation', resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
      ['close', 'cancel'], 'close', 'close_overlay', 'Esc', true
    ));
    this.commandRegistry.replace(items);
  }

  private pushPaneCommandDefinitions(items: Array<AgentHomeCommandDefinition>): void {
    const hostContext = this.getUIContext().getHostContext();
    const largePaneAvailable = this.workbenchMode === AgentHomeWorkbenchMode.MEDIUM ||
      this.workbenchMode === AgentHomeWorkbenchMode.EXPANDED;
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.FOCUS_LEFT_PANE, 'layout', resolveResourceString(hostContext, $r('app.string.agent_home_workspaces_title')),
      ['left', 'pane'], 'left', 'focus_left', 'Alt+1', largePaneAvailable
    ));
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.FOCUS_MIDDLE_PANE, 'layout', resolveResourceString(hostContext, $r('app.string.agent_home_sessions_title')),
      ['middle', 'conversation'], 'middle', 'focus_middle', 'Alt+2', true
    ));
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.FOCUS_RIGHT_PANE, 'layout', resolveResourceString(hostContext, $r('app.string.agent_home_status_detail_title')),
      ['right', 'details'], 'right', 'focus_right', 'Alt+3', true
    ));
  }

  private pushSlashCommandDefinitions(items: Array<AgentHomeCommandDefinition>): void {
    const slashCommands = this.currentSlashCommands();
    for (let index = 0; index < slashCommands.length; index++) {
      const slash = slashCommands[index];
      const keywords: Array<string> = [];
      keywords.push(slash.description);
      keywords.push(slash.source);
      items.push(new AgentHomeCommandDefinition(
        'slash_' + this.safeIdPart(slash.command), 'slash', slash.command, keywords, 'slash',
        'slash:' + slash.command, '', slash.available, slash.warning, slash.requiresConfirmation
      ));
    }
  }

  private filteredCommandDefinitions(): Array<AgentHomeCommandDefinition> {
    this.syncCommandRegistry();
    return this.commandRegistry.filter(this.commandPaletteQuery);
  }

  private commandSymbol(symbolName: string): Resource {
    if (symbolName === 'plus') { return $r('sys.symbol.plus'); }
    if (symbolName === 'sessions') { return $r('sys.symbol.ellipsis_message'); }
    if (symbolName === 'terminal') { return $r('sys.symbol.AI_keyboard'); }
    if (symbolName === 'settings') { return $r('sys.symbol.gearshape'); }
    if (symbolName === 'doctor') { return $r('sys.symbol.stethoscope'); }
    if (symbolName === 'refresh') { return $r('sys.symbol.arrow_clockwise'); }
    if (symbolName === 'workspace') { return $r('sys.symbol.folder'); }
    if (symbolName === 'files') { return $r('sys.symbol.doc_plaintext'); }
    if (symbolName === 'git') { return $r('sys.symbol.doc_plaintext'); }
    if (symbolName === 'fork') { return $r('sys.symbol.arrow_triangle_divide'); }
    if (symbolName === 'checkpoint') { return $r('sys.symbol.checkmark_clipboard'); }
    if (symbolName === 'send') { return $r('sys.symbol.paperplane_right_fill'); }
    if (symbolName === 'close') { return $r('sys.symbol.xmark'); }
    if (symbolName === 'slash') { return $r('sys.symbol.textformat'); }
    if (symbolName === 'left') { return $r('sys.symbol.chevron_left'); }
    if (symbolName === 'right') { return $r('sys.symbol.chevron_right'); }
    if (symbolName === 'middle') { return $r('sys.symbol.message'); }
    if (symbolName === 'focus') { return $r('sys.symbol.scope'); }
    return $r('sys.symbol.magnifyingglass');
  }

  private executeCommandDefinition(item: AgentHomeCommandDefinition): void {
    if (!item.enabled) {
      return;
    }
    this.closeCommandPalette();
    if (item.action.startsWith('slash:')) {
      this.applySlashCommand(item.action.substring(6));
      this.focusComposer();
      return;
    }
    this.executeRegisteredCommand(item.id, item.action);
  }

  private executeRegisteredCommand(commandId: string, action: string): void {
    if (commandId === AgentHomeCommandId.OPEN_PALETTE || action === 'open_palette') {
      this.openCommandPalette();
    } else if (commandId === AgentHomeCommandId.SEND_MESSAGE || action === AgentHomeActionKey.SEND_MESSAGE) {
      this.handleSendMessage();
    } else if (commandId === AgentHomeCommandId.FOCUS_COMPOSER || action === 'focus_composer') {
      this.focusComposer();
    } else if (commandId === AgentHomeCommandId.OPEN_TERMINAL) {
      if (this.workbenchMode === AgentHomeWorkbenchMode.EXPANDED) {
        this.workbenchRightPaneTab = AgentHomeVisibleRightPane.TERMINAL;
        this.refreshBridgeTerminalsIfAvailable();
      } else {
        this.handleAction(AgentHomeActionKey.OPEN_RUNTIME);
      }
    } else if (commandId === AgentHomeCommandId.FOCUS_LEFT_PANE || action === 'focus_left') {
      this.requestComponentFocus(AGENT_HOME_LEFT_PANE_FOCUS_KEY);
    } else if (commandId === AgentHomeCommandId.FOCUS_MIDDLE_PANE || action === 'focus_middle') {
      this.requestComponentFocus(AGENT_HOME_MIDDLE_PANE_FOCUS_KEY);
    } else if (commandId === AgentHomeCommandId.FOCUS_RIGHT_PANE || action === 'focus_right') {
      if (this.workbenchMode === AgentHomeWorkbenchMode.EXPANDED) {
        this.requestComponentFocus(AGENT_HOME_RIGHT_PANE_FOCUS_KEY);
      } else {
        this.openSheet(AgentHomeSheetKey.SESSION_DETAILS);
      }
    } else if (commandId === AgentHomeCommandId.CLOSE_TOP_OVERLAY || action === 'close_overlay') {
      this.closeTopInteraction();
    } else if (commandId === AgentHomeCommandId.REFRESH_VISIBLE_SCOPE || action === 'refresh') {
      this.refreshCurrentVisibleScope();
    } else if (action === 'diagnostics') {
      this.client.exportDiagnostics('json');
      if (this.workbenchMode === AgentHomeWorkbenchMode.EXPANDED) {
        this.workbenchRightPaneTab = AgentHomeVisibleRightPane.DOCTOR;
      } else {
        this.openSheet(AgentHomeSheetKey.SESSION_DETAILS);
      }
    } else if (action === 'show_workspace_files') {
      this.workspacePanelTabIndex = AgentHomeWorkspacePanelTab.FILES;
      this.showMainPage(AgentHomeMainPageIndex.WORKSPACE_BROWSER);
      this.refreshWorkspaceFiles(this.pendingWorkspaceFilesParentPath);
    } else if (action === 'show_git_changes') {
      this.workspacePanelTabIndex = AgentHomeWorkspacePanelTab.CHANGES;
      this.showMainPage(AgentHomeMainPageIndex.WORKSPACE_BROWSER);
      this.refreshWorkspaceChanges();
    } else {
      this.handleAction(action);
    }
  }

  private openCommandPalette(): void {
    if (!this.supportsCommandPalette()) {
      return;
    }
    this.commandPaletteVisible = true;
    this.commandPaletteQuery = '';
    this.commandPaletteSelectedIndex = 0;
    setTimeout((): void => { this.requestComponentFocus(AGENT_HOME_COMMAND_SEARCH_FOCUS_KEY); }, 0);
  }

  private closeCommandPalette(): void {
    this.commandPaletteVisible = false;
    this.commandPaletteQuery = '';
    this.commandPaletteSelectedIndex = 0;
    this.commandSearchFocused = false;
  }

  private supportsCommandPalette(): boolean {
    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.commandPalette;
  }

  private refreshCurrentVisibleScope(): void {
    const input = new AgentHomeVisibleScopeInput(
      this.workbenchMode,
      this.mainPageIndex,
      this.activeSheetKey,
      this.workspacePanelTabIndex,
      this.workbenchRightPaneTab
    );
    const plan: AgentHomeVisibleRefreshPlan = this.visibleScopeCoordinator.resolve(input);
    const start: AgentHomeVisibleRefreshStart = this.visibleScopeCoordinator.begin(
      plan,
      this.activeHostProfileId,
      this.connectionEpoch
    );
    if (!start.shouldStart) {
      return;
    }
    for (let index = 0; index < plan.operations.length; index++) {
      this.executeVisibleRefreshOperation(plan.operations[index]);
    }
    this.scheduleVisibleRefreshRelease(start.ticket);
  }

  private executeVisibleRefreshOperation(operation: string): void {
    const bridgeSessionId = this.currentBridgeSessionId();
    if (operation === AgentHomeVisibleRefreshOperation.HISTORY) {
      this.refreshActiveSessionHistory();
    } else if (operation === AgentHomeVisibleRefreshOperation.MESSAGE_QUEUE && bridgeSessionId.length > 0) {
      this.client.requestMessageQueue(bridgeSessionId);
    } else if (operation === AgentHomeVisibleRefreshOperation.USAGE_SUMMARY && bridgeSessionId.length > 0) {
      this.client.requestUsageSummary(
        bridgeSessionId, this.currentBridgeAgentId(), this.usageBudgetWindowDraft
      );
      this.refreshCurrentProviderUsage(bridgeSessionId, this.currentBridgeAgentId());
    } else if (operation === AgentHomeVisibleRefreshOperation.USAGE_EVENTS && bridgeSessionId.length > 0) {
      this.client.requestUsageEvents(
        bridgeSessionId, this.currentBridgeAgentId(), this.usageBudgetWindowDraft
      );
    } else if (operation === AgentHomeVisibleRefreshOperation.HOST_WORKSPACES) {
      this.refreshHostWorkspaceGroups().catch((error: Error): void => {
        logger.warn(TAG, 'refresh visible host workspaces failed: ' + this.errorToString(error));
      });
    } else if (operation === AgentHomeVisibleRefreshOperation.WORKSPACE_SESSIONS) {
      this.requestRemoteSessions();
    } else if (operation === AgentHomeVisibleRefreshOperation.WORKSPACE_FILES) {
      this.refreshWorkspaceFiles(this.pendingWorkspaceFilesParentPath);
    } else if (operation === AgentHomeVisibleRefreshOperation.GIT_STATUS ||
      operation === AgentHomeVisibleRefreshOperation.WORKSPACE_DIFF) {
      this.refreshWorkspaceChanges();
    } else if (operation === AgentHomeVisibleRefreshOperation.TERMINAL_LIST ||
      operation === AgentHomeVisibleRefreshOperation.ACTIVE_TERMINAL) {
      this.refreshBridgeTerminalsIfAvailable();
    } else if (operation === AgentHomeVisibleRefreshOperation.DAEMON_STATUS) {
      this.refreshDaemonStatus();
    } else if (operation === AgentHomeVisibleRefreshOperation.DIAGNOSTICS && this.supportsDiagnosticsExport()) {
      this.client.exportDiagnostics('json');
    } else if (operation === AgentHomeVisibleRefreshOperation.SESSION_STATUS) {
      this.requestRemoteSessions();
    } else if (operation === AgentHomeVisibleRefreshOperation.AGENT_STATUS) {
      this.refreshCurrentAgentRuntimeStatus();
    }
  }

  private scheduleVisibleRefreshRelease(ticket: AgentHomeVisibleRefreshTicket): void {
    this.clearVisibleRefreshReleaseTimer();
    this.visibleRefreshReleaseTimer = setTimeout((): void => {
      this.visibleRefreshReleaseTimer = -1;
      this.visibleScopeCoordinator.complete(ticket, this.activeHostProfileId, this.connectionEpoch);
    }, AGENT_HOME_VISIBLE_REFRESH_RELEASE_MS);
  }

  private clearVisibleRefreshReleaseTimer(): void {
    if (this.visibleRefreshReleaseTimer >= 0) {
      clearTimeout(this.visibleRefreshReleaseTimer);
      this.visibleRefreshReleaseTimer = -1;
    }
  }

  private handleCommandSearchKeyEvent(event: KeyEvent): boolean {
    if (event.type !== KeyType.Down) {
      return false;
    }
    const definitions = this.filteredCommandDefinitions();
    if (event.keyCode === KeyCode.KEYCODE_DPAD_UP) {
      this.commandPaletteSelectedIndex = this.commandRegistry.nextSelection(
        this.commandPaletteSelectedIndex,
        -1,
        definitions.length
      );
      return true;
    }
    if (event.keyCode === KeyCode.KEYCODE_DPAD_DOWN) {
      this.commandPaletteSelectedIndex = this.commandRegistry.nextSelection(
        this.commandPaletteSelectedIndex,
        1,
        definitions.length
      );
      return true;
    }
    if (event.keyCode === KeyCode.KEYCODE_ENTER) {
      if (this.commandPaletteSelectedIndex >= 0 && this.commandPaletteSelectedIndex < definitions.length) {
        this.executeCommandDefinition(definitions[this.commandPaletteSelectedIndex]);
      }
      return true;
    }
    if (event.keyCode === KeyCode.KEYCODE_ESCAPE) {
      this.closeCommandPalette();
      return true;
    }
    return false;
  }

  private handleAgentHomeKeyEvent(event: KeyEvent): boolean {
    if (this.updateModifierKeyState(event)) {
      return false;
    }
    if (event.type !== KeyType.Down) {
      return false;
    }
    this.syncCommandRegistry();
    const shortcutInput = new AgentHomeKeyboardShortcutInput(this.shortcutKeyText(event));
    shortcutInput.ctrlKey = this.controlKeyDown;
    shortcutInput.metaKey = this.metaKeyDown || event.metaKey === 1;
    shortcutInput.altKey = this.altKeyDown;
    shortcutInput.shiftKey = this.shiftKeyDown;
    shortcutInput.composerFocused = this.composerFocused;
    shortcutInput.commandSearchFocused = this.commandSearchFocused;
    shortcutInput.dialogOpen = this.activeSheetKey !== AgentHomeSheetKey.NONE;
    shortcutInput.overlayVisible = this.commandPaletteVisible || this.activeSheetKey !== AgentHomeSheetKey.NONE;
    shortcutInput.shortcutsEnabled = this.keyboardShortcutsEnabled;
    shortcutInput.leftPaneAvailable = this.workbenchMode === AgentHomeWorkbenchMode.MEDIUM ||
      this.workbenchMode === AgentHomeWorkbenchMode.EXPANDED;
    shortcutInput.middlePaneAvailable = true;
    shortcutInput.rightPaneAvailable = this.workbenchMode === AgentHomeWorkbenchMode.EXPANDED;
    const decision: AgentHomeCommandShortcutDecision = this.commandRegistry.resolveShortcut(shortcutInput);
    if (!decision.handled) {
      return false;
    }
    if (!decision.blocked) {
      this.executeRegisteredCommand(decision.commandId, '');
    }
    return true;
  }

  private updateModifierKeyState(event: KeyEvent): boolean {
    const pressed = event.type === KeyType.Down;
    if (event.keyCode === KeyCode.KEYCODE_CTRL_LEFT || event.keyCode === KeyCode.KEYCODE_CTRL_RIGHT) {
      this.controlKeyDown = pressed;
      return true;
    }
    if (event.keyCode === KeyCode.KEYCODE_META_LEFT || event.keyCode === KeyCode.KEYCODE_META_RIGHT) {
      this.metaKeyDown = pressed;
      return true;
    }
    if (event.keyCode === KeyCode.KEYCODE_ALT_LEFT || event.keyCode === KeyCode.KEYCODE_ALT_RIGHT) {
      this.altKeyDown = pressed;
      return true;
    }
    if (event.keyCode === KeyCode.KEYCODE_SHIFT_LEFT || event.keyCode === KeyCode.KEYCODE_SHIFT_RIGHT) {
      this.shiftKeyDown = pressed;
      return true;
    }
    return false;
  }

  private shortcutKeyText(event: KeyEvent): string {
    if (event.keyCode === KeyCode.KEYCODE_K) { return 'k'; }
    if (event.keyCode === KeyCode.KEYCODE_L) { return 'l'; }
    if (event.keyCode === KeyCode.KEYCODE_T) { return 't'; }
    if (event.keyCode === KeyCode.KEYCODE_R) { return 'r'; }
    if (event.keyCode === KeyCode.KEYCODE_ENTER) { return 'enter'; }
    if (event.keyCode === KeyCode.KEYCODE_ESCAPE) { return 'escape'; }
    if (event.keyCode === KeyCode.KEYCODE_1) { return '1'; }
    if (event.keyCode === KeyCode.KEYCODE_2) { return '2'; }
    if (event.keyCode === KeyCode.KEYCODE_3) { return '3'; }
    return event.keyText.toLowerCase();
  }

  private requestComponentFocus(componentId: string): void {
    try {
      this.getUIContext().getFocusController().requestFocus(componentId);
    } catch (error) {
      logger.warn(TAG, 'request agent home focus failed: ' + this.errorToString(error));
    }
  }

  private focusComposer(): void {
    this.requestComponentFocus(AGENT_HOME_COMPOSER_FOCUS_KEY);
  }

  private closeTopInteraction(): void {
    if (this.commandPaletteVisible) {
      this.closeCommandPalette();
      return;
    }
    if (this.activeSheetKey !== AgentHomeSheetKey.NONE) {
      this.closeSheet();
    }
  }

  @Builder
  private buildAssistantContentNodes(item: AgentHomeChatItem): void {
    Column({ space: 8 }) {
      ForEach(AgentBridgeIncomingParser.parseRichContentNodes(item.contentNodesJson),
        (node: AgentBridgeRichContentNode, index: number) => {
          this.buildAssistantContentNode(
            item,
            node,
            index,
            AgentHomeRichContentPolicy.resolveNode(node, this.authoritativeRichContentWorkspaceId())
          )
          if (node.truncated) {
            Text(node.truncationReason.length > 0 ? node.truncationReason : $r('app.string.agent_home_content_truncated'))
              .width('100%')
              .fontSize(12)
              .fontColor($r('app.color.tag_amber'))
          }
        }, (node: AgentBridgeRichContentNode, index: number): string => {
          return node.id.length > 0 ? node.id : item.id + '_ast_' + String(index);
        })
    }
    .width('100%')
    .padding({ bottom: 8 })
  }

  @Builder
  private buildAssistantContentNode(
    item: AgentHomeChatItem,
    node: AgentBridgeRichContentNode,
    index: number,
    decision: AgentHomeRichContentDecision
  ): void {
    if (decision.renderKind === AgentHomeRichContentNodeKind.CODE) {
      this.buildAssistantAstCodeNode(node, item.id + '_ast_' + String(index), false)
    } else if (decision.renderKind === AgentHomeRichContentNodeKind.DIFF) {
      this.buildAssistantAstCodeNode(node, item.id + '_ast_' + String(index), true)
    } else if (decision.renderKind === AgentHomeRichContentNodeKind.LINK) {
      this.buildAssistantAstLinkNode(node)
    } else if (decision.renderKind === AgentHomeRichContentNodeKind.FILE) {
      this.buildAssistantAstFileNode(node, decision)
    } else if (decision.renderKind === AgentHomeRichContentNodeKind.TODO) {
      this.buildAssistantAstTodoNode(node, decision)
    } else if (decision.renderKind === AgentHomeRichContentNodeKind.TOOL) {
      this.buildAssistantAstToolNode(node, decision)
    } else if (decision.renderKind === AgentHomeRichContentNodeKind.WARNING ||
      decision.renderKind === AgentHomeRichContentNodeKind.FALLBACK) {
      this.buildAssistantAstFallbackNode(node, decision)
    } else {
      this.buildAssistantRichBlock(new AgentHomeRichBlock(
        item.id + '_ast_' + String(index), AgentHomeRichBlockKind.PARAGRAPH, node.text
      ))
    }
  }

  @Builder
  private buildAssistantAstCodeNode(node: AgentBridgeRichContentNode, nodeId: string, isDiff: boolean): void {
    Column({ space: 6 }) {
      Row({ space: 6 }) {
        SymbolGlyph(isDiff ? $r('sys.symbol.arrow_left_arrow_right') : $r('sys.symbol.code'))
          .fontSize(14)
          .fontColor([this.agentHomeReadableSecondaryColor()])
        Text(this.assistantAstCodeTitle(node, isDiff))
          .layoutWeight(1)
          .fontSize(10)
          .fontWeight(FontWeight.Medium)
          .fontColor(this.codeBlockMetaTextColor())
          .textCase(TextCase.UpperCase)
          .maxLines(1)
      }
      .width('100%')
      Text() {
        if (node.tokenized && node.tokens.length > 0) {
          ForEach(node.tokens, (token: AgentBridgeRichContentToken) => {
            this.buildAssistantAstCodeToken(token)
          }, (token: AgentBridgeRichContentToken, index: number): string => {
            return nodeId + '_token_' + String(index);
          })
        } else {
          Span(node.text)
            .fontColor(this.codeBlockTextColor())
        }
      }
      .width('100%')
      .fontSize(this.codeFontSize)
      .lineHeight(Math.max(this.codeFontSize + 6, this.chatLineHeight))
      .fontFamily('monospace')
      .fontColor(this.codeBlockTextColor())
      .textSelectable(TextSelectableMode.SELECTABLE_UNFOCUSABLE)
      .copyOption(CopyOptions.LocalDevice)
    }
    .width('100%')
    .padding({ left: 12, right: 12, top: 10, bottom: 10 })
    .backgroundColor(this.codeBlockBackgroundColor())
    .border({ width: 1, color: this.codeBlockBorderColor() })
    .borderRadius(12)
  }

  @Builder
  private buildAssistantAstCodeToken(token: AgentBridgeRichContentToken): void {
    Span(token.text)
      .fontSize(this.codeFontSize)
      .lineHeight(Math.max(this.codeFontSize + 6, this.chatLineHeight))
      .fontFamily('monospace')
      .fontColor(this.assistantAstCodeTokenColor(token.kind))
  }

