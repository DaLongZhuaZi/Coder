  @Builder
  private buildAutomationCollaborationPanel(): void {
    Column({ space: 10 }) {
      Row({ space: 8 }) {
        SymbolGlyph($r('sys.symbol.calendar_badge_play'))
          .fontSize(18)
          .fontColor([$r('app.color.text_body')])
        Column({ space: 2 }) {
          Text($r('app.string.agent_home_m7_title'))
            .fontSize(14)
            .fontWeight(FontWeight.Medium)
            .fontColor($r('app.color.text_body'))
          Text($r('app.string.agent_home_m7_subtitle'))
            .fontSize(10)
            .fontColor($r('app.color.text_secondary'))
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .layoutWeight(1)
        Button() {
          Row({ space: 4 }) {
            SymbolGlyph($r('sys.symbol.arrow_clockwise'))
              .fontSize(13)
              .fontColor([$r('app.color.text_body')])
            Text($r('app.string.agent_home_m7_refresh'))
              .fontSize(10)
              .fontColor($r('app.color.text_body'))
          }
        }
        .height(32)
        .padding({ left: 9, right: 9 })
        .borderRadius(8)
        .backgroundColor($r('app.color.background_secondary'))
        .enabled(!this.m7Busy)
        .onClick((): void => {
          this.refreshM7CurrentTab();
        })
      }
      .width('100%')

      Row({ space: 4 }) {
        if (this.canUseBridgeSchedules()) {
          this.buildAutomationTabButton(
            AgentHomeAutomationTabIndex.SCHEDULES,
            $r('app.string.agent_home_m7_tab_schedules'),
            $r('sys.symbol.calendar')
          )
        }
        if (this.canUseBridgeLoops()) {
          this.buildAutomationTabButton(
            AgentHomeAutomationTabIndex.LOOPS,
            $r('app.string.agent_home_m7_tab_loops'),
            $r('sys.symbol.repeat')
          )
        }
        if (this.canUseBridgeChatRooms()) {
          this.buildAutomationTabButton(
            AgentHomeAutomationTabIndex.ROOMS,
            $r('app.string.agent_home_m7_tab_rooms'),
            $r('sys.symbol.person_2')
          )
        }
      }
      .width('100%')
      .height(40)
      .padding(4)
      .backgroundColor($r('app.color.background_secondary'))
      .borderRadius(10)

      if (this.m7Result.action.length > 0) {
        this.buildM7ResultCard()
      }
      if (this.automationTabIndex === AgentHomeAutomationTabIndex.SCHEDULES && this.canUseBridgeSchedules()) {
        this.buildScheduleManagementPanel()
      } else if (this.automationTabIndex === AgentHomeAutomationTabIndex.LOOPS && this.canUseBridgeLoops()) {
        this.buildLoopManagementPanel()
      } else if (this.canUseBridgeChatRooms()) {
        this.buildChatRoomManagementPanel()
      }
    }
    .width('100%')
    .padding({ top: 8, bottom: 4 })
  }

  @Builder
  private buildAutomationTabButton(index: number, title: ResourceStr, symbol: Resource): void {
    Button() {
      Row({ space: 4 }) {
        SymbolGlyph(symbol)
          .fontSize(14)
          .fontColor([this.automationTabIndex === index ? $r('app.color.text_white') : $r('app.color.text_secondary')])
        Text(title)
          .fontSize(10)
          .fontColor(this.automationTabIndex === index ? $r('app.color.text_white') : $r('app.color.text_body'))
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }
      .justifyContent(FlexAlign.Center)
      .width('100%')
    }
    .layoutWeight(1)
    .height(32)
    .padding({ left: 2, right: 2 })
    .borderRadius(8)
    .backgroundColor(this.automationTabIndex === index ? this.agentHomeSolidControlBackgroundColor() : Color.Transparent)
    .onClick((): void => {
      this.automationTabIndex = index;
      this.refreshM7CurrentTab();
    })
  }

