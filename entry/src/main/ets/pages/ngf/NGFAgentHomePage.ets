  private providerProfileRuntimeStatusText(item: AgentBridgeProviderProfileRecord): string {
    const mode = item.runtimeMode.length > 0 ? item.runtimeMode : 'oneshot';
    if (item.runtimeRegistered) {
      const runtimeId = item.runtimeProviderId.length > 0 ? item.runtimeProviderId : item.providerId;
      return mode + ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_profile_runtime_ready')) + ': ' + runtimeId;
    }
    if (item.runtimeError.length > 0) {
      const category = item.runtimeFailureCategory.length > 0 ? item.runtimeFailureCategory + ': ' : '';
      return mode + ' / ' + category + item.runtimeError;
    }
    return mode + ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_profile_runtime_unavailable'));
