        if (item.id === this.activeWorkspaceId) {
          Circle()
            .width(8)
            .height(8)
            .fill($r('app.color.tag_blue'))
        }
      }
      .width('100%')
      .height(42)
      .onClick((): void => {
        this.activateWorkspace(item.id);
      })
