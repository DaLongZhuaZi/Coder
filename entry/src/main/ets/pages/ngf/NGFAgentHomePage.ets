  private checkpointConflictSummaryText(result: AgentBridgeCheckpointRestoreResult): string {
    const parts: Array<string> = [];
    const limit = result.conflicts.length > 3 ? 3 : result.conflicts.length;
    for (let index = 0; index < limit; index++) {
      const item = result.conflicts[index];
      let line = item.path;
      if (item.reason.length > 0) {
        line = line + ' (' + item.reason + ')';
      }
      parts.push(line);
    }
    const verifyLimit = result.verifyErrors.length > 2 ? 2 : result.verifyErrors.length;
    for (let index = 0; index < verifyLimit; index++) {
      const item = result.verifyErrors[index];
      let line = item.path;
      if (line.length === 0) {
        line = item.reason;
      } else if (item.reason.length > 0) {
        line = line + ' (' + item.reason + ')';
      }
      parts.push(line);
    }
    if (result.conflicts.length > limit) {
      parts.push('+' + String(result.conflicts.length - limit));
    }
    return parts.join('\n');
  }

  private checkpointRestoreVerificationSummaryText(result: AgentBridgeCheckpointRestoreResult): string {
    const hostContext = this.getUIContext().getHostContext();
    const parts: Array<string> = [];
    parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_verify_summary')) + ': ' +
      (result.manifestVerified ? resolveResourceString(hostContext, $r('app.string.agent_home_daemon_doctor_ok')) :
        resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_manifest_failed'))));
    parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_file_counts')) + ': ' +
      resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_files_restored')) + ' ' + String(result.filesRestored) + ', ' +
      resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_files_verified')) + ' ' + String(result.filesVerified) + ', ' +
      resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_files_skipped')) + ' ' + String(result.filesSkipped));
    if (result.verifyErrors.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_verify_errors')) + ': ' + String(result.verifyErrors.length));
    }
    if (result.preRestoreSnapshotId.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_pre_snapshot')) + ': ' + result.preRestoreSnapshotId);
    }
    if (result.restorePlanId.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_plan')) + ': ' + result.restorePlanId);
    }
    if (result.workspaceRoot.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_workspace_root')) + ': ' + result.workspaceRoot);
    }
    if (result.restoreBlocked) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_blocked')) + ': ' + result.restoredReason);
    }
    const skippedReasons = this.checkpointSkippedReasonsText(result.skippedReasons);
    if (skippedReasons.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_skipped_reasons')) + ': ' + skippedReasons);
    }
    if (!result.runtimeRestored) {
      parts.push(this.checkpointRuntimeBoundaryText(result.runtimeRestoreReason));
    }
    return parts.join('\n');
  }

