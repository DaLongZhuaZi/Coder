  private visibleDaemonDoctorChecks(): Array<AgentBridgeDaemonDoctorCheck> {
    const important: Array<AgentBridgeDaemonDoctorCheck> = [];
    for (let index = 0; index < this.daemonStatus.doctor.checks.length; index++) {
      const item = this.daemonStatus.doctor.checks[index];
      if (item.status === 'error' || item.status === 'warning') {
        important.push(item);
      }
      if (important.length >= 4) {
        return important;
      }
    }
    if (important.length > 0) {
      return important;
    }
    const fallback: Array<AgentBridgeDaemonDoctorCheck> = [];
    const limit = this.daemonStatus.doctor.checks.length > 3 ? 3 : this.daemonStatus.doctor.checks.length;
    for (let index = 0; index < limit; index++) {
      fallback.push(this.daemonStatus.doctor.checks[index]);
    }
    return fallback;
  }

