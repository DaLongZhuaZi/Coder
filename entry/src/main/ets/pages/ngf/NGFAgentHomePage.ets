            .width('100%')
            .fontSize(12)
            .fontColor(this.agentHomeReadableSecondaryColor())
            .maxLines(8)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        } else if (decision.fallbackReason.length > 0) {
          Text($r('app.string.agent_home_content_unavailable'))
            .width('100%')
            .fontSize(11)
            .fontColor(this.agentHomeReadableSecondaryColor())
        }
      }
      .layoutWeight(1)
    }
    .width('100%')
    .padding(12)
    .borderRadius(12)
    .backgroundColor($r('app.color.panel_background'))
  }

  private authoritativeRichContentWorkspaceId(): string {
    const agent = this.currentBridgeAgentRecord();
    if (agent !== null && agent.workspaceId.length > 0) {
      return agent.workspaceId;
    }
    const workspace = this.currentWorkspace();
    if (workspace === null) {
      return '';
    }
    const record = this.findBridgeWorkspaceRecordForLocalWorkspace(workspace);
    return record !== null ? record.workspaceId : '';
  }

  private richContentFileLabel(decision: AgentHomeRichContentDecision): string {
    if (decision.line > 0) {
      return decision.normalizedPath + ':' + String(decision.line);
    }
    return decision.normalizedPath;
  }

  private assistantAstCodeTitle(node: AgentBridgeRichContentNode, isDiff: boolean): ResourceStr {
    if (node.displayName.length > 0) {
      return node.displayName;
    }
    if (node.language.length > 0) {
      return node.language;
    }
    return isDiff ? $r('app.string.agent_home_content_diff') : $r('app.string.agent_home_content_code');
  }

  private assistantTodoStatusText(status: string): ResourceStr {
    if (status === AgentHomeTodoStatus.COMPLETED) { return $r('app.string.agent_home_todo_completed'); }
    if (status === AgentHomeTodoStatus.IN_PROGRESS) { return $r('app.string.agent_home_todo_in_progress'); }
    if (status === AgentHomeTodoStatus.CANCELLED) { return $r('app.string.agent_home_todo_cancelled'); }
    return $r('app.string.agent_home_todo_pending');
  }

  private assistantAstCodeTokenColor(kind: string): ResourceColor {
    if (kind === 'comment') { return $r('app.color.text_secondary'); }
    if (kind === 'string' || kind === 'addition') { return $r('app.color.tag_green'); }
    if (kind === 'keyword' || kind === 'header') { return $r('app.color.tag_blue'); }
    if (kind === 'number' || kind === 'variable') { return $r('app.color.tag_amber'); }
    if (kind === 'deletion') { return $r('app.color.tag_red'); }
    return this.codeBlockTextColor();
  }

  private assistantTodoStatusSymbol(status: string): Resource {
    if (status === AgentHomeTodoStatus.COMPLETED) { return $r('sys.symbol.checkmark_circle'); }
    if (status === AgentHomeTodoStatus.IN_PROGRESS) { return $r('sys.symbol.play_circle'); }
    if (status === AgentHomeTodoStatus.CANCELLED) { return $r('sys.symbol.xmark_circle'); }
    return $r('sys.symbol.circle');
  }

  private assistantTodoStatusColor(status: string): ResourceColor {
    if (status === AgentHomeTodoStatus.COMPLETED) { return $r('app.color.tag_green'); }
    if (status === AgentHomeTodoStatus.IN_PROGRESS) { return $r('app.color.tag_blue'); }
    if (status === AgentHomeTodoStatus.CANCELLED) { return $r('app.color.tag_red'); }
    return this.agentHomeReadableSecondaryColor();
  }

  private assistantToolCategorySymbol(category: string): Resource {
    if (category === AgentHomeToolCardCategory.FILE) { return $r('sys.symbol.doc'); }
    if (category === AgentHomeToolCardCategory.SHELL) { return $r('sys.symbol.AI_keyboard'); }
    if (category === AgentHomeToolCardCategory.GIT) { return $r('sys.symbol.arrow_left_arrow_right'); }
    if (category === AgentHomeToolCardCategory.GITHUB) { return $r('sys.symbol.person_2'); }
    if (category === AgentHomeToolCardCategory.CHECKPOINT) { return $r('sys.symbol.arrow_counterclockwise'); }
    if (category === AgentHomeToolCardCategory.TERMINAL) { return $r('sys.symbol.desktop'); }
    if (category === AgentHomeToolCardCategory.PERMISSION) { return $r('sys.symbol.security_shield'); }
    if (category === AgentHomeToolCardCategory.PLAN) { return $r('sys.symbol.route_plan'); }
    return $r('sys.symbol.wrench_and_screwdriver');
  }

  @Builder
  private buildRichInlineRunText(
    run: AgentHomeRichInlineRun,
    fontSize: number,
    lineHeight: number,
    fontColor: ResourceColor
  ): void {
    if (run.kind === AgentHomeRichInlineKind.LINK) {
      Text(run.text)
        .fontSize(fontSize)
        .lineHeight(lineHeight)
        .fontWeight(FontWeight.Medium)
        .fontColor($r('app.color.tag_blue'))
        .decoration({ type: TextDecorationType.Underline, color: $r('app.color.tag_blue') })
        .onClick((): void => {
          this.handleAssistantAnswerLinkClick(run.target);
        })
    } else if (run.kind === AgentHomeRichInlineKind.CODE) {
      Text(run.text)
        .fontSize(fontSize - 1)
        .lineHeight(lineHeight)
        .fontFamily('monospace')
        .fontColor(this.inlineCodeTextColor())
        .backgroundColor(this.inlineCodeTextBackgroundColor())
        .borderRadius(6)
        .padding({ left: 3, right: 3 })
    } else if (run.kind === AgentHomeRichInlineKind.STRONG) {
      Text(run.text)
        .fontSize(fontSize)
        .lineHeight(lineHeight)
        .fontWeight(FontWeight.Medium)
        .fontColor(fontColor)
    } else if (run.kind === AgentHomeRichInlineKind.EMPHASIS) {
      Text(run.text)
        .fontSize(fontSize)
        .lineHeight(lineHeight)
        .fontStyle(FontStyle.Italic)
        .fontColor(fontColor)
    } else {
      Text(run.text)
        .fontSize(fontSize)
        .lineHeight(lineHeight)
        .fontColor(fontColor)
    }
  }

