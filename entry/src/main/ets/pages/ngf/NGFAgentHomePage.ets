    }
    const title = this.workspaceTitleDraft.trim().length > 0 ? this.workspaceTitleDraft.trim() : this.lastPathSegment(path);
    this.client.importWorkspaceRegistry(this.bridgeWorkspaceIdForPath(path), path, title, true, false);
    this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_workspace_registry_preview_requested')));
