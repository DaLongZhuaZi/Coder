  private async loadPersistentState(): Promise<void> {
    try {
      const restoredFleetRun: AgentHomeDaemonRollingResult | null = agentHomeDaemonFleetRunStore.restore();
      const migrationVersion = await this.persistence.hostMigrationVersion();
      if (migrationVersion < 1) {
        const legacySnapshot = await this.persistence.loadOrCreate(this.buildBootstrapState());
        this.trustedDevices = legacySnapshot.trustedDevices;
        await this.ensureHostProfileMigration(legacySnapshot);
      } else {
        this.trustedDevices = await this.persistence.loadTrustedDevices();
      }
      await this.drainCredentialGarbageCollection();
      this.hostProfiles = await this.persistence.loadHostProfiles();
      if (this.hostProfiles.length === 0) {
        this.clearHostRuntimeState();
        if (restoredFleetRun !== null) {
          this.daemonFleetRollingResult = restoredFleetRun;
          this.daemonFleetBusy = false;
          this.daemonFleetLastError = '';
        }
        this.finishPersistentStateLoading();
        return;
      }
      let activeHostProfileId = await this.persistence.loadActiveHostProfileId();
      let activeProfile = this.findHostProfile(activeHostProfileId);
      if (activeProfile === null) {
        activeProfile = this.hostProfiles[0];
        activeHostProfileId = activeProfile.hostProfileId;
      }
      await this.activateHostProfile(activeProfile, false, '');
      if (restoredFleetRun !== null) {
        this.daemonFleetRollingResult = restoredFleetRun;
        this.daemonFleetBusy = false;
        this.daemonFleetLastError = '';
      }
      logger.info(TAG, 'agent home host state loaded: hostProfileId=' + activeHostProfileId);
    } catch (e) {
      logger.error(TAG, 'load agent home state failed: ' + e);
      this.connectionStatus = AgentBridgeConnectionStatus.ERROR;
      this.bridgeConnectionReasonText = this.errorToString(e);
      this.finishPersistentStateLoading();
    }
  }

  private async ensureHostProfileMigration(snapshot: AgentHomeStateSnapshot): Promise<void> {
    const migrationVersion = await this.persistence.hostMigrationVersion();
    const existingProfiles = await this.persistence.loadHostProfiles();
    if (migrationVersion >= 1 && existingProfiles.length > 0) {
      return;
    }
    const legacy = snapshot.profile;
    if (
      legacy.endpoint.length === 0 && legacy.token.length === 0 &&
        snapshot.workspaces.length === 0 && snapshot.sessions.length === 0
    ) {
      return;
    }
    let credentialAlias = '';
    let credentialDigest = '';
    if (legacy.token.length > 0) {
      const writeResult = await agentHomeHostCredentialStore.writeNew(AGENT_LEGACY_HOST_PROFILE_ID, legacy.token);
      if (!writeResult.ok) {
        throw new Error('host credential migration failed: ' + writeResult.failureCategory);
      }
      credentialAlias = writeResult.alias;
      credentialDigest = writeResult.digest;
    }
    const now = Date.now();
    const endpoint = AgentBridgeClient.normalizeEndpointInput(legacy.endpoint);
    const displayName = this.defaultHostProfileName(endpoint);
    const profile = new AgentHomeHostProfile(
      AGENT_LEGACY_HOST_PROFILE_ID,
      displayName,
      endpoint,
      credentialAlias,
      credentialDigest,
      legacy.providerId,
      legacy.modelId,
      legacy.speedMode,
      legacy.reasoningMode,
      legacy.activeWorkspaceId,
      legacy.activeSessionId,
      legacy.previewPath,
      legacy.activeDeviceId.length > 0 ? legacy.activeDeviceId : legacy.lastDeviceId,
      '',
      true,
      credentialAlias.length > 0 ? AgentHomeHostIdentityStatus.UNBOUND : AgentHomeHostIdentityStatus.CREDENTIAL_MISSING,
      legacy.updatedAt > 0 ? legacy.updatedAt : now,
      now,
      now
    );
    try {
      await this.persistence.migrateLegacyHostProfile(profile);
    } catch (error) {
      if (credentialAlias.length > 0) {
        await agentHomeHostCredentialStore.remove(credentialAlias);
      }
      throw new Error(this.errorToString(error));
    }
  }

  private async drainCredentialGarbageCollection(): Promise<void> {
    const aliases = await this.persistence.loadCredentialGarbageCollection();
    for (let index = 0; index < aliases.length; index++) {
      const alias = aliases[index];
      if (alias.length > 0 && await agentHomeHostCredentialStore.remove(alias)) {
        await this.persistence.removeCredentialGarbageCollection(alias);
      }
    }
  }

  private defaultHostProfileName(endpoint: string): string {
    if (endpoint.length === 0) {
      return 'Bridge';
    }
    if (AgentBridgeClient.isRelayEndpoint(endpoint)) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_host_default_name')
      );
    }
    const host = this.extractHostFromBridgeEndpoint(endpoint);
    return host.length > 0 ? host : endpoint;
  }

  private normalizeHostEndpoint(endpoint: string): string {
    const value: string = endpoint.trim();
    if (AgentBridgeClient.isRelayEndpoint(value)) {
      return value;
    }
    return AgentBridgeClient.normalizeEndpointInput(value);
  }

  private findHostProfile(hostProfileId: string): AgentHomeHostProfile | null {
    for (let index = 0; index < this.hostProfiles.length; index++) {
      if (this.hostProfiles[index].hostProfileId === hostProfileId) {
        return this.hostProfiles[index];
      }
    }
    return null;
  }

  private hostProfileDisplayName(hostProfileId: string): string {
    const profile = this.findHostProfile(hostProfileId);
    if (profile !== null && profile.displayName.length > 0) {
      return profile.displayName;
    }
    return hostProfileId.length > 0 ? hostProfileId : this.resolveDetailEmptyText();
  }

  private activeHostIdentityMismatch(): boolean {
    const profile = this.findHostProfile(this.activeHostProfileId);
    return profile !== null && profile.identityStatus === AgentHomeHostIdentityStatus.MISMATCH;
  }

  private activeHostCanConnect(): boolean {
    return AgentHomeRelayUiPolicy.canConnectHost(
      this.bridgeEndpoint,
      this.activeHostCredentialAvailable && this.activeBridgeCredential.length > 0
    );
  }

  private async activateHostProfile(
    profile: AgentHomeHostProfile,
    explicitSwitch: boolean,
    pendingWorkspaceId: string
  ): Promise<void> {
    this.cancelDaemonFleetRolling('host_switch');
    this.daemonFleetConnectionPool.stop();
    this.daemonFleetResults = [];
    this.daemonFleetRollingResult = new AgentHomeDaemonRollingResult();
    this.daemonFleetLastError = '';
    this.connectionEpoch = this.connectionEpoch + 1;
    const epoch = this.connectionEpoch;
    this.activeHostProfileId = profile.hostProfileId;
    this.daemonStatusCoordinator.reset(profile.hostProfileId, epoch);
    this.voiceRequestCoordinator.reset(profile.hostProfileId, epoch);
    this.resetCurrentUsageScope();
    this.hostSwitchCoordinator.setInitialHost(profile.hostProfileId);
    this.hostSwitchStatus = AgentHomeHostSwitchStatus.LOADING;
    this.pendingHostWorkspaceId = pendingWorkspaceId;
    this.bridgeEndpoint = profile.endpoint;
    this.bridgeToken = '';
    this.selectedProviderId = profile.providerId.length > 0 ? profile.providerId : AgentBridgeProviderId.CODEX;
    this.selectedModelId = profile.modelId.length > 0 ? profile.modelId : 'configured';
    this.selectedSpeedMode = profile.speedMode.length > 0 ? profile.speedMode : 'auto';
    this.selectedReasoningMode = profile.reasoningMode.length > 0 ? profile.reasoningMode : 'auto';
    this.activeDeviceId = profile.lastDeviceId;
    this.lastDeviceId = profile.lastDeviceId;
    this.currentBridgeServerId = profile.lastServerId;
    this.currentBridgeServerInfo = null;
    const snapshot = await this.persistence.loadHostSnapshot(profile);
    if (!this.acceptsHostEpoch(profile.hostProfileId, epoch)) {
      return;
    }
    this.applyHostSnapshot(snapshot);
    this.remoteSessions = await this.persistence.loadRemoteSessions(profile.hostProfileId);
    if (!this.acceptsHostEpoch(profile.hostProfileId, epoch)) {
      return;
    }
    this.bridgeProjectRecords = await this.persistence.loadProjectRecords(profile.lastDeviceId, profile.lastServerId);
    this.bridgeWorkspaceRecords = await this.persistence.loadWorkspaceRecords(profile.lastDeviceId, profile.lastServerId);
    this.bridgeTerminals = await this.persistence.loadTerminalSnapshots(profile.lastDeviceId, profile.lastServerId);
    if (!this.acceptsHostEpoch(profile.hostProfileId, epoch)) {
      return;
    }
    const credential = await agentHomeHostCredentialStore.read(profile.credentialAlias);
    if (!this.acceptsHostEpoch(profile.hostProfileId, epoch)) {
      return;
    }
    this.activeBridgeCredential = credential === null ? '' : credential;
    this.activeHostCredentialAvailable = this.activeBridgeCredential.length > 0;
    const relayHost = AgentBridgeClient.isRelayEndpoint(profile.endpoint);
    profile.identityStatus = this.activeHostCredentialAvailable || relayHost ?
      profile.identityStatus : AgentHomeHostIdentityStatus.CREDENTIAL_MISSING;
    profile.lastUsedAt = Date.now();
    profile.updatedAt = Date.now();
    await this.persistence.saveHostProfile(profile);
    await this.persistence.saveActiveHostProfileId(profile.hostProfileId);
    this.upsertHostProfileState(profile);
    await this.refreshHostWorkspaceGroups();
    this.ensureSessionImportProvider();
    this.syncWorkspaceDrafts();
    this.bindBridgeHandlersForEpoch(profile.hostProfileId, epoch);
    this.hostSwitchCoordinator.markReady(profile.hostProfileId);
    this.hostSwitchStatus = AgentHomeHostSwitchStatus.READY;
    if (this.pendingHostWorkspaceId.length > 0) {
      this.activatePendingHostWorkspace();
    }
    this.consumeNotificationTapRouteIfReady();
    const shouldConnect = explicitSwitch || profile.autoConnectOnLaunch;
    if (shouldConnect && this.activeHostCanConnect() && profile.endpoint.length > 0) {
      this.restoreLastBridgeConnection();
    } else {
      this.finishPersistentStateLoading();
    }
  }

  private applyHostSnapshot(snapshot: AgentHomeHostSnapshot): void {
    this.workspaces = snapshot.workspaces;
    this.sessions = snapshot.sessions;
    this.messages = snapshot.messages;
    this.previews = snapshot.previews;
