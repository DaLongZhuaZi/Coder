    const items: Array<AgentHomeCommandDefinition> = [];
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.OPEN_PALETTE, 'navigation', resolveResourceString(hostContext, $r('app.string.agent_home_command_palette')),
      ['command', 'search'], 'command', 'open_palette', 'Ctrl/Meta+K', this.supportsCommandPalette()
    ));
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.SEND_MESSAGE, 'composer', resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_send')),
      ['send', 'composer'], 'send', AgentHomeActionKey.SEND_MESSAGE, 'Ctrl/Meta+Enter',
      this.connectionStatus === AgentBridgeConnectionStatus.CONNECTED && this.activeSessionId.length > 0
    ));
    items.push(new AgentHomeCommandDefinition(
      AgentHomeCommandId.FOCUS_COMPOSER, 'composer', resolveResourceString(hostContext, $r('app.string.agent_home_message_placeholder')),
