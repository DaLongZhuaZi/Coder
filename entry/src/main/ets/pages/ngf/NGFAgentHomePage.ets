  private applyBridgeCheckpointUpdate(source: string): void {
    if (!this.canUseBridgeCheckpoints()) {
      return;
    }
    const checkpoint = AgentBridgeIncomingParser.parseFirstCheckpointRecord(source);
    if (checkpoint.checkpointId.length === 0) {
      return;
    }
    const nextItems: Array<AgentBridgeCheckpointRecord> = [];
    let replaced = false;
    for (let index = 0; index < this.checkpointRecords.length; index++) {
      const item = this.checkpointRecords[index];
      if (item.checkpointId === checkpoint.checkpointId) {
        nextItems.push(checkpoint);
        replaced = true;
      } else {
        nextItems.push(item);
      }
    }
    if (!replaced) {
      nextItems.unshift(checkpoint);
    }
    this.checkpointRecords = nextItems;
    if (source.indexOf('"dryRun":true') >= 0) {
      const restoreResult = AgentBridgeIncomingParser.parseCheckpointRestoreResult(source);
      if (source.indexOf('"fileRestore"') >= 0 || source.indexOf('"conflicts"') >= 0) {
        this.handleCheckpointRestoreDryRun(restoreResult);
      } else {
        this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_checkpoint_restore_dry_run_done')));
      }
    } else if (source.indexOf('"restored"') >= 0) {
      const restoreResult = AgentBridgeIncomingParser.parseCheckpointRestoreResult(source);
      if (restoreResult.preRestoreSnapshotId.length > 0 && restoreResult.checkpoint.agentId.length > 0) {
        this.showCheckpointPreRestoreRollbackDialog(restoreResult);
      } else {
        this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_checkpoint_restore_conversation_only')));
      }
    } else {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_checkpoint_created_status')));
    }
  }

