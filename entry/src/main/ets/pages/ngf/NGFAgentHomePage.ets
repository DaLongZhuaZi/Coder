  @Builder
  private buildAssistantAstFallbackNode(
    node: AgentBridgeRichContentNode,
    decision: AgentHomeRichContentDecision
  ): void {
    Row({ space: 8 }) {
      SymbolGlyph(node.kind === AgentHomeRichContentNodeKind.WARNING ?
        $r('sys.symbol.exclamationmark_triangle') : $r('sys.symbol.info_circle'))
        .fontSize(16)
        .fontColor([node.kind === AgentHomeRichContentNodeKind.WARNING ?
          $r('app.color.tag_amber') : this.agentHomeReadableSecondaryColor()])
      Column({ space: 3 }) {
        Text(node.displayName.length > 0 ? node.displayName :
          (node.toolName.length > 0 ? node.toolName : node.kind))
          .width('100%')
          .fontSize(13)
          .fontWeight(FontWeight.Medium)
          .fontColor(this.agentHomeReadableTextColor())
        if (node.text.length > 0) {
