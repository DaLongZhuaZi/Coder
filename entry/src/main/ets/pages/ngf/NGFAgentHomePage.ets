  @Builder
  private buildLoopRecordCard(item: AgentBridgeLoopRecord): void {
    Column({ space: 6 }) {
      Row({ space: 6 }) {
        SymbolGlyph($r('sys.symbol.repeat'))
          .fontSize(14)
          .fontColor([item.status === 'succeeded' ? $r('app.color.tag_green') : $r('app.color.text_secondary')])
        Column({ space: 2 }) {
          Text(item.name.length > 0 ? item.name : item.id)
            .fontSize(11)
            .fontWeight(FontWeight.Medium)
            .fontColor($r('app.color.text_body'))
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
          Text(this.loopSummaryText(item))
            .fontSize(9)
            .fontColor($r('app.color.text_secondary'))
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .layoutWeight(1)
        Text(item.status)
          .fontSize(9)
          .fontColor($r('app.color.text_secondary'))
      }
      .width('100%')
      Row({ space: 5 }) {
        Button($r('app.string.agent_home_m7_edit'))
          .layoutWeight(1)
          .height(28)
          .fontSize(9)
          .borderRadius(7)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .enabled(!item.running)
          .onClick((): void => {
            this.selectLoop(item);
          })
        if (item.status === 'paused') {
          Button($r('app.string.agent_home_m7_resume'))
            .layoutWeight(1)
            .height(28)
            .fontSize(9)
            .borderRadius(7)
            .backgroundColor($r('app.color.background_secondary'))
            .fontColor($r('app.color.text_body'))
            .onClick((): void => {
              this.previewLoopAction(AgentBridgeRequestType.LOOP_RESUME, item);
            })
        } else if (item.status === 'running' || item.status === 'pausing') {
          Button($r('app.string.agent_home_m7_pause'))
            .layoutWeight(1)
            .height(28)
            .fontSize(9)
            .borderRadius(7)
            .backgroundColor($r('app.color.background_secondary'))
            .fontColor($r('app.color.text_body'))
            .enabled(item.status === 'running')
            .onClick((): void => {
              this.pauseLoop(item.id);
            })
        } else {
          Button($r('app.string.agent_home_m7_start'))
            .layoutWeight(1)
            .height(28)
            .fontSize(9)
            .borderRadius(7)
            .backgroundColor($r('app.color.background_secondary'))
            .fontColor($r('app.color.text_body'))
            .onClick((): void => {
              this.previewLoopAction(AgentBridgeRequestType.LOOP_START, item);
            })
        }
        Button($r('app.string.agent_home_m7_rounds'))
          .layoutWeight(1)
          .height(28)
          .fontSize(9)
          .borderRadius(7)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .onClick((): void => {
            this.selectedLoopId = item.id;
            this.client.requestLoopRounds(item.id);
          })
      }
      .width('100%')
      Row({ space: 5 }) {
        Button($r('app.string.agent_home_m7_stop'))
          .layoutWeight(1)
          .height(28)
          .fontSize(9)
          .borderRadius(7)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .enabled(item.status === 'running' || item.status === 'pausing' || item.status === 'paused')
          .onClick((): void => {
            this.previewLoopAction(AgentBridgeRequestType.LOOP_STOP, item);
          })
        Button($r('app.string.agent_home_m7_takeover'))
          .layoutWeight(1)
          .height(28)
          .fontSize(9)
          .borderRadius(7)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .enabled(item.status === 'running' || item.status === 'pausing' || item.status === 'paused')
          .onClick((): void => {
            this.previewLoopAction(AgentBridgeRequestType.LOOP_TAKEOVER, item);
          })
        Button($r('app.string.agent_home_m7_remove'))
          .layoutWeight(1)
          .height(28)
          .fontSize(9)
          .borderRadius(7)
          .backgroundColor($r('app.color.background_error'))
          .fontColor($r('app.color.tag_red'))
          .enabled(!item.running && item.status !== 'pausing' && item.status !== 'stopping')
          .onClick((): void => {
            this.previewLoopAction(AgentBridgeRequestType.LOOP_REMOVE, item);
          })
      }
      .width('100%')
    }
    .width('100%')
    .padding(8)
    .backgroundColor(this.selectedLoopId === item.id ? $r('app.color.background_secondary') : $r('app.color.background_surface'))
    .borderRadius(8)
    .border({ width: 1, color: $r('app.color.card_border') })
  }

