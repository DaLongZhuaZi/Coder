  private applyBridgeDaemonStatus(source: string): void {
    if (!this.canUseBridgeDaemonManagement()) {
      return;
    }
    const status = AgentBridgeIncomingParser.parseDaemonStatus(source);
    const parsed = AgentBridgeIncomingParser.parse(source);
    const accepted = this.daemonStatusCoordinator.accept(new AgentHomeDaemonStatusUpdate(
      this.activeHostProfileId,
      this.connectionEpoch,
      parsed.requestId,
      status,
      parsed.envelopeType === AgentBridgeEnvelopeType.RESPONSE
    ));
    if (!accepted) {
      logger.debug(TAG, 'ignored stale daemon status snapshot: requestId=' + parsed.requestId +
        ', instanceId=' + status.instanceId + ', generation=' + String(status.generation));
      return;
    }
    this.daemonStatus = status;
  }

  private applyBridgeDaemonAutostart(source: string): void {
    if (!this.canUseBridgeDaemonManagement()) {
      return;
    }
    const nextStatus = new AgentBridgeDaemonStatus();
    nextStatus.action = this.daemonStatus.action;
    nextStatus.status = this.daemonStatus.status;
    nextStatus.health = this.daemonStatus.health;
    nextStatus.pid = this.daemonStatus.pid;
    nextStatus.supervisorPid = this.daemonStatus.supervisorPid;
    nextStatus.workerPid = this.daemonStatus.workerPid;
    nextStatus.supervised = this.daemonStatus.supervised;
    nextStatus.workerGeneration = this.daemonStatus.workerGeneration;
    nextStatus.workerReady = this.daemonStatus.workerReady;
    nextStatus.startedAt = this.daemonStatus.startedAt;
    nextStatus.workerStartedAt = this.daemonStatus.workerStartedAt;
    nextStatus.workerReadyAt = this.daemonStatus.workerReadyAt;
    nextStatus.lastHeartbeatAt = this.daemonStatus.lastHeartbeatAt;
    nextStatus.lastWorkerHeartbeatAt = this.daemonStatus.lastWorkerHeartbeatAt;
    nextStatus.exitCode = this.daemonStatus.exitCode;
    nextStatus.lastError = this.daemonStatus.lastError;
    nextStatus.restartCount = this.daemonStatus.restartCount;
    nextStatus.consecutiveCrashes = this.daemonStatus.consecutiveCrashes;
    nextStatus.crashWindowCount = this.daemonStatus.crashWindowCount;
    nextStatus.crashLoop = this.daemonStatus.crashLoop;
    nextStatus.nextRestartAt = this.daemonStatus.nextRestartAt;
    nextStatus.lastRestartReason = this.daemonStatus.lastRestartReason;
    nextStatus.warningsJson = this.daemonStatus.warningsJson;
    const failureCategory = AgentBridgeIncomingParser.extractStringProperty(source, 'failureCategory');
    const remediation = AgentBridgeIncomingParser.cleanJsonText(
      AgentBridgeIncomingParser.extractStringProperty(source, 'remediation')
    );
    const message = AgentBridgeIncomingParser.cleanJsonText(
      AgentBridgeIncomingParser.extractStringProperty(source, 'message')
    );
    nextStatus.failureCategory = failureCategory.length > 0 ? failureCategory : this.daemonStatus.failureCategory;
    nextStatus.remediation = remediation.length > 0 ? remediation : this.daemonStatus.remediation;
    nextStatus.message = message.length > 0 ? message : this.daemonStatus.message;
    nextStatus.serverId = this.daemonStatus.serverId;
    nextStatus.uptimeSec = this.daemonStatus.uptimeSec;
    nextStatus.activeConnections = this.daemonStatus.activeConnections;
    nextStatus.activeWebSocketConnections = this.daemonStatus.activeWebSocketConnections;
    nextStatus.managedProcessesJson = this.daemonStatus.managedProcessesJson;
    nextStatus.featuresJson = this.daemonStatus.featuresJson;
    nextStatus.configPath = this.daemonStatus.configPath;
    nextStatus.logPath = this.daemonStatus.logPath;
    nextStatus.doctor = this.daemonStatus.doctor;
    nextStatus.instanceId = this.daemonStatus.instanceId;
    nextStatus.hostProfileId = this.daemonStatus.hostProfileId;
    nextStatus.instanceHealth = this.daemonStatus.instanceHealth;
    nextStatus.generation = this.daemonStatus.generation;
    nextStatus.bridgeVersion = this.daemonStatus.bridgeVersion;
    nextStatus.nodeVersion = this.daemonStatus.nodeVersion;
    nextStatus.platform = this.daemonStatus.platform;
    nextStatus.architecture = this.daemonStatus.architecture;
    nextStatus.remoteConfigJson = this.daemonStatus.remoteConfigJson;
    nextStatus.autostartPreviewJson = this.daemonStatus.autostartPreviewJson;
    const autostartJson = AgentBridgeIncomingParser.extractObjectProperty(source, 'autostart');
    nextStatus.autostartJson = autostartJson;
    nextStatus.autostartEnabled = AgentBridgeIncomingParser.extractBooleanProperty(autostartJson, 'enabled');
    nextStatus.autostartConfigured = AgentBridgeIncomingParser.extractBooleanProperty(autostartJson, 'configured');
    nextStatus.autostartSupported = AgentBridgeIncomingParser.extractBooleanProperty(autostartJson, 'supported');
    nextStatus.autostartMethod = AgentBridgeIncomingParser.extractStringProperty(autostartJson, 'method');
    nextStatus.autostartPlatform = AgentBridgeIncomingParser.extractStringProperty(autostartJson, 'platform');
    nextStatus.autostartRegistrationId = AgentBridgeIncomingParser.extractStringProperty(autostartJson, 'registrationId');
    nextStatus.autostartTargetPath = AgentBridgeIncomingParser.extractStringProperty(autostartJson, 'targetPath');
    nextStatus.autostartRunnerPath = AgentBridgeIncomingParser.extractStringProperty(autostartJson, 'runnerPath');
    nextStatus.autostartWarning = AgentBridgeIncomingParser.cleanJsonText(
      AgentBridgeIncomingParser.extractFirstStringProperty(autostartJson, 'warning', 'lastError')
    );
    const previewJson = AgentBridgeIncomingParser.extractObjectProperty(source, 'preview');
    if (previewJson.length > 0) {
      nextStatus.autostartPreviewJson = previewJson;
    }
    const configPath = AgentBridgeIncomingParser.extractStringProperty(source, 'configPath');
    if (configPath.length > 0) {
      nextStatus.configPath = configPath;
    }
    this.daemonStatus = nextStatus;
  }

  private applyBridgeDaemonLogs(source: string): void {
    if (!this.canUseBridgeDaemonManagement()) {
      return;
    }
    this.daemonLogTail = AgentBridgeIncomingParser.parseDaemonLogTail(source);
  }

  private applyBridgeDaemonUpdate(source: string): void {
    if (!this.canUseBridgeDaemonSelfUpdate()) {
      return;
    }
    const result = AgentBridgeIncomingParser.parseDaemonUpdateResult(source);
    if (result.packageName.length === 0 && result.action.length === 0) {
      return;
    }
    this.daemonUpdateResult = result;
    if (result.action.length > 0 && result.action !== AgentBridgeRequestType.DAEMON_UPDATE_STATUS) {
      this.showTransientStatus(this.daemonUpdateStatusText());
    }
  }

  private refreshBridgeTerminalsIfAvailable(): void {
    if (!this.canUseBridgeTerminalBinary()) {
      return;
    }
    this.client.requestTerminals('', this.currentWorkspacePath(), this.currentBridgeAgentId());
  }

  private loadTerminalSnapshotsIfTrusted(): void {
    if (!this.hasTrustedBridgeV2Server()) {
      return;
    }
    this.persistence.loadTerminalSnapshots(this.activeDeviceId, this.currentBridgeServerId).then((items: Array<AgentBridgeTerminalSession>): void => {
      if (!this.hasTrustedBridgeV2Server() || items.length === 0 || this.bridgeTerminals.length > 0) {
        return;
      }
      this.bridgeTerminals = items;
      if (this.activeTerminalId.length === 0) {
        this.activeTerminalId = items[0].terminal.terminalId;
      }
    }).catch((error: Error): void => {
      logger.error(TAG, 'load terminal snapshots failed: ' + this.errorToString(error));
    });
  }

  private clearTerminalConnectionSlots(): void {
    if (this.bridgeTerminals.length === 0) {
      return;
    }
    const nextItems: Array<AgentBridgeTerminalSession> = [];
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      const existing = this.bridgeTerminals[index];
      const nextSession = new AgentBridgeTerminalSession();
      nextSession.terminal = existing.terminal;
      nextSession.transcript = existing.transcript;
      nextSession.slot = 0;
      nextSession.subscribed = false;
      nextSession.desiredSubscription = existing.desiredSubscription || existing.subscribed;
      nextSession.restoreState = AgentBridgeTerminalRestoreState.IDLE;
      nextSession.lastAppliedRestoreSeq = existing.lastAppliedRestoreSeq;
      nextSession.lastAppliedSnapshotSeq = existing.lastAppliedSnapshotSeq;
      nextSession.pendingOutput = '';
      nextSession.renderer = existing.renderer;
      nextSession.renderedText = existing.renderedText;
      nextSession.renderRuns = existing.renderRuns;
      nextItems.push(nextSession);
    }
    this.bridgeTerminals = nextItems;
  }

  private trackPendingTerminalCreateRequest(requestId: string): void {
    if (requestId.length === 0) {
      return;
    }
    for (let index = 0; index < this.pendingTerminalCreateRequestIds.length; index++) {
      if (this.pendingTerminalCreateRequestIds[index] === requestId) {
        return;
      }
    }
    this.pendingTerminalCreateRequestIds.push(requestId);
  }

  private consumePendingTerminalCreateRequest(requestId: string): boolean {
    if (requestId.length === 0 || this.pendingTerminalCreateRequestIds.length === 0) {
      return false;
    }
    let matched = false;
    const nextItems: Array<string> = [];
    for (let index = 0; index < this.pendingTerminalCreateRequestIds.length; index++) {
      const item = this.pendingTerminalCreateRequestIds[index];
      if (item === requestId) {
        matched = true;
      } else {
        nextItems.push(item);
      }
    }
    this.pendingTerminalCreateRequestIds = nextItems;
    return matched;
  }

  private canUseBridgeTerminalBinary(): boolean {
    if (!this.hasTrustedBridgeV2Server()) {
      return false;
    }
    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.terminalBinaryFrames;
  }

