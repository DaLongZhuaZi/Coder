        this.compactCheckpointText(item.validationMessagesJson, 120));
    }
    if (item.secretStorageState.length > 0 && item.secretStorageState !== 'ready') {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_provider_profile_validation')) + ': ' + item.secretStorageState);
    }
