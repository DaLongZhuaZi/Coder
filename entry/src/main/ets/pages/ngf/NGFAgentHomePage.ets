      Text($r('app.string.agent_home_daemon_fleet_desc'))
        .width('100%')
        .fontSize(10)
        .fontColor($r('app.color.text_secondary'))
        .maxLines(2)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
      Row({ space: 8 }) {
        Button($r('app.string.agent_home_daemon_fleet_refresh'))
          .layoutWeight(1)
          .height(32)
          .fontSize(11)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .enabled(!this.daemonFleetBusy)
          .onClick((): void => {
            this.refreshDaemonFleet().catch((error: Error): void => {
              logger.warn(TAG, 'refresh daemon fleet failed: ' + this.errorToString(error));
            });
          })
      }
      .width('100%')
      Row({ space: 4 }) {
        Button($r('app.string.agent_home_daemon_fleet_restart'))
          .layoutWeight(1)
          .height(32)
          .fontSize(11)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .enabled(!this.daemonFleetBusy && this.daemonFleetResults.length > 0)
          .onClick((): void => {
            this.daemonFleetRollingOperation = 'restart';
            this.previewDaemonFleetRollingRestart();
          })
        Button($r('app.string.agent_home_daemon_fleet_update'))
          .layoutWeight(1)
          .height(32)
          .fontSize(11)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .enabled(!this.daemonFleetBusy && this.daemonFleetResults.length > 0)
          .onClick((): void => {
            this.daemonFleetRollingOperation = 'update';
            this.previewDaemonFleetRollingRestart();
          })
        Button($r('app.string.agent_home_daemon_fleet_rollback'))
          .layoutWeight(1)
          .height(32)
          .fontSize(11)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_secondary'))
          .fontColor($r('app.color.text_body'))
          .enabled(!this.daemonFleetBusy && this.daemonFleetResults.length > 0)
          .onClick((): void => {
            this.daemonFleetRollingOperation = 'rollback';
            this.previewDaemonFleetRollingRestart();
          })
      }
      .width('100%')
      if (this.daemonFleetBusy) {
        Text($r('app.string.agent_home_daemon_fleet_loading'))
          .width('100%')
          .fontSize(10)
          .fontColor($r('app.color.text_secondary'))
      }
      if (this.daemonFleetLastError.length > 0) {
        Text(this.daemonFleetLastError)
          .width('100%')
          .fontSize(10)
          .fontColor($r('app.color.button_warning'))
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }
      if (this.daemonFleetResults.length > 0) {
        this.buildDaemonFleetSummary()
      }
      if (this.daemonFleetResults.length === 0) {
        Text($r('app.string.agent_home_daemon_fleet_empty'))
          .width('100%')
          .fontSize(10)
          .fontColor($r('app.color.text_secondary'))
      } else {
        ForEach(this.daemonFleetResults, (item: AgentHomeDaemonFleetQueryResult) => {
          this.buildDaemonFleetRow(item)
        }, (item: AgentHomeDaemonFleetQueryResult): string => item.hostProfileId)
      }
      if (this.daemonFleetRollingResult.status.length > 0 &&
        (this.daemonFleetResults.length > 0 || this.daemonFleetRollingResult.status === 'interrupted')) {
        this.buildDaemonDiagnosticRow(
          $r('app.string.agent_home_daemon_fleet_plan_status'),
          this.daemonFleetRollingResult.status
        )
        this.buildDaemonDiagnosticRow(
          $r('app.string.agent_home_daemon_fleet_plan_targets'),
          String(this.daemonFleetRollingResult.pending.length)
        )
        this.buildDaemonDiagnosticRow(
          $r('app.string.agent_home_daemon_fleet_plan_excluded'),
          String(this.daemonFleetRollingResult.excluded.length)
        )
        this.buildDaemonDiagnosticRow(
          $r('app.string.agent_home_daemon_fleet_plan_completed'),
          String(this.daemonFleetRollingResult.completed.length)
        )
        this.buildDaemonDiagnosticRow(
          $r('app.string.agent_home_daemon_fleet_plan_failed'),
          String(this.daemonFleetRollingResult.failed.length)
        )
        if (this.daemonFleetRollingResult.status === 'interrupted') {
          Text($r('app.string.agent_home_daemon_fleet_interrupted'))
            .width('100%')
            .fontSize(11)
            .fontColor($r('app.color.button_warning'))
          Text($r('app.string.agent_home_daemon_fleet_interrupted_remediation'))
            .width('100%')
            .fontSize(10)
            .fontColor($r('app.color.text_secondary'))
        }
        if (this.daemonFleetRollingResult.status === 'preview' && this.daemonFleetRollingResult.pending.length > 0) {
          Button($r('app.string.agent_home_daemon_fleet_execute'))
            .width('100%')
            .height(34)
            .fontSize(11)
            .borderRadius(8)
            .backgroundColor($r('app.color.button_primary'))
            .fontColor($r('app.color.text_white'))
            .enabled(!this.daemonFleetBusy)
            .onClick((): void => {
              this.confirmDaemonFleetRollingOperation();
            })
        }
      }
    }
    .width('100%')
    .padding(8)
    .backgroundColor($r('app.color.background_surface'))
    .borderRadius(10)
  }

  @Builder
  private buildDaemonFleetSummary(): void {
    Column({ space: 3 }) {
      this.buildDaemonDiagnosticRow(
        $r('app.string.agent_home_daemon_fleet_summary'),
        String(this.daemonFleetSummary.total)
      )
      this.buildDaemonDiagnosticRow(
        $r('app.string.agent_home_daemon_fleet_health'),
        this.daemonFleetHealthSummaryText()
      )
      this.buildDaemonDiagnosticRow(
        $r('app.string.agent_home_daemon_fleet_versions'),
        this.daemonFleetDistributionText(this.daemonFleetSummary.bridgeVersions)
      )
      this.buildDaemonDiagnosticRow(
        $r('app.string.agent_home_daemon_fleet_config_versions'),
        this.daemonFleetDistributionText(this.daemonFleetSummary.configVersions)
      )
      this.buildDaemonDiagnosticRow(
        $r('app.string.agent_home_daemon_fleet_warnings'),
        String(this.daemonFleetSummary.warningCount)
