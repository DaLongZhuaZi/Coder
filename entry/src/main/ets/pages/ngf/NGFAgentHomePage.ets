  private applyWorkspaceRegistrySuggestion(item: AgentBridgeWorkspaceSuggestionRecord): void {
    this.workspacePathDraft = item.path;
    this.workspaceTitleDraft = item.displayName.length > 0 ? item.displayName : this.lastPathSegment(item.path);
  }

  private bridgeWorkspaceIdForPath(path: string): string {
    const record = this.findBridgeWorkspaceRecordForPath(path);
    if (record !== null) {
      return record.workspaceId;
    }
    return '';
  }

  private findBridgeWorkspaceRecordForPath(path: string): AgentBridgeWorkspaceRecord | null {
    for (let index = 0; index < this.bridgeWorkspaceRecords.length; index++) {
      const item = this.bridgeWorkspaceRecords[index];
      if (this.workspacePathEquals(item.cwd, path) || this.workspacePathEquals(item.workspacePath, path)) {
        return item;
      }
    }
    return null;
  }

  private findBridgeWorkspaceRecordForLocalWorkspace(workspace: AgentHomeWorkspaceItem): AgentBridgeWorkspaceRecord | null {
    for (let index = 0; index < this.bridgeWorkspaceRecords.length; index++) {
      const item = this.bridgeWorkspaceRecords[index];
      const localWorkspaceId = this.localWorkspaceIdForBridgeWorkspace(item.workspaceId, item.cwd);
      if (localWorkspaceId === workspace.id || this.workspacePathEquals(item.cwd, workspace.subtitle)) {
        return item;
      }
    }
    return null;
  }

  private workspaceRegistryResultWorkspaceId(result: AgentBridgeWorkspaceRegistryResult): string {
    if (result.workspaceId.length > 0) {
      return result.workspaceId;
    }
    if (result.workspace.workspaceId.length > 0) {
      return result.workspace.workspaceId;
    }
    if (result.duplicateOfWorkspaceId.length > 0) {
      return result.duplicateOfWorkspaceId;
    }
    return this.bridgeWorkspaceIdForPath(this.workspaceRegistryResultPath(result));
  }

  private workspaceRegistryResultPath(result: AgentBridgeWorkspaceRegistryResult): string {
    if (result.workspacePath.length > 0) {
      return result.workspacePath;
    }
    if (result.cwd.length > 0) {
      return result.cwd;
    }
    if (result.workspace.cwd.length > 0) {
      return result.workspace.cwd;
    }
    if (result.workspace.workspacePath.length > 0) {
      return result.workspace.workspacePath;
    }
    return this.workspacePathDraft.trim();
  }

  private workspaceRegistryResultTitle(result: AgentBridgeWorkspaceRegistryResult): string {
    if (result.workspace.title.length > 0) {
      return result.workspace.title;
    }
    if (result.workspace.displayName.length > 0) {
      return result.workspace.displayName;
    }
    const draftTitle = this.workspaceTitleDraft.trim();
    if (draftTitle.length > 0) {
      return draftTitle;
    }
    return this.lastPathSegment(this.workspaceRegistryResultPath(result));
  }

  private workspaceRegistryResultStatusText(result: AgentBridgeWorkspaceRegistryResult): string {
    const hostContext = this.getUIContext().getHostContext();
    let prefix = resolveResourceString(hostContext, $r('app.string.agent_home_workspace_registry_done'));
    if (!result.ok) {
      prefix = resolveResourceString(hostContext, $r('app.string.agent_home_workspace_registry_failed'));
    } else if (result.preview && result.action === 'workspace.registry.open') {
      prefix = resolveResourceString(hostContext, $r('app.string.agent_home_workspace_registry_open_preview_ready'));
    } else if (result.preview && result.action === 'workspace.registry.archive') {
      prefix = resolveResourceString(hostContext, $r('app.string.agent_home_workspace_registry_archive_preview_ready'));
