          Button($r('app.string.agent_home_runtime_file_transfer_upload'))
            .height(36)
            .fontSize(11)
            .borderRadius(9)
            .backgroundColor(this.agentHomeSolidControlBackgroundColor())
            .enabled(this.uploadLocalPathDraft.trim().length > 0 && this.uploadTargetPathDraft.trim().length > 0)
            .onClick((): void => {
              this.uploadDraftFileToWorkspace().catch((error: Error): void => {
