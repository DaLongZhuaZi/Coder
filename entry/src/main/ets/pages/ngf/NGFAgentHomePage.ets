  private isBridgeWorkspaceRegistryResult(source: string): boolean {
    if (source.indexOf('"action":"workspace.registry.') >= 0) {
      return true;
    }
    return source.indexOf('"workspace.registry.') >= 0 &&
      (source.indexOf('"projects":[') >= 0 ||
        source.indexOf('"workspaces":[') >= 0 ||
        source.indexOf('"suggestions":[') >= 0 ||
        source.indexOf('"checks":[') >= 0 ||
        source.indexOf('"validation":{') >= 0);
  }

  private applyBridgeWorkspaceRegistryResult(result: AgentBridgeWorkspaceRegistryResult): void {
    if (!this.canUseBridgeWorkspaceRegistry() || result.action.length === 0) {
      return;
    }
    this.lastWorkspaceRegistryResult = result;
    if (result.projects.length > 0 || result.action === 'workspace.registry.list') {
      this.bridgeProjectRecords = result.projects;
      if (result.projects.length > 0) {
        this.applyBridgeProjectRegistry(result.projects);
      }
    }
    if (result.workspaces.length > 0 || result.action === 'workspace.registry.list') {
      this.bridgeWorkspaceRecords = result.workspaces;
      if (result.workspaces.length > 0) {
        this.applyBridgeWorkspaceRegistry(result.workspaces);
      }
    }
    if (result.suggestions.length > 0 || result.action === 'workspace.registry.suggestions' || result.action === 'workspace.registry.list') {
      this.workspaceRegistrySuggestions = result.suggestions;
    }
    if (result.checks.length > 0 || result.action === 'workspace.registry.doctor' || result.action === 'workspace.registry.list') {
      this.workspaceRegistryDoctorChecks = result.checks;
    }
    if (result.workspace.workspaceId.length > 0) {
      this.upsertBridgeWorkspaceRecord(result.workspace);
      if (this.hasTrustedBridgeV2Server()) {
        const records: Array<AgentBridgeWorkspaceRecord> = [];
        records.push(result.workspace);
        this.persistence.saveWorkspaceRecords(this.activeDeviceId, this.currentBridgeServerId, records).catch((error: Error): void => {
          logger.error(TAG, 'persist workspace registry action result failed: ' + this.errorToString(error));
        });
      }
      if (result.confirmed && result.action !== 'workspace.registry.archive') {
        this.projectBridgeWorkspaceRecord(result.workspace);
      }
    }
    if (result.preview && result.validation.ok) {
      this.handleWorkspaceRegistryPreviewResult(result);
      return;
    }
    this.showTransientStatus(this.workspaceRegistryResultStatusText(result));
  }

  private upsertBridgeWorkspaceRecord(record: AgentBridgeWorkspaceRecord): void {
    if (record.workspaceId.length === 0) {
      return;
    }
    const items: Array<AgentBridgeWorkspaceRecord> = [];
    let replaced = false;
    for (let index = 0; index < this.bridgeWorkspaceRecords.length; index++) {
      const item = this.bridgeWorkspaceRecords[index];
      if (item.workspaceId === record.workspaceId) {
        items.push(record);
        replaced = true;
      } else {
        items.push(item);
      }
    }
    if (!replaced) {
      items.push(record);
    }
    this.bridgeWorkspaceRecords = items;
  }

