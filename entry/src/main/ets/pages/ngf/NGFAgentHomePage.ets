    }
    if (group.id === 'queue') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_diagnostics_group_queue'));
    }
    if (group.id === 'usage') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_diagnostics_group_usage'));
    }
    if (group.id === 'secureStorage') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_diagnostics_group_secure_storage'));
    }
    if (group.id === 'remoteConfig') {
