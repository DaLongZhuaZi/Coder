  @Builder
  private buildWorkspaceDiffTruncationNotice(): void {
    if (this.activeWorkspaceDiffIsTruncated()) {
      Row({ space: 6 }) {
        SymbolGlyph($r('sys.symbol.exclamationmark_triangle'))
          .fontSize(14)
          .fontColor([$r('app.color.tag_amber')])
        Text($r('app.string.agent_home_workspace_diff_truncated_notice'))
          .fontSize(10)
          .fontColor($r('app.color.tag_amber'))
          .layoutWeight(1)
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
        if (this.activeWorkspaceDiffTruncationReason().length > 0) {
          Text($r('app.string.agent_home_workspace_diff_truncation_reason'))
            .fontSize(9)
            .fontColor($r('app.color.text_secondary'))
          Text(this.activeWorkspaceDiffTruncationReason())
            .fontSize(9)
            .fontColor($r('app.color.text_secondary'))
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
      }
      .width('100%')
      .padding({ left: 8, right: 8, top: 6, bottom: 2 })
    }
  }

  private activeWorkspaceDiffIsTruncated(): boolean {
    const item = this.activeWorkspaceChange();
    return item !== null && item.diffTruncated;
  }

  private activeWorkspaceDiffTruncationReason(): string {
    const item = this.activeWorkspaceChange();
    return item === null ? '' : item.diffTruncationReason;
  }

