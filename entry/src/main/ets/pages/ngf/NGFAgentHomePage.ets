  private resetChatRoomDraft(): void {
    this.selectedChatRoomId = '';
    this.chatRoomNameDraft = '';
    this.chatRoomPurposeDraft = '';
    this.chatRoomMessageDraft = '';
    this.chatRoomAgentIdDraft = '';
    this.chatRoomMentionMemberId = '';
    this.chatRoomReplyMessageId = '';
    this.chatRoomClientMessageId = '';
    this.chatRoomMessages = [];
  }

  private selectChatRoom(item: AgentBridgeChatRoom): void {
    this.selectedChatRoomId = item.id;
    this.chatRoomNameDraft = item.name;
    this.chatRoomPurposeDraft = item.purpose;
    this.chatRoomMentionMemberId = '';
    this.chatRoomReplyMessageId = '';
    this.client.getChatRoom(item.id);
