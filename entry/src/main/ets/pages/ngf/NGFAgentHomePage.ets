        .onClick((): void => {
          this.refreshRelayState();
        })
        Button() {
          Row({ space: 5 }) {
            SymbolGlyph($r('sys.symbol.qrcode'))
              .fontSize(14)
              .fontColor([$r('app.color.text_body')])
            Text($r('app.string.agent_home_relay_pairing_start'))
              .fontSize(11)
              .fontColor($r('app.color.text_body'))
          }
        }
        .layoutWeight(1)
        .height(36)
        .borderRadius(9)
        .backgroundColor($r('app.color.background_surface'))
        .enabled(!this.relayOperationBusy && this.isRelayUrlDraftValid())
        .onClick((): void => {
          this.startRelayPairingOffer();
        })
