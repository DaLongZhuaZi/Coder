                  this.applyMetadataSuggestion();
                })
                Button($r('app.string.agent_home_metadata_copy')).onClick((): void => {
                  this.copyTextToPasteboard(this.metadataSuggestionDraft);
                })
                Button($r('app.string.agent_home_metadata_cancel')).onClick((): void => {
                  this.cancelPendingMetadataGeneration();
                  this.metadataSuggestionDraft = '';
                })
              }
              if (this.supportsMetadataGeneration()) {
                Row({ space: 6 }) {
                  Button($r('app.string.agent_home_metadata_branch')).onClick((): void => { this.requestMetadataSuggestion('branchName'); })
                  Button($r('app.string.agent_home_metadata_commit')).onClick((): void => { this.requestMetadataSuggestion('commitMessage'); })
                  Button($r('app.string.agent_home_metadata_pr')).onClick((): void => { this.requestMetadataSuggestion('pullRequest'); })
                }
              }
            }
          }
          .width('100%')
          .padding(12)
          .backgroundColor($r('app.color.background_surface'))
          .borderRadius(12)
          .border({ width: 1, color: $r('app.color.card_border') })
        }
        .width('100%')
        .padding({ bottom: this.bottomInsetVp + 12 })
      }
      .width('100%')
      .layoutWeight(1)
      .scrollBar(BarState.Off)
    }
    .width('100%')
    .height('100%')
    .padding({ left: 20, right: 20, top: 10 })
    .backgroundColor(Color.Transparent)
    .backgroundEffect(this.agentHomeSurfaceBackgroundEffect())
    .border({
