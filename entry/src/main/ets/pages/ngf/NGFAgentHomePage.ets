  private confirmWorkspaceRegistryImportFromPreview(result: AgentBridgeWorkspaceRegistryResult): void {
    const path = this.workspaceRegistryResultPath(result);
    if (path.length === 0) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_workspace_path_empty')));
      return;
    }
    const title = this.workspaceRegistryResultTitle(result);
    const workspaceId = this.workspaceRegistryResultWorkspaceId(result);
    if (result.action === 'workspace.registry.create') {
      this.client.createWorkspaceRegistry(workspaceId, path, title, false, true);
    } else {
      this.client.importWorkspaceRegistry(workspaceId, path, title, false, true);
    }
    this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_workspace_registry_confirm_requested')));
  }

