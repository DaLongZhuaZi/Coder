  private isReasoningExpanded(messageId: string): boolean {
    for (let index = 0; index < this.expandedReasoningMessageIds.length; index++) {
      if (this.expandedReasoningMessageIds[index] === messageId) {
        return true;
      }
    }
    return false;
  }

  private reasoningViewportHeight(messageId: string): number {
    return this.isReasoningExpanded(messageId) ? AGENT_HOME_REASONING_EXPANDED_HEIGHT : AGENT_HOME_REASONING_COLLAPSED_HEIGHT;
  }

  private reasoningMaxLines(messageId: string): number {
    return this.isReasoningExpanded(messageId) ? 60 : 1;
  }

  private toggleReasoningExpansion(messageId: string): void {
    this.setReasoningExpansion(messageId, !this.isReasoningExpanded(messageId), true);
  }

  private expandReasoningMessage(messageId: string): void {
    if (this.isReasoningExpanded(messageId)) {
      return;
    }
    this.setReasoningExpansion(messageId, true, false);
  }

  private collapseReasoningMessage(messageId: string): void {
    if (!this.isReasoningExpanded(messageId)) {
      return;
    }
    this.setReasoningExpansion(messageId, false, true);
  }

  private collapseReasoningForCurrentSession(): void {
    for (let index = this.messages.length - 1; index >= 0; index--) {
      const item = this.messages[index];
      if (
        item.sessionId === this.activeSessionId &&
          item.role === AgentHomeMessageRole.ASSISTANT &&
          item.reasoningText.length > 0
      ) {
        this.collapseReasoningMessage(item.id);
      }
    }
  }

  private setReasoningExpansion(messageId: string, expanded: boolean, animated: boolean): void {
    const updater = (): void => {
      const nextIds: Array<string> = [];
      let found = false;
      for (let index = 0; index < this.expandedReasoningMessageIds.length; index++) {
        const itemId = this.expandedReasoningMessageIds[index];
        if (itemId === messageId) {
          found = true;
          if (expanded) {
            nextIds.push(itemId);
          }
        } else {
          nextIds.push(itemId);
        }
      }
      if (expanded && !found) {
        nextIds.push(messageId);
      }
      this.expandedReasoningMessageIds = nextIds;
    };
    if (animated) {
      this.animateTransientState(220, Curve.EaseInOut, updater);
      return;
    }
    updater();
  }

  private showTransientStatus(text: string): void {
    const normalized = this.normalizeTransientStatusText(text);
    if (normalized.length === 0) {
      return;
    }
    this.clearTransientStatusTimer();
    this.transientStatusSequence = this.transientStatusSequence + 1;
    const sequence = this.transientStatusSequence;
    this.transientStatusText = normalized;
    this.transientStatusVisible = true;
    this.animateTransientState(180, Curve.EaseOut, (): void => {
      this.transientStatusOpacity = 1;
    });
    this.transientStatusTimer = setTimeout((): void => {
      if (this.transientStatusSequence === sequence) {
        this.hideTransientStatus();
      }
    }, 3200);
  }

  private hideTransientStatus(): void {
    this.clearTransientStatusTimer();
    this.animateTransientState(220, Curve.EaseOut, (): void => {
      this.transientStatusOpacity = 0;
    });
    const sequence = this.transientStatusSequence;
    this.transientStatusTimer = setTimeout((): void => {
      if (this.transientStatusSequence === sequence) {
        this.transientStatusVisible = false;
        this.transientStatusText = '';
        this.transientStatusTimer = -1;
      }
    }, 240);
  }

  private clearTransientStatusTimer(): void {
    if (this.transientStatusTimer >= 0) {
      clearTimeout(this.transientStatusTimer);
      this.transientStatusTimer = -1;
    }
  }

  private beginConversationRenderTransition(sessionId: string): void {
    if (sessionId.length === 0) {
      return;
    }
    this.clearConversationRenderTimers();
    this.conversationRenderSequence = this.conversationRenderSequence + 1;
    const sequence = this.conversationRenderSequence;
    this.conversationRenderSessionId = sessionId;
    this.isConversationRenderPending = true;
    this.animateTransientState(AGENT_HOME_CONVERSATION_RENDER_FADE_MS, Curve.EaseOut, (): void => {
      this.conversationRenderOverlayOpacity = 1;
    });
    this.conversationRenderTimeoutTimer = setTimeout((): void => {
      if (this.conversationRenderSequence === sequence) {
        this.hideConversationRenderTransition(sequence);
      }
    }, AGENT_HOME_CONVERSATION_RENDER_TIMEOUT_MS);
  }

  private scheduleConversationRenderReady(sessionId: string): void {
    if (!this.isConversationRenderPending) {
      return;
    }
    if (this.conversationRenderSessionId.length > 0 && this.conversationRenderSessionId !== sessionId) {
      return;
    }
    if (this.conversationRenderSettleTimer >= 0) {
      clearTimeout(this.conversationRenderSettleTimer);
      this.conversationRenderSettleTimer = -1;
    }
    const sequence = this.conversationRenderSequence;
    this.conversationRenderSettleTimer = setTimeout((): void => {
      if (this.conversationRenderSequence === sequence) {
        this.hideConversationRenderTransition(sequence);
      }
    }, AGENT_HOME_CONVERSATION_RENDER_SETTLE_MS);
  }

  private hideConversationRenderTransition(sequence: number): void {
    if (this.conversationRenderSequence !== sequence) {
      return;
    }
    if (this.conversationRenderTimeoutTimer >= 0) {
      clearTimeout(this.conversationRenderTimeoutTimer);
      this.conversationRenderTimeoutTimer = -1;
    }
    if (this.conversationRenderSettleTimer >= 0) {
      clearTimeout(this.conversationRenderSettleTimer);
      this.conversationRenderSettleTimer = -1;
    }
    this.animateTransientState(AGENT_HOME_CONVERSATION_RENDER_FADE_MS, Curve.EaseOut, (): void => {
      this.conversationRenderOverlayOpacity = 0;
    });
    this.conversationRenderSettleTimer = setTimeout((): void => {
      if (this.conversationRenderSequence === sequence) {
        this.isConversationRenderPending = false;
        this.conversationRenderSessionId = '';
        this.conversationRenderSettleTimer = -1;
      }
    }, AGENT_HOME_CONVERSATION_RENDER_FADE_MS + 40);
  }

  private clearConversationRenderTimers(): void {
    if (this.conversationRenderSettleTimer >= 0) {
      clearTimeout(this.conversationRenderSettleTimer);
      this.conversationRenderSettleTimer = -1;
    }
    if (this.conversationRenderTimeoutTimer >= 0) {
      clearTimeout(this.conversationRenderTimeoutTimer);
      this.conversationRenderTimeoutTimer = -1;
    }
  }

  private handleConversationScroll(yOffset: number): void {
    if (this.isConversationProgrammaticScroll) {
      return;
    }
    const distance = Math.abs(yOffset);
    if (distance <= 0) {
      return;
    }
    this.conversationAwayFromBottomDistance = this.conversationAwayFromBottomDistance + distance;
    if (this.conversationAwayFromBottomDistance >= AGENT_HOME_CONVERSATION_BOTTOM_BUTTON_THRESHOLD) {
      this.showConversationBottomButton = true;
    }
    this.collapseComposerToCompact();
  }

  private scheduleConversationScrollToBottom(animated: boolean): void {
    this.clearConversationAutoScrollTimer();
    this.conversationAutoScrollTimer = setTimeout((): void => {
      this.conversationAutoScrollTimer = -1;
      this.scrollConversationToBottom(animated);
      this.scheduleConversationScrollToBottomAfterContentSettle();
    }, 60);
  }

  private scheduleConversationScrollForNewContent(): void {
    if (!this.showConversationBottomButton) {
      this.scheduleConversationScrollToBottom(true);
    }
  }

  private finishBridgeReplyUiUpdate(): void {
    this.resetConversationBottomButtonState();
    this.scheduleConversationScrollToBottom(true);
  }

  private scheduleConversationScrollToBottomAfterContentSettle(): void {
    if (this.showConversationBottomButton) {
      return;
    }
    this.conversationAutoScrollTimer = setTimeout((): void => {
      this.conversationAutoScrollTimer = -1;
      if (!this.showConversationBottomButton) {
        this.scrollConversationToBottom(false);
      }
    }, 260);
  }

  private scrollConversationToBottom(animated: boolean): void {
    this.beginConversationProgrammaticScrollGuard();
    this.resetConversationBottomButtonState();
    try {
      if (animated) {
        this.conversationScroller.scrollEdge(Edge.Bottom);
      } else {
        this.conversationScroller.scrollEdge(Edge.Bottom);
      }
    } catch (error) {
      logger.warn(TAG, 'scroll conversation to bottom failed: ' + this.errorToString(error));
    }
  }

  private resetConversationBottomButtonState(): void {
    this.showConversationBottomButton = false;
    this.conversationAwayFromBottomDistance = 0;
  }

  private beginConversationProgrammaticScrollGuard(): void {
    this.clearConversationScrollGuardTimer();
    this.isConversationProgrammaticScroll = true;
    this.conversationScrollGuardTimer = setTimeout((): void => {
      this.isConversationProgrammaticScroll = false;
      this.conversationScrollGuardTimer = -1;
    }, AGENT_HOME_CONVERSATION_SCROLL_GUARD_MS);
  }

  private clearConversationScrollGuardTimer(): void {
    if (this.conversationScrollGuardTimer >= 0) {
      clearTimeout(this.conversationScrollGuardTimer);
      this.conversationScrollGuardTimer = -1;
    }
    this.isConversationProgrammaticScroll = false;
  }

  private clearConversationAutoScrollTimer(): void {
    if (this.conversationAutoScrollTimer >= 0) {
      clearTimeout(this.conversationAutoScrollTimer);
      this.conversationAutoScrollTimer = -1;
    }
  }

  private startActiveTurnTimer(): void {
    if (this.activeTurnStartedAt <= 0) {
      this.activeTurnStartedAt = Date.now();
    }
    this.activeTurnTimerVisible = true;
    this.updateActiveTurnElapsedText();
    if (this.activeTurnTimer >= 0) {
      return;
    }
    this.activeTurnTimer = setInterval((): void => {
      this.updateActiveTurnElapsedText();
    }, 1000);
  }

  private stopActiveTurnTimer(): void {
    if (this.activeTurnTimer >= 0) {
      clearInterval(this.activeTurnTimer);
      this.activeTurnTimer = -1;
    }
    this.clearActiveTurnWatchdog();
    this.activeTurnStartedAt = 0;
    this.assistantResponseStartedAt = 0;
    this.activeTurnLastActivityAt = 0;
    this.activeTurnElapsedText = '';
    this.activeTurnTimerVisible = false;
  }

  private startSessionStatusPulse(): void {
    if (this.sessionStatusPulseTimer >= 0) {
      return;
    }
    this.sessionStatusPulseTimer = setInterval((): void => {
      const nextValue = this.sessionStatusPulseValue > 0 ? 0 : 1;
      const uiContext = this.getUIContext();
      if (uiContext) {
        uiContext.animateTo({ duration: 820, curve: Curve.EaseInOut }, (): void => {
          this.sessionStatusPulseValue = nextValue;
        });
      } else {
        this.sessionStatusPulseValue = nextValue;
      }
    }, 920);
  }

  private clearSessionStatusPulse(): void {
    if (this.sessionStatusPulseTimer >= 0) {
      clearInterval(this.sessionStatusPulseTimer);
      this.sessionStatusPulseTimer = -1;
    }
    this.sessionStatusPulseValue = 0;
  }

  private markActiveTurnActivity(): void {
    this.activeTurnLastActivityAt = Date.now();
    this.startActiveTurnWatchdog();
  }

  private startActiveTurnWatchdog(): void {
    if (this.activeTurnWatchdogTimer >= 0) {
      return;
    }
    this.activeTurnWatchdogTimer = setInterval((): void => {
      this.handleActiveTurnWatchdogTick();
    }, AGENT_HOME_REPLY_STALL_CHECK_MS);
  }

  private clearActiveTurnWatchdog(): void {
    if (this.activeTurnWatchdogTimer >= 0) {
      clearInterval(this.activeTurnWatchdogTimer);
      this.activeTurnWatchdogTimer = -1;
    }
  }

  private handleActiveTurnWatchdogTick(): void {
    if (!this.isReplyInProgress()) {
      this.clearActiveTurnWatchdog();
      return;
    }
    if (this.activeTurnLastActivityAt <= 0) {
      this.activeTurnLastActivityAt = this.activeTurnStartedAt > 0 ? this.activeTurnStartedAt : Date.now();
      return;
    }
    const elapsedMs = Date.now() - this.activeTurnLastActivityAt;
    if (elapsedMs < AGENT_HOME_REPLY_STALL_TIMEOUT_MS) {
      return;
    }
    this.finishStalledActiveTurn(elapsedMs);
  }

  private finishStalledActiveTurn(elapsedMs: number): void {
    const message = this.buildStalledReplyText(elapsedMs);
    logger.warn(
      TAG,
      'bridge active session stalled: sessionId=' + this.currentBridgeSessionId() +
        ', elapsedMs=' + String(elapsedMs) +
        ', activeTool=' + this.activeToolName
    );
    this.markActiveSessionRunningToolsFailed(message);
    this.addMessage(AgentHomeMessageRole.STATUS, '', message, '');
    this.replyState = AgentHomeReplyState.IDLE;
    this.activeToolName = '';
    this.activeSubagentName = '';
    this.publishAgentTaskErrorNotification(message);
    this.stopActiveTurnTimer();
    this.stopContextCompactionStatus();
    this.resetActiveAssistantStream();
    this.showTransientStatus(message);
  }

  private buildStalledReplyText(elapsedMs: number): string {
    const elapsedSeconds = Math.max(0, Math.floor(elapsedMs / 1000));
    return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_reply_stalled')) +
      ' ' + this.formatElapsedSeconds(elapsedSeconds);
  }

  private updateActiveTurnElapsedText(): void {
    if (this.activeTurnStartedAt <= 0) {
      this.activeTurnElapsedText = '';
      return;
    }
    const elapsedSeconds = Math.max(0, Math.floor((Date.now() - this.activeTurnStartedAt) / 1000));
    this.activeTurnElapsedText = this.formatElapsedSeconds(elapsedSeconds);
  }

  private formatElapsedSeconds(totalSeconds: number): string {
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    if (hours > 0) {
      return String(hours) + 'h ' + String(minutes) + 'm ' + String(seconds) + 's';
    }
    if (minutes > 0) {
      return String(minutes) + 'm ' + String(seconds) + 's';
    }
    return String(seconds) + 's';
  }

  private publishAgentTaskRunningNotification(detail: string): void {
    this.agentTaskNotificationActive = true;
    this.ensureAgentTaskNotificationKey();
    this.startAgentContinuousTask();
    const title = this.resolveAgentNotificationString($r('app.string.agent_home_notification_running_title'));
    const baseContent = detail.length > 0 ? detail :
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_running_content'));
    this.publishAgentNotification(
      AGENT_HOME_AGENT_TASK_NOTIFICATION_ID,
      title,
      this.buildAgentNotificationContent(baseContent, ''),
      true,
      true
    );
  }

  private publishAgentTaskToolNotification(toolName: string): void {
    const baseContent = this.resolveAgentNotificationString($r('app.string.agent_home_notification_tool_content'));
    const detail = toolName.length > 0 ? toolName : this.resolveAgentNotificationString($r('app.string.agent_home_status_tool'));
    this.publishAgentTaskRunningNotification(baseContent + ': ' + detail);
  }

  private publishAgentTaskWaitingNotification(detail: string, sessionId: string): void {
    this.agentTaskNotificationActive = true;
    this.ensureAgentTaskNotificationKey();
    this.startAgentContinuousTask();
    this.publishAgentNotification(
      AGENT_HOME_AGENT_TASK_NOTIFICATION_ID,
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_waiting_title')),
      this.buildAgentNotificationContent(detail, ''),
      true,
      true,
      sessionId
    );
  }

  private publishAgentTaskCompletedNotification(): void {
    if (!this.shouldPublishAgentTaskEndNotification()) {
      return;
    }
    const elapsedText = this.activeTurnElapsedText;
    const baseContent = this.resolveAgentNotificationString($r('app.string.agent_home_notification_completed_content'));
    const detail = elapsedText.length > 0 ?
      this.resolveAgentNotificationString($r('app.string.agent_home_status_elapsed')) + ': ' + elapsedText :
      '';
    const routeSessionId = this.agentTaskNotificationSessionId;
    this.agentTaskNotificationActive = false;
    this.agentTaskNotificationKey = '';
    this.agentTaskNotificationSessionId = '';
    this.stopAgentContinuousTask();
    this.cancelAgentRequestNotification();
    if (this.canUseBridgeOfflineNotifications()) {
      ngfSystemNotificationManager.cancel(AGENT_HOME_AGENT_TASK_NOTIFICATION_ID).catch((error: Error): void => {
        logger.warn(TAG, 'cancel completed agent task notification failed: ' + this.errorToString(error));
      });
      return;
    }
    this.publishAgentNotification(
      AGENT_HOME_AGENT_TASK_NOTIFICATION_ID,
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_completed_title')),
      this.buildAgentNotificationContent(baseContent, detail),
      false,
      false,
      routeSessionId
    );
  }

  private publishAgentTaskInterruptedNotification(message: string): void {
    if (!this.shouldPublishAgentTaskEndNotification()) {
      return;
    }
    const content = message.length > 0 ? message :
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_interrupted_content'));
    const routeSessionId = this.agentTaskNotificationSessionId;
    this.agentTaskNotificationActive = false;
    this.agentTaskNotificationKey = '';
    this.agentTaskNotificationSessionId = '';
    this.stopAgentContinuousTask();
    this.cancelAgentRequestNotification();
    this.publishAgentNotification(
      AGENT_HOME_AGENT_TASK_NOTIFICATION_ID,
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_interrupted_title')),
      this.buildAgentNotificationContent(content, ''),
      false,
      false,
      routeSessionId
    );
  }

  private publishAgentTaskErrorNotification(message: string): void {
    if (!this.shouldPublishAgentTaskEndNotification()) {
      return;
    }
    const content = message.length > 0 ? message :
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_error_content'));
    const routeSessionId = this.agentTaskNotificationSessionId;
    this.agentTaskNotificationActive = false;
    this.agentTaskNotificationKey = '';
    this.agentTaskNotificationSessionId = '';
    this.stopAgentContinuousTask();
    this.cancelAgentRequestNotification();
    this.publishAgentNotification(
      AGENT_HOME_AGENT_TASK_NOTIFICATION_ID,
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_error_title')),
      this.buildAgentNotificationContent(content, ''),
      false,
      false,
      routeSessionId
    );
  }

  private publishAgentUserRequestNotification(item: AgentHomeUserRequestItem): void {
    if (item.status !== AgentHomeInteractionStatus.PENDING) {
      this.cancelAgentRequestNotification();
      return;
    }
    const title = item.title.length > 0 ? item.title :
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_waiting_title'));
    const baseContent = this.isPermissionRequest(item) ?
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_permission_content')) :
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_request_content'));
    const detail = item.prompt.length > 0 ? item.prompt : title;
    this.activeRequestNotificationKey = item.sessionId + ':' + item.requestId;
    if (!this.canUseBridgeOfflineNotifications()) {
      this.publishAgentRequestNotification(
        this.activeRequestNotificationKey,
        title,
        this.buildAgentNotificationContent(baseContent, detail),
        AgentHomeNotificationTapAction.OPEN_REQUEST,
        this.buildAgentNotificationRoutePayload(item.sessionId, item.requestId, '')
      );
    }
    this.publishAgentTaskWaitingNotification(baseContent + ': ' + detail, item.sessionId);
  }

  private publishAgentPlanRequestNotification(item: AgentHomePlanItem): void {
    if (item.status !== AgentHomeInteractionStatus.PENDING) {
      this.cancelAgentRequestNotification();
      return;
    }
    const title = item.title.length > 0 ? item.title :
      this.resolveAgentNotificationString($r('app.string.agent_home_plan_title'));
    const baseContent = this.resolveAgentNotificationString($r('app.string.agent_home_notification_plan_content'));
    const detail = item.content.length > 0 ? item.content : title;
    this.activeRequestNotificationKey = item.sessionId + ':' + item.planId;
    if (!this.canUseBridgeOfflineNotifications()) {
      this.publishAgentRequestNotification(
        this.activeRequestNotificationKey,
        title,
        this.buildAgentNotificationContent(baseContent, detail),
        AgentHomeNotificationTapAction.OPEN_PLAN,
        this.buildAgentNotificationRoutePayload(
          item.sessionId,
          '',
          item.planId.length > 0 ? item.planId : item.id
        )
      );
    }
    this.publishAgentTaskWaitingNotification(baseContent + ': ' + detail, item.sessionId);
  }

  private cancelAgentRequestNotification(): void {
    if (this.activeRequestNotificationKey.length === 0) {
      return;
    }
    this.activeRequestNotificationKey = '';
    ngfSystemNotificationManager.cancel(AGENT_HOME_AGENT_REQUEST_NOTIFICATION_ID).catch((error: Error): void => {
      logger.warn(TAG, 'cancel agent request notification failed: ' + this.errorToString(error));
    });
  }

  private publishAgentNotification(
    id: number,
    title: string,
    content: string,
    isOngoing: boolean,
    isAlertOnce: boolean,
    routeSessionId: string = ''
  ): void {
    const safeTitle = title.length > 0 ? title : this.resolveAgentNotificationString($r('app.string.EntryAbility_label'));
    const safeContent = content.length > 0 ? content : safeTitle;
    const request = new NGFNotificationRequest(
      id,
      this.compactAgentNotificationText(safeTitle),
      this.compactAgentNotificationText(safeContent),
      NGFNotificationType.BASIC,
      0,
      0,
      isOngoing,
      isAlertOnce
    );
    const targetSessionId = routeSessionId.length > 0 ?
      routeSessionId :
      (this.agentTaskNotificationSessionId.length > 0 ? this.agentTaskNotificationSessionId : this.activeSessionId);
    if (targetSessionId.length > 0) {
      request.tapAction = AgentHomeNotificationTapAction.OPEN_SESSION;
      request.tapPayloadJson = this.buildAgentNotificationRoutePayload(targetSessionId, '', '');
    }
    this.ensureAgentNotificationPermission().then((enabled: boolean): void => {
      if (!enabled) {
        return;
      }
      ngfSystemNotificationManager.publish(request).catch((error: Error): void => {
        logger.error(TAG, 'publish agent notification failed: ' + this.errorToString(error));
      });
    }).catch((error: Error): void => {
      logger.error(TAG, 'request agent notification permission failed: ' + this.errorToString(error));
    });
  }

  private startAgentContinuousTask(): void {
    if (this.agentContinuousTaskActive || this.agentContinuousTaskPending) {
      return;
    }
    this.ensureAgentTaskNotificationKey();
    this.agentContinuousTaskPending = true;
    this.agentContinuousTaskStopRequested = false;
    const taskId = this.agentTaskNotificationKey.length > 0 ?
      this.agentTaskNotificationKey :
      'agent_task_' + String(Date.now());
    this.agentContinuousTaskId = taskId;
    ngfBackgroundTaskManager.startContinuousTask(
      taskId,
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_running_title')),
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_running_content'))
    ).then((enabled: boolean): void => {
      this.agentContinuousTaskPending = false;
      this.agentContinuousTaskActive = enabled;
      if (this.agentContinuousTaskStopRequested) {
        this.agentContinuousTaskStopRequested = false;
        if (enabled) {
          this.stopAgentContinuousTask();
        } else {
          this.agentContinuousTaskId = '';
        }
        return;
      }
      if (!enabled) {
        this.agentContinuousTaskId = '';
      }
    }).catch((error: Error): void => {
      this.agentContinuousTaskPending = false;
      this.agentContinuousTaskActive = false;
      this.agentContinuousTaskStopRequested = false;
      this.agentContinuousTaskId = '';
      logger.warn(TAG, 'start agent continuous task failed: ' + this.errorToString(error));
    });
  }

  private stopAgentContinuousTask(): void {
    if (this.agentContinuousTaskPending) {
      this.agentContinuousTaskStopRequested = true;
      return;
    }
    if (!this.agentContinuousTaskActive) {
      return;
    }
    this.agentContinuousTaskActive = false;
    this.agentContinuousTaskStopRequested = false;
    const taskId = this.agentContinuousTaskId;
    this.agentContinuousTaskId = '';
    ngfBackgroundTaskManager.stopContinuousTask(taskId).catch((error: Error): void => {
      logger.warn(TAG, 'stop agent continuous task failed: ' + this.errorToString(error));
    });
  }

  private publishAgentRequestNotification(
    expectedKey: string,
    title: string,
    content: string,
    tapAction: string,
    tapPayloadJson: string
  ): void {
    const safeTitle = title.length > 0 ? title :
      this.resolveAgentNotificationString($r('app.string.agent_home_notification_waiting_title'));
    const safeContent = content.length > 0 ? content : safeTitle;
    const request = new NGFNotificationRequest(
      AGENT_HOME_AGENT_REQUEST_NOTIFICATION_ID,
      this.compactAgentNotificationText(safeTitle),
      this.compactAgentNotificationText(safeContent),
      NGFNotificationType.BASIC,
      0,
      0,
      false
    );
    request.tapAction = tapAction;
    request.tapPayloadJson = tapPayloadJson;
    this.ensureAgentNotificationPermission().then((enabled: boolean): void => {
      if (!enabled || this.activeRequestNotificationKey !== expectedKey) {
        return;
      }
      ngfSystemNotificationManager.publish(request).catch((error: Error): void => {
        logger.error(TAG, 'publish agent request notification failed: ' + this.errorToString(error));
      });
    }).catch((error: Error): void => {
      logger.error(TAG, 'request agent notification permission failed: ' + this.errorToString(error));
    });
  }

  private ensureAgentNotificationPermission(): Promise<boolean> {
    if (this.agentNotificationPermissionChecked) {
      return Promise.resolve(this.agentNotificationPermissionEnabled);
    }
    const existingPending = this.agentNotificationPermissionPending;
    if (existingPending !== null) {
      return existingPending;
    }
    const pending = ngfSystemNotificationManager.requestPermission().then((enabled: boolean): boolean => {
      this.agentNotificationPermissionChecked = true;
      this.agentNotificationPermissionEnabled = enabled;
      this.agentNotificationPermissionPending = null;
      return enabled;
    }).catch((error: Error): boolean => {
      this.agentNotificationPermissionPending = null;
      this.agentNotificationPermissionEnabled = false;
      logger.error(TAG, 'request agent notification permission failed: ' + this.errorToString(error));
      return false;
    });
    this.agentNotificationPermissionPending = pending;
    return pending;
  }

  private shouldPublishAgentTaskEndNotification(): boolean {
    return this.agentTaskNotificationActive ||
      this.activeTurnTimerVisible ||
      this.replyState !== AgentHomeReplyState.IDLE;
  }

  private ensureAgentTaskNotificationKey(): void {
    if (this.agentTaskNotificationSessionId.length === 0 && this.activeSessionId.length > 0) {
      this.agentTaskNotificationSessionId = this.activeSessionId;
    }
    if (this.agentTaskNotificationKey.length > 0) {
      return;
    }
    this.agentTaskNotificationKey = this.activeSessionId + ':' + String(this.activeTurnStartedAt);
  }

  private buildAgentNotificationContent(baseContent: string, detail: string): string {
    const parts: Array<string> = [];
    if (baseContent.length > 0) {
      parts.push(baseContent);
    }
    if (detail.length > 0) {
      parts.push(detail);
    }
    const contextText = this.agentNotificationContextText();
    if (contextText.length > 0) {
      parts.push(contextText);
    }
    return this.compactAgentNotificationText(parts.join(' · '));
  }

  private buildAgentNotificationRoutePayload(
    sessionId: string,
    requestId: string,
    planId: string,
    notificationId: string = '',
    messageId: string = '',
    terminalId: string = ''
  ): string {
    return JSON.stringify(
      new AgentHomeNotificationRoutePayload(
        sessionId,
        requestId,
        planId,
        notificationId,
        messageId,
        terminalId,
        this.activeHostProfileId
      )
    );
  }

  private handleLocalPushStatusChanged(status: NGFPushStatus): void {
    this.localPushStatus = status;
    this.registerPushTokenIfReady(false);
  }

  private handlePushBackgroundMessage(message: NGFPushPayloadRecord): void {
    logger.info(TAG, 'Push Kit 后台消息已接收: type=' + message.type + ', receivedAt=' + String(message.receivedAt));
    if (this.canUseBridgeOfflineNotifications()) {
      this.refreshBridgeNotificationsIfAvailable();
    }
  }

  private refreshPushNotificationStatus(): void {
    if (!this.canUseBridgePushSubscriptions()) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_feature_unavailable')));
      return;
    }
    this.client.requestPushStatus(this.activeDeviceId);
  }

  private retryPushToken(): void {
    ngfPushManagerFacade.refreshToken().then((): void => {
      this.localPushStatus = ngfPushManagerFacade.currentStatus();
      this.registerPushTokenIfReady(true);
    }).catch((error: Error): void => {
      logger.warn(TAG, 'Push Token refresh failed: ' + error.message);
    });
  }

  private registerPushTokenIfReady(force: boolean): void {
    if (!this.canUseBridgePushSubscriptions() || this.pushRegistrationPending) {
      return;
    }
    const token = ngfPushManagerFacade.currentToken();
    if (token.length === 0 || this.activeDeviceId.length === 0 || this.currentBridgeServerId.length === 0) {
      return;
    }
    if (!force && token === this.registeredPushToken && this.registeredPushServerId === this.currentBridgeServerId) {
      return;
    }
    this.pushRegistrationPending = true;
    this.pendingPushRegistrationToken = token;
    this.pendingPushAction = AgentBridgeRequestType.NOTIFICATION_PUSH_REGISTER;
    this.pendingPushRequestId = this.client.registerPushToken(token, this.activeDeviceId, this.appBuildVersion);
    if (this.pendingPushRequestId.length === 0) {
      this.clearPendingPushRequest();
      return;
    }
    if (force) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_register_requested')));
    }
  }

  private unregisterCurrentPushSubscription(): void {
    if (!this.canUseBridgePushSubscriptions() || this.pushRegistrationPending) {
      return;
    }
    const subscription = this.currentPushSubscription();
    if (subscription === null || subscription.subscriptionId.length === 0) {
      return;
    }
    this.pushRegistrationPending = true;
    this.pendingPushAction = AgentBridgeRequestType.NOTIFICATION_PUSH_UNREGISTER;
    this.pendingPushRequestId = this.client.unregisterPushToken(
      subscription.subscriptionId,
      this.activeDeviceId,
      subscription.tokenFingerprint
    );
    if (this.pendingPushRequestId.length === 0) {
      this.clearPendingPushRequest();
      return;
    }
    this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_unregister_requested')));
  }

  private applyBridgePushStatus(source: string): void {
    if (!this.canUseBridgePushSubscriptions()) {
      return;
    }
    const result = AgentBridgeIncomingParser.parsePushStatusResult(source);
    if (
      result.action === AgentBridgeRequestType.NOTIFICATION_PUSH_REGISTER &&
        this.pendingPushAction === AgentBridgeRequestType.NOTIFICATION_PUSH_REGISTER
    ) {
      if (result.ok && result.subscription !== null && this.pendingPushRegistrationToken.length > 0) {
        this.registeredPushToken = this.pendingPushRegistrationToken;
        this.registeredPushServerId = this.currentBridgeServerId;
      }
      this.clearPendingPushRequest();
    } else if (
      result.action === AgentBridgeRequestType.NOTIFICATION_PUSH_UNREGISTER &&
        this.pendingPushAction === AgentBridgeRequestType.NOTIFICATION_PUSH_UNREGISTER
    ) {
      if (result.ok) {
        result.subscription = null;
        this.registeredPushToken = '';
        this.registeredPushServerId = '';
      }
      this.clearPendingPushRequest();
    }
    this.bridgePushStatus = result;
  }

  private currentPushSubscription(): AgentBridgePushSubscriptionRecord | null {
    if (this.bridgePushStatus.subscription !== null) {
      return this.bridgePushStatus.subscription;
    }
    for (let index = 0; index < this.bridgePushStatus.subscriptions.length; index++) {
      const item = this.bridgePushStatus.subscriptions[index];
      if (this.activeDeviceId.length > 0 && item.deviceId === this.activeDeviceId) {
        return item;
      }
    }
    if (this.bridgePushStatus.subscriptions.length === 1) {
      return this.bridgePushStatus.subscriptions[0];
    }
    return null;
  }

  private currentPushSubscriptionFingerprint(): string {
    const subscription = this.currentPushSubscription();
    return subscription === null ? '' : subscription.tokenFingerprint;
  }

  private currentPushSubscriptionLastAttempt(): string {
    const subscription = this.currentPushSubscription();
    return subscription === null ? '' : subscription.lastAttemptAt;
  }

  private currentPushSubscriptionLastSuccess(): string {
    const subscription = this.currentPushSubscription();
    return subscription === null ? '' : subscription.lastSuccessAt;
  }

  private currentPushSubscriptionDeliveryCount(): string {
    const subscription = this.currentPushSubscription();
    return subscription === null ? '0' : String(subscription.deliveryCount);
  }

  private currentPushSubscriptionLastFailure(): string {
    const subscription = this.currentPushSubscription();
    return subscription === null ? '' : subscription.lastFailureCategory;
  }

  private localPushStatusText(): string {
    if (this.localPushStatus.tokenAvailable) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_client_ready'));
    }
    if (this.localPushStatus.failureCategory.length > 0) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_client_unavailable')) +
        ': ' + this.localPushStatus.failureCategory + ' (' + String(this.localPushStatus.errorCode) + ')';
    }
    return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_client_pending'));
  }

  private bridgePushStatusText(): string {
    if (this.bridgePushStatus.deliveryReady) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_delivery_ready'));
    }
    if (this.bridgePushStatus.configured) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_delivery_waiting_subscription'));
    }
    if (this.bridgePushStatus.failureCategory.length > 0) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_delivery_not_configured')) +
        ': ' + this.bridgePushStatus.failureCategory;
    }
    return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_push_client_pending'));
  }

  private refreshBridgeNotificationsIfAvailable(): void {
    if (!this.canUseBridgeOfflineNotifications()) {
      return;
    }
    this.client.requestNotifications(true, 100);
  }

  private applyBridgeNotificationResult(source: string, publishCreated: boolean): void {
    if (!this.canUseBridgeOfflineNotifications()) {
      return;
    }
    const result = AgentBridgeIncomingParser.parseNotificationResult(source);
    if (result.action === AgentBridgeRequestType.NOTIFICATION_LIST) {
      this.bridgeNotifications = result.notifications;
    } else if (result.notification !== null) {
      this.upsertBridgeNotification(result.notification);
    } else if (result.notifications.length > 0) {
      this.bridgeNotifications = result.notifications;
    }
    if (source.indexOf('"unreadCount"') >= 0) {
      this.bridgeNotificationUnreadCount = Math.max(0, result.unreadCount);
    } else {
      this.bridgeNotificationUnreadCount = this.countUnreadBridgeNotifications();
    }
    this.syncBridgeNotificationBadge();
    if (result.action === AgentBridgeRequestType.NOTIFICATION_LIST) {
      this.publishBridgeNotificationCatchUp(result.notifications);
    }
    if (publishCreated && result.notification !== null && !result.notification.read) {
      this.publishBridgeNotificationCard(result.notification);
    }
  }

  private publishBridgeNotificationCatchUp(items: Array<AgentBridgeNotificationRecord>): void {
    let publishedCount = 0;
    for (let index = 0; index < items.length; index++) {
      const item = items[index];
      if (!item.read && publishedCount < 8) {
        this.publishBridgeNotificationCard(item);
        publishedCount = publishedCount + 1;
      }
    }
  }

  private upsertBridgeNotification(incoming: AgentBridgeNotificationRecord): void {
    if (incoming.notificationId.length === 0) {
      return;
    }
    const nextItems: Array<AgentBridgeNotificationRecord> = [];
    let replaced = false;
    for (let index = 0; index < this.bridgeNotifications.length; index++) {
      const item = this.bridgeNotifications[index];
      if (item.notificationId === incoming.notificationId) {
        nextItems.push(incoming);
        replaced = true;
      } else {
        nextItems.push(item);
      }
    }
    if (!replaced) {
      nextItems.unshift(incoming);
    }
    this.bridgeNotifications = nextItems;
  }

  private countUnreadBridgeNotifications(): number {
    let count = 0;
    for (let index = 0; index < this.bridgeNotifications.length; index++) {
      if (!this.bridgeNotifications[index].read) {
        count = count + 1;
      }
    }
    return count;
  }

  private syncBridgeNotificationBadge(): void {
    ngfSystemNotificationManager.setBadgeNumber(this.bridgeNotificationUnreadCount).then((updated: boolean): void => {
      if (!updated) {
        logger.warn(TAG, 'bridge notification badge update was not applied');
      }
    }).catch((error: Error): void => {
      logger.warn(TAG, 'bridge notification badge update failed: ' + this.errorToString(error));
    });
  }

  private publishBridgeNotificationCard(item: AgentBridgeNotificationRecord): void {
    if (item.notificationId.length === 0 || this.wasBridgeNotificationPublished(item.notificationId)) {
      return;
    }
    this.rememberPublishedBridgeNotification(item.notificationId);
    this.publishBridgeNotificationCardTask(item).catch((error: Error): void => {
      logger.error(TAG, 'publish bridge notification card failed: ' + this.errorToString(error));
    });
  }

  private async publishBridgeNotificationCardTask(item: AgentBridgeNotificationRecord): Promise<void> {
    const enabled = await this.ensureAgentNotificationPermission();
    if (!enabled) {
      return;
    }
    const notificationId = await this.bridgeSystemNotificationId(item.notificationId);
    const title = this.bridgeNotificationTitle(item);
    const body = this.bridgeNotificationBody(item);
    const additionalText = this.bridgeNotificationAdditionalText(item);
    const lines: Array<string> = [];
    if (body.length > 0) {
      lines.push(body);
    }
    if (additionalText.length > 0) {
      lines.push(additionalText);
    }
    const request = new NGFNotificationRequest(
      notificationId,
      title,
      body.length > 0 ? body : title,
      lines.length > 1 ? NGFNotificationType.MULTILINE : NGFNotificationType.LONG_TEXT,
      0,
      0,
      false,
      false
    );
    request.longText = body;
    request.lines = lines;
    request.additionalText = additionalText;
    request.appMessageId = 'ngf.bridge.' + item.notificationId;
    request.badgeNumber = this.bridgeNotificationUnreadCount;
    const expiresAt = Date.parse(item.expiresAt);
    if (Number.isFinite(expiresAt) && expiresAt > Date.now()) {
      request.autoDeletedTime = expiresAt;
    }
    request.tapAction = this.bridgeNotificationTapAction(item);
    request.tapPayloadJson = this.buildAgentNotificationRoutePayload(
      this.bridgeNotificationSessionId(item),
      item.kind === 'permission' || item.kind === 'question' ? item.route.requestId : '',
      item.kind === 'plan' ? item.route.requestId : '',
      item.notificationId,
      item.route.messageId,
      item.route.terminalId.length > 0 ? item.route.terminalId : item.terminalId
    );
    await ngfSystemNotificationManager.publish(request);
  }

  private async bridgeSystemNotificationId(notificationId: string): Promise<number> {
    try {
      const digest = await securityToolkit.shaHash(notificationId);
      const numericValue = Number('0x' + digest.substring(0, 8));
      if (Number.isFinite(numericValue)) {
        return 40000 + Math.floor(numericValue % 1000000000);
      }
    } catch (error) {
      logger.warn(TAG, 'bridge notification id hash failed: ' + this.errorToString(error));
    }
    this.bridgeSystemNotificationSequence = this.bridgeSystemNotificationSequence + 1;
    return 40000 + this.bridgeSystemNotificationSequence;
  }

  private bridgeNotificationTitle(item: AgentBridgeNotificationRecord): string {
    if (item.kind === 'completed') {
      return this.resolveAgentNotificationString($r('app.string.agent_home_notification_completed_title'));
    }
    if (item.kind === 'plan') {
      return this.resolveAgentNotificationString($r('app.string.agent_home_plan_title'));
    }
    if (item.kind === 'terminal_attention') {
      return this.resolveAgentNotificationString($r('app.string.agent_home_runtime_terminal_attention'));
    }
    if (item.kind === 'permission' || item.kind === 'question') {
      return this.resolveAgentNotificationString($r('app.string.agent_home_notification_waiting_title'));
    }
    return item.title.length > 0 ? item.title : this.resolveAgentNotificationString($r('app.string.EntryAbility_label'));
  }

  private bridgeNotificationBody(item: AgentBridgeNotificationRecord): string {
    let baseContent = '';
    if (item.kind === 'completed') {
      baseContent = this.resolveAgentNotificationString($r('app.string.agent_home_notification_completed_content'));
    } else if (item.kind === 'plan') {
      baseContent = this.resolveAgentNotificationString($r('app.string.agent_home_notification_plan_content'));
    } else if (item.kind === 'permission') {
      baseContent = this.resolveAgentNotificationString($r('app.string.agent_home_notification_permission_content'));
    } else if (item.kind === 'question') {
      baseContent = this.resolveAgentNotificationString($r('app.string.agent_home_notification_request_content'));
    } else if (item.kind === 'terminal_attention') {
      baseContent = this.resolveAgentNotificationString($r('app.string.agent_home_runtime_terminal_attention_required'));
    }
    if (item.body.length === 0 || item.body === baseContent) {
      return baseContent.length > 0 ? baseContent : item.title;
    }
    if (baseContent.length === 0) {
      return item.body;
    }
    return baseContent + ': ' + item.body;
  }

  private bridgeNotificationAdditionalText(item: AgentBridgeNotificationRecord): string {
    const sessionId = this.resolveNotificationLocalSessionId(this.bridgeNotificationSessionId(item));
    if (sessionId.length > 0) {
      for (let index = 0; index < this.sessions.length; index++) {
        if (this.sessions[index].id === sessionId) {
          return this.sessions[index].title;
        }
      }
    }
    if (item.agentId.length > 0) {
      return item.agentId;
    }
    return item.workspaceId;
  }

  private bridgeNotificationSessionId(item: AgentBridgeNotificationRecord): string {
    return item.route.sessionId.length > 0 ? item.route.sessionId : item.sessionId;
  }

  private bridgeNotificationTapAction(item: AgentBridgeNotificationRecord): string {
    if (item.kind === 'permission' || item.kind === 'question') {
      return AgentHomeNotificationTapAction.OPEN_REQUEST;
    }
    if (item.kind === 'plan') {
      return AgentHomeNotificationTapAction.OPEN_PLAN;
    }
    if (item.kind === 'terminal_attention') {
      return AgentHomeNotificationTapAction.OPEN_TERMINAL;
    }
    return AgentHomeNotificationTapAction.OPEN_SESSION;
  }

  private wasBridgeNotificationPublished(notificationId: string): boolean {
    for (let index = 0; index < this.publishedBridgeNotificationIds.length; index++) {
      if (this.publishedBridgeNotificationIds[index] === notificationId) {
        return true;
      }
    }
    return false;
  }

  private rememberPublishedBridgeNotification(notificationId: string): void {
    const nextItems: Array<string> = [];
    nextItems.push(notificationId);
    const limit = Math.min(this.publishedBridgeNotificationIds.length, 199);
    for (let index = 0; index < limit; index++) {
      nextItems.push(this.publishedBridgeNotificationIds[index]);
    }
    this.publishedBridgeNotificationIds = nextItems;
  }

  private markBridgeNotificationOpened(notificationId: string): void {
    if (notificationId.length === 0) {
      return;
    }
    this.markBridgeNotificationReadLocally(notificationId);
    if (this.canUseBridgeOfflineNotifications()) {
      this.client.actOnNotification(notificationId, 'open');
    } else {
      this.enqueuePendingBridgeNotificationAction(notificationId);
    }
  }

  private enqueuePendingBridgeNotificationAction(notificationId: string): void {
    const scopedId = this.activeHostProfileId + ':' + notificationId;
    for (let index = 0; index < this.pendingBridgeNotificationActionIds.length; index++) {
      if (this.pendingBridgeNotificationActionIds[index] === scopedId) {
        return;
      }
    }
    this.pendingBridgeNotificationActionIds.push(scopedId);
  }

  private flushPendingBridgeNotificationActions(): void {
    if (!this.canUseBridgeOfflineNotifications() || this.pendingBridgeNotificationActionIds.length === 0) {
      return;
    }
    const remaining: Array<string> = [];
    for (let index = 0; index < this.pendingBridgeNotificationActionIds.length; index++) {
      const scopedId = this.pendingBridgeNotificationActionIds[index];
      const prefix = this.activeHostProfileId + ':';
      if (!scopedId.startsWith(prefix)) {
        remaining.push(scopedId);
        continue;
      }
      const notificationId = scopedId.substring(prefix.length);
      const requestId = this.client.actOnNotification(notificationId, 'open');
      if (requestId.length === 0) {
        remaining.push(scopedId);
      }
    }
    this.pendingBridgeNotificationActionIds = remaining;
  }

  private markBridgeNotificationReadLocally(notificationId: string): void {
    const nextItems: Array<AgentBridgeNotificationRecord> = [];
    let changed = false;
    for (let index = 0; index < this.bridgeNotifications.length; index++) {
      const item = this.bridgeNotifications[index];
      if (item.notificationId === notificationId && !item.read) {
        item.read = true;
        item.clicked = true;
        changed = true;
      }
      nextItems.push(item);
    }
    if (!changed) {
      return;
    }
    this.bridgeNotifications = nextItems;
    this.bridgeNotificationUnreadCount = this.countUnreadBridgeNotifications();
    this.syncBridgeNotificationBadge();
  }

  private agentNotificationContextText(): string {
    const parts: Array<string> = [];
    const session = this.currentSession();
    if (session !== null && session.title.length > 0) {
      parts.push(session.title);
    }
    const providerName = this.providerDisplayNameForId(this.currentSessionProviderId());
    if (providerName.length > 0) {
      parts.push(providerName);
    }
    const subagentName = this.currentVisibleSubagentName();
    if (subagentName.length > 0) {
      parts.push(subagentName);
    }
    return parts.join(' · ');
  }

  private resolveAgentNotificationString(resource: ResourceStr): string {
    return resolveResourceString(this.getUIContext().getHostContext(), resource);
  }

  private compactAgentNotificationText(text: string): string {
    const value = text.trim();
    if (value.length <= AGENT_HOME_NOTIFICATION_TEXT_LIMIT) {
      return value;
    }
    return value.substring(0, AGENT_HOME_NOTIFICATION_TEXT_LIMIT) + '...';
  }

  private startContextCompactionStatus(): void {
    this.isContextCompacting = true;
  }

  private stopContextCompactionStatus(): void {
    this.isContextCompacting = false;
  }

  private animateTransientState(duration: number, curve: Curve, updater: () => void): void {
    const uiContext = this.getUIContext();
    if (uiContext) {
      uiContext.animateTo({ duration: duration, curve: curve }, updater);
      return;
    }
    updater();
  }

  private setComposerExpansionProgress(progress: number): void {
    const nextProgress = this.clampComposerProgress(progress);
    this.composerExpansionProgress = nextProgress;
    this.isCompactComposerMode = nextProgress < 0.5;
  }

  private shouldExpandComposerAfterPan(event: GestureEvent): boolean {
    if (event.velocityY <= -AGENT_HOME_COMPOSER_EXPANSION_VELOCITY_THRESHOLD) {
      return true;
    }
    if (event.velocityY >= AGENT_HOME_COMPOSER_EXPANSION_VELOCITY_THRESHOLD) {
      return false;
    }
    return this.clampComposerProgress(this.composerExpansionProgress) >= AGENT_HOME_COMPOSER_EXPANSION_SNAP_THRESHOLD;
  }

  private handleComposerPanStart(_event: GestureEvent): void {
    this.clearComposerSettleTimer();
    this.isComposerDragging = true;
    this.composerDragStartProgress = this.clampComposerProgress(this.composerExpansionProgress);
  }

  private handleComposerPanUpdate(event: GestureEvent): void {
    const dragProgress = -event.offsetY / AGENT_HOME_COMPOSER_EXPANSION_DRAG_DISTANCE;
    this.setComposerExpansionProgress(this.composerDragStartProgress + dragProgress);
  }

  private handleComposerPanEnd(event: GestureEvent): void {
    this.isComposerDragging = false;
    this.settleComposerExpansion(this.shouldExpandComposerAfterPan(event));
  }

  private handleComposerPanCancel(_event: GestureEvent): void {
    this.isComposerDragging = false;
    this.settleComposerExpansion(this.composerExpansionProgress >= AGENT_HOME_COMPOSER_EXPANSION_SNAP_THRESHOLD);
  }

  private settleComposerExpansion(expanded: boolean): void {
    this.clearComposerSettleTimer();
    this.isComposerDragging = false;
    this.composerSettleSequence = this.composerSettleSequence + 1;
    const sequence = this.composerSettleSequence;
    const startProgress = this.clampComposerProgress(this.composerExpansionProgress);
    const targetProgress = expanded ? 1 : 0;
    const distance = Math.abs(targetProgress - startProgress);
    if (distance <= 0.01) {
      this.setComposerExpansionProgress(targetProgress);
      return;
    }
    const duration = Math.max(96, AGENT_HOME_COMPOSER_SETTLE_DURATION_MS * distance);
    const startTime = Date.now();
    this.composerSettleTimer = setInterval((): void => {
      if (this.composerSettleSequence !== sequence) {
        this.clearComposerSettleTimer();
        return;
      }
      const elapsed = Date.now() - startTime;
      const linearProgress = this.clampComposerProgress(elapsed / duration);
      const easedProgress = 1 - Math.pow(1 - linearProgress, 3);
      this.setComposerExpansionProgress(startProgress + (targetProgress - startProgress) * easedProgress);
      if (linearProgress >= 1) {
        this.clearComposerSettleTimer();
        this.setComposerExpansionProgress(targetProgress);
      }
    }, AGENT_HOME_COMPOSER_SETTLE_FRAME_MS);
  }

  private clearComposerSettleTimer(): void {
    if (this.composerSettleTimer >= 0) {
      clearInterval(this.composerSettleTimer);
      this.composerSettleTimer = -1;
    }
  }

  private expandComposerFromCompact(): void {
    if (this.composerExpansionProgress >= 1) {
      return;
    }
    this.settleComposerExpansion(true);
  }

  private collapseComposerToCompact(): void {
    if (this.composerExpansionProgress <= 0) {
      return;
    }
    this.settleComposerExpansion(false);
  }

  private normalizeTransientStatusText(text: string): string {
    let normalized = text.split('\r').join(' ').split('\n').join(' ').trim();
    while (normalized.indexOf('  ') >= 0) {
      normalized = normalized.split('  ').join(' ');
    }
    if (normalized.length > 180) {
      return normalized.substring(0, 180) + '...';
    }
    return normalized;
  }

  private createBridgeAppNonce(): string {
    const randomText = securityToolkit.generateRandomBase64(18);
    if (randomText.length > 0) {
      return randomText;
    }
    return 'nonce_' + String(Date.now());
  }

  private async bridgeTokenDigest(token: string): Promise<string> {
    if (token.length === 0) {
      return '';
    }
    try {
      return await securityToolkit.shaHash(token);
    } catch (error) {
      logger.warn(TAG, 'bridge token digest failed: ' + this.errorToString(error));
      return '';
    }
  }

  private bindBridgeHandlersForEpoch(hostProfileId: string, epoch: number): void {
    this.client.setAppNonceRefresher((): string => {
      if (!this.acceptsHostEpoch(hostProfileId, epoch)) {
        return this.bridgeConnectionAppNonce;
      }
      this.bridgeConnectionAppNonce = this.createBridgeAppNonce();
      return this.bridgeConnectionAppNonce;
    });
    this.client.setHandlers(
      (status: string, detail: string): void => {
        if (!this.acceptsHostEpoch(hostProfileId, epoch)) {
          return;
        }
        this.handleBridgeStatus(status, detail);
      },
      (text: string): void => {
        if (!this.acceptsHostEpoch(hostProfileId, epoch)) {
          return;
        }
        this.handleBridgeText(text);
      },
      (message: string): void => {
        if (!this.acceptsHostEpoch(hostProfileId, epoch)) {
          return;
        }
        this.handleBridgeError(message);
      },
      (sessionId: string): void => {
        if (!this.acceptsHostEpoch(hostProfileId, epoch)) {
          return;
        }
        this.handleBridgeSession(sessionId);
      }
    );
    this.client.setBinaryHandlers(
      (frame: AgentBridgeTerminalFrame): void => {
        if (!this.acceptsHostEpoch(hostProfileId, epoch)) {
          return;
        }
        this.handleBridgeTerminalFrame(frame);
      },
      (frame: AgentBridgeFileTransferFrame): void => {
        if (!this.acceptsHostEpoch(hostProfileId, epoch)) {
          return;
        }
        this.handleBridgeFileTransferFrame(frame);
      }
    );
  }

  private acceptsHostEpoch(hostProfileId: string, epoch: number): boolean {
    if (hostProfileId.length === 0) {
      return this.activeHostProfileId.length === 0 && epoch === this.connectionEpoch;
    }
    return hostProfileId === this.activeHostProfileId && epoch === this.connectionEpoch;
  }

  private requestHostSwitch(hostProfileId: string, workspaceId: string = ''): void {
    const plan: AgentHomeHostSwitchPlan = this.hostSwitchCoordinator.plan(hostProfileId, this.connectionStatus);
    if (plan.noOp) {
      if (workspaceId.length > 0) {
        this.pendingHostWorkspaceId = workspaceId;
        this.activatePendingHostWorkspace();
      }
      return;
    }
    if (!plan.requiresConfirmation) {
      this.performHostSwitch(hostProfileId, workspaceId).catch((error: Error): void => {
        this.handleHostSwitchFailure(error);
      });
      return;
    }
    const target = this.findHostProfile(hostProfileId);
    const hostContext = this.getUIContext().getHostContext();
    this.hostSwitchStatus = AgentHomeHostSwitchStatus.AWAITING_CONFIRMATION;
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_host_switch_title')),
      message: resolveResourceString(hostContext, $r('app.string.agent_home_host_switch_message')) +
        (target !== null ? ': ' + target.displayName : ''),
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_host_switch_action')),
        action: (): void => {
          this.performHostSwitch(hostProfileId, workspaceId).catch((error: Error): void => {
            this.handleHostSwitchFailure(error);
          });
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {
          this.hostSwitchCoordinator.cancel();
          this.hostSwitchStatus = AgentHomeHostSwitchStatus.IDLE;
        }
      }
    });
  }

  private async performHostSwitch(hostProfileId: string, workspaceId: string): Promise<void> {
    const target = this.findHostProfile(hostProfileId);
    if (target === null) {
      throw new Error('host_profile_not_found');
    }
    const currentProfile = this.buildCurrentHostProfile();
    if (currentProfile !== null) {
      await this.persistence.saveHostProfile(currentProfile);
      this.upsertHostProfileState(currentProfile);
    }
    this.closeSessionWindowsForHost(this.activeHostProfileId, 'host_switch');
    this.hostSwitchCoordinator.begin(hostProfileId);
    this.hostSwitchStatus = AgentHomeHostSwitchStatus.QUIESCING;
    this.connectionEpoch = this.connectionEpoch + 1;
    this.quiesceCurrentHostConnection();
    this.releaseRelayLifecycleState();
    this.client.clearHandlers();
    this.client.disconnect();
    this.clearHostRuntimeState();
    this.hostSwitchCoordinator.markLoading();
    this.hostSwitchStatus = AgentHomeHostSwitchStatus.LOADING;
    await this.activateHostProfile(target, true, workspaceId);
  }

  private quiesceCurrentHostConnection(): void {
    this.voiceTtsPlaybackCoordinator.invalidate();
    this.clearActiveVoiceTtsState();
    this.clearBrowserRequests();
    this.resetBrowserPermissionState();
    this.browserScreenshotDataUrl = '';
    const bridgeSessionId = this.currentBridgeSessionId();
    if (this.gitDiffSubscribed && this.gitDiffSubscriptionId.length > 0 && bridgeSessionId.length > 0) {
      this.client.unsubscribeGitDiff(
        bridgeSessionId,
        this.activeWorkspaceId,
        this.gitDiffSubscriptionId,
        this.currentBridgeAgentId()
      );
    }
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      const terminal = this.bridgeTerminals[index];
      if (terminal.subscribed && terminal.terminal.terminalId.length > 0) {
        this.client.unsubscribeTerminal(terminal.terminal.terminalId);
      }
    }
    const transferIds: Array<string> = [];
    for (let index = 0; index < this.bridgeFileTransfers.length; index++) {
      if (this.bridgeFileTransfers[index].status === 'running') {
        transferIds.push(this.bridgeFileTransfers[index].requestId);
      }
    }
    for (let index = 0; index < transferIds.length; index++) {
      this.cancelRuntimeFileTransfer(transferIds[index]);
    }
    this.destroyTrackedHostHttpRequests();
    this.gitDiffSubscriptionId = '';
    this.gitDiffSubscribed = false;
    this.pendingRemoteSessionsRequestPairs = [];
    this.pendingRemoteSessionsRefresh = false;
    this.pendingAgentTimelineRequestPairs = [];
    this.pendingTerminalCreateRequestIds = [];
    this.pendingWorkspaceFilesParentPath = '';
    this.pendingWorkspacePreviewImagePath = '';
    this.clearPendingWorkspacePreviewRequest();
    this.loadingRemoteSessions = false;
    this.loadingWorkspaceChanges = false;
    this.loadingWorkspaceFiles = false;
    this.loadingWorkspaceDiffIds = [];
    this.loadingWorkspaceFileParentPaths = [];
    this.resetPushRegistrationForConnection();
    this.stopActiveTurnTimer();
    this.stopContextCompactionStatus();
  }

  private handleHostSwitchFailure(error: Error): void {
    this.hostSwitchCoordinator.markFailed();
    this.hostSwitchStatus = AgentHomeHostSwitchStatus.FAILED;
    this.connectionStatus = AgentBridgeConnectionStatus.ERROR;
    this.bridgeConnectionReasonText = this.errorToString(error);
    logger.error(TAG, 'host switch failed: ' + this.bridgeConnectionReasonText);
  }

  private beginAddHostProfile(): void {
    this.editingHostProfileId = '';
    this.hostDisplayNameDraft = '';
    this.hostEndpointDraft = '';
    this.hostCredentialDraft = '';
    this.hostAutoConnectDraft = true;
    this.hostEditorVisible = true;
  }

  private beginEditHostProfile(hostProfileId: string): void {
    const profile = this.findHostProfile(hostProfileId);
    if (profile === null) {
      return;
    }
    this.editingHostProfileId = profile.hostProfileId;
    this.hostDisplayNameDraft = profile.displayName;
    this.hostEndpointDraft = profile.endpoint;
    this.hostCredentialDraft = '';
    this.hostAutoConnectDraft = profile.autoConnectOnLaunch;
    this.hostEditorVisible = true;
  }

  private cancelHostProfileEditor(): void {
    this.editingHostProfileId = '';
    this.hostDisplayNameDraft = '';
    this.hostEndpointDraft = '';
    this.hostCredentialDraft = '';
    this.hostAutoConnectDraft = true;
    this.hostEditorVisible = false;
  }

  private saveHostProfileEditor(connectAfterSave: boolean = false): void {
    this.saveHostProfileEditorTask(connectAfterSave).catch((error: Error): void => {
      this.showTransientStatus(this.errorToString(error));
      logger.error(TAG, 'save host profile failed: ' + this.errorToString(error));
    });
  }

  private async saveHostProfileEditorTask(connectAfterSave: boolean): Promise<void> {
    const endpoint = this.normalizeHostEndpoint(this.hostEndpointDraft);
    if (endpoint.length === 0) {
      throw new Error('host_endpoint_required');
    }
    if (AgentHomeRelayUiPolicy.isRelayPairingUri(endpoint)) {
      this.cancelHostProfileEditor();
      this.applyRelayPairingQrPayload(endpoint, connectAfterSave);
      return;
    }
    const relayEndpoint = AgentHomeRelayUiPolicy.isRelayPublicEndpoint(endpoint);
    if (AgentBridgeClient.isRelayEndpoint(endpoint) && !relayEndpoint) {
      throw new Error(resolveResourceString(
        this.getUIContext().getHostContext(),
        $r('app.string.agent_home_relay_pairing_qr_invalid')
      ));
    }
    const existing = this.findHostProfile(this.editingHostProfileId);
    const credentialDraft = this.hostCredentialDraft;
    const hostProfileId = existing !== null ? existing.hostProfileId : this.createHostProfileId();
    let credentialAlias = existing !== null ? existing.credentialAlias : '';
    let credentialDigest = existing !== null ? existing.credentialDigest : '';
    let newCredentialResult: AgentHomeCredentialWriteResult | null = null;
    if (credentialDraft.length > 0 && !relayEndpoint) {
      newCredentialResult = await agentHomeHostCredentialStore.writeNew(hostProfileId, credentialDraft);
      if (!newCredentialResult.ok) {
        throw new Error(newCredentialResult.failureCategory);
      }
      credentialAlias = newCredentialResult.alias;
      credentialDigest = newCredentialResult.digest;
    }
    if (relayEndpoint) {
      credentialAlias = '';
      credentialDigest = '';
    }
    if (credentialAlias.length === 0 && !AgentBridgeClient.isRelayEndpoint(endpoint)) {
      if (newCredentialResult !== null) {
        await agentHomeHostCredentialStore.remove(newCredentialResult.alias);
      }
      throw new Error('host_credential_required');
    }
    const now = Date.now();
    const endpointChanged: boolean = existing !== null && existing.endpoint !== endpoint;
    const profile = new AgentHomeHostProfile(
      hostProfileId,
      this.hostDisplayNameDraft.trim().length > 0 ? this.hostDisplayNameDraft.trim() : this.defaultHostProfileName(endpoint),
      endpoint,
      credentialAlias,
      credentialDigest,
      existing !== null ? existing.providerId : this.selectedProviderId,
      existing !== null ? existing.modelId : this.selectedModelId,
      existing !== null ? existing.speedMode : this.selectedSpeedMode,
      existing !== null ? existing.reasoningMode : this.selectedReasoningMode,
      existing !== null ? existing.activeWorkspaceId : '',
      existing !== null ? existing.activeSessionId : '',
      existing !== null ? existing.previewPath : '',
      existing !== null && !endpointChanged ? existing.lastDeviceId : '',
      existing !== null && !endpointChanged ? existing.lastServerId : '',
      this.hostAutoConnectDraft,
      existing !== null && !endpointChanged ? existing.identityStatus : AgentHomeHostIdentityStatus.UNBOUND,
      existing !== null ? existing.createdAt : now,
      now,
      existing !== null ? existing.lastUsedAt : 0
    );
    try {
      if (existing !== null && newCredentialResult !== null) {
        await this.persistence.saveHostProfileWithCredentialRotation(profile, existing.credentialAlias);
      } else {
        await this.persistence.saveHostProfile(profile);
      }
    } catch (error) {
      if (newCredentialResult !== null) {
        await agentHomeHostCredentialStore.remove(newCredentialResult.alias);
      }
      throw new Error(this.errorToString(error));
    }
    if (existing !== null && existing.credentialAlias.length > 0 &&
      (newCredentialResult !== null || relayEndpoint)) {
      await this.removeOrQueueHostCredential(existing.credentialAlias);
    }
    if (existing !== null && this.relayIdentityScopeChanged(existing.endpoint, endpoint)) {
      await this.deleteRelayIdentityForHost(existing);
    }
    this.upsertHostProfileState(profile);
    this.cancelHostProfileEditor();
    await this.refreshHostWorkspaceGroups();
    if (profile.hostProfileId === this.activeHostProfileId) {
      this.bridgeEndpoint = profile.endpoint;
      if (relayEndpoint) {
        this.activeBridgeCredential = '';
        this.activeHostCredentialAvailable = false;
      } else if (newCredentialResult !== null) {
        this.activeBridgeCredential = credentialDraft;
        this.activeHostCredentialAvailable = true;
      }
      if (this.connectionStatus === AgentBridgeConnectionStatus.CONNECTED) {
        this.releaseRelayLifecycleState();
        this.client.disconnect();
      }
      if (connectAfterSave) {
        this.restoreLastBridgeConnection();
      }
    } else if (connectAfterSave || existing === null) {
      this.requestHostSwitch(profile.hostProfileId);
    }
  }

  private createHostProfileId(): string {
    const randomText = securityToolkit.generateRandomBase64(12);
    let safeText = '';
    for (let index = 0; index < randomText.length; index++) {
      const ch = randomText.charAt(index);
      const code = ch.charCodeAt(0);
      const alpha = (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
      const digit = code >= 48 && code <= 57;
      if (alpha || digit) {
        safeText = safeText + ch;
      }
    }
    return 'host_' + (safeText.length > 0 ? safeText : String(Date.now()));
  }

  private async removeOrQueueHostCredential(alias: string): Promise<void> {
    if (alias.length === 0) {
      return;
    }
    if (await agentHomeHostCredentialStore.remove(alias)) {
      await this.persistence.removeCredentialGarbageCollection(alias);
      return;
    }
    await this.persistence.queueCredentialGarbageCollection(alias);
  }

  private requestDeleteHostProfile(hostProfileId: string): void {
    const profile = this.findHostProfile(hostProfileId);
    if (profile === null) {
      return;
    }
    const hostContext = this.getUIContext().getHostContext();
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_host_delete_title')),
      message: resolveResourceString(hostContext, $r('app.string.agent_home_host_delete_message')) + ': ' + profile.displayName,
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_host_delete_action')),
        action: (): void => {
          this.deleteHostProfileTask(profile).catch((error: Error): void => {
            this.showTransientStatus(this.errorToString(error));
          });
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {}
      }
    });
  }

  private async deleteHostProfileTask(profile: AgentHomeHostProfile): Promise<void> {
    this.closeSessionWindowsForHost(profile.hostProfileId, 'host_delete');
    if (profile.hostProfileId === this.activeHostProfileId) {
      this.connectionEpoch = this.connectionEpoch + 1;
      this.quiesceCurrentHostConnection();
      this.releaseRelayLifecycleState();
      this.client.clearHandlers();
      this.client.disconnect();
    }
    await this.persistence.deleteHostProfile(profile.hostProfileId, profile.credentialAlias);
    if (await agentHomeHostCredentialStore.remove(profile.credentialAlias)) {
      await this.persistence.removeCredentialGarbageCollection(profile.credentialAlias);
    }
    await this.deleteRelayIdentityForHost(profile);
    const nextItems: Array<AgentHomeHostProfile> = [];
    for (let index = 0; index < this.hostProfiles.length; index++) {
      if (this.hostProfiles[index].hostProfileId !== profile.hostProfileId) {
        nextItems.push(this.hostProfiles[index]);
      }
    }
    this.hostProfiles = nextItems;
    if (profile.hostProfileId === this.activeHostProfileId) {
      this.clearHostRuntimeState();
      if (nextItems.length > 0) {
        await this.activateHostProfile(nextItems[0], false, '');
      }
    }
    await this.refreshHostWorkspaceGroups();
  }

  private async deleteRelayIdentityForHost(profile: AgentHomeHostProfile): Promise<void> {
    if (!AgentBridgeClient.isRelayEndpoint(profile.endpoint)) {
      return;
    }
    const relayId: string = this.relayIdFromHostEndpoint(profile.endpoint);
    if (relayId.length === 0) {
      logger.warn(TAG, 'skip Relay identity cleanup because the stored Relay descriptor is invalid');
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(),
        $r('app.string.agent_home_relay_identity_cleanup_failed')
      ));
      return;
    }
    try {
      const alias: string = await ngfRelayCryptoFacade.buildIdentityAlias(profile.hostProfileId, relayId);
      await ngfRelayCryptoFacade.deleteIdentity(alias);
    } catch (error) {
      logger.warn(TAG, 'Relay identity cleanup failed: ' + this.errorToString(error));
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(),
        $r('app.string.agent_home_relay_identity_cleanup_failed')
      ));
    }
  }

  private relayIdentityScopeChanged(previousEndpoint: string, nextEndpoint: string): boolean {
    const previousRelayId: string = this.relayIdFromHostEndpoint(previousEndpoint);
    if (previousRelayId.length === 0) {
      return false;
    }
    const nextRelayId: string = this.relayIdFromHostEndpoint(nextEndpoint);
    return previousRelayId !== nextRelayId;
  }

  private relayIdFromHostEndpoint(endpoint: string): string {
    if (AgentHomeRelayUiPolicy.isRelayPublicEndpoint(endpoint)) {
      const publicEndpoint: AgentBridgeRelayPublicEndpoint = AgentBridgeIncomingParser.parseRelayPublicEndpoint(endpoint);
      return publicEndpoint.isValid() ? publicEndpoint.relayId : '';
    }
    if (AgentHomeRelayUiPolicy.isRelayPairingUri(endpoint)) {
      const legacyOffer: AgentBridgeRelayPairingOffer = AgentBridgeClient.parseRelayPairingUri(endpoint);
      return legacyOffer.relayId;
    }
    return '';
  }

  private requestRebindActiveHost(): void {
    const profile = this.findHostProfile(this.activeHostProfileId);
    if (profile === null) {
      return;
    }
    const hostContext = this.getUIContext().getHostContext();
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_host_rebind_title')),
      message: resolveResourceString(hostContext, $r('app.string.agent_home_host_rebind_message')),
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_host_rebind_action')),
        action: (): void => {
          profile.lastDeviceId = '';
          profile.lastServerId = '';
          profile.identityStatus = AgentHomeHostIdentityStatus.UNBOUND;
          profile.updatedAt = Date.now();
          this.persistence.saveHostProfile(profile).then((): void => {
            this.upsertHostProfileState(profile);
            this.activeDeviceId = '';
            this.currentBridgeServerId = '';
            this.restoreLastBridgeConnection();
          }).catch((error: Error): void => {
            this.showTransientStatus(this.errorToString(error));
          });
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {}
      }
    });
  }

  private trackHostHttpRequest(request: http.HttpRequest): void {
    this.trackedHostHttpRequests.push(request);
  }

  private untrackHostHttpRequest(request: http.HttpRequest): void {
    const nextItems: Array<http.HttpRequest> = [];
    for (let index = 0; index < this.trackedHostHttpRequests.length; index++) {
      if (this.trackedHostHttpRequests[index] !== request) {
        nextItems.push(this.trackedHostHttpRequests[index]);
      }
    }
    this.trackedHostHttpRequests = nextItems;
  }

  private destroyTrackedHostHttpRequests(): void {
    for (let index = 0; index < this.trackedHostHttpRequests.length; index++) {
      this.trackedHostHttpRequests[index].destroy();
    }
    this.trackedHostHttpRequests = [];
  }

  private handleConnect(): void {
    if (this.bridgeEndpoint.trim().length === 0) {
      this.addBridgeLogMessage(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_endpoint_required'))
      );
      this.openSheet(AgentHomeSheetKey.SETTINGS);
      return;
    }
    if (!this.activeHostCanConnect()) {
      this.addBridgeLogMessage(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_token_required'))
      );
      this.openSheet(AgentHomeSheetKey.SETTINGS);
      return;
    }
    const normalizedEndpoint = this.normalizeHostEndpoint(this.bridgeEndpoint);
    this.bridgeEndpoint = normalizedEndpoint;
    this.bridgeConnectionAppNonce = this.createBridgeAppNonce();
    this.bridgeTrustState = AgentBridgeTrustState.UNKNOWN;
    this.currentBridgeServerId = '';
    this.currentBridgeServerInfo = null;
    this.resetPushRegistrationForConnection();
    this.pendingAgentTimelineRequestPairs = [];
    this.bridgeNotifications = [];
    this.bridgeNotificationUnreadCount = 0;
    this.publishedBridgeNotificationIds = [];
    this.syncBridgeNotificationBadge();
    this.persistProfile();
    const config = new AgentBridgeConnectionConfig(
      normalizedEndpoint,
      this.activeBridgeCredential,
      AGENT_HOME_BRIDGE_CLIENT_ID,
      this.bridgeConnectionAppNonce,
      this.activeHostProfileId,
      this.appBuildVersion
    );
    this.client.connect(config);
  }

  private restoreLastBridgeConnection(): void {
    if (!this.activeHostCanConnect()) {
      return;
    }
    if (this.connectionStatus === AgentBridgeConnectionStatus.CONNECTING ||
      this.connectionStatus === AgentBridgeConnectionStatus.CONNECTED) {
      return;
    }
    const normalizedEndpoint = this.normalizeHostEndpoint(this.bridgeEndpoint);
    if (normalizedEndpoint.length === 0) {
      return;
    }
    this.bridgeEndpoint = normalizedEndpoint;
    this.addBridgeLogMessage(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_restore_connection'))
    );
    this.bridgeConnectionAppNonce = this.createBridgeAppNonce();
    this.bridgeTrustState = AgentBridgeTrustState.UNKNOWN;
    this.currentBridgeServerId = '';
    this.currentBridgeServerInfo = null;
    this.resetPushRegistrationForConnection();
    this.pendingAgentTimelineRequestPairs = [];
    const config = new AgentBridgeConnectionConfig(
      normalizedEndpoint,
      this.activeBridgeCredential,
      AGENT_HOME_BRIDGE_CLIENT_ID,
      this.bridgeConnectionAppNonce,
      this.activeHostProfileId,
      this.appBuildVersion
    );
    this.client.connect(config);
  }

  private handleComposerReconnect(): void {
    if (!this.canReconnectBridgeFromComposer()) {
      return;
    }
    this.restoreLastBridgeConnection();
  }

  private scanBridgeConnectionQr(openSessionsAfterConnect: boolean = false): void {
    const options: scanBarcode.ScanOptions = {
      scanTypes: [scanCore.ScanType.QR_CODE],
      enableAlbum: true,
      enableMultiMode: false
    };
    try {
      scanBarcode.startScanForResult(
        this.getUIContext().getHostContext(),
        options,
        (error: BusinessError, result: scanBarcode.ScanResult): void => {
          if (error) {
            this.handleScanBridgeQrError(error);
            return;
          }
          this.applyBridgeQrPayload(result.originalValue, openSessionsAfterConnect);
        }
      );
    } catch (error) {
      this.handleScanBridgeQrError(error);
    }
  }

  private handleScanBridgeQrError(error: Object | string | number | boolean | null | undefined): void {
    const message = this.errorToString(error);
    if (message.indexOf('1000500002') >= 0) {
      return;
    }
    logger.error(TAG, 'scan bridge qr failed: ' + message);
    this.addBridgeLogMessage(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_scan_bridge_qr_failed')) +
        ': ' + message
    );
  }

  private applyBridgeQrPayload(source: string, openSessionsAfterConnect: boolean = false): void {
    if (AgentHomeRelayUiPolicy.isRelayPairingUri(source)) {
      this.applyRelayPairingQrPayload(source.trim(), openSessionsAfterConnect);
      return;
    }
    const payload = this.parseBridgeQrPayload(source);
    if (payload.endpoint.trim().length === 0 || payload.token.trim().length === 0) {
      this.addBridgeLogMessage(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_scan_bridge_qr_invalid'))
      );
      return;
    }

    if (!this.hostEditorVisible) {
      this.beginAddHostProfile();
    }
    this.hostEndpointDraft = AgentBridgeClient.normalizeEndpointInput(payload.endpoint);
    this.hostCredentialDraft = payload.token.trim();
    if (this.hostDisplayNameDraft.length === 0) {
      this.hostDisplayNameDraft = payload.deviceName.length > 0 ? payload.deviceName : this.defaultHostProfileName(this.hostEndpointDraft);
    }
    this.pendingExpectedDeviceId = payload.physicalDeviceId.trim();
    this.pendingExpectedKeyFingerprint = payload.publicKeyFingerprint.trim();
    if (payload.providerId.trim().length > 0 && this.hasProvider(payload.providerId.trim())) {
      this.selectedProviderId = payload.providerId.trim();
      this.ensureSelectedRuntimeOptions();
    }
    this.workspacePathDraft = payload.workspacePath;
    this.workspaceTitleDraft = payload.workspaceTitle;
    this.addBridgeLogMessage(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_scan_bridge_qr_applied'))
    );
    try {
      this.getUIContext().getPromptAction().showToast({
        message: resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_scan_bridge_qr_applied'))
      });
    } catch (error) {
      logger.warn(TAG, 'show bridge qr applied toast failed: ' + this.errorToString(error));
    }
    this.pendingOpenSessionsSheetAfterBridgeQrConnect = openSessionsAfterConnect;
    this.saveHostProfileEditor(true);
  }

  private applyRelayPairingQrPayload(source: string, openSessionsAfterConnect: boolean): void {
    const offer: AgentBridgeRelayPairingOffer = AgentBridgeClient.parseRelayPairingUri(source);
    const publicEndpoint: string = AgentHomeRelayUiPolicy.safePublicEndpointFromPairing(
      source,
      AgentBridgeClient.buildRelayPublicEndpoint(offer)
    );
    const expiresAt: number = Date.parse(offer.expiresAt);
    if (publicEndpoint.length === 0 || !Number.isFinite(expiresAt) || expiresAt <= Date.now()) {
      this.addBridgeLogMessage(resolveResourceString(
        this.getUIContext().getHostContext(),
        $r('app.string.agent_home_relay_pairing_qr_invalid')
      ));
      return;
    }
    this.startRelayPairingHostConnection(source, offer, publicEndpoint, openSessionsAfterConnect).catch(
      (error: Error): void => {
        this.clearPendingRelayPairingConnection();
        logger.error(TAG, 'start Relay pairing connection failed: ' + this.errorToString(error));
        this.showTransientStatus(resolveResourceString(
          this.getUIContext().getHostContext(),
          $r('app.string.agent_home_relay_operation_failed')
        ));
      }
    );
  }

  private async startRelayPairingHostConnection(
    pairingUri: string,
    offer: AgentBridgeRelayPairingOffer,
    publicEndpoint: string,
    openSessionsAfterConnect: boolean
  ): Promise<void> {
    const existing: AgentHomeHostProfile | null = this.findHostProfileByEndpoint(publicEndpoint);
    const now: number = Date.now();
    const hostProfileId: string = existing !== null ? existing.hostProfileId : this.createHostProfileId();
    const displayName: string = offer.bridgeDisplayName.length > 0 ? offer.bridgeDisplayName :
      this.defaultHostProfileName(publicEndpoint);
    const profile: AgentHomeHostProfile = new AgentHomeHostProfile(
      hostProfileId,
      displayName,
      publicEndpoint,
      '',
      '',
      existing !== null && existing.providerId.length > 0 ? existing.providerId : this.selectedProviderId,
      existing !== null && existing.modelId.length > 0 ? existing.modelId : this.selectedModelId,
      existing !== null && existing.speedMode.length > 0 ? existing.speedMode : this.selectedSpeedMode,
      existing !== null && existing.reasoningMode.length > 0 ? existing.reasoningMode : this.selectedReasoningMode,
      existing !== null ? existing.activeWorkspaceId : '',
      existing !== null ? existing.activeSessionId : '',
      existing !== null ? existing.previewPath : '',
      existing !== null ? existing.lastDeviceId : '',
      existing !== null ? existing.lastServerId : '',
      false,
      AgentHomeHostIdentityStatus.UNBOUND,
      existing !== null && existing.createdAt > 0 ? existing.createdAt : now,
      now,
      now
    );
    const currentProfile: AgentHomeHostProfile | null = this.buildCurrentHostProfile();
    if (currentProfile !== null) {
      await this.persistence.saveHostProfile(currentProfile);
      this.upsertHostProfileState(currentProfile);
    }
    this.closeSessionWindowsForHost(this.activeHostProfileId, 'relay_pairing');
    this.hostSwitchCoordinator.begin(hostProfileId);
    this.hostSwitchStatus = AgentHomeHostSwitchStatus.QUIESCING;
    this.connectionEpoch = this.connectionEpoch + 1;
    this.quiesceCurrentHostConnection();
    this.releaseRelayLifecycleState();
    this.client.clearHandlers();
    this.client.disconnect();
    this.clearHostRuntimeState();
    await this.persistence.saveHostProfile(profile);
    this.upsertHostProfileState(profile);
    if (existing !== null && existing.credentialAlias.length > 0) {
      await this.removeOrQueueHostCredential(existing.credentialAlias);
    }
    this.hostSwitchCoordinator.markLoading();
    this.hostSwitchStatus = AgentHomeHostSwitchStatus.LOADING;
    await this.activateHostProfile(profile, false, '');
    this.pendingRelayPublicEndpoint = publicEndpoint;
    this.pendingRelayHostProfileId = hostProfileId;
    this.pendingOpenSessionsSheetAfterBridgeQrConnect = openSessionsAfterConnect;
    if (!this.scheduleRelayHostPairingExpiry(offer.expiresAt)) {
      throw new Error('relay_pairing_offer_expired');
    }
    this.bridgeConnectionAppNonce = this.createBridgeAppNonce();
    this.bridgeTrustState = AgentBridgeTrustState.UNKNOWN;
    this.currentBridgeServerId = '';
    this.currentBridgeServerInfo = null;
    const baseConfig: AgentBridgeConnectionConfig = new AgentBridgeConnectionConfig(
      publicEndpoint,
      '',
      AGENT_HOME_BRIDGE_CLIENT_ID,
      this.bridgeConnectionAppNonce,
      hostProfileId,
      this.appBuildVersion
    );
    if (!this.client.connectRelayPairingUri(pairingUri, baseConfig)) {
      throw new Error('relay_pairing_connection_rejected');
    }
    this.showTransientStatus(resolveResourceString(
      this.getUIContext().getHostContext(),
      $r('app.string.agent_home_relay_pairing_connecting')
    ));
  }

  private parseBridgeQrPayload(source: string): AgentBridgeQrPayload {
    const trimmed = source.trim();
    if (trimmed.startsWith('ngf-agent-bridge://connect?')) {
      return new AgentBridgeQrPayload(
        this.extractQueryParam(trimmed, 'endpoint'),
        this.extractQueryParam(trimmed, 'token'),
        this.extractQueryParam(trimmed, 'providerId'),
        this.extractQueryParam(trimmed, 'workspacePath'),
        this.extractQueryParam(trimmed, 'workspaceTitle'),
        this.extractQueryParam(trimmed, 'physicalDeviceId'),
        this.extractQueryParam(trimmed, 'bridgeInstanceId'),
        this.extractQueryParam(trimmed, 'deviceName'),
        this.extractQueryParam(trimmed, 'devicePlatform'),
        this.extractQueryParam(trimmed, 'publicKeyFingerprint')
      );
    }
    return new AgentBridgeQrPayload(
      this.extractJsonString(trimmed, 'endpoint'),
      this.extractJsonString(trimmed, 'token'),
      this.extractJsonString(trimmed, 'providerId'),
      this.extractJsonString(trimmed, 'workspacePath'),
      this.extractJsonString(trimmed, 'workspaceTitle'),
      this.extractJsonString(trimmed, 'physicalDeviceId'),
      this.extractJsonString(trimmed, 'bridgeInstanceId'),
      this.extractJsonString(trimmed, 'displayName'),
      this.extractJsonString(trimmed, 'platform'),
      this.extractJsonString(trimmed, 'publicKeyFingerprint')
    );
  }

  private extractQueryParam(source: string, key: string): string {
    const queryStart = source.indexOf('?');
    if (queryStart < 0 || queryStart + 1 >= source.length) {
      return '';
    }
    const query = source.substring(queryStart + 1);
    const pairs = query.split('&');
    for (let index = 0; index < pairs.length; index++) {
      const pair = pairs[index];
      const separator = pair.indexOf('=');
      const name = separator >= 0 ? pair.substring(0, separator) : pair;
      if (name === key) {
        const value = separator >= 0 ? pair.substring(separator + 1) : '';
        return this.decodeUriComponentSafe(value);
      }
    }
    return '';
  }

  private extractJsonString(source: string, key: string): string {
    const pattern = '"' + key + '"';
    const keyIndex = source.indexOf(pattern);
    if (keyIndex < 0) {
      return '';
    }
    const colonIndex = source.indexOf(':', keyIndex + pattern.length);
    if (colonIndex < 0) {
      return '';
    }
    let quoteIndex = colonIndex + 1;
    while (quoteIndex < source.length && source.charAt(quoteIndex) === ' ') {
      quoteIndex++;
    }
    if (quoteIndex >= source.length || source.charAt(quoteIndex) !== '"') {
      return '';
    }

    let result = '';
    let cursor = quoteIndex + 1;
    while (cursor < source.length) {
      const ch = source.charAt(cursor);
      if (ch === '"') {
        return result;
      }
      if (ch === '\\' && cursor + 1 < source.length) {
        const escaped = source.charAt(cursor + 1);
        if (escaped === 'n') {
          result = result + '\n';
        } else if (escaped === 'r') {
          result = result + '\r';
        } else if (escaped === 't') {
          result = result + '\t';
        } else {
          result = result + escaped;
        }
        cursor = cursor + 2;
      } else {
        result = result + ch;
        cursor = cursor + 1;
      }
    }
    return '';
  }

  private decodeUriComponentSafe(value: string): string {
    try {
      return decodeURIComponent(value.split('+').join(' '));
    } catch (error) {
      logger.warn(TAG, 'decode qr payload field failed: ' + this.errorToString(error));
    }
    return value;
  }

  private applyBridgeQrWorkspace(workspacePath: string, workspaceTitle: string): void {
    const path = workspacePath.trim();
    if (path.length === 0) {
      return;
    }
    const existing = this.findWorkspaceByPath(path);
    if (existing) {
      this.updateActiveWorkspaceId(existing.id);
      this.workspaceTitleDraft = existing.title;
      this.workspacePathDraft = existing.subtitle;
      return;
    }

    const title = workspaceTitle.trim().length > 0 ? workspaceTitle.trim() : this.workspaceTitleFromPath(path);
    const initial = title.length > 0 ? title.substring(0, 1) : 'W';
    const workspace = new AgentHomeWorkspaceItem(
      'workspace_qr_' + String(Date.now()),
      title,
      path,
      initial,
      '#2D6CDF',
      this.currentBranchName(),
      true
    );
    const nextWorkspaces: Array<AgentHomeWorkspaceItem> = [];
    for (let index = 0; index < this.workspaces.length; index++) {
      nextWorkspaces.push(this.workspaces[index]);
    }
    nextWorkspaces.push(workspace);
    this.workspaces = nextWorkspaces;
    this.updateActiveWorkspaceId(workspace.id);
    this.workspaceTitleDraft = workspace.title;
    this.workspacePathDraft = workspace.subtitle;
    this.persistence.saveWorkspace(workspace, this.activeHostProfileId).catch((error: Error): void => {
      logger.error(TAG, 'persist qr workspace failed: ' + this.errorToString(error));
    });
  }

  private supportsVoice(): boolean {
    const localCaptureAvailable: boolean = this.voiceSnapshot.capabilities.audioCapture;
    return localCaptureAvailable || this.supportsRemoteVoiceStt() || this.supportsRemoteVoiceTts();
  }

  private supportsVoiceInput(): boolean {
    return this.voiceSnapshot.capabilities.audioCapture || this.supportsRemoteVoiceStt();
  }

  private supportsVoicePlayback(): boolean {
    return this.voiceSnapshot.capabilities.audioPlayback || this.supportsRemoteVoiceTts();
  }

  private supportsRemoteVoiceStt(): boolean {
    if (this.connectionStatus !== AgentBridgeConnectionStatus.CONNECTED || this.currentBridgeServerInfo === null) {
      return false;
    }
    const features = this.currentBridgeServerInfo.features;
    if (features.voiceCapabilityMatrix) {
      return features.voiceRemoteSpeechToText;
    }
    return features.voiceRemoteSpeechToText || features.voiceSpeechToText || features.voice;
  }

  private supportsRemoteVoiceTts(): boolean {
    if (this.connectionStatus !== AgentBridgeConnectionStatus.CONNECTED || this.currentBridgeServerInfo === null) {
      return false;
    }
    const features = this.currentBridgeServerInfo.features;
    if (features.voiceCapabilityMatrix) {
      return features.voiceRemoteTextToSpeech;
    }
    return features.voiceRemoteTextToSpeech || features.voiceTextToSpeech || features.voice;
  }

  private shouldShowVoicePanel(): boolean {
    return this.voiceOperationPending || this.voiceTranscriptPending || this.voiceTranscriptDraft.length > 0 ||
      this.voiceSnapshot.state === NGFVoicePlatformState.RECORDING ||
      this.voiceSnapshot.state === NGFVoicePlatformState.FINISHING ||
      this.voiceSnapshot.state === NGFVoicePlatformState.SPEAKING ||
      this.voiceSnapshot.state === NGFVoicePlatformState.ERROR;
  }

  private voiceStatusText(): string {
    const hostContext = this.getUIContext().getHostContext();
    if (this.voiceSnapshot.state === NGFVoicePlatformState.RECORDING) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_voice_recording'));
    }
    if (this.isVoiceSpeechActive()) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_voice_speaking'));
    }
    if (this.voiceOperationPending) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_voice_transcribing'));
    }
    if (this.voiceSnapshot.failureCategory === 'permission_denied') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_voice_permission_denied'));
    }
    if (this.voiceTranscriptDraft.length > 0) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_voice_final_hint'));
    }
    if (this.voiceSnapshot.message.length > 0) {
      return this.voiceSnapshot.message;
    }
    return resolveResourceString(hostContext, $r('app.string.agent_home_voice_partial_hint'));
  }

  private voicePermissionRemediationText(): string {
    if (this.voiceSnapshot.capabilities.microphonePermission !== NGFVoicePermissionState.DENIED) {
      return '';
    }
    const hostContext = this.getUIContext().getHostContext();
    if (this.voiceSnapshot.capabilities.permissionRemediation === NGFVoicePermissionRemediation.OPEN_APP_PERMISSION_SETTINGS) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_voice_permission_remediation'));
    }
    return resolveResourceString(hostContext, $r('app.string.agent_home_voice_permission_denied'));
  }

  private voiceRetentionRiskText(): string {
    if (!this.voiceBridgeResult.privacyStatusAvailable || !this.voiceBridgeResult.privacy.userNoticeRequired) {
      return '';
    }
    const hostContext = this.getUIContext().getHostContext();
    return resolveResourceString(hostContext, $r('app.string.agent_home_voice_retention_unknown'));
  }

  private startVoiceInput(): void {
    if (!this.supportsVoiceInput() || this.voiceOperationPending) {
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_voice_unavailable')));
      return;
    }
    if (this.voiceSnapshot.state === NGFVoicePlatformState.RECORDING) {
      return;
    }
    this.voiceTranscriptDraft = '';
    this.voiceTranscriptPending = false;
    this.voiceOperationPending = true;
    this.voiceCaptureMode = '';
    const language: string = this.currentVoiceLanguage();
    ngfVoicePlatformFacade.initializeSpeech(language).then((capabilities): void => {
      this.voiceSnapshot = ngfVoicePlatformFacade.getSnapshot();
      if (capabilities.audioCapture && capabilities.speechRecognition) {
        this.voiceCaptureMode = AgentHomeVoiceMode.DEVICE_STT;
        const localSessionId: string = 'local_voice_' + String(Date.now());
        ngfVoicePlatformFacade.startRecording(localSessionId, language, AgentHomeVoiceMode.DEVICE_STT).then((started: boolean): void => {
          this.voiceOperationPending = false;
          if (!started) {
            this.voiceCaptureMode = '';
          }
        }).catch((error: Error): void => {
          this.voiceCaptureMode = '';
          this.voiceOperationPending = false;
          logger.warn(TAG, 'start local voice recording failed: ' + this.errorToString(error));
        });
        return;
      }
      if (capabilities.audioCapture && this.supportsRemoteVoiceStt()) {
        this.voiceCaptureMode = AgentHomeVoiceMode.REMOTE_STT;
        const requestId: string = this.client.startVoiceSession('', language);
        this.voiceRequestCoordinator.beginRemoteStart(requestId, this.activeHostProfileId, this.connectionEpoch);
        return;
      }
      this.voiceOperationPending = false;
      this.voiceCaptureMode = '';
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_voice_unavailable')));
    }).catch((error: Error): void => {
      this.voiceOperationPending = false;
      this.voiceCaptureMode = '';
      logger.warn(TAG, 'initialize voice platform failed: ' + this.errorToString(error));
    });
  }

  private finishVoiceInput(): void {
    const voiceSessionId = this.voiceSnapshot.sessionId;
    if (voiceSessionId.length === 0 || this.voiceOperationPending) {
      return;
    }
    this.voiceOperationPending = true;
    ngfVoicePlatformFacade.finishRecording().then((): void => {
      if (this.voiceCaptureMode === AgentHomeVoiceMode.REMOTE_STT) {
        const requestId: string = this.client.finishVoiceSession(voiceSessionId);
        this.voiceRequestCoordinator.beginRemoteFinish(requestId, voiceSessionId);
      } else {
        this.voiceOperationPending = false;
      }
    }).catch((error: Error): void => {
      this.voiceOperationPending = false;
      logger.warn(TAG, 'finish voice recording failed: ' + this.errorToString(error));
    });
  }

  private cancelVoiceInput(reason: string): void {
    const voiceSessionId = this.voiceSnapshot.sessionId;
    this.voiceOperationPending = false;
    this.voiceTranscriptPending = false;
    this.voiceTranscriptDraft = '';
    const captureMode: string = this.voiceCaptureMode;
    this.voiceCaptureMode = '';
    ngfVoicePlatformFacade.cancelRecording(reason).catch((error: Error): void => {
      logger.warn(TAG, 'cancel voice recording failed: ' + this.errorToString(error));
    });
    if (captureMode === AgentHomeVoiceMode.REMOTE_STT) {
      let requestId: string = '';
      if (voiceSessionId.length > 0 && this.connectionStatus === AgentBridgeConnectionStatus.CONNECTED) {
        requestId = this.client.cancelVoiceSession(voiceSessionId, reason);
      }
      this.voiceRequestCoordinator.beginRemoteCancel(requestId, voiceSessionId);
    }
  }

  private confirmVoiceTranscript(): void {
    const cleanText = this.voiceTranscriptDraft.trim();
    if (cleanText.length === 0) {
      return;
    }
    this.draftText = this.draftText.trim().length > 0 ? this.draftText + ' ' + cleanText : cleanText;
    this.voiceTranscriptDraft = '';
    this.voiceTranscriptPending = false;
    this.voiceOperationPending = false;
    this.voiceCaptureMode = '';
    this.focusComposer();
  }

  private toggleVoiceSpeech(): void {
    if (this.isVoiceSpeechActive()) {
      this.voiceTtsPlaybackCoordinator.invalidate();
      ngfVoicePlatformFacade.stopSpeaking('user_interrupt').catch((error: Error): void => {
        logger.warn(TAG, 'interrupt local TTS failed: ' + this.errorToString(error));
      });
      if (this.voiceTtsMode === AgentHomeVoiceMode.REMOTE_TTS &&
        (this.voiceBridgeResult.ttsRequestId.length > 0 || this.voiceTtsClientRequestId.length > 0)) {
        const cancelledClientRequestId: string = this.voiceTtsClientRequestId;
        const cancelledRpcRequestId: string = this.voiceTtsRpcRequestId;
        const cancelledBridgeRequestId: string = this.voiceBridgeResult.ttsRequestId;
        this.voiceTtsCancelledClientRequestId = cancelledClientRequestId;
        this.voiceTtsCancelledRpcRequestId = cancelledRpcRequestId;
        this.voiceTtsCancelledBridgeRequestId = cancelledBridgeRequestId;
        this.client.stopVoiceSpeech(
          cancelledBridgeRequestId,
          'user_interrupt',
          cancelledClientRequestId
        );
      }
      this.clearActiveVoiceTtsState();
      return;
    }
    const text = this.latestAssistantVoiceText();
    if (text.length === 0 || !this.supportsVoicePlayback()) {
      return;
    }
    const language: string = this.currentVoiceLanguage();
    const playbackHostProfileId: string = this.activeHostProfileId;
    const playbackConnectionEpoch: number = this.connectionEpoch;
    const playbackGeneration: number = this.voiceTtsPlaybackCoordinator.begin(
      playbackHostProfileId,
      playbackConnectionEpoch
    );
    this.voiceTtsClientRequestId = '';
    this.voiceTtsRpcRequestId = '';
    this.voiceTtsBridgeRequestId = '';
    this.voiceBridgeResult = new AgentBridgeVoiceResult();
    ngfVoicePlatformFacade.initializeSpeech(language).then((capabilities): void => {
      if (!this.voiceTtsPlaybackCoordinator.isCurrent(
        playbackGeneration,
        playbackHostProfileId,
        playbackConnectionEpoch
      )) {
        return;
      }
      if (capabilities.textToSpeech) {
        this.voiceTtsMode = AgentHomeVoiceMode.DEVICE_TTS;
        ngfVoicePlatformFacade.speak(text, language).catch((error: Error): void => {
          if (!this.voiceTtsPlaybackCoordinator.isCurrent(
            playbackGeneration,
            playbackHostProfileId,
            playbackConnectionEpoch
          )) {
            return;
          }
          this.voiceTtsMode = '';
          logger.warn(TAG, 'start local TTS failed: ' + this.errorToString(error));
        });
      } else if (this.supportsRemoteVoiceTts()) {
        this.voiceTtsMode = AgentHomeVoiceMode.REMOTE_TTS;
        this.voiceTtsClientRequestId = this.nextVoiceTtsClientRequestId();
        this.voiceTtsRpcRequestId = this.client.speakVoiceText('', text, language, this.voiceTtsClientRequestId);
      } else {
        this.voiceTtsMode = '';
        this.showTransientStatus(resolveResourceString(
          this.getUIContext().getHostContext(), $r('app.string.agent_home_voice_unavailable')));
      }
    }).catch((error: Error): void => {
      if (!this.voiceTtsPlaybackCoordinator.isCurrent(
        playbackGeneration,
        playbackHostProfileId,
        playbackConnectionEpoch
      )) {
        return;
      }
      logger.warn(TAG, 'initialize voice TTS failed: ' + this.errorToString(error));
    });
  }

  private latestAssistantVoiceText(): string {
    for (let index = this.messages.length - 1; index >= 0; index--) {
      const item = this.messages[index];
      if (item.role === AgentHomeMessageRole.ASSISTANT && item.text.trim().length > 0) {
        return item.text.trim();
      }
    }
    return '';
  }

  private currentVoiceLanguage(): string {
    const language: string = ngfI18nManagerFacade.getCurrentLocale();
    return language.toLowerCase().startsWith('en') ? 'en-US' : 'zh-CN';
  }

  private nextVoiceTtsClientRequestId(): string {
    this.voiceTtsClientSequence = this.voiceTtsClientSequence + 1;
    return 'app_tts_' + Date.now().toString() + '_' + this.voiceTtsClientSequence.toString();
  }

  private handleLocalVoiceSnapshot(snapshot: NGFVoicePlatformSnapshot): void {
    this.voiceSnapshot = snapshot;
    if (this.voiceTtsMode === AgentHomeVoiceMode.REMOTE_TTS &&
      this.voiceTtsPlaybackCoordinator.isPlaybackStarted() &&
      snapshot.ttsRequestId.length === 0 &&
      (snapshot.state === NGFVoicePlatformState.IDLE ||
        snapshot.state === NGFVoicePlatformState.ERROR ||
        snapshot.state === NGFVoicePlatformState.INTERRUPTED)) {
      const generation: number = this.voiceTtsPlaybackCoordinator.currentGeneration();
      if (this.voiceTtsPlaybackCoordinator.complete(generation, this.activeHostProfileId, this.connectionEpoch)) {
        this.clearActiveVoiceTtsState();
      }
    }
  }

  private handleLocalVoiceChunk(sessionId: string, sequence: number, chunk: Uint8Array): void {
    if (this.voiceCaptureMode !== AgentHomeVoiceMode.REMOTE_STT || sessionId.length === 0 ||
      this.connectionStatus !== AgentBridgeConnectionStatus.CONNECTED) {
      return;
    }
    const helper = new util.Base64Helper();
    const audioBase64 = helper.encodeToStringSync(chunk);
    this.client.sendVoiceChunk(sessionId, sequence - 1, audioBase64);
  }

  private handleLocalVoiceTranscript(sessionId: string, text: string, isFinal: boolean, isLast: boolean): void {
    if (this.voiceCaptureMode !== AgentHomeVoiceMode.DEVICE_STT ||
      sessionId !== this.voiceSnapshot.sessionId || text.trim().length === 0) {
      return;
    }
    this.voiceTranscriptDraft = text;
    this.voiceTranscriptPending = isFinal || isLast;
  }

  private applyBridgeVoiceResult(
    source: string,
    envelopeRequestId: string = '',
    isResponse: boolean = false
  ): void {
    const result = AgentBridgeIncomingParser.parseVoiceResult(source);
    const voiceMatch: AgentHomeVoiceRequestMatch = this.voiceRequestCoordinator.accept(
      result,
      envelopeRequestId,
      isResponse,
      this.activeHostProfileId,
      this.connectionEpoch
    );
    if (!voiceMatch.accepted) {
      logger.info(TAG, 'ignored stale remote voice result: action=' + result.action);
      return;
    }
    if (!this.isCurrentVoiceTtsResult(result, envelopeRequestId)) {
      logger.info(TAG, 'ignored stale remote TTS result');
      return;
    }
    const hasPlayableVoiceAudio: boolean = result.ok && result.audioBase64.length > 0 &&
      (result.action === AgentBridgeRequestType.VOICE_TTS_SPEAK ||
        result.action === AgentBridgeEventType.VOICE_TTS_UPDATED);
    let playbackGeneration: number = 0;
    let playbackHostProfileId: string = '';
    let playbackConnectionEpoch: number = 0;
    if (hasPlayableVoiceAudio) {
      const playbackIdentity: string = this.resolveVoiceTtsPlaybackIdentity(result, envelopeRequestId);
      playbackGeneration = this.voiceTtsPlaybackCoordinator.currentGeneration();
      playbackHostProfileId = this.activeHostProfileId;
      playbackConnectionEpoch = this.connectionEpoch;
      if (!this.voiceTtsPlaybackCoordinator.markPlaybackStarted(
        playbackGeneration,
        playbackHostProfileId,
        playbackConnectionEpoch,
        playbackIdentity
      )) {
        logger.info(TAG, 'ignored duplicate or unidentified remote TTS audio');
        return;
      }
    }
    this.voiceBridgeResult = result;
    if (!result.ok) {
      if (result.action === AgentBridgeRequestType.VOICE_TTS_SPEAK ||
        result.action === AgentBridgeRequestType.VOICE_TTS_STOP ||
        result.action === AgentBridgeEventType.VOICE_TTS_UPDATED) {
        this.clearActiveVoiceTtsState();
      }
      this.voiceOperationPending = false;
      const failedSnapshot = ngfVoicePlatformFacade.getSnapshot();
      failedSnapshot.failureCategory = result.failureCategory;
      failedSnapshot.message = result.message.length > 0 ? result.message : result.remediation;
      failedSnapshot.state = NGFVoicePlatformState.ERROR;
      failedSnapshot.updatedAt = Date.now();
      this.voiceSnapshot = failedSnapshot;
      if (this.isRemoteVoiceSessionAction(result.action)) {
        this.voiceRequestCoordinator.completeRemoteSession();
      }
      return;
    }
    if (result.action === AgentBridgeRequestType.VOICE_SESSION_START && result.sessionId.length > 0) {
      this.voiceCaptureMode = result.mode.length > 0 ? result.mode : AgentHomeVoiceMode.REMOTE_STT;
      ngfVoicePlatformFacade.startRecording(result.sessionId, this.currentVoiceLanguage(), this.voiceCaptureMode).then((started: boolean): void => {
        this.voiceOperationPending = false;
        if (!started) {
          const requestId: string = this.client.cancelVoiceSession(result.sessionId, 'local_capture_failed');
          this.voiceRequestCoordinator.beginRemoteCancel(requestId, result.sessionId);
        }
      }).catch((error: Error): void => {
        this.voiceOperationPending = false;
        const requestId: string = this.client.cancelVoiceSession(result.sessionId, 'local_capture_failed');
        this.voiceRequestCoordinator.beginRemoteCancel(requestId, result.sessionId);
        logger.warn(TAG, 'start local voice recording failed: ' + this.errorToString(error));
      });
      return;
    }
    if (hasPlayableVoiceAudio) {
      this.voiceTtsMode = AgentHomeVoiceMode.REMOTE_TTS;
      this.voiceTtsBridgeRequestId = result.ttsRequestId;
      ngfVoicePlatformFacade.playAudioBase64(
        result.audioBase64,
        result.mimeType,
        result.sampleRate > 0 ? result.sampleRate : 16000,
        result.channels > 0 ? result.channels : 1,
        result.sampleBits > 0 ? result.sampleBits : 16
      ).then((played: boolean): void => {
        if (!this.voiceTtsPlaybackCoordinator.isCurrent(
          playbackGeneration,
          playbackHostProfileId,
          playbackConnectionEpoch
        )) {
          return;
        }
        if (!played) {
          this.voiceTtsPlaybackCoordinator.complete(
            playbackGeneration,
            playbackHostProfileId,
            playbackConnectionEpoch
          );
          this.clearActiveVoiceTtsState();
        }
      }).catch((error: Error): void => {
        if (!this.voiceTtsPlaybackCoordinator.isCurrent(
          playbackGeneration,
          playbackHostProfileId,
          playbackConnectionEpoch
        )) {
          return;
        }
        this.voiceTtsPlaybackCoordinator.complete(
          playbackGeneration,
          playbackHostProfileId,
          playbackConnectionEpoch
        );
        this.clearActiveVoiceTtsState();
        logger.warn(TAG, 'play remote voice audio failed: ' + this.errorToString(error));
      });
    }
    if (result.transcript.length > 0) {
      this.voiceTranscriptDraft = result.transcript;
      this.voiceTranscriptPending = result.isFinal || result.action === AgentBridgeRequestType.VOICE_SESSION_FINISH ||
        result.action === AgentBridgeEventType.VOICE_TRANSCRIPT_FINAL;
    }
    if (result.action === AgentBridgeRequestType.VOICE_SESSION_FINISH ||
      result.action === AgentBridgeEventType.VOICE_TRANSCRIPT_FINAL ||
      result.action === AgentBridgeRequestType.VOICE_SESSION_CANCEL) {
      this.voiceOperationPending = false;
      if (result.action === AgentBridgeRequestType.VOICE_SESSION_CANCEL) {
        this.voiceCaptureMode = '';
      }
    }
    if (result.action === AgentBridgeRequestType.VOICE_SESSION_FINISH ||
      result.action === AgentBridgeEventType.VOICE_TRANSCRIPT_FINAL ||
      result.action === AgentBridgeRequestType.VOICE_SESSION_CANCEL) {
      this.voiceRequestCoordinator.completeRemoteSession();
    }
    if (result.action === AgentBridgeRequestType.VOICE_TTS_STOP && result.ok) {
      this.clearActiveVoiceTtsState();
    }
  }

  private isRemoteVoiceSessionAction(action: string): boolean {
    return action === AgentBridgeRequestType.VOICE_SESSION_START ||
      action === AgentBridgeRequestType.VOICE_SESSION_CHUNK ||
      action === AgentBridgeRequestType.VOICE_SESSION_FINISH ||
      action === AgentBridgeRequestType.VOICE_SESSION_CANCEL ||
      action === AgentBridgeEventType.VOICE_TRANSCRIPT_PARTIAL ||
      action === AgentBridgeEventType.VOICE_TRANSCRIPT_FINAL ||
      action === AgentBridgeEventType.VOICE_VAD_CHANGED ||
      action === AgentBridgeEventType.VOICE_SESSION_UPDATED;
  }

  private isVoiceSpeechActive(): boolean {
    return this.voiceSnapshot.state === NGFVoicePlatformState.SPEAKING ||
      (this.voiceTtsMode === AgentHomeVoiceMode.REMOTE_TTS &&
        this.voiceTtsPlaybackCoordinator.isActive());
  }

  private clearActiveVoiceTtsState(): void {
    this.voiceTtsMode = '';
    this.voiceTtsClientRequestId = '';
    this.voiceTtsRpcRequestId = '';
    this.voiceTtsBridgeRequestId = '';
  }

  private resolveVoiceTtsPlaybackIdentity(result: AgentBridgeVoiceResult, envelopeRequestId: string): string {
    const clientRequestId: string = result.clientRequestId.trim();
    if (clientRequestId.length > 0) {
      return clientRequestId;
    }
    const ttsRequestId: string = result.ttsRequestId.trim();
    if (ttsRequestId.length > 0) {
      return ttsRequestId;
    }
    return envelopeRequestId.trim();
  }

  private isCurrentVoiceTtsResult(result: AgentBridgeVoiceResult, envelopeRequestId: string): boolean {
    const isTtsResult: boolean = result.action === AgentBridgeRequestType.VOICE_TTS_SPEAK ||
      result.action === AgentBridgeRequestType.VOICE_TTS_STOP ||
      result.action === AgentBridgeEventType.VOICE_TTS_UPDATED;
    if (!isTtsResult) {
      return true;
    }
    if (!this.voiceTtsPlaybackCoordinator.isActive()) {
      return false;
    }
    if (result.clientRequestId.length > 0 && result.clientRequestId === this.voiceTtsCancelledClientRequestId) {
      return false;
    }
    if (result.clientRequestId.length > 0) {
      return result.clientRequestId === this.voiceTtsClientRequestId;
    }
    if (result.clientRequestId.length === 0 &&
      (this.voiceTtsCancelledClientRequestId.length > 0 || this.voiceTtsCancelledBridgeRequestId.length > 0) &&
      (result.ttsRequestId === this.voiceTtsCancelledBridgeRequestId || envelopeRequestId === this.voiceTtsCancelledRpcRequestId)) {
      return false;
    }
    if (this.voiceTtsClientRequestId.length === 0) {
      return false;
    }
    if (result.ttsRequestId.length > 0 && this.voiceTtsBridgeRequestId.length > 0) {
      return result.ttsRequestId === this.voiceTtsBridgeRequestId;
    }
    if (envelopeRequestId.length > 0 && this.voiceTtsRpcRequestId.length > 0) {
      return envelopeRequestId === this.voiceTtsRpcRequestId;
    }
    return false;
  }

  private handleSendMessage(): void {
    if (this.isReplyInProgress()) {
      this.handleStopReply();
      return;
    }
    const text = this.draftText.trim();
    if (text.length === 0 && this.attachments.length === 0) {
      return;
    }
    const outgoingContextItems = this.buildOutgoingContextItems(text);
    const outgoingText = this.buildOutgoingMessageText(text);
    const outgoingComposerTokensJson = this.composerTokensJson();
    this.draftText = '';
    this.attachments = [];
    this.composerTokens = [];
    this.resetActiveAssistantStream();

    if (this.connectionStatus !== AgentBridgeConnectionStatus.CONNECTED) {
      this.showTransientStatus(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_bridge_local_only'))
      );
      return;
    }

    const bridgeSessionId = this.currentBridgeSessionId();
    if (bridgeSessionId.length > 0) {
      this.addMessage(AgentHomeMessageRole.USER, '', outgoingText, '');
      this.touchActiveSession();
      this.markReplySubmitted();
      if (this.isOutgoingContextCompactionRequest(outgoingText)) {
        this.startContextCompactionStatus();
      }
      this.client.sendMessage(
        bridgeSessionId,
        outgoingText,
        this.selectedModelId,
        this.selectedSpeedMode,
        this.selectedReasoningMode,
        this.currentAgentRunMode(),
        this.currentSelectedInteractionModes(),
        this.currentOpenCodeAgent(),
        outgoingContextItems,
        this.nextClientMessageId(),
        outgoingComposerTokensJson
      );
      return;
    }

    this.pendingFirstMessage = outgoingText;
    this.pendingFirstContextItems = outgoingContextItems;
    this.pendingFirstComposerTokensJson = outgoingComposerTokensJson;
    this.showTransientStatus(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_bridge_session_creating'))
    );
    this.markReplySubmitted();
    if (this.isOutgoingContextCompactionRequest(outgoingText)) {
      this.startContextCompactionStatus();
    }
    this.pendingBridgeCreateProviderId = this.selectedProviderId;
    this.pendingBridgeCreateLocalSessionId = this.ensurePendingBridgeCreateSession();
    this.client.createSession(
      this.selectedProviderId,
      this.currentWorkspacePath(),
      this.currentWorkspaceTitle(),
      this.selectedModelId,
      this.selectedSpeedMode,
      this.selectedReasoningMode
    );
  }

  private ensurePendingBridgeCreateSession(): string {
    const currentSession = this.currentSession();
    if (currentSession !== null) {
      return currentSession.id;
    }
    this.sessionSequence = this.sessionSequence + 1;
    const workspace = this.currentWorkspace();
    const workspaceId = workspace !== null ? workspace.id : this.activeWorkspaceId;
    const workspaceTitle = workspace !== null ? workspace.title : '';
    const sessionTitle = workspaceTitle.length > 0 ? workspaceTitle :
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_new_session'));
    const session = new AgentHomeSessionItem(
      'local_session_' + String(Date.now()) + '_' + String(this.sessionSequence),
      workspaceId,
      sessionTitle,
      this.currentBranchName(),
      this.selectedProviderId,
      this.selectedModelId,
      this.selectedSpeedMode,
      this.selectedReasoningMode,
      '',
      Date.now()
    );
    this.upsertSession(session);
    this.activeSessionId = session.id;
    this.persistSession(session);
    this.persistProfile();
    return session.id;
  }

  private handleStopReply(): void {
    this.pendingFirstMessage = '';
    this.pendingFirstContextItems = [];
    this.pendingFirstComposerTokensJson = '';
    const bridgeSessionId = this.currentBridgeSessionId();
    if (bridgeSessionId.length > 0) {
      this.stoppedBridgeSessionId = bridgeSessionId;
    }
    if (bridgeSessionId.length === 0 || this.connectionStatus !== AgentBridgeConnectionStatus.CONNECTED) {
      this.finishLocalStopReply();
      return;
    }
    if (!this.currentProviderOption().supportsSessionAbort) {
      this.finishLocalStopReply();
      return;
    }
    this.client.abortSession(
      this.currentSessionProviderId(),
      bridgeSessionId,
      this.remoteSessionIdForAbort(bridgeSessionId)
    );
    this.showTransientStatus(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_stop_reply_requested'))
    );
    this.finishLocalStopReply();
  }

  private finishLocalStopReply(): void {
    this.publishAgentTaskInterruptedNotification(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_notification_interrupted_content'))
    );
    this.replyState = AgentHomeReplyState.IDLE;
    this.activeToolName = '';
    this.stopActiveTurnTimer();
    this.stopContextCompactionStatus();
    this.resetActiveAssistantStream();
  }

  private markReplySubmitted(): void {
    this.stoppedBridgeSessionId = '';
    this.assistantResponseStartedAt = 0;
    this.markActiveTurnActivity();
    this.replyState = AgentHomeReplyState.RESPONDING;
    this.activeToolName = '';
    this.startActiveTurnTimer();
    this.publishAgentTaskRunningNotification('');
  }

  private async pickImageAttachments(): Promise<void> {
    const uris = await ngfMediaPickerFacade.pickImages(6);
    this.appendPickedAttachments(uris, AgentHomeAttachmentKind.IMAGE);
    if (uris.length > 0) {
      this.closeSheet();
    }
  }

  private async pickDocumentAttachments(): Promise<void> {
    const uris = await ngfMediaPickerFacade.pickDocuments();
    this.appendPickedAttachments(uris, AgentHomeAttachmentKind.DOCUMENT);
    if (uris.length > 0) {
      this.closeSheet();
    }
  }

  private appendPickedAttachments(uris: Array<string>, kind: string): void {
    if (uris.length === 0) {
      return;
    }
    const nextItems: Array<AgentHomeAttachmentItem> = [];
    for (let index = 0; index < this.attachments.length; index++) {
      nextItems.push(this.attachments[index]);
    }
    for (let index = 0; index < uris.length; index++) {
      const uri = uris[index];
      if (uri.length === 0 || this.hasAttachmentUri(uri, nextItems)) {
        continue;
      }
      nextItems.push(this.buildAttachmentItem(uri, kind, index));
    }
    this.attachments = nextItems;
  }

  private buildAttachmentItem(uri: string, kind: string, ordinal: number): AgentHomeAttachmentItem {
    const displayName = this.extractAttachmentDisplayName(uri, kind);
    const extensionName = this.extractAttachmentExtension(displayName, kind);
    const id = 'attachment_' + kind + '_' + String(Date.now()) + '_' + String(ordinal);
    return new AgentHomeAttachmentItem(id, uri, displayName, extensionName, kind);
  }

  private removeAttachment(attachmentId: string): void {
    const nextItems: Array<AgentHomeAttachmentItem> = [];
    for (let index = 0; index < this.attachments.length; index++) {
      const item = this.attachments[index];
      if (item.id !== attachmentId) {
        nextItems.push(item);
      }
    }
    this.attachments = nextItems;
  }

  private hasAttachmentUri(uri: string, items: Array<AgentHomeAttachmentItem>): boolean {
    for (let index = 0; index < items.length; index++) {
      if (items[index].uri === uri) {
        return true;
      }
    }
    return false;
  }

  private extractAttachmentDisplayName(uri: string, kind: string): string {
    let normalized = uri;
    const queryIndex = normalized.indexOf('?');
    if (queryIndex >= 0) {
      normalized = normalized.substring(0, queryIndex);
    }
    while (normalized.endsWith('/') || normalized.endsWith('\\')) {
      normalized = normalized.substring(0, normalized.length - 1);
    }
    const slashIndex = normalized.lastIndexOf('/');
    const backslashIndex = normalized.lastIndexOf('\\');
    const segmentIndex = slashIndex > backslashIndex ? slashIndex : backslashIndex;
    if (segmentIndex >= 0 && segmentIndex + 1 < normalized.length) {
      const name = normalized.substring(segmentIndex + 1);
      if (name.length > 0) {
        return name;
      }
    }
    if (normalized.length > 0) {
      return normalized;
    }
    if (kind === AgentHomeAttachmentKind.IMAGE) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_attachment_image_fallback'));
    }
    return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_attachment_file_fallback'));
  }

  private extractAttachmentExtension(displayName: string, kind: string): string {
    const dotIndex = displayName.lastIndexOf('.');
    if (dotIndex >= 0 && dotIndex + 1 < displayName.length) {
      return displayName.substring(dotIndex + 1).toUpperCase();
    }
    if (kind === AgentHomeAttachmentKind.IMAGE) {
      return 'IMG';
    }
    return 'FILE';
  }

  private resolveAttachmentSymbol(item: AgentHomeAttachmentItem): Resource {
    if (item.kind === AgentHomeAttachmentKind.DOCUMENT) {
      return $r('sys.symbol.doc_plaintext');
    }
    return $r('sys.symbol.doc_plaintext');
  }

  private buildOutgoingContextItems(text: string): Array<AgentBridgeContextItem> {
    const items: Array<AgentBridgeContextItem> = [];
    const workspacePath = this.currentWorkspacePath();
    if (workspacePath.length > 0) {
      this.appendContextItemIfMissing(
        items,
        new AgentBridgeContextItem(
          'workspace',
          workspacePath,
          '',
          this.currentWorkspaceTitle(),
          '',
          'text/plain'
        )
      );
    }
    this.appendMentionContextItems(items, text);
    this.appendAttachmentContextItems(items);
    return items;
  }

  private appendMentionContextItems(items: Array<AgentBridgeContextItem>, text: string): void {
    const tokens = this.extractContextMentionTokens(text);
    for (let index = 0; index < tokens.length; index++) {
      const pathValue = tokens[index];
      this.appendContextItemIfMissing(
        items,
        new AgentBridgeContextItem(
          'file',
          pathValue,
          '',
          this.contextTitleForPath(pathValue),
          '',
          'text/plain'
        )
      );
    }
  }

  private appendAttachmentContextItems(items: Array<AgentBridgeContextItem>): void {
    for (let index = 0; index < this.attachments.length; index++) {
      const item = this.attachments[index];
      const kind = item.kind === AgentHomeAttachmentKind.IMAGE ? 'image' : 'file';
      this.appendContextItemIfMissing(
        items,
        new AgentBridgeContextItem(
          kind,
          this.pathFromAttachmentUri(item.uri),
          item.uri,
          item.displayName,
          '',
          this.mediaTypeForAttachment(item)
        )
      );
    }
  }

  private appendContextItemIfMissing(items: Array<AgentBridgeContextItem>, item: AgentBridgeContextItem): void {
    if (item.path.length === 0 && item.uri.length === 0 && item.content.length === 0) {
      return;
    }
    for (let index = 0; index < items.length; index++) {
      const existing = items[index];
      if (existing.kind === item.kind && existing.path === item.path && existing.uri === item.uri) {
        return;
      }
      if (item.path.length > 0 && existing.path === item.path) {
        return;
      }
    }
    items.push(item);
  }

  private extractContextMentionTokens(text: string): Array<string> {
    const items: Array<string> = [];
    let token = '';
    for (let index = 0; index < text.length; index++) {
      const ch = text.charAt(index);
      if (this.isContextTokenSeparator(ch)) {
        this.appendCleanContextMentionToken(items, token);
        token = '';
      } else {
        token = token + ch;
      }
    }
    this.appendCleanContextMentionToken(items, token);
    return items;
  }

  private appendCleanContextMentionToken(items: Array<string>, token: string): void {
    const cleanToken = this.cleanContextMentionToken(token);
    if (cleanToken.length === 0) {
      return;
    }
    for (let index = 0; index < items.length; index++) {
      if (items[index] === cleanToken) {
        return;
      }
    }
    items.push(cleanToken);
  }

  private cleanContextMentionToken(token: string): string {
    let value = token.trim();
    if (value.length <= 1 || value.charAt(0) !== '@') {
      return '';
    }
    value = value.substring(1);
    while (value.length > 0 && this.isContextTokenTrailingPunctuation(value.charAt(value.length - 1))) {
      value = value.substring(0, value.length - 1);
    }
    if (value.length === 0 || value.charAt(0) === '/') {
      return '';
    }
    return value;
  }

  private isContextTokenSeparator(value: string): boolean {
    return value === ' ' || value === '\n' || value === '\r' || value === '\t';
  }

  private isContextTokenTrailingPunctuation(value: string): boolean {
    return value === ',' || value === '.' || value === ';' || value === ':' ||
      value === ')' || value === ']' || value === '}';
  }

  private contextTitleForPath(pathValue: string): string {
    const slashIndex = pathValue.lastIndexOf('/');
    const backslashIndex = pathValue.lastIndexOf('\\');
    const index = slashIndex > backslashIndex ? slashIndex : backslashIndex;
    if (index >= 0 && index + 1 < pathValue.length) {
      return pathValue.substring(index + 1);
    }
    return pathValue;
  }

  private pathFromAttachmentUri(uri: string): string {
    if (uri.startsWith('file://')) {
      return uri.substring(7);
    }
    return uri;
  }

  private mediaTypeForAttachment(item: AgentHomeAttachmentItem): string {
    const extension = item.extensionName.toLowerCase();
    if (item.kind === AgentHomeAttachmentKind.IMAGE) {
      return 'image/' + (extension.length > 0 ? extension : 'png');
    }
    if (extension.length > 0) {
      return 'text/' + extension;
    }
    return 'text/plain';
  }

  private buildOutgoingMessageText(text: string): string {
    let content = text;
    if (this.attachments.length === 0) {
      return content;
    }
    if (content.length > 0) {
      content = content + '\n\n';
    }
    content = content + 'Attachments:';
    for (let index = 0; index < this.attachments.length; index++) {
      const item = this.attachments[index];
      const label = item.kind === AgentHomeAttachmentKind.IMAGE ? 'image' : 'file';
      let line = '\n- ' + label + ': ' + item.displayName;
      if (item.uri !== item.displayName) {
        line = line + ' (' + item.uri + ')';
      }
      content = content + line;
    }
    return content;
  }

  private isOutgoingContextCompactionRequest(text: string): boolean {
    const trimmed = text.trim().toLowerCase();
    return trimmed === '/compact' || trimmed.startsWith('/compact ') ||
      trimmed === '/summarize' || trimmed.startsWith('/summarize ');
  }

  private updateContextCompactionFromBridgeText(text: string): void {
    const value = text.toLowerCase();
    if (this.isContextCompactionEndText(value)) {
      this.stopContextCompactionStatus();
      return;
    }
    if (this.isContextCompactionStartText(value)) {
      this.startContextCompactionStatus();
    }
  }

  private isContextCompactionStartText(value: string): boolean {
    if (value.indexOf('context.compacting') >= 0 || value.indexOf('compact.started') >= 0 ||
      value.indexOf('compaction.started') >= 0) {
      return true;
    }
    const hasCompactTerm = value.indexOf('/compact') >= 0 || value.indexOf('compacting') >= 0 ||
      value.indexOf('compact context') >= 0 || value.indexOf('summariz') >= 0;
    if (!hasCompactTerm) {
      return false;
    }
    return value.indexOf('context') >= 0 || value.indexOf('/compact') >= 0;
  }

  private isContextCompactionEndText(value: string): boolean {
    if (this.isContextCompacting && (value.indexOf('"event":"message.completed"') >= 0 ||
      value.indexOf('"type":"session.idle"') >= 0)) {
      return true;
    }
    return value.indexOf('context.compacted') >= 0 || value.indexOf('context.compaction.completed') >= 0 ||
      value.indexOf('compact.completed') >= 0 || value.indexOf('compaction.completed') >= 0 ||
      value.indexOf('context compressed') >= 0 || value.indexOf('summarization completed') >= 0;
  }

  private handleRequestPreview(): void {
    const bridgeSessionId = this.currentBridgeSessionId();
    if (this.connectionStatus !== AgentBridgeConnectionStatus.CONNECTED || bridgeSessionId.length === 0) {
      this.showTransientStatus(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_preview_requires_session'))
      );
      return;
    }

    const path = this.previewPath.trim();
    this.persistProfile();
    this.client.requestPreview(bridgeSessionId, path);
    this.showTransientStatus(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_preview_requested')) + ': ' + path
    );
  }

  private handleBridgeStatus(status: string, detail: string): void {
    this.connectionStatus = status;
    this.bridgeConnectionReasonText = this.buildBridgeConnectionReasonText(status, detail);
    this.refreshHostWorkspaceGroups().catch((error: Error): void => {
      logger.warn(TAG, 'refresh host connection group failed: ' + this.errorToString(error));
    });
    if (status === AgentBridgeConnectionStatus.CONNECTING) {
      this.pendingRemoteSessionsRefresh = false;
      this.replyState = AgentHomeReplyState.IDLE;
      this.activeToolName = '';
      this.activeSubagentName = '';
    }
    if (status === AgentBridgeConnectionStatus.DISCONNECTED || status === AgentBridgeConnectionStatus.ERROR) {
      this.resetPushRegistrationForConnection();
      if (status === AgentBridgeConnectionStatus.ERROR) {
        this.publishAgentTaskErrorNotification(this.buildBridgeConnectionReasonText(status, detail));
      } else {
        this.publishAgentTaskInterruptedNotification(this.buildBridgeConnectionReasonText(status, detail));
      }
      this.replyState = AgentHomeReplyState.IDLE;
      this.activeToolName = '';
      this.activeSubagentName = '';
      this.pendingRemoteSessionsRequestPairs = [];
      this.pendingRemoteSessionsRefresh = false;
      this.pendingTerminalCreateRequestIds = [];
      this.loadingRemoteSessions = false;
      this.pendingOpenSessionsSheetAfterBridgeQrConnect = false;
      this.clearTerminalConnectionSlots();
      this.finishPersistentStateLoading();
      this.stopActiveTurnTimer();
      this.stopContextCompactionStatus();
    }
    if (
      status === AgentBridgeConnectionStatus.CONNECTING ||
        status === AgentBridgeConnectionStatus.DISCONNECTED ||
        status === AgentBridgeConnectionStatus.ERROR
    ) {
      this.addBridgeLogMessage(this.buildConnectionStatusLogText(detail));
    }
    if (status === AgentBridgeConnectionStatus.CONNECTED) {
      if (this.pendingRelayHostProfileId.length > 0) {
        this.completePendingRelayHostProfile().catch((error: Error): void => {
          logger.error(TAG, 'complete Relay host profile failed: ' + this.errorToString(error));
        });
      }
      if (this.pendingOpenSessionsSheetAfterBridgeQrConnect) {
        this.pendingOpenSessionsSheetAfterBridgeQrConnect = false;
        this.openSheet(AgentHomeSheetKey.SESSIONS);
      } else if (this.hasTrustedActiveDevice()) {
        this.requestRemoteSessions();
      } else {
        this.pendingRemoteSessionsRefresh = true;
      }
      const requestedHistory = this.hasTrustedActiveDevice() ? this.refreshActiveSessionHistory() : false;
      if (!requestedHistory) {
        this.finishPersistentStateLoading();
      }
    }
  }

  private handleBridgeError(message: string): void {
    this.connectionStatus = AgentBridgeConnectionStatus.ERROR;
    this.bridgeConnectionReasonText = this.buildBridgeConnectionReasonText(AgentBridgeConnectionStatus.ERROR, message);
    this.replyState = AgentHomeReplyState.IDLE;
    this.activeToolName = '';
    this.activeSubagentName = '';
    this.pendingRemoteSessionsRequestPairs = [];
    this.pendingRemoteSessionsRefresh = false;
    this.pendingTerminalCreateRequestIds = [];
    this.loadingRemoteSessions = false;
    this.pendingOpenSessionsSheetAfterBridgeQrConnect = false;
    this.clearTerminalConnectionSlots();
    this.finishPersistentStateLoading();
    this.publishAgentTaskErrorNotification(this.bridgeConnectionReasonText);
    this.stopActiveTurnTimer();
    this.stopContextCompactionStatus();
    if (this.isConversationRenderPending && this.activeSessionId.length > 0) {
      this.scheduleConversationRenderReady(this.activeSessionId);
    }
    this.addBridgeLogMessage(message);
  }

  private handleLegacyBridgeDeviceHandshake(): void {
    if (this.bridgeTrustState === AgentBridgeTrustState.LEGACY_LIMITED) {
      return;
    }
    this.bridgeTrustState = AgentBridgeTrustState.LEGACY_LIMITED;
    this.activeDeviceId = '';
    this.addBridgeLogMessage(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_bridge_legacy_limited'))
    );
  }

  private handleBridgeDeviceHandshake(text: string): void {
    const handshake = AgentBridgeIncomingParser.parseDeviceHandshake(text);
    this.applyBridgeDeviceHandshake(handshake).catch((error: Error): void => {
      logger.error(TAG, 'apply bridge device handshake failed: ' + this.errorToString(error));
      this.bridgeTrustState = AgentBridgeTrustState.UNTRUSTED;
      this.addBridgeLogMessage(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_bridge_untrusted_device'))
      );
    });
  }

  private async applyBridgeDeviceHandshake(handshake: AgentBridgeDeviceHandshake): Promise<void> {
    if (!this.isBridgeDeviceHandshakeAcceptable(handshake)) {
      this.bridgeTrustState = AgentBridgeTrustState.UNTRUSTED;
      this.activeDeviceId = '';
      this.addBridgeLogMessage(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_bridge_untrusted_device'))
      );
      return;
    }
    if (!(await this.isBridgeDevicePublicKeyFingerprintAcceptable(handshake.identity))) {
      this.bridgeTrustState = AgentBridgeTrustState.UNTRUSTED;
      this.activeDeviceId = '';
      this.addBridgeLogMessage(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_bridge_untrusted_device'))
      );
      return;
    }
    const identity = handshake.identity;
    const activeHost = this.findHostProfile(this.activeHostProfileId);
    if (
      activeHost !== null && activeHost.lastDeviceId.length > 0 &&
        activeHost.lastDeviceId !== identity.physicalDeviceId
    ) {
      activeHost.identityStatus = AgentHomeHostIdentityStatus.MISMATCH;
      activeHost.updatedAt = Date.now();
      await this.persistence.saveHostProfile(activeHost);
      this.upsertHostProfileState(activeHost);
      this.client.disconnect();
      this.bridgeTrustState = AgentBridgeTrustState.UNTRUSTED;
      this.connectionStatus = AgentBridgeConnectionStatus.ERROR;
      this.bridgeConnectionReasonText = 'host_identity_mismatch';
      return;
    }
    const previous = this.findTrustedDeviceById(identity.physicalDeviceId);
    const now = Date.now();
    const firstTrustedAt = previous ? previous.firstTrustedAt : now;
    const trustedDevice = new AgentBridgeTrustedDevice(
      identity.physicalDeviceId,
      identity.bridgeInstanceId,
      identity.displayName.length > 0 ? identity.displayName : identity.physicalDeviceId,
      identity.platform,
      identity.publicKeyPem,
      identity.publicKeyFingerprint,
      this.bridgeEndpoint,
      await this.bridgeTokenDigest(this.activeBridgeCredential),
      AgentBridgeTrustState.TRUSTED,
      firstTrustedAt,
      now
    );
    this.upsertTrustedDeviceState(trustedDevice);
    this.activeDeviceId = trustedDevice.deviceId;
    this.lastDeviceId = trustedDevice.deviceId;
    this.bridgeTrustState = AgentBridgeTrustState.TRUSTED;
    this.pendingExpectedDeviceId = '';
    this.pendingExpectedKeyFingerprint = '';
    await this.persistence.saveTrustedDevice(trustedDevice);
    if (activeHost !== null) {
      activeHost.lastDeviceId = trustedDevice.deviceId;
      activeHost.identityStatus = AgentHomeHostIdentityStatus.VERIFIED;
      activeHost.updatedAt = Date.now();
      await this.persistence.saveHostProfile(activeHost);
      this.upsertHostProfileState(activeHost);
    }
    await this.persistence.migrateLegacyRemoteSessionsToDevice(trustedDevice.deviceId);
    this.migrateLegacyWorkspaceStateToDevice(trustedDevice.deviceId);
    this.persistProfile();
    this.addBridgeLogMessage(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_bridge_trusted_device_applied')) +
        trustedDevice.displayName
    );
    if (this.connectionStatus === AgentBridgeConnectionStatus.CONNECTED) {
      this.requestRemoteSessions();
      const requestedHistory = this.refreshActiveSessionHistory();
      if (!requestedHistory) {
        this.finishPersistentStateLoading();
      }
      this.bootstrapTrustedBridgeV2();
    }
  }

  private isBridgeDeviceHandshakeAcceptable(handshake: AgentBridgeDeviceHandshake): boolean {
    const identity = handshake.identity;
    if (
      identity.physicalDeviceId.length === 0 ||
        identity.bridgeInstanceId.length === 0 ||
        identity.publicKeyPem.length === 0 ||
        identity.publicKeyFingerprint.length === 0
    ) {
      logger.warn(TAG, 'bridge device handshake rejected: missing identity field');
      return false;
    }
    if (identity.keyType.length > 0 && identity.keyType !== 'ECDSA_P256') {
      logger.warn(TAG, 'bridge device handshake rejected: unsupported identity key type ' + identity.keyType);
      return false;
    }
    if (this.pendingExpectedDeviceId.length > 0 && this.pendingExpectedDeviceId !== identity.physicalDeviceId) {
      logger.warn(TAG, 'bridge device handshake rejected: expected device mismatch');
      return false;
    }
    if (this.pendingExpectedKeyFingerprint.length > 0 && this.pendingExpectedKeyFingerprint !== identity.publicKeyFingerprint) {
      logger.warn(TAG, 'bridge device handshake rejected: expected fingerprint mismatch');
      return false;
    }
    const existing = this.findTrustedDeviceById(identity.physicalDeviceId);
    const matchesPinnedQrIdentity =
      this.pendingExpectedDeviceId.length > 0 &&
        this.pendingExpectedKeyFingerprint.length > 0 &&
        this.pendingExpectedDeviceId === identity.physicalDeviceId &&
        this.pendingExpectedKeyFingerprint === identity.publicKeyFingerprint;
    const updatesTrustedFingerprint =
      existing !== null &&
        existing.publicKeyFingerprint.length > 0 &&
        existing.publicKeyFingerprint !== identity.publicKeyFingerprint;
    if (
      updatesTrustedFingerprint && !matchesPinnedQrIdentity
    ) {
      logger.warn(TAG, 'bridge device handshake rejected: trusted fingerprint changed');
      return false;
    }
    const proof = handshake.proof;
    if (
      proof.appNonce.length === 0 ||
        proof.signature.length === 0 ||
        proof.material.length === 0 ||
        proof.serverNonce.length === 0 ||
        proof.issuedAt <= 0
    ) {
      logger.warn(TAG, 'bridge device handshake rejected: missing proof field');
      return false;
    }
    if (this.bridgeConnectionAppNonce.length > 0 && proof.appNonce !== this.bridgeConnectionAppNonce) {
      logger.warn(TAG, 'bridge device handshake rejected: app nonce mismatch');
      return false;
    }
    if (!this.isBridgeProofMetadataAcceptable(identity, proof)) {
      return false;
    }
    if (!this.isBridgeProofMaterialAcceptable(identity, proof)) {
      return false;
    }
    const verified = securityToolkit.verifyEcdsaP256Sha256(identity.publicKeyPem, proof.material, proof.signature);
    if (!verified) {
      logger.warn(TAG, 'bridge device handshake rejected: ECDSA signature verification failed');
    } else if (updatesTrustedFingerprint) {
      logger.info(TAG, 'bridge device fingerprint update accepted from pinned QR identity');
    }
    return verified;
  }

  private async isBridgeDevicePublicKeyFingerprintAcceptable(identity: AgentBridgeDeviceIdentity): Promise<boolean> {
    if (identity.publicKeyPem.length === 0 || identity.publicKeyFingerprint.length === 0) {
      return false;
    }
    try {
      const fingerprint = await securityToolkit.shaHash(identity.publicKeyPem);
      if (fingerprint !== identity.publicKeyFingerprint) {
        logger.warn(TAG, 'bridge device handshake rejected: public key fingerprint mismatch');
        return false;
      }
      return true;
    } catch (error) {
      logger.warn(TAG, 'bridge device public key fingerprint check failed: ' + this.errorToString(error));
      return false;
    }
  }

  private isBridgeProofMetadataAcceptable(identity: AgentBridgeDeviceIdentity, proof: AgentBridgeConnectionProof): boolean {
    if (proof.keyType.length > 0 && proof.keyType !== 'ECDSA_P256') {
      logger.warn(TAG, 'bridge device handshake rejected: unsupported proof key type ' + proof.keyType);
      return false;
    }
    if (identity.keyType.length > 0 && proof.keyType.length > 0 && proof.keyType !== identity.keyType) {
      logger.warn(TAG, 'bridge device handshake rejected: proof key type mismatch');
      return false;
    }
    if (proof.curve.length > 0 && proof.curve !== 'ECC256') {
      logger.warn(TAG, 'bridge device handshake rejected: unsupported proof curve ' + proof.curve);
      return false;
    }
    if (proof.encoding.length > 0 && proof.encoding !== 'asn1-der') {
      logger.warn(TAG, 'bridge device handshake rejected: unsupported proof encoding ' + proof.encoding);
      return false;
    }
    const verifier = this.bridgeProofVerifierName(proof);
    if (verifier !== AGENT_HOME_BRIDGE_PROOF_VERIFIER) {
      logger.warn(TAG, 'bridge device handshake rejected: unsupported proof verifier ' + verifier);
      return false;
    }
    return true;
  }

  private bridgeProofVerifierName(proof: AgentBridgeConnectionProof): string {
    if (proof.verifier.length > 0) {
      return proof.verifier;
    }
    if (proof.keyType === 'ECDSA_P256' && proof.algorithm === 'SHA256') {
      return AGENT_HOME_BRIDGE_PROOF_VERIFIER;
    }
    return '';
  }

  private isBridgeProofMaterialAcceptable(identity: AgentBridgeDeviceIdentity, proof: AgentBridgeConnectionProof): boolean {
    const expectedEndpoint = this.normalizeHostEndpoint(this.bridgeEndpoint);
    const hasExpectedMaterial =
      this.bridgeProofMaterialContains(proof.material, 'protocolVersion', AGENT_HOME_BRIDGE_PROOF_PROTOCOL) &&
        this.bridgeProofMaterialContains(proof.material, 'physicalDeviceId', identity.physicalDeviceId) &&
        this.bridgeProofMaterialContains(proof.material, 'bridgeInstanceId', identity.bridgeInstanceId) &&
        this.bridgeProofMaterialContains(proof.material, 'endpoint', expectedEndpoint) &&
        this.bridgeProofMaterialContains(proof.material, 'clientId', AGENT_HOME_BRIDGE_CLIENT_ID) &&
        this.bridgeProofMaterialContains(proof.material, 'appNonce', proof.appNonce) &&
        this.bridgeProofMaterialContains(proof.material, 'serverNonce', proof.serverNonce) &&
        this.bridgeProofMaterialContains(proof.material, 'issuedAt', String(proof.issuedAt));
    if (!hasExpectedMaterial) {
      logger.warn(TAG, 'bridge device handshake rejected: proof material mismatch');
    }
    return hasExpectedMaterial;
  }

  private bridgeProofMaterialContains(material: string, key: string, value: string): boolean {
    return value.length > 0 && material.indexOf(key + '=' + value) >= 0;
  }

  private findTrustedDeviceById(deviceId: string): AgentBridgeTrustedDevice | null {
    for (let index = 0; index < this.trustedDevices.length; index++) {
      const item = this.trustedDevices[index];
      if (item.deviceId === deviceId) {
        return item;
      }
    }
    return null;
  }

  private upsertTrustedDeviceState(device: AgentBridgeTrustedDevice): void {
    const nextItems: Array<AgentBridgeTrustedDevice> = [];
    let replaced = false;
    for (let index = 0; index < this.trustedDevices.length; index++) {
      const item = this.trustedDevices[index];
      if (item.deviceId === device.deviceId) {
        nextItems.push(device);
        replaced = true;
      } else {
        nextItems.push(item);
      }
    }
    if (!replaced) {
      nextItems.push(device);
    }
    this.trustedDevices = nextItems;
  }

  private migrateLegacyWorkspaceStateToDevice(deviceId: string): void {
    if (deviceId.length === 0) {
      return;
    }
    const oldWorkspaceIds: Array<string> = [];
    const newWorkspaceIds: Array<string> = [];
    const nextWorkspaces: Array<AgentHomeWorkspaceItem> = [];
    for (let index = 0; index < this.workspaces.length; index++) {
      const item = this.workspaces[index];
      const nextWorkspaceId = this.workspaceIdForPathWithDevice(item.subtitle, deviceId);
      if (nextWorkspaceId.length > 0 && item.id !== nextWorkspaceId && item.id.indexOf('workspace_device_') !== 0) {
        oldWorkspaceIds.push(item.id);
        newWorkspaceIds.push(nextWorkspaceId);
        nextWorkspaces.push(new AgentHomeWorkspaceItem(
          nextWorkspaceId,
          item.title,
          item.subtitle,
          item.initial,
          item.accentColor,
          item.branchName,
          item.isOnline
        ));
      } else {
        nextWorkspaces.push(item);
      }
    }
    if (oldWorkspaceIds.length === 0) {
      return;
    }
    const nextSessions: Array<AgentHomeSessionItem> = [];
    for (let index = 0; index < this.sessions.length; index++) {
      const session = this.sessions[index];
      nextSessions.push(new AgentHomeSessionItem(
        session.id,
        this.mappedWorkspaceId(session.workspaceId, oldWorkspaceIds, newWorkspaceIds),
        session.title,
        session.branchName,
        session.providerId,
        session.modelId,
        session.speedMode,
        session.reasoningMode,
        session.bridgeSessionId,
        session.updatedAt
      ));
    }
    this.workspaces = nextWorkspaces;
    this.sessions = nextSessions;
    this.updateActiveWorkspaceId(this.mappedWorkspaceId(this.activeWorkspaceId, oldWorkspaceIds, newWorkspaceIds));
    this.persistence.replaceWorkspaceSessionState(
      nextWorkspaces,
      nextSessions,
      oldWorkspaceIds,
      newWorkspaceIds,
      this.activeHostProfileId
    ).catch((error: Error): void => {
      logger.error(TAG, 'migrate legacy workspace state failed: ' + this.errorToString(error));
    });
  }

  private mappedWorkspaceId(workspaceId: string, oldWorkspaceIds: Array<string>, newWorkspaceIds: Array<string>): string {
    for (let index = 0; index < oldWorkspaceIds.length; index++) {
      if (workspaceId === oldWorkspaceIds[index]) {
        return newWorkspaceIds[index];
      }
    }
    return workspaceId;
  }

  private currentTrustedDevice(): AgentBridgeTrustedDevice | null {
    if (this.activeDeviceId.length > 0) {
      return this.findTrustedDeviceById(this.activeDeviceId);
    }
    if (this.lastDeviceId.length > 0) {
      return this.findTrustedDeviceById(this.lastDeviceId);
    }
    return null;
  }

  private hasTrustedActiveDevice(): boolean {
    if (this.bridgeTrustState !== AgentBridgeTrustState.TRUSTED || this.activeDeviceId.length === 0) {
      return false;
    }
    return this.findTrustedDeviceById(this.activeDeviceId) !== null;
  }

  private currentTrustedDeviceName(): string {
    const device = this.currentTrustedDevice();
    if (device) {
      return device.displayName;
    }
    return '';
  }

  private currentTrustedDeviceStateText(): string {
    if (this.bridgeTrustState === AgentBridgeTrustState.TRUSTED) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_trusted_device_state_trusted'));
    }
    if (this.bridgeTrustState === AgentBridgeTrustState.LEGACY_LIMITED) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_trusted_device_state_legacy'));
    }
    if (this.bridgeTrustState === AgentBridgeTrustState.UNTRUSTED) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_trusted_device_state_untrusted'));
    }
    return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_trusted_device_state_unknown'));
  }

  private currentTrustedDeviceFingerprintText(): string {
    const device = this.currentTrustedDevice();
    if (!device || device.publicKeyFingerprint.length === 0) {
      return '';
    }
    if (device.publicKeyFingerprint.length <= 16) {
      return device.publicKeyFingerprint;
    }
    return device.publicKeyFingerprint.substring(0, 16);
  }

  private currentTrustedDeviceEndpointText(): string {
    const device = this.currentTrustedDevice();
    if (device && device.lastEndpoint.length > 0) {
      return device.lastEndpoint;
    }
    return this.bridgeEndpoint;
  }

  private removeActiveTrustedDevice(): void {
    if (this.activeDeviceId.length === 0) {
      return;
    }
    const removedDeviceId = this.activeDeviceId;
    const nextItems: Array<AgentBridgeTrustedDevice> = [];
    for (let index = 0; index < this.trustedDevices.length; index++) {
      const item = this.trustedDevices[index];
      if (item.deviceId !== removedDeviceId) {
        nextItems.push(item);
      }
    }
    this.trustedDevices = nextItems;
    this.activeDeviceId = '';
    if (this.lastDeviceId === removedDeviceId) {
      this.lastDeviceId = '';
    }
    this.bridgeTrustState = AgentBridgeTrustState.UNKNOWN;
    this.persistProfile();
    this.persistence.deleteTrustedDevice(removedDeviceId).catch((error: Error): void => {
      logger.error(TAG, 'delete trusted bridge device failed: ' + this.errorToString(error));
    });
    this.addBridgeLogMessage(
      resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_trusted_device_removed'))
    );
  }

  private handleBridgeText(text: string): void {
    const parsed = AgentBridgeIncomingParser.parse(text);
    const relayMessage = this.isRelayBridgeMessage(text, parsed);
    const serviceAccessMessage = text.indexOf('"accessUrl"') >= 0 || text.indexOf('"ticket"') >= 0;
    const compactText = relayMessage || serviceAccessMessage ? '' : this.compactText(text);
    logger.info(TAG, relayMessage ? 'relay bridge event received: ' + parsed.eventType :
      serviceAccessMessage ? 'sensitive bridge response received' : 'bridge event received: ' + compactText);
    if (!relayMessage && this.isBridgeM7Message(text, parsed)) {
      this.applyBridgeM7Result(text, parsed);
    }
    if (parsed.eventType === AgentBridgeEventType.WORKSPACE_SERVICE_UPDATED ||
      text.indexOf('"services":[') >= 0 || text.indexOf('"proxyPath"') >= 0 ||
      this.workspaceServicePending && text.indexOf('"serviceId"') >= 0) {
      this.applyWorkspaceServiceResult(text, parsed);
    }
    if (parsed.eventType === AgentBridgeEventType.BROWSER_UPDATED ||
      text.indexOf('"supportedCommands"') >= 0 && text.indexOf('"hosts"') >= 0 ||
      text.indexOf('"pages"') >= 0 && text.indexOf('"pageId"') >= 0 ||
      text.indexOf('"snapshot"') >= 0 && text.indexOf('"nodeCount"') >= 0 ||
      text.indexOf('"screenshot"') >= 0 && text.indexOf('"mimeType"') >= 0 ||
      text.indexOf('"downloadDirectory"') >= 0 && text.indexOf('"domains"') >= 0 ||
      this.browserAutomationPending && text.indexOf('"browser_') >= 0) {
      this.applyBrowserAutomationResult(text, parsed);
    }
    if (!relayMessage && (text.indexOf('"action":"voice.') >= 0 || text.indexOf('"event":"voice.') >= 0)) {
      this.applyBridgeVoiceResult(
        text,
        parsed.requestId,
        parsed.envelopeType === AgentBridgeEnvelopeType.RESPONSE
      );
    }
    if (this.handleBridgeResponseErrorIfNeeded(text, parsed)) {
      return;
    }
    if (relayMessage) {
      this.applyRelayResult(text, parsed);
      return;
    }
    const isCurrentEvent = this.isCurrentBridgeEvent(parsed);
    const isStoppedReplyEvent = this.shouldIgnoreStoppedReplyEvent(parsed);
    const isMessageImportPayload = text.indexOf('"messages":[') >= 0;
    if (text.indexOf('"serverInfo":{') >= 0 || parsed.eventType === AgentBridgeEventType.SERVER_INFO) {
      this.applyBridgeServerInfo(text);
    }
    if (
      parsed.eventType === AgentBridgeEventType.NOTIFICATION_PUSH_UPDATED ||
        text.indexOf('"action":"notification.push.status"') >= 0 ||
        text.indexOf('"action":"notification.push.register"') >= 0 ||
        text.indexOf('"action":"notification.push.unregister"') >= 0 ||
        text.indexOf('"action":"notification.push.deliver"') >= 0
    ) {
      this.applyBridgePushStatus(text);
    }
    if (
      parsed.eventType === AgentBridgeEventType.NOTIFICATION_CREATED ||
        parsed.eventType === AgentBridgeEventType.NOTIFICATION_UPDATED ||
        parsed.eventType === AgentBridgeEventType.NOTIFICATION_ACTION ||
        text.indexOf('"action":"notification.list"') >= 0 ||
        text.indexOf('"action":"notification.read"') >= 0 ||
        text.indexOf('"action":"notification.prune"') >= 0
    ) {
      this.applyBridgeNotificationResult(
        text,
        parsed.eventType === AgentBridgeEventType.NOTIFICATION_CREATED
      );
    }
    if (isCurrentEvent && !isStoppedReplyEvent) {
      if (this.shouldCountAsActiveTurnActivity(parsed)) {
        this.markActiveTurnActivity();
      }
      this.updateActivityFromBridgeText(text);
      if (!isMessageImportPayload) {
        this.updateContextCompactionFromBridgeText(text);
      }
    }
    if (text.indexOf('"providers":[') >= 0 && text.indexOf('"profileId"') < 0) {
      if (text.indexOf('"deviceIdentity":{') >= 0) {
        this.handleBridgeDeviceHandshake(text);
      } else if (this.bridgeTrustState !== AgentBridgeTrustState.TRUSTED && this.activeDeviceId.length === 0) {
        this.handleLegacyBridgeDeviceHandshake();
      }
      this.applyProviderOptions(AgentBridgeIncomingParser.parseProviders(text));
      this.persistV2ProviderCatalogIfTrusted(text);
    }
    if (text.indexOf('"sessions":[') >= 0) {
      const remoteSessions = AgentBridgeIncomingParser.parseRemoteSessions(text);
      this.replaceRemoteSessions(this.resolveRemoteSessionProviderIdFromResponse(text, remoteSessions, parsed), remoteSessions);
    }
    if (text.indexOf('"agents":[') >= 0) {
      this.applyBridgeAgentRecords(AgentBridgeIncomingParser.parseAgentRecords(text));
    }
    if (parsed.envelopeType === AgentBridgeEnvelopeType.RESPONSE && text.indexOf('"forkPlanId"') >= 0 && text.indexOf('"preview":true') >= 0) {
      this.confirmForkPreview(text, parsed.requestId);
    }
    if (
      text.indexOf('"agent":{') >= 0 &&
        (
          parsed.eventType === AgentBridgeEventType.AGENT_CREATED ||
            parsed.eventType === AgentBridgeEventType.AGENT_UPDATED ||
            parsed.eventType === AgentBridgeEventType.AGENT_DELETED ||
            parsed.envelopeType === AgentBridgeEnvelopeType.RESPONSE
        )
    ) {
      this.applyBridgeAgentRecord(AgentBridgeIncomingParser.parseFirstAgentRecord(text));
      if (parsed.envelopeType === AgentBridgeEnvelopeType.RESPONSE) {
        this.completePendingFork(text, parsed.requestId);
      }
    }
    if (text.indexOf('"items":[') >= 0 && text.indexOf('"seq"') >= 0 && text.indexOf('"projectedItem"') >= 0) {
      this.applyBridgeAgentTimelinePage(text);
    }
    if (text.indexOf('"checkpoints":[') >= 0) {
      this.applyBridgeCheckpointRecords(text);
    }
    if (text.indexOf('"checkpoint":{') >= 0) {
      this.applyBridgeCheckpointUpdate(text);
    }
    if (parsed.eventType === AgentBridgeEventType.WORKSPACE_REGISTRY_UPDATED || this.isBridgeWorkspaceRegistryResult(text)) {
      this.applyBridgeWorkspaceRegistryResult(AgentBridgeIncomingParser.parseWorkspaceRegistryResult(text));
    }
    if (text.indexOf('"projects":[') >= 0) {
      this.applyBridgeProjectRegistry(AgentBridgeIncomingParser.parseProjectRecords(text));
    }
    if (text.indexOf('"workspaces":[') >= 0) {
      this.applyBridgeWorkspaceRegistry(AgentBridgeIncomingParser.parseWorkspaceRecords(text));
    }
    if (text.indexOf('"worktrees":[') >= 0) {
      this.applyBridgeWorktrees(text);
    }
    if (this.isBridgeWorktreeActionResult(text)) {
      this.applyBridgeWorktreeActionResult(text);
    }
    if (text.indexOf('"validationReport":{') >= 0 &&
      (text.indexOf('"preview":[') >= 0 || text.indexOf('"imported":[') >= 0 || text.indexOf('"providers":[') >= 0)) {
      this.applyBridgeProviderAcpResult(text);
    }
    if (text.indexOf('"manifestDigest"') >= 0 || text.indexOf('"installStatus"') >= 0 || text.indexOf('"sourceUrl"') >= 0) {
      this.applyBridgeProviderDirectoryResult(text);
    }
    if (text.indexOf('"profiles":[') >= 0) {
      this.applyBridgeProviderProfiles(text);
    }
    if (text.indexOf('"testStatus"') >= 0 && text.indexOf('"profile":{') >= 0) {
      this.applyBridgeProviderProfileTest(text);
    }
    if (parsed.eventType === AgentBridgeEventType.GITHUB_PR_UPDATED ||
      parsed.eventType === AgentBridgeEventType.GITHUB_CHECKS_UPDATED ||
      this.isBridgeGitHubResult(text)) {
      this.applyBridgeGitHubResult(text);
    }
    if (this.isBridgeGitActionResult(text)) {
      this.applyBridgeGitActionResult(text);
    }
    if (text.indexOf('"hooks":[') >= 0) {
      this.applyBridgeTerminalHooks(text);
    }
    if (text.indexOf('"devices":[') >= 0 && (text.indexOf('"trusted"') >= 0 || text.indexOf('"storePath"') >= 0)) {
      this.applyBridgeSecurityDevices(text);
    }
    if (text.indexOf('"managedProcesses":[') >= 0 && text.indexOf('"configPath"') >= 0) {
      this.applyBridgeDaemonStatus(text);
    }
    if (text.indexOf('"autostart":{') >= 0 && text.indexOf('"configPath"') >= 0) {
      this.applyBridgeDaemonAutostart(text);
    }
    if (text.indexOf('"logPath"') >= 0 && text.indexOf('"truncated"') >= 0 && text.indexOf('"sizeBytes"') >= 0) {
      this.applyBridgeDaemonLogs(text);
    }
    if (parsed.eventType === AgentBridgeEventType.DAEMON_UPDATE_UPDATED ||
      text.indexOf('"action":"daemon.update.') >= 0 ||
      (text.indexOf('"update":{') >= 0 && text.indexOf('"packageName":"@dlzz/agent-bridge"') >= 0)) {
      this.applyBridgeDaemonUpdate(text);
    }
    if (parsed.eventType === AgentBridgeEventType.DAEMON_CONFIG_UPDATED || text.indexOf('"action":"daemon.config.') >= 0) {
      this.applyBridgeDaemonConfig(text);
    }
    if (parsed.eventType === AgentBridgeEventType.MESSAGE_QUEUE_UPDATED || parsed.eventType === AgentBridgeEventType.USAGE_UPDATED ||
      parsed.eventType === AgentBridgeEventType.USAGE_BUDGET_WARNING ||
      text.indexOf('"action":"usage.') >= 0 || text.indexOf('"action":"metadata.generate"') >= 0 ||
      text.indexOf('"action":"metadata.generate.cancel"') >= 0 ||
      text.indexOf('"action":"provider.usage.list"') >= 0 ||
      text.indexOf('"action":"diagnostics.export"') >= 0 || text.indexOf('"action":"message.queue.') >= 0) {
      this.experienceResult = AgentBridgeIncomingParser.parseExperienceResult(text);
      const experienceMatchesScope = this.experienceResultMatchesCurrentUsageScope(this.experienceResult);
      const providerUsageMatchesScope = this.providerUsageMatchesCurrentUsageScope(this.experienceResult);
      const providerUsageRequestMatches = this.pendingProviderUsageRequestId.length === 0 ||
        parsed.requestId.length === 0 || parsed.requestId === this.pendingProviderUsageRequestId;
      if (this.experienceResult.action === AgentBridgeRequestType.PROVIDER_USAGE_LIST &&
        providerUsageMatchesScope && providerUsageRequestMatches) {
        this.providerUsageResult = this.experienceResult.providerUsage;
        this.providerUsageLoading = false;
        this.pendingProviderUsageRequestId = '';
      }
      if (this.experienceResult.action === AgentBridgeRequestType.USAGE_SUMMARY_GET && experienceMatchesScope) {
        this.usageSummary = this.experienceResult.usageSummary;
        this.usageSummaryAvailable = true;
      }
      if (this.experienceResult.queueItemsJson.length > 0) {
        this.messageQueueItems = AgentBridgeIncomingParser.parseMessageQueueItems(this.experienceResult.queueItemsJson);
      }
      if (this.experienceResult.queueItem.queueId.length > 0) {
        this.upsertMessageQueueItem(this.experienceResult.queueItem);
      }
      if (this.experienceResult.usageEventsJson.length > 0 && experienceMatchesScope) {
        this.usageEventItems = AgentBridgeIncomingParser.parseUsageEvents(this.experienceResult.usageEventsJson);
      }
      if (this.experienceResult.usageEvent.eventId.length > 0) {
        this.upsertUsageEvent(this.experienceResult.usageEvent);
      }
      if (this.experienceResult.budgetJson.length > 0 && experienceMatchesScope) {
        this.usageBudget = AgentBridgeIncomingParser.parseUsageBudget(this.experienceResult.budgetJson);
        this.usageTokenBudgetDraft = this.usageBudget.tokenLimit >= 0 ? String(this.usageBudget.tokenLimit) : '';
        this.usageCostBudgetDraft = this.usageBudget.costLimit >= 0 ? String(this.usageBudget.costLimit) : '';
        this.usageBudgetCurrencyDraft = this.usageBudget.currency;
        this.usageBudgetWindowDraft = this.usageBudget.window;
        this.usageBudgetWarningThresholdDraft = this.usageBudget.warningThreshold >= 0 ?
          String(this.usageBudget.warningThreshold) : '0.8';
      } else if (experienceMatchesScope &&
        (this.experienceResult.action === AgentBridgeRequestType.USAGE_BUDGET_GET ||
          this.experienceResult.action === AgentBridgeRequestType.USAGE_BUDGET_SET)) {
        this.usageBudget = new AgentBridgeUsageBudgetRecord();
        this.usageTokenBudgetDraft = '';
        this.usageCostBudgetDraft = '';
      }
      if (this.experienceResult.budgetWarnings.length > 0 && experienceMatchesScope) {
        this.mergeUsageBudgetWarnings(this.experienceResult.budgetWarnings);
      }
      if (this.experienceResult.reportJson.length > 0) {
        this.diagnosticsReport = this.experienceResult.diagnosticsReport;
        if (this.pendingDiagnosticsExportFormat.length > 0 &&
          parsed.requestId === this.pendingDiagnosticsExportRequestId) {
          const exportFormat = this.pendingDiagnosticsExportFormat;
          this.pendingDiagnosticsExportFormat = '';
          this.pendingDiagnosticsExportRequestId = '';
          this.saveDiagnosticsReportToFile(exportFormat).catch((error: Error): void => {
            logger.error(TAG, 'save diagnostics report failed: ' + this.errorToString(error));
          });
        }
      }
      if (this.experienceResult.action === AgentBridgeRequestType.METADATA_GENERATE ||
        this.experienceResult.action === AgentBridgeRequestType.METADATA_GENERATE_CANCEL) {
        const matchesMetadataRequest = this.pendingMetadataRequestId.length === 0 ||
          this.experienceResult.requestId.length === 0 ||
          this.experienceResult.requestId === this.pendingMetadataRequestId;
        if (matchesMetadataRequest && (this.experienceResult.cancelled ||
          this.experienceResult.failureCategory.length > 0 || this.experienceResult.suggestion.length > 0)) {
          this.pendingMetadataRequestId = '';
        }
        if (matchesMetadataRequest && this.experienceResult.suggestion.length > 0) {
          this.metadataSuggestionDraft = this.experienceResult.suggestion;
          if (this.experienceResult.kind.length > 0) {
            this.metadataSuggestionKind = this.experienceResult.kind;
          }
        }
      }
      if (parsed.eventType === AgentBridgeEventType.MESSAGE_QUEUE_UPDATED && this.currentBridgeSessionId().length > 0) {
        this.client.requestMessageQueue(this.currentBridgeSessionId());
      }
    }
    if (text.indexOf('"terminals":[') >= 0) {
      this.applyBridgeTerminalList(AgentBridgeIncomingParser.parseTerminalStates(text));
    }
    if (text.indexOf('"terminal":{') >= 0) {
      const terminal = AgentBridgeIncomingParser.parseFirstTerminalState(text);
      const terminalSlot = AgentBridgeIncomingParser.parseTerminalSlot(text);
      const isCreateResponse = this.consumePendingTerminalCreateRequest(parsed.requestId);
      this.applyBridgeTerminalState(terminal, terminalSlot, text.indexOf('"slot"') >= 0);
      if (isCreateResponse) {
        this.selectRuntimeTerminal(terminal.terminalId);
      }
      if (text.indexOf('"text"') >= 0) {
        this.applyBridgeTerminalCapture(
          terminal.terminalId,
          AgentBridgeIncomingParser.parseTerminalCaptureText(text)
        );
      }
    }
    if (
      parsed.eventType === AgentBridgeEventType.FILE_TRANSFER_PROGRESS ||
        parsed.eventType === AgentBridgeEventType.FILE_TRANSFER_COMPLETED ||
        parsed.eventType === AgentBridgeEventType.FILE_TRANSFER_FAILED
    ) {
      this.applyBridgeFileTransferEvent(parsed.eventType, AgentBridgeIncomingParser.parseFileTransferState(text));
    }
    if (parsed.eventType === AgentBridgeEventType.TERMINAL_STREAM_EXIT) {
      this.applyBridgeTerminalClosed(AgentBridgeIncomingParser.extractStringProperty(text, 'terminalId'));
    }
    if (isMessageImportPayload) {
      const targetSessionId = this.resolveMessageImportTargetSessionId(text);
      if (targetSessionId.length > 0) {
        this.applyImportedMessages(
          AgentBridgeIncomingParser.parseImportedMessages(text),
          AgentBridgeIncomingParser.parseImportedToolCalls(text),
          targetSessionId
        );
      }
    }
    if (parsed.eventType === AgentBridgeEventType.WORKSPACE_DIFF_SUBSCRIPTION_UPDATED || text.indexOf('"subscriptionId"') >= 0 && text.indexOf('"changes":[') >= 0) {
      this.applyGitDiffSubscriptionStatus(text);
      this.applyWorkspaceChangesFromBridge(text);
    }
    if (text.indexOf('"subscriptionId"') >= 0 && text.indexOf('"status"') >= 0 && text.indexOf('"changes":[') < 0) {
      this.applyGitDiffSubscriptionStatus(text);
    }
    if (text.indexOf('"diffText"') >= 0 && text.indexOf('"path"') >= 0) {
      this.applyWorkspaceDiffFromBridge(text);
    }
    if (text.indexOf('"session":{') >= 0) {
      this.applyRemoteSessionUpdate(AgentBridgeIncomingParser.parseFirstRemoteSession(text));
    }
    if (parsed.sessionId.length > 0) {
      this.handleBridgeSession(parsed.sessionId);
    }
    if (isStoppedReplyEvent) {
      return;
    }
    if (parsed.eventType.length > 0 && !isCurrentEvent) {
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.OPENCODE_EVENT) {
      this.upsertOpenCodeToolCallFromRawEvent(text, parsed);
    }
    this.updateActiveSubagentFromParsed(parsed);
    if (!parsed.isOk) {
      if (parsed.requestId === this.pendingForkPreviewRequestId || parsed.requestId === this.pendingForkConfirmRequestId) {
        this.clearPendingForkState();
      }
      const errorText = this.resolveBridgeErrorText(parsed, compactText);
      this.applyWorkspacePreviewErrorIfNeeded(errorText);
      if (this.isPersistentStateLoading) {
        this.finishPersistentStateLoading();
      }
      this.showTransientStatus(errorText);
      this.publishAgentTaskErrorNotification(errorText);
      this.replyState = AgentHomeReplyState.IDLE;
      this.activeToolName = '';
      this.activeSubagentName = '';
      this.stopActiveTurnTimer();
      this.stopContextCompactionStatus();
      if (this.isConversationRenderPending && this.activeSessionId.length > 0) {
        this.scheduleConversationRenderReady(this.activeSessionId);
      }
      return;
    }
    if (parsed.envelopeType === AgentBridgeEnvelopeType.RESPONSE && parsed.previewPath.length > 0) {
      this.addPreviewFromBridge(parsed, compactText);
      return;
    }
    if (parsed.envelopeType === AgentBridgeEnvelopeType.RESPONSE && parsed.downloadPath.length > 0) {
      this.handleBridgeDownloadReady(parsed);
      return;
    }

    if (parsed.eventType === AgentBridgeEventType.MESSAGE_DELTA) {
      if (parsed.text.length > 0 || parsed.reasoningText.length > 0) {
        this.startActiveTurnTimer();
        this.replyState = AgentHomeReplyState.RESPONDING;
        if (parsed.role === AgentHomeMessageRole.USER) {
          this.appendUserDelta(parsed.text, parsed.messageId);
        } else if (this.isReasoningDelta(parsed)) {
          this.appendAssistantReasoning(parsed);
        } else {
          this.appendAssistantDelta(parsed);
        }
      }
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.MESSAGE_COMPLETED) {
      if (parsed.role !== AgentHomeMessageRole.USER) {
        if (parsed.reasoningText.length > 0) {
          this.appendAssistantReasoning(parsed);
        }
        if (parsed.text.length > 0) {
          this.appendAssistantCompletion(parsed);
        }
        this.finalizeActiveAssistantDuration();
      }
      this.publishAgentTaskCompletedNotification();
      this.replyState = AgentHomeReplyState.IDLE;
      this.activeToolName = '';
      this.activeSubagentName = '';
      this.stopActiveTurnTimer();
      this.stopContextCompactionStatus();
      this.collapseReasoningForCurrentSession();
      this.resetActiveAssistantStream();
      this.finishBridgeReplyUiUpdate();
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.TOOL_STARTED) {
      this.startActiveTurnTimer();
      this.replyState = AgentHomeReplyState.TOOL_RUNNING;
      this.activeToolName = this.resolveToolStatusName(parsed);
      this.upsertToolCallFromBridge(parsed, AgentHomeToolCallStatus.RUNNING);
      this.publishAgentTaskToolNotification(this.activeToolName);
      this.showTransientStatus(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_tool_started')) +
          ': ' + this.activeToolName
      );
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.TOOL_OUTPUT) {
      this.startActiveTurnTimer();
      this.replyState = AgentHomeReplyState.TOOL_RUNNING;
      this.activeToolName = this.resolveToolStatusName(parsed);
      this.upsertToolCallFromBridge(parsed, parsed.toolErrorText.length > 0 ? AgentHomeToolCallStatus.ERROR : AgentHomeToolCallStatus.RUNNING);
      this.publishAgentTaskToolNotification(this.activeToolName);
      this.showTransientStatus(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_tool_output')) +
          ': ' + this.activeToolName
      );
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.TOOL_COMPLETED) {
      if (this.isReplyInProgress()) {
        this.replyState = AgentHomeReplyState.RESPONDING;
      }
      this.upsertToolCallFromBridge(parsed, this.normalizeToolCallStatus(parsed.toolStatus));
      this.activeToolName = '';
      this.showTransientStatus(
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_tool_completed'))
      );
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.PERMISSION_REQUESTED) {
      this.upsertPermissionRequestFromBridge(text, parsed);
      this.showTransientStatus(compactText);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.QUESTION_REQUESTED) {
      this.upsertUserRequestFromBridge(text, parsed);
      this.showTransientStatus(compactText);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.PLAN_REQUESTED) {
      this.upsertPlanFromBridge(parsed);
      this.showTransientStatus(compactText);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.PLAN_UPDATED) {
      this.updatePlanFromBridge(parsed);
      this.showTransientStatus(compactText);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.TODO_UPDATED) {
      this.showTransientStatus(compactText);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.PREVIEW_UPDATED) {
      this.addPreviewFromBridge(parsed, compactText);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.WORKSPACE_CHANGES_UPDATED) {
      this.applyWorkspaceChangesFromBridge(text);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.WORKSPACE_FILES_UPDATED) {
      this.applyWorkspaceFilesFromBridge(text);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.FILE_DOWNLOAD_READY) {
      this.handleBridgeDownloadReady(parsed);
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.BRIDGE_CONNECTED) {
      return;
    }
    if (parsed.eventType === AgentBridgeEventType.ERROR) {
      const errorText = this.resolveBridgeErrorText(parsed, compactText);
      this.showTransientStatus(errorText);
      this.publishAgentTaskErrorNotification(errorText);
      this.replyState = AgentHomeReplyState.IDLE;
      this.activeToolName = '';
      this.activeSubagentName = '';
      this.stopActiveTurnTimer();
      this.stopContextCompactionStatus();
    }
  }

  private applyBridgeServerInfo(source: string): void {
    const serverInfo = AgentBridgeIncomingParser.parseServerInfo(source);
    if (serverInfo.serverId.length === 0) {
      return;
    }
    this.currentBridgeServerId = serverInfo.serverId;
    this.currentBridgeServerInfo = serverInfo;
    if (serverInfo.features.voicePrivacyStatus && this.hasTrustedActiveDevice()) {
      this.client.requestVoiceStatus();
    }
    const voiceSnapshot: NGFVoicePlatformSnapshot = ngfVoicePlatformFacade.getSnapshot();
    if (serverInfo.features.voiceCapabilityMatrix) {
      voiceSnapshot.capabilities.remoteSpeechToText = serverInfo.features.voiceRemoteSpeechToText;
      voiceSnapshot.capabilities.remoteTextToSpeech = serverInfo.features.voiceRemoteTextToSpeech;
    } else {
      voiceSnapshot.capabilities.remoteSpeechToText = serverInfo.features.voiceRemoteSpeechToText ||
        serverInfo.features.voiceSpeechToText || serverInfo.features.voice;
      voiceSnapshot.capabilities.remoteTextToSpeech = serverInfo.features.voiceRemoteTextToSpeech ||
        serverInfo.features.voiceTextToSpeech || serverInfo.features.voice;
    }
    voiceSnapshot.capabilities.audioPlayback = serverInfo.features.voiceAudioPlayback || voiceSnapshot.capabilities.audioPlayback;
    voiceSnapshot.capabilities.interruptionHandling = serverInfo.features.voiceInterruptionHandling ||
      voiceSnapshot.capabilities.interruptionHandling;
    this.voiceSnapshot = voiceSnapshot;
    if (this.workbenchWidthVp > 0) {
      this.updateWorkbenchLayout(this.workbenchWidthVp);
    }
    if (!this.hasTrustedActiveDevice()) {
      return;
    }
    if (!serverInfo.features.offlineNotifications) {
      this.bridgeNotifications = [];
      this.bridgeNotificationUnreadCount = 0;
      this.publishedBridgeNotificationIds = [];
      this.pendingBridgeNotificationActionIds = [];
      this.syncBridgeNotificationBadge();
    }
    if (!serverInfo.features.pushKitSubscriptions) {
      this.bridgePushStatus = new AgentBridgePushStatusResult();
      this.resetPushRegistrationForConnection();
    }
    if (!serverInfo.features.relay) {
      this.resetRelayRuntimeState();
    }
    this.persistence.saveDaemonServer(this.activeDeviceId, serverInfo, this.bridgeEndpoint).catch((error: Error): void => {
      logger.error(TAG, 'persist daemon server failed: ' + this.errorToString(error));
    });
    const activeHost = this.findHostProfile(this.activeHostProfileId);
    if (activeHost !== null) {
      activeHost.lastDeviceId = this.activeDeviceId;
      activeHost.lastServerId = serverInfo.serverId;
      activeHost.identityStatus = AgentHomeHostIdentityStatus.VERIFIED;
      activeHost.updatedAt = Date.now();
      this.persistence.saveHostProfile(activeHost).then((): void => {
        this.upsertHostProfileState(activeHost);
        this.refreshHostWorkspaceGroups().catch((error: Error): void => {
          logger.warn(TAG, 'refresh host workspace groups failed: ' + this.errorToString(error));
        });
      }).catch((error: Error): void => {
        logger.error(TAG, 'persist host server identity failed: ' + this.errorToString(error));
      });
    }
    if (this.canUseBridgeDaemonFleet()) {
      this.refreshDaemonFleet().catch((error: Error): void => {
        logger.warn(TAG, 'refresh daemon fleet failed: ' + this.errorToString(error));
      });
    }
    this.loadTerminalSnapshotsIfTrusted();
    this.refreshBridgeTerminalsIfAvailable();
    this.flushPendingBridgeNotificationActions();
    this.refreshBridgeNotificationsIfAvailable();
    if (serverInfo.features.pushKitSubscriptions) {
      this.refreshPushNotificationStatus();
      this.registerPushTokenIfReady(false);
    }
  }

  private bootstrapTrustedBridgeV2(): void {
    if (this.connectionStatus !== AgentBridgeConnectionStatus.CONNECTED || !this.hasTrustedActiveDevice()) {
      return;
    }
    if (this.currentBridgeServerId.length === 0) {
      this.client.requestServerInfo();
    } else {
      const serverInfo = this.currentBridgeServerInfo;
      if (serverInfo !== null) {
        this.persistence.saveDaemonServer(this.activeDeviceId, serverInfo, this.bridgeEndpoint).catch((error: Error): void => {
          logger.error(TAG, 'persist daemon server during bootstrap failed: ' + this.errorToString(error));
        });
      }
    }
    if (this.currentBridgeServerInfo !== null && this.currentBridgeServerInfo.features.voicePrivacyStatus) {
      this.client.requestVoiceStatus();
    }
    this.client.requestProviderCatalog('global', '', false);
    const cwd = this.currentWorkspacePath();
    if (cwd.length > 0) {
      this.client.requestProviderCatalog('workspace', cwd, false);
    }
    this.client.requestProjectRegistry();
    this.client.requestWorkspaceRegistry();
    if (this.canUseBridgeServiceProxy()) {
      this.client.listWorkspaceServices();
    }
    if (this.canUseBridgeBrowserAutomation()) {
      this.refreshBrowserAutomation();
    }
    this.client.requestAgents(false);
    if (this.canUseBridgeProviderProfiles()) {
      this.client.listProviderProfiles();
    }
    if (this.canUseBridgeDaemonManagement()) {
      const statusRequestId = this.client.requestDaemonStatus();
      this.daemonStatusCoordinator.beginRequest(statusRequestId, this.activeHostProfileId, this.connectionEpoch);
      if (this.canUseBridgeDaemonAutostartInstaller()) {
        this.client.requestDaemonAutostartStatus();
      }
      if (this.canUseBridgeDaemonSelfUpdate()) {
        this.client.requestDaemonUpdateStatus();
      }
    }
    if (this.canUseBridgePushSubscriptions()) {
      this.refreshPushNotificationStatus();
      this.registerPushTokenIfReady(false);
    }
    if (this.canUseBridgeRelay()) {
      this.refreshRelayState();
    }
    if (this.canUseBridgeWorktrees()) {
      const worktreeSessionId = this.currentBridgeSessionId();
      const worktreeWorkspacePath = this.currentWorkspacePath();
      if (worktreeSessionId.length > 0 || worktreeWorkspacePath.length > 0) {
        this.client.listWorktrees(worktreeSessionId, this.activeWorkspaceId, worktreeWorkspacePath);
      }
    }
    if (this.canUseBridgeAutomationCollaboration()) {
      this.refreshM7All();
    }
    this.flushPendingBridgeNotificationActions();
    this.refreshBridgeNotificationsIfAvailable();
    this.loadTerminalSnapshotsIfTrusted();
    this.refreshBridgeTerminalsIfAvailable();
  }

  private hasTrustedBridgeV2Server(): boolean {
    return this.hasTrustedActiveDevice() && this.currentBridgeServerId.length > 0;
  }

  private persistV2ProviderCatalogIfTrusted(source: string): void {
    if (!this.hasTrustedBridgeV2Server()) {
      return;
    }
    const providersJson = AgentBridgeIncomingParser.extractArrayProperty(source, 'providers');
    if (providersJson.length === 0) {
      return;
    }
    const scope = AgentBridgeIncomingParser.extractStringProperty(source, 'scope');
    const cwd = AgentBridgeIncomingParser.extractStringProperty(source, 'cwd');
    const cacheStatus = AgentBridgeIncomingParser.extractStringProperty(source, 'cacheStatus');
    const updatedAt = AgentBridgeIncomingParser.extractNumberProperty(source, 'updatedAt', Date.now());
    this.persistence.saveProviderCatalogSnapshot(
      this.activeDeviceId,
      this.currentBridgeServerId,
      scope.length > 0 ? scope : 'global',
      cwd,
      providersJson,
      cacheStatus,
      updatedAt
    ).catch((error: Error): void => {
      logger.error(TAG, 'persist provider catalog snapshot failed: ' + this.errorToString(error));
    });
  }

  private handleBridgeResponseErrorIfNeeded(text: string, parsed: AgentBridgeParsedMessage): boolean {
    if (text.indexOf('"type":"response"') < 0 || text.indexOf('"ok":false') < 0 || text.indexOf('"error":{') < 0) {
      return false;
    }
    const errorObject = AgentBridgeIncomingParser.extractObjectProperty(text, 'error');
    const code = AgentBridgeIncomingParser.extractStringProperty(errorObject, 'code');
    let message = AgentBridgeIncomingParser.cleanJsonText(AgentBridgeIncomingParser.extractStringProperty(errorObject, 'message'));
    if (message.length === 0) {
      message = this.resolveDetailEmptyText();
    }
    if (parsed.requestId.length > 0 && parsed.requestId === this.pendingProviderUsageRequestId) {
      const providerUsageFailure = new AgentBridgeProviderUsageResult();
      providerUsageFailure.ok = false;
      providerUsageFailure.action = AgentBridgeRequestType.PROVIDER_USAGE_LIST;
      providerUsageFailure.providerId = this.currentProviderOption().id;
      providerUsageFailure.hostProfileId = this.activeHostProfileId;
      providerUsageFailure.sessionId = this.currentBridgeSessionId();
      providerUsageFailure.agentId = this.currentBridgeAgentId();
      providerUsageFailure.window = this.usageBudgetWindowDraft;
      providerUsageFailure.status = 'unavailable';
      providerUsageFailure.failureCategory = code;
      providerUsageFailure.message = message;
      this.providerUsageResult = providerUsageFailure;
      this.providerUsageLoading = false;
      this.pendingProviderUsageRequestId = '';
    }
    if (this.isRelayBridgeMessage(text, parsed)) {
      this.relayFailureCategory = code.length > 0 ? code : 'relay_operation_failed';
      this.relayRemediation = '';
      this.pendingRelayStatusRequestId = '';
      this.pendingRelayDeviceListRequestId = '';
      this.relayRefreshBusy = false;
      this.clearRelayOperation();
      this.clearPendingRelayPairingConnection();
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_relay_operation_failed')
      ));
      this.addBridgeLogMessage(this.relayFailureCategory);
      return true;
    }
    if (code === 'git_plan_expired' || code === 'git_plan_stale' || code === 'git_plan_required') {
      this.clearPendingGitPlan();
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_git_plan_expired')
      ));
    }
    if (code === 'UNSUPPORTED') {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_feature_unavailable')));
    } else {
      this.showTransientStatus(message);
    }
    if (parsed.requestId.length > 0 && parsed.requestId === this.pendingPushRequestId) {
      this.clearPendingPushRequest();
    }
    if (parsed.requestId.length > 0 && parsed.requestId === this.pendingDiagnosticsExportRequestId) {
      this.pendingDiagnosticsExportFormat = '';
      this.pendingDiagnosticsExportRequestId = '';
    }
    if (this.workspaceServicePending && parsed.requestId.length > 0) {
      this.workspaceServicePending = false;
      this.pendingWorkspaceServiceAction = '';
      this.pendingWorkspaceServiceId = '';
      this.pendingWorkspaceServiceOwnerAgentId = '';
      this.workspaceServiceResult = new AgentBridgeWorkspaceServiceResult();
      this.workspaceServiceResult.ok = false;
      this.workspaceServiceResult.failureCategory = code;
      this.workspaceServiceResult.message = message;
    }
    this.applyPendingWorkspacePreviewError(parsed.requestId, message);
    this.replyState = AgentHomeReplyState.IDLE;
    this.activeToolName = '';
    this.activeSubagentName = '';
    this.stopActiveTurnTimer();
    this.addBridgeLogMessage(code.length > 0 ? code + ': ' + message : message);
    return true;
  }

  private isRelayBridgeMessage(text: string, parsed: AgentBridgeParsedMessage): boolean {
    return parsed.eventType === AgentBridgeEventType.RELAY_UPDATED ||
      parsed.eventType === AgentBridgeEventType.RELAY_DEVICE_UPDATED ||
      text.indexOf('"action":"relay.') >= 0;
  }

  private applyBridgeAgentRecords(agents: Array<AgentBridgeAgentRecord>): void {
    if (!this.hasTrustedBridgeV2Server()) {
      logger.warn(TAG, 'v2 agent list ignored before trusted server');
      return;
    }
    if (agents.length === 0) {
      return;
    }
    this.bridgeAgentRecords = agents;
    this.persistence.saveAgentRecords(this.activeDeviceId, this.currentBridgeServerId, agents).catch((error: Error): void => {
      logger.error(TAG, 'persist v2 agents failed: ' + this.errorToString(error));
    });
    for (let index = 0; index < agents.length; index++) {
      this.projectBridgeAgentIntoLocalSession(agents[index], false);
      this.requestBridgeAgentTimelineFromCursor(agents[index].id);
    }
  }

  private applyBridgeAgentRecord(agent: AgentBridgeAgentRecord): void {
    if (!this.hasTrustedBridgeV2Server()) {
      return;
    }
    if (agent.id.length === 0) {
      return;
    }
    this.upsertBridgeAgentRecord(agent);
    this.persistence.saveAgentRecord(this.activeDeviceId, this.currentBridgeServerId, agent).catch((error: Error): void => {
      logger.error(TAG, 'persist v2 agent failed: ' + this.errorToString(error));
    });
    this.projectBridgeAgentIntoLocalSession(agent, true);
    this.requestBridgeAgentTimelineFromCursor(agent.id);
  }

  private upsertBridgeAgentRecord(agent: AgentBridgeAgentRecord): void {
    if (agent.id.length === 0) {
      return;
    }
    const nextItems: Array<AgentBridgeAgentRecord> = [];
    let replaced = false;
    for (let index = 0; index < this.bridgeAgentRecords.length; index++) {
      const item = this.bridgeAgentRecords[index];
      if (item.id === agent.id) {
        nextItems.push(agent);
        replaced = true;
      } else {
        nextItems.push(item);
      }
    }
    if (!replaced) {
      nextItems.push(agent);
    }
    this.bridgeAgentRecords = nextItems;
  }

  private requestBridgeAgentTimelineFromCursor(agentId: string): void {
    if (!this.hasTrustedBridgeV2Server() || agentId.length === 0) {
      return;
    }
    this.persistence.loadAgentTimelineCursor(this.activeDeviceId, this.currentBridgeServerId, agentId).then((cursor: number): void => {
      if (!this.hasTrustedBridgeV2Server()) {
        return;
      }
      const requestId = this.client.requestAgentTimeline(agentId, String(cursor), 'after', 200);
      if (requestId.length > 0) {
        this.trackPendingAgentTimelineRequest(requestId, agentId);
      }
    }).catch((error: Error): void => {
      logger.error(TAG, 'load v2 timeline cursor failed: ' + this.errorToString(error));
    });
  }

  private trackPendingAgentTimelineRequest(requestId: string, agentId: string): void {
    if (requestId.length === 0 || agentId.length === 0) {
      return;
    }
    const nextPairs: Array<string> = [];
    let replaced = false;
    for (let index = 0; index < this.pendingAgentTimelineRequestPairs.length; index += 2) {
      const existingRequestId = this.pendingAgentTimelineRequestPairs[index];
      const existingAgentId = index + 1 < this.pendingAgentTimelineRequestPairs.length ?
        this.pendingAgentTimelineRequestPairs[index + 1] :
        '';
      if (existingRequestId === requestId) {
        nextPairs.push(requestId);
        nextPairs.push(agentId);
        replaced = true;
      } else {
        nextPairs.push(existingRequestId);
        nextPairs.push(existingAgentId);
      }
    }
    if (!replaced) {
      nextPairs.push(requestId);
      nextPairs.push(agentId);
    }
    this.pendingAgentTimelineRequestPairs = nextPairs;
  }

  private consumePendingAgentTimelineRequestAgentId(requestId: string): string {
    let agentId = '';
    const nextPairs: Array<string> = [];
    for (let index = 0; index < this.pendingAgentTimelineRequestPairs.length; index += 2) {
      const existingRequestId = this.pendingAgentTimelineRequestPairs[index];
      const existingAgentId = index + 1 < this.pendingAgentTimelineRequestPairs.length ?
        this.pendingAgentTimelineRequestPairs[index + 1] :
        '';
      if (existingRequestId === requestId && agentId.length === 0) {
        agentId = existingAgentId;
      } else {
        nextPairs.push(existingRequestId);
        nextPairs.push(existingAgentId);
      }
    }
    this.pendingAgentTimelineRequestPairs = nextPairs;
    return agentId;
  }

  private applyBridgeAgentTimelinePage(source: string): void {
    if (!this.hasTrustedBridgeV2Server()) {
      logger.warn(TAG, 'v2 timeline page ignored before trusted server');
      return;
    }
    const parsed = AgentBridgeIncomingParser.parse(source);
    let agentId = AgentBridgeIncomingParser.extractStringProperty(source, 'agentId');
    if (agentId.length === 0 && parsed.requestId.length > 0) {
      agentId = this.consumePendingAgentTimelineRequestAgentId(parsed.requestId);
    }
    const items = AgentBridgeIncomingParser.parseAgentTimelineRecords(source);
    if (agentId.length === 0 && items.length > 0) {
      agentId = items[0].agentId;
    }
    if (agentId.length === 0) {
      return;
    }
    this.persistence.saveAgentTimelineItems(this.activeDeviceId, this.currentBridgeServerId, agentId, items).catch((error: Error): void => {
      logger.error(TAG, 'persist v2 timeline page failed: ' + this.errorToString(error));
    });
    for (let index = 0; index < items.length; index++) {
      this.projectBridgeTimelineItem(agentId, items[index]);
    }
    const latestSeq = AgentBridgeIncomingParser.extractNumberProperty(source, 'latestSeq', 0);
    if (latestSeq > 0) {
      this.client.acknowledgeAgentTimeline(agentId, latestSeq);
    }
    if (AgentBridgeIncomingParser.extractBooleanProperty(source, 'hasNewer')) {
      const endCursor = AgentBridgeIncomingParser.extractStringProperty(source, 'endCursor');
      this.client.requestAgentTimeline(agentId, endCursor.length > 0 ? endCursor : String(latestSeq), 'after', 200);
    }
  }

  private applyBridgeCheckpointRecords(source: string): void {
    if (!this.canUseBridgeCheckpoints()) {
