  private supportsUsageEvents(): boolean {
    const serverInfo = this.currentBridgeServerInfo;
    const provider = this.currentProviderOption();
    if (serverInfo === null || !serverInfo.features.usageEvents || provider.id.length === 0) {
      return false;
    }
    // New descriptors publish an explicit usageEvents capability. Older Bridge
    // versions omit it, so retain the previous global-feature behavior for them.
    return !provider.usageEventsCapabilityKnown || provider.supportsUsageEvents;
  }

