  private beginForkPreview(
    agentId: string,
    title: string,
    workspaceMode: string,
    boundaryMessageId: string = '',
    timelineEpoch: number = 0,
    timelineSeq: number = 0
  ): void {
    this.clearPendingForkState();
    this.pendingForkSourceAgentId = agentId;
    this.pendingMessageForkId = boundaryMessageId;
    this.pendingMessageForkEpoch = timelineEpoch;
    this.pendingMessageForkSeq = timelineSeq;
    this.pendingMessageForkMode = AgentHomeMessageForkPolicy.normalizeWorkspaceMode(workspaceMode);
    this.pendingForkPreviewRequestId = this.client.forkAgent(
      agentId,
      '',
      title,
      '',
      false,
      this.pendingMessageForkMode,
      '',
      false,
      boundaryMessageId,
      timelineEpoch,
      timelineSeq
    );
  }

  private confirmForkPreview(source: string, requestId: string): void {
    const forkPlanId = AgentBridgeIncomingParser.extractStringProperty(source, 'forkPlanId');
    if (forkPlanId.length === 0 || this.pendingForkSourceAgentId.length === 0 ||
      requestId.length === 0 || requestId !== this.pendingForkPreviewRequestId) {
      return;
    }
    const workspaceMode = AgentBridgeIncomingParser.extractStringProperty(source, 'workspaceMode');
    if (workspaceMode.length > 0 && workspaceMode !== this.pendingMessageForkMode) {
      this.clearPendingForkState();
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(),
        $r('app.string.agent_home_message_fork_preview_stale')
      ));
      return;
    }
    const responseBoundaryMessageId = AgentBridgeIncomingParser.extractStringProperty(source, 'boundaryMessageId');
    const responseTimelineEpoch = AgentBridgeIncomingParser.extractNumberProperty(source, 'timelineEpoch', 0);
    const responseTimelineSeq = AgentBridgeIncomingParser.extractNumberProperty(source, 'timelineSeq', 0);
    if (this.pendingMessageForkId.length > 0 && !AgentHomeMessageForkPolicy.matchesPreviewBinding(
      this.pendingMessageForkId,
      this.pendingMessageForkEpoch,
      this.pendingMessageForkSeq,
      this.pendingMessageForkMode,
      responseBoundaryMessageId,
      responseTimelineEpoch,
      responseTimelineSeq,
      workspaceMode
    )) {
      this.clearPendingForkState();
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(),
        $r('app.string.agent_home_message_fork_preview_stale')
      ));
      return;
    }
    const worktreePath = AgentBridgeIncomingParser.extractStringProperty(source, 'worktreePath');
    const branch = AgentBridgeIncomingParser.extractStringProperty(source, 'branch');
    const boundaryCursor = AgentBridgeIncomingParser.extractStringProperty(source, 'boundaryCursor');
    const contextDigest = AgentBridgeIncomingParser.extractStringProperty(source, 'contextDigest');
    const contextItemCount = AgentBridgeIncomingParser.extractNumberProperty(source, 'contextItemCount', 0);
    const warnings = AgentBridgeIncomingParser.extractStringArrayProperty(source, 'warnings');
    const hostContext = this.getUIContext().getHostContext();
    const previewLines: Array<string> = [];
    previewLines.push(resolveResourceString(hostContext, $r('app.string.agent_home_message_fork_preview_mode')) + ': ' +
      resolveResourceString(hostContext, this.pendingMessageForkMode === 'isolated' ?
        $r('app.string.agent_home_message_fork_isolated') : $r('app.string.agent_home_message_fork_shared')));
    if (this.pendingMessageForkId.length > 0) {
      previewLines.push(resolveResourceString(hostContext, $r('app.string.agent_home_message_fork_preview_context')) + ': ' +
        String(contextItemCount));
      previewLines.push(resolveResourceString(hostContext, $r('app.string.agent_home_message_fork_preview_cursor')) + ': ' +
        (boundaryCursor.length > 0 ? boundaryCursor : String(responseTimelineSeq)));
      if (contextDigest.length > 0) {
        previewLines.push(resolveResourceString(hostContext, $r('app.string.agent_home_message_fork_preview_digest')) + ': ' +
          contextDigest);
      }
    }
    if (worktreePath.length > 0 && this.pendingMessageForkMode === 'isolated') {
      previewLines.push(worktreePath);
    }
    if (branch.length > 0 && this.pendingMessageForkMode === 'isolated') {
      previewLines.push(branch);
    }
    if (warnings.length > 0) {
      previewLines.push(resolveResourceString(hostContext, $r('app.string.agent_home_message_fork_preview_warnings')) + ': ' +
        warnings.join('\n'));
    }
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_message_fork_preview_title')),
      message: resolveResourceString(hostContext, $r('app.string.agent_home_message_fork_preview_message')) + '\n' +
        previewLines.join('\n'),
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_confirm')),
        action: (): void => {
          this.pendingForkConfirmRequestId = this.client.forkAgent(
            this.pendingForkSourceAgentId,
            '',
            '',
            '',
            false,
            this.pendingMessageForkMode,
            forkPlanId,
            true,
            this.pendingMessageForkId,
            this.pendingMessageForkEpoch,
            this.pendingMessageForkSeq
          );
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => { this.clearPendingForkState(); }
      }
    });
  }

  private completePendingFork(source: string, requestId: string): void {
    if (requestId.length === 0 || requestId !== this.pendingForkConfirmRequestId ||
      !AgentBridgeIncomingParser.extractBooleanProperty(source, 'confirmed')) {
      return;
    }
    const child = AgentBridgeIncomingParser.parseFirstAgentRecord(source);
    if (child.id.length > 0) {
      const sessionId = this.localSessionIdForBridgeAgent(child.id);
      const session = this.findLocalSessionById(sessionId);
      if (session !== null && session.workspaceId.length > 0) {
        this.updateActiveWorkspaceId(session.workspaceId);
      }
      this.activateSession(sessionId);
      this.requestBridgeAgentTimelineFromCursor(child.id);
    }
    this.clearPendingForkState();
  }

  private clearPendingForkState(): void {
    this.pendingForkPreviewRequestId = '';
    this.pendingForkConfirmRequestId = '';
    this.pendingForkSourceAgentId = '';
    this.pendingMessageForkId = '';
    this.pendingMessageForkEpoch = 0;
    this.pendingMessageForkSeq = 0;
    this.pendingMessageForkMode = 'shared';
  }

