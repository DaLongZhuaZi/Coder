  private refreshM7All(): void {
    if (!this.canUseBridgeAutomationCollaboration()) {
      return;
    }
    let requested = false;
    if (this.canUseBridgeSchedules()) {
      requested = this.client.listSchedules().length > 0 || requested;
    }
    if (this.canUseBridgeLoops()) {
      requested = this.client.listLoops().length > 0 || requested;
    }
    if (this.canUseBridgeChatRooms()) {
      requested = this.client.listChatRooms().length > 0 || requested;
    }
    this.m7Busy = requested;
  }

  private refreshM7CurrentTab(): void {
    if (this.automationTabIndex === AgentHomeAutomationTabIndex.SCHEDULES && this.canUseBridgeSchedules()) {
      this.m7Busy = this.client.listSchedules().length > 0;
      return;
    }
    if (this.automationTabIndex === AgentHomeAutomationTabIndex.LOOPS && this.canUseBridgeLoops()) {
      this.m7Busy = this.client.listLoops().length > 0;
      return;
    }
    if (this.canUseBridgeChatRooms()) {
      this.m7Busy = this.client.listChatRooms().length > 0;
      return;
    }
    if (this.canUseBridgeSchedules()) {
      this.automationTabIndex = AgentHomeAutomationTabIndex.SCHEDULES;
      this.m7Busy = this.client.listSchedules().length > 0;
    } else if (this.canUseBridgeLoops()) {
      this.automationTabIndex = AgentHomeAutomationTabIndex.LOOPS;
      this.m7Busy = this.client.listLoops().length > 0;
    }
  }

  private resetScheduleDraft(): void {
    this.selectedScheduleId = '';
    this.scheduleNameDraft = '';
    this.schedulePromptDraft = '';
    this.scheduleCronDraft = '0 9 * * *';
    this.scheduleTimezoneDraft = 'UTC';
    this.scheduleEnabledDraft = true;
    this.scheduleRunRecords = [];
  }

  private selectSchedule(item: AgentBridgeScheduleRecord): void {
    this.selectedScheduleId = item.id;
    this.scheduleNameDraft = item.name;
    this.schedulePromptDraft = item.prompt;
    this.scheduleCronDraft = item.cadence.expression;
    this.scheduleTimezoneDraft = item.cadence.timezone.length > 0 ? item.cadence.timezone : 'UTC';
    this.scheduleEnabledDraft = item.enabled;
    this.client.requestScheduleHistory(item.id);
  }

  private buildScheduleDraftRecord(): AgentBridgeScheduleRecord {
    const item = new AgentBridgeScheduleRecord();
    const existing = this.findScheduleRecord(this.selectedScheduleId);
    if (existing !== null) {
      item.id = existing.id;
      item.modelId = existing.modelId;
      item.concurrency = existing.concurrency;
      item.retry = existing.retry;
      item.retention = existing.retention;
      item.missedRunPolicy = existing.missedRunPolicy;
    }
    item.name = this.scheduleNameDraft.trim();
    item.prompt = this.schedulePromptDraft.trim();
    item.workspaceId = this.activeWorkspaceId;
    item.workspacePath = this.currentWorkspacePath();
    item.providerId = this.selectedProviderId;
    item.modelId = item.modelId.length > 0 ? item.modelId : this.selectedModelId;
    item.enabled = this.scheduleEnabledDraft;
    item.status = item.enabled ? 'enabled' : 'disabled';
    item.cadence.expression = this.scheduleCronDraft.trim();
    item.cadence.timezone = this.scheduleTimezoneDraft.trim().length > 0 ? this.scheduleTimezoneDraft.trim() : 'UTC';
    return item;
  }

  private previewSaveSchedule(): void {
    if (!this.canUseBridgeSchedules() || this.m7Busy) {
      return;
    }
    const schedule = this.buildScheduleDraftRecord();
    this.pendingM7Action = schedule.id.length > 0 ? AgentBridgeRequestType.SCHEDULE_UPDATE : AgentBridgeRequestType.SCHEDULE_CREATE;
    this.pendingM7Schedule = schedule;
    this.pendingM7EntityId = schedule.id;
    this.m7Busy = this.client.saveSchedule(schedule).length > 0;
  }

  private previewScheduleAction(action: string, schedule: AgentBridgeScheduleRecord): void {
    if (!this.canUseBridgeSchedules() || this.m7Busy || schedule.id.length === 0) {
      return;
    }
    this.pendingM7Action = action;
    this.pendingM7Schedule = schedule;
    this.pendingM7EntityId = schedule.id;
    let requestId = '';
    if (action === AgentBridgeRequestType.SCHEDULE_RUN_NOW) {
      requestId = this.client.runScheduleNow(schedule.id);
    } else if (action === AgentBridgeRequestType.SCHEDULE_ENABLE) {
      requestId = this.client.setScheduleEnabled(schedule.id, true);
    } else if (action === AgentBridgeRequestType.SCHEDULE_DISABLE) {
      requestId = this.client.setScheduleEnabled(schedule.id, false);
    } else if (action === AgentBridgeRequestType.SCHEDULE_REMOVE) {
      requestId = this.client.removeSchedule(schedule.id);
    }
    this.m7Busy = requestId.length > 0;
  }

  private findScheduleRecord(scheduleId: string): AgentBridgeScheduleRecord | null {
    for (let index = 0; index < this.scheduleRecords.length; index++) {
      if (this.scheduleRecords[index].id === scheduleId) {
        return this.scheduleRecords[index];
      }
    }
    return null;
  }

  private resetLoopDraft(): void {
    this.selectedLoopId = '';
    this.loopNameDraft = '';
    this.loopPromptDraft = '';
    this.loopVerifyPromptDraft = '';
    this.loopCriterionDraft = '';
    this.loopMaxRoundsDraft = '5';
    this.loopWorkspaceModeDraft = 'isolated';
    this.loopRoundRecords = [];
  }

  private selectLoop(item: AgentBridgeLoopRecord): void {
    this.selectedLoopId = item.id;
    this.loopNameDraft = item.name;
    this.loopPromptDraft = item.prompt;
    this.loopVerifyPromptDraft = item.verifyPrompt;
    this.loopCriterionDraft = item.acceptanceCriteria.length > 0 ? item.acceptanceCriteria[0].description : '';
    this.loopMaxRoundsDraft = String(item.maxRounds > 0 ? item.maxRounds : 5);
    this.loopWorkspaceModeDraft = item.workspaceMode === 'shared' ? 'shared' : 'isolated';
    this.client.requestLoopRounds(item.id);
  }

  private buildLoopDraftRecord(): AgentBridgeLoopRecord {
    const item = new AgentBridgeLoopRecord();
    const existing = this.findLoopRecord(this.selectedLoopId);
    if (existing !== null) {
      item.id = existing.id;
      item.sourceAgentId = existing.sourceAgentId;
      item.workerModelId = existing.workerModelId;
      item.verifierModelId = existing.verifierModelId;
      item.budget = existing.budget;
    }
    item.name = this.loopNameDraft.trim();
    item.prompt = this.loopPromptDraft.trim();
    item.verifyPrompt = this.loopVerifyPromptDraft.trim();
    item.workspaceId = this.activeWorkspaceId;
    item.workspacePath = this.currentWorkspacePath();
    item.workerProviderId = this.selectedProviderId;
    item.workerModelId = item.workerModelId.length > 0 ? item.workerModelId : this.selectedModelId;
    item.verifierProviderId = this.selectedProviderId;
    item.verifierModelId = item.verifierModelId.length > 0 ? item.verifierModelId : this.selectedModelId;
    item.workspaceMode = this.loopWorkspaceModeDraft;
    item.maxRounds = this.parseM7PositiveInteger(this.loopMaxRoundsDraft, 5, 100);
    if (this.loopCriterionDraft.trim().length > 0) {
      const criterion = new AgentBridgeLoopAcceptanceCriterion();
      criterion.id = 'acceptance_1';
      criterion.description = this.loopCriterionDraft.trim();
      item.acceptanceCriteria.push(criterion);
    }
    return item;
  }

  private previewSaveLoop(): void {
    if (!this.canUseBridgeLoops() || this.m7Busy) {
      return;
    }
    const loop = this.buildLoopDraftRecord();
    this.pendingM7Action = loop.id.length > 0 ? AgentBridgeRequestType.LOOP_UPDATE : AgentBridgeRequestType.LOOP_CREATE;
    this.pendingM7Loop = loop;
    this.pendingM7EntityId = loop.id;
    this.m7Busy = this.client.saveLoop(loop).length > 0;
  }

  private previewLoopAction(action: string, loop: AgentBridgeLoopRecord): void {
    if (!this.canUseBridgeLoops() || this.m7Busy || loop.id.length === 0) {
      return;
    }
    this.pendingM7Action = action;
    this.pendingM7Loop = loop;
    this.pendingM7EntityId = loop.id;
    let requestId = '';
    if (action === AgentBridgeRequestType.LOOP_START) {
      requestId = this.client.startLoop(loop.id);
    } else if (action === AgentBridgeRequestType.LOOP_RESUME) {
      requestId = this.client.resumeLoop(loop.id);
    } else if (action === AgentBridgeRequestType.LOOP_STOP) {
      requestId = this.client.stopLoop(loop.id);
    } else if (action === AgentBridgeRequestType.LOOP_TAKEOVER) {
      requestId = this.client.takeoverLoop(loop.id);
    } else if (action === AgentBridgeRequestType.LOOP_REMOVE) {
      requestId = this.client.removeLoop(loop.id);
    }
    this.m7Busy = requestId.length > 0;
  }

  private pauseLoop(loopId: string): void {
    if (!this.canUseBridgeLoops() || this.m7Busy || loopId.length === 0) {
      return;
    }
    this.m7Busy = this.client.pauseLoop(loopId).length > 0;
  }

  private findLoopRecord(loopId: string): AgentBridgeLoopRecord | null {
