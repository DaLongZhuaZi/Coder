              .fontColor([$r('app.color.text_white')])
            Text($r('app.string.agent_home_relay_connect'))
              .fontSize(11)
              .fontColor($r('app.color.text_white'))
          }
        }
        .layoutWeight(1)
        .height(36)
        .borderRadius(9)
        .backgroundColor($r('app.color.button_primary'))
        .enabled(!this.relayOperationBusy && !this.relayStatus.connected && this.isRelayUrlDraftValid())
        .onClick((): void => {
          this.connectBridgeRelay();
        })
        Button() {
          Row({ space: 5 }) {
            SymbolGlyph($r('sys.symbol.link_slash'))
              .fontSize(14)
              .fontColor([$r('app.color.text_body')])
            Text($r('app.string.agent_home_relay_disconnect'))
              .fontSize(11)
              .fontColor($r('app.color.text_body'))
          }
        }
        .layoutWeight(1)
        .height(36)
        .borderRadius(9)
        .backgroundColor($r('app.color.background_surface'))
        .enabled(!this.relayOperationBusy && this.relayStatus.connected)
        .onClick((): void => {
          this.disconnectBridgeRelay();
        })
      }
      .width('100%')

      this.buildRelayDiagnosticRow($r('app.string.agent_home_relay_status'), this.relayConnectionStateText())
      this.buildRelayDiagnosticRow($r('app.string.agent_home_relay_transport'), this.relayTransportText())
