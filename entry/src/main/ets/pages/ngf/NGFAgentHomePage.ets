  private previewRemoveChatRoomMember(member: AgentBridgeChatRoomMember): void {
    if (!this.canUseBridgeChatRooms() || this.m7Busy || this.selectedChatRoomId.length === 0) {
      return;
    }
    this.pendingM7Action = AgentBridgeRequestType.CHAT_ROOM_MEMBER_REMOVE;
    this.pendingM7Member = member;
    this.pendingM7EntityId = this.selectedChatRoomId;
    this.m7Busy = this.client.removeChatRoomMember(this.selectedChatRoomId, member.memberId).length > 0;
  }

  private postSelectedChatRoomMessage(): void {
    const body = this.chatRoomMessageDraft.trim();
    if (!this.canUseBridgeChatRooms() || !this.currentChatRoomCanPost() || body.length === 0) {
      return;
    }
    if (this.chatRoomClientMessageId.length === 0) {
      this.chatRoomClientMessageId = 'room_message_' + String(Date.now()) + '_' + this.safeIdPart(this.selectedChatRoomId);
    }
    const mentions: Array<string> = [];
    if (this.chatRoomMentionMemberId.length > 0) {
      mentions.push(this.chatRoomMentionMemberId);
    }
    this.m7Busy = this.client.postChatRoomMessage(
      this.selectedChatRoomId,
      this.chatRoomClientMessageId,
      body,
      this.chatRoomReplyMessageId,
      mentions
    ).length > 0;
  }

  private acknowledgeSelectedChatRoom(): void {
    const room = this.findChatRoomRecord(this.selectedChatRoomId);
    if (room === null) {
      return;
    }
    let lastSeq = room.sequence;
    if (this.chatRoomMessages.length > 0) {
      lastSeq = this.chatRoomMessages[this.chatRoomMessages.length - 1].seq;
    }
    this.m7Busy = this.client.acknowledgeChatRoom(room.id, lastSeq).length > 0;
  }

  private findChatRoomRecord(roomId: string): AgentBridgeChatRoom | null {
    for (let index = 0; index < this.chatRoomRecords.length; index++) {
      if (this.chatRoomRecords[index].id === roomId) {
        return this.chatRoomRecords[index];
      }
    }
    return null;
  }

  private currentChatRoomMembers(): Array<AgentBridgeChatRoomMember> {
    const room = this.findChatRoomRecord(this.selectedChatRoomId);
    return room === null ? [] : room.members;
  }

  private currentChatRoomCanManage(): boolean {
    const room = this.findChatRoomRecord(this.selectedChatRoomId);
    return room !== null && room.canManage && room.archivedAt.length === 0;
  }

  private currentChatRoomCanPost(): boolean {
    const room = this.findChatRoomRecord(this.selectedChatRoomId);
    return room !== null && room.canPost && room.archivedAt.length === 0;
  }

  private showM7PreviewDialog(result: AgentBridgeM7Result): void {
    if (this.pendingM7Action.length === 0 || result.action !== this.pendingM7Action || result.planId.length === 0) {
      return;
    }
    this.pendingM7PlanId = result.planId;
    const hostContext = this.getUIContext().getHostContext();
    const entityName = this.m7PreviewEntityName(result);
    let message = resolveResourceString(hostContext, $r('app.string.agent_home_m7_confirm_message')) + '\n' + result.action;
    if (entityName.length > 0) {
      message += '\n' + entityName;
    }
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_m7_confirm_title')),
      message,
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_confirm')),
        action: (): void => {
          this.confirmPendingM7Operation();
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {
          this.clearPendingM7Operation();
        }
      }
    });
  }

  private confirmPendingM7Operation(): void {
    const action = this.pendingM7Action;
    const planId = this.pendingM7PlanId;
    if (action.length === 0 || planId.length === 0) {
      return;
    }
    let requestId = '';
    if (action === AgentBridgeRequestType.SCHEDULE_CREATE || action === AgentBridgeRequestType.SCHEDULE_UPDATE) {
      requestId = this.client.saveSchedule(this.pendingM7Schedule, planId, true);
    } else if (action === AgentBridgeRequestType.SCHEDULE_ENABLE) {
      requestId = this.client.setScheduleEnabled(this.pendingM7EntityId, true, planId, true);
    } else if (action === AgentBridgeRequestType.SCHEDULE_DISABLE) {
      requestId = this.client.setScheduleEnabled(this.pendingM7EntityId, false, planId, true);
    } else if (action === AgentBridgeRequestType.SCHEDULE_RUN_NOW) {
      requestId = this.client.runScheduleNow(this.pendingM7EntityId, planId, true);
    } else if (action === AgentBridgeRequestType.SCHEDULE_REMOVE) {
      requestId = this.client.removeSchedule(this.pendingM7EntityId, planId, true);
    } else if (action === AgentBridgeRequestType.LOOP_CREATE || action === AgentBridgeRequestType.LOOP_UPDATE) {
      requestId = this.client.saveLoop(this.pendingM7Loop, planId, true);
    } else if (action === AgentBridgeRequestType.LOOP_START) {
      requestId = this.client.startLoop(this.pendingM7EntityId, planId, true);
    } else if (action === AgentBridgeRequestType.LOOP_RESUME) {
      requestId = this.client.resumeLoop(this.pendingM7EntityId, planId, true);
    } else if (action === AgentBridgeRequestType.LOOP_STOP) {
      requestId = this.client.stopLoop(this.pendingM7EntityId, planId, true);
    } else if (action === AgentBridgeRequestType.LOOP_TAKEOVER) {
      requestId = this.client.takeoverLoop(this.pendingM7EntityId, planId, true);
    } else if (action === AgentBridgeRequestType.LOOP_REMOVE) {
      requestId = this.client.removeLoop(this.pendingM7EntityId, planId, true);
    } else if (action === AgentBridgeRequestType.CHAT_ROOM_CREATE || action === AgentBridgeRequestType.CHAT_ROOM_UPDATE) {
      requestId = this.client.saveChatRoom(this.pendingM7Room, '', planId, true);
    } else if (action === AgentBridgeRequestType.CHAT_ROOM_ARCHIVE) {
      requestId = this.client.archiveChatRoom(this.pendingM7EntityId, planId, true);
    } else if (action === AgentBridgeRequestType.CHAT_ROOM_MEMBER_ADD) {
      requestId = this.client.addChatRoomMember(this.pendingM7EntityId, this.pendingM7Member, planId, true);
    } else if (action === AgentBridgeRequestType.CHAT_ROOM_MEMBER_UPDATE) {
      requestId = this.client.updateChatRoomMember(
        this.pendingM7EntityId,
        this.pendingM7Member.memberId,
        this.pendingM7Member.role,
        this.pendingM7Member.displayName,
        planId,
        true
      );
    } else if (action === AgentBridgeRequestType.CHAT_ROOM_MEMBER_REMOVE) {
      requestId = this.client.removeChatRoomMember(
        this.pendingM7EntityId,
        this.pendingM7Member.memberId,
        planId,
        true
      );
    }
    this.m7Busy = requestId.length > 0;
    this.clearPendingM7Operation();
  }

  private clearPendingM7Operation(): void {
    this.pendingM7Action = '';
    this.pendingM7PlanId = '';
    this.pendingM7EntityId = '';
    this.pendingM7Schedule = new AgentBridgeScheduleRecord();
    this.pendingM7Loop = new AgentBridgeLoopRecord();
    this.pendingM7Room = new AgentBridgeChatRoom();
    this.pendingM7Member = new AgentBridgeChatRoomMember();
  }

  private m7PreviewEntityName(result: AgentBridgeM7Result): string {
    if (result.schedule.name.length > 0) {
      return result.schedule.name;
    }
    if (result.loop.name.length > 0) {
      return result.loop.name;
    }
    if (result.room.name.length > 0) {
      return result.room.name;
    }
    if (result.member.displayName.length > 0) {
      return result.member.displayName;
    }
    return this.pendingM7EntityId;
  }

  private applyBridgeM7Result(source: string, parsed: AgentBridgeParsedMessage): void {
    if (parsed.envelopeType === AgentBridgeEnvelopeType.EVENT) {
      this.refreshM7ForEvent(parsed.eventType);
      return;
    }
    const result = AgentBridgeIncomingParser.parseM7Result(source);
    this.m7Result = result;
    this.m7Busy = false;
    if (result.schedules.length > 0 || result.action === AgentBridgeRequestType.SCHEDULE_LIST) {
      this.scheduleRecords = result.schedules;
    }
    if (result.schedule.id.length > 0) {
      this.upsertScheduleRecord(result.schedule);
    }
    if (result.runs.length > 0 || result.action === AgentBridgeRequestType.SCHEDULE_HISTORY) {
      this.scheduleRunRecords = result.runs;
    }
    if (result.loops.length > 0 || result.action === AgentBridgeRequestType.LOOP_LIST) {
      this.loopRecords = result.loops;
    }
    if (result.loop.id.length > 0) {
      this.upsertLoopRecord(result.loop);
    }
    if (result.rounds.length > 0 || result.action === AgentBridgeRequestType.LOOP_ROUNDS) {
      this.loopRoundRecords = result.rounds;
    }
    if (result.rooms.length > 0 || result.action === AgentBridgeRequestType.CHAT_ROOM_LIST) {
      this.chatRoomRecords = result.rooms;
    }
    if (result.room.id.length > 0) {
      this.upsertChatRoomRecord(result.room);
    }
    if (result.messages.length > 0 || result.action === AgentBridgeRequestType.CHAT_ROOM_MESSAGE_LIST) {
      this.chatRoomMessages = result.messages;
    }
    if (result.preview && result.ok && result.planId.length > 0) {
      this.showM7PreviewDialog(result);
      return;
    }
    if (!result.ok) {
      return;
    }
    if (result.action === AgentBridgeRequestType.CHAT_ROOM_MESSAGE_POST) {
      this.chatRoomMessageDraft = '';
      this.chatRoomMentionMemberId = '';
      this.chatRoomReplyMessageId = '';
      this.chatRoomClientMessageId = '';
      if (this.selectedChatRoomId.length > 0) {
        this.client.requestChatRoomMessages(this.selectedChatRoomId, 0, 0, 100);
      }
    }
    if (result.action === AgentBridgeRequestType.CHAT_ROOM_ACK && this.selectedChatRoomId.length > 0) {
      this.client.listChatRooms();
    }
    if (result.action === AgentBridgeRequestType.SCHEDULE_REMOVE &&
      result.scheduleId.length > 0 && result.scheduleId === this.selectedScheduleId) {
      this.resetScheduleDraft();
    }
    if (result.action === AgentBridgeRequestType.LOOP_REMOVE &&
      result.loopId.length > 0 && result.loopId === this.selectedLoopId) {
      this.resetLoopDraft();
    }
    if ((result.action === AgentBridgeRequestType.SCHEDULE_CREATE || result.action === AgentBridgeRequestType.SCHEDULE_UPDATE) &&
      result.schedule.id.length > 0) {
      this.selectSchedule(result.schedule);
    }
    if ((result.action === AgentBridgeRequestType.LOOP_CREATE || result.action === AgentBridgeRequestType.LOOP_UPDATE) &&
      result.loop.id.length > 0) {
      this.selectLoop(result.loop);
    }
    if ((result.action === AgentBridgeRequestType.CHAT_ROOM_CREATE || result.action === AgentBridgeRequestType.CHAT_ROOM_UPDATE) &&
      result.room.id.length > 0) {
      this.selectChatRoom(result.room);
    }
    if (result.confirmed || result.action === AgentBridgeRequestType.LOOP_PAUSE) {
      this.refreshM7ActionScope(result.action);
    }
  }

  private refreshM7ForEvent(eventType: string): void {
    if (!this.isSettingsSheetOpen || !this.canUseBridgeAutomationCollaboration()) {
      return;
    }
    if (eventType === AgentBridgeEventType.SCHEDULE_UPDATED) {
      this.client.listSchedules();
    } else if (eventType === AgentBridgeEventType.SCHEDULE_RUN_UPDATED) {
      this.client.listSchedules();
      if (this.selectedScheduleId.length > 0) {
        this.client.requestScheduleHistory(this.selectedScheduleId);
      }
    } else if (eventType === AgentBridgeEventType.LOOP_UPDATED) {
      this.client.listLoops();
    } else if (eventType === AgentBridgeEventType.LOOP_ROUND_UPDATED) {
      this.client.listLoops();
      if (this.selectedLoopId.length > 0) {
        this.client.requestLoopRounds(this.selectedLoopId);
      }
    } else if (eventType === AgentBridgeEventType.CHAT_ROOM_UPDATED) {
      this.client.listChatRooms();
      if (this.selectedChatRoomId.length > 0) {
        this.client.getChatRoom(this.selectedChatRoomId);
      }
    } else if (eventType === AgentBridgeEventType.CHAT_ROOM_MESSAGE_CREATED) {
      if (this.selectedChatRoomId.length > 0) {
        this.client.requestChatRoomMessages(this.selectedChatRoomId, 0, 0, 100);
      }
      this.client.listChatRooms();
    } else if (eventType === AgentBridgeEventType.CHAT_ROOM_ACK_UPDATED) {
      this.client.listChatRooms();
    }
  }

  private refreshM7ActionScope(action: string): void {
    if (action.indexOf('schedule.') === 0 && this.canUseBridgeSchedules()) {
      this.client.listSchedules();
      if (this.selectedScheduleId.length > 0) {
        this.client.requestScheduleHistory(this.selectedScheduleId);
      }
    } else if (action.indexOf('loop.') === 0 && this.canUseBridgeLoops()) {
      this.client.listLoops();
      if (this.selectedLoopId.length > 0) {
        this.client.requestLoopRounds(this.selectedLoopId);
      }
    } else if (action.indexOf('chat.room.') === 0 && this.canUseBridgeChatRooms()) {
      this.client.listChatRooms();
      if (this.selectedChatRoomId.length > 0) {
        this.client.getChatRoom(this.selectedChatRoomId);
        this.client.requestChatRoomMessages(this.selectedChatRoomId, 0, 0, 100);
      }
    }
  }

  private upsertScheduleRecord(item: AgentBridgeScheduleRecord): void {
    const next: Array<AgentBridgeScheduleRecord> = [];
    let replaced = false;
    for (let index = 0; index < this.scheduleRecords.length; index++) {
      if (this.scheduleRecords[index].id === item.id) {
        next.push(item);
        replaced = true;
      } else {
        next.push(this.scheduleRecords[index]);
      }
    }
    if (!replaced) {
      next.push(item);
    }
    this.scheduleRecords = next;
  }

  private upsertLoopRecord(item: AgentBridgeLoopRecord): void {
    const next: Array<AgentBridgeLoopRecord> = [];
    let replaced = false;
    for (let index = 0; index < this.loopRecords.length; index++) {
      if (this.loopRecords[index].id === item.id) {
        next.push(item);
        replaced = true;
      } else {
        next.push(this.loopRecords[index]);
      }
    }
    if (!replaced) {
      next.push(item);
    }
    this.loopRecords = next;
  }

  private upsertChatRoomRecord(item: AgentBridgeChatRoom): void {
    const next: Array<AgentBridgeChatRoom> = [];
    let replaced = false;
    for (let index = 0; index < this.chatRoomRecords.length; index++) {
      if (this.chatRoomRecords[index].id === item.id) {
        next.push(item);
        replaced = true;
      } else {
        next.push(this.chatRoomRecords[index]);
      }
    }
    if (!replaced) {
      next.push(item);
    }
    this.chatRoomRecords = next;
  }

