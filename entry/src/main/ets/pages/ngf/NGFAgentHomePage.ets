  private async refreshDaemonFleet(): Promise<void> {
    if (!this.canUseBridgeDaemonFleet()) {
      this.daemonFleetLastError = resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_feature_unavailable')
      );
      return;
    }
    const expectedEpoch = this.connectionEpoch;
    this.daemonFleetBusy = true;
    this.daemonFleetLastError = '';
    try {
      const results = await this.daemonFleetConnectionPool.collect(
        this.hostProfiles,
        this.appBuildVersion,
        3,
        8000
      );
      if (expectedEpoch !== this.connectionEpoch || !this.canUseBridgeDaemonFleet() ||
        !AgentHomeDaemonFleetAvailabilityPolicy.matchesCurrentProfiles(results, this.hostProfiles)) {
        return;
      }
      this.daemonFleetResults = results;
      this.daemonFleetSummary = summarizeDaemonFleetResults(results);
      for (let index = 0; index < results.length; index++) {
        if (!results[index].ok && results[index].message.length > 0) {
          this.daemonFleetLastError = results[index].message;
          break;
        }
      }
    } catch (error) {
      this.daemonFleetLastError = this.errorToString(error);
    } finally {
      this.daemonFleetBusy = false;
    }
  }

  private previewDaemonFleetRollingRestart(): void {
    if (!this.canUseBridgeDaemonFleet() || this.daemonFleetResults.length === 0) {
      this.daemonFleetLastError = resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_feature_unavailable')
      );
      return;
    }
    const snapshots: Array<AgentHomeDaemonInstanceSnapshot> = [];
    for (let index = 0; index < this.daemonFleetResults.length; index++) {
      const source = this.daemonFleetResults[index].snapshot;
      const isolated = this.isDaemonFleetHostIsolated(source.hostProfileId);
      snapshots.push(cloneDaemonFleetSnapshot(source, isolated));
    }
    this.daemonFleetRollingResult = this.daemonFleetCoordinator.buildPreview(
      snapshots,
      this.daemonFleetRollingOperation
    );
    agentHomeDaemonFleetRunStore.clear();
    this.daemonFleetLastError = '';
    this.showTransientStatus(resolveResourceString(
      this.getUIContext().getHostContext(), $r('app.string.agent_home_daemon_fleet_preview_ready')
    ));
  }

  private confirmDaemonFleetRollingOperation(): void {
    if (this.daemonFleetRollingResult.status !== 'preview' || this.daemonFleetRollingResult.pending.length === 0 || this.daemonFleetBusy) {
      return;
    }
    const hostContext = this.getUIContext().getHostContext();
    const operation = this.daemonFleetOperationLabel();
    const message = resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_confirm_message')) +
      '\n' + operation + ' · ' + String(this.daemonFleetRollingResult.pending.length);
    this.getUIContext().showAlertDialog({
      title: resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_confirm_title')),
      message,
      primaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_confirm')),
        action: (): void => {
          this.runDaemonFleetRollingOperation().catch((error: Error): void => {
            this.daemonFleetLastError = this.errorToString(error);
          });
        }
      },
      secondaryButton: {
        value: resolveResourceString(hostContext, $r('app.string.agent_home_action_cancel')),
        action: (): void => {}
      }
    });
  }

  private async runDaemonFleetRollingOperation(): Promise<void> {
    if (this.daemonFleetRollingResult.status !== 'preview' || this.daemonFleetRollingResult.pending.length === 0) {
      return;
    }
    const expectedEpoch = this.connectionEpoch;
    const preview = this.daemonFleetRollingResult;
    const control = new AgentHomeDaemonFleetRunControl();
    this.daemonFleetRollingControl = control;
    agentHomeDaemonFleetRunStore.begin(preview);
    this.daemonFleetBusy = true;
    this.daemonFleetLastError = '';
    try {
      const result = await this.daemonFleetCoordinator.run(preview, async (step: AgentHomeDaemonRollingStep): Promise<AgentHomeDaemonStepExecutionResult> => {
        const profile = this.findHostProfile(step.hostProfileId);
        if (profile === null) {
          return new AgentHomeDaemonStepExecutionResult(
            false,
            step.expectedGeneration,
            'unreachable',
            resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_daemon_fleet_host_missing'))
          );
        }
        const action: AgentHomeDaemonFleetActionResult = await this.daemonFleetConnectionPool.execute(
          profile,
          this.daemonFleetRollingOperation,
          step.expectedGeneration,
          step.targetBridgeVersion,
          this.appBuildVersion,
          30000,
          step.instanceId
        );
        return new AgentHomeDaemonStepExecutionResult(
          action.ok,
          action.generation,
          action.health,
          action.message,
          action.hostProfileId,
          action.instanceId,
          action.bridgeVersion,
          action.configVersion,
          action.failureCategory
        );
      }, control);
      if (expectedEpoch !== this.connectionEpoch) {
        return;
      }
      this.daemonFleetRollingResult = result;
      agentHomeDaemonFleetRunStore.finish(result);
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(),
        result.status === 'completed' ? $r('app.string.agent_home_daemon_fleet_completed') :
          $r('app.string.agent_home_daemon_fleet_failed')
      ));
    } finally {
      if (this.daemonFleetRollingControl === control) {
        this.daemonFleetRollingControl = null;
      }
      this.daemonFleetBusy = false;
    }
    await this.refreshDaemonFleet();
  }

  private cancelDaemonFleetRolling(reason: string): void {
    if (this.daemonFleetRollingControl !== null) {
      agentHomeDaemonFleetRunStore.markInterrupted(this.daemonFleetRollingResult, reason);
      this.daemonFleetRollingControl.cancel(reason);
    }
  }

  private toggleDaemonFleetIsolation(hostProfileId: string): void {
    if (hostProfileId.length === 0) {
      return;
    }
    const next: Array<string> = [];
    let found = false;
    for (let index = 0; index < this.daemonFleetIsolatedHostProfileIds.length; index++) {
      const existing = this.daemonFleetIsolatedHostProfileIds[index];
      if (existing === hostProfileId) {
        found = true;
      } else {
        next.push(existing);
      }
    }
    if (!found) {
      next.push(hostProfileId);
    }
    this.daemonFleetIsolatedHostProfileIds = next;
    this.daemonFleetRollingResult = new AgentHomeDaemonRollingResult();
  }

  private isDaemonFleetHostIsolated(hostProfileId: string): boolean {
    for (let index = 0; index < this.daemonFleetIsolatedHostProfileIds.length; index++) {
      if (this.daemonFleetIsolatedHostProfileIds[index] === hostProfileId) {
        return true;
      }
    }
    return false;
  }

  private daemonFleetOperationLabel(): string {
    const hostContext = this.getUIContext().getHostContext();
    if (this.daemonFleetRollingOperation === 'update') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_update'));
    }
    if (this.daemonFleetRollingOperation === 'rollback') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_rollback'));
    }
    return resolveResourceString(hostContext, $r('app.string.agent_home_daemon_fleet_restart'));
