  @Builder
  private buildBrowserAutomationPanel(): void {
    Column({ space: 8 }) {
      Row({ space: 8 }) {
        SymbolGlyph($r('sys.symbol.navigation'))
          .fontSize(18)
          .fontColor([$r('app.color.text_body')])
        Column({ space: 2 }) {
          Text($r('app.string.agent_home_browser_title'))
            .fontSize(14)
            .fontWeight(FontWeight.Medium)
            .fontColor($r('app.color.text_body'))
          Text($r('app.string.agent_home_browser_desc'))
            .fontSize(10)
            .fontColor($r('app.color.text_secondary'))
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .layoutWeight(1)
        Button($r('app.string.agent_home_browser_refresh'))
          .height(32)
          .fontSize(10)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_surface'))
          .enabled(!this.browserAutomationPending)
          .onClick((): void => { this.refreshBrowserAutomation(); })
      }
      .width('100%')

      Text($r('app.string.agent_home_browser_hosts'))
        .width('100%')
        .fontSize(11)
        .fontWeight(FontWeight.Medium)
        .fontColor($r('app.color.text_body'))
      if (this.browserHosts.length === 0) {
        Text($r('app.string.agent_home_browser_no_host'))
          .width('100%')
          .fontSize(10)
          .fontColor($r('app.color.text_secondary'))
      } else {
        ForEach(this.browserHosts, (host: AgentBridgeBrowserHostRecord) => {
          Column({ space: 2 }) {
            Row({ space: 6 }) {
              Button(host.label.length > 0 ? host.label : host.hostId)
                .layoutWeight(1)
                .height(34)
                .fontSize(10)
                .borderRadius(8)
                .backgroundColor(host.hostId === this.selectedBrowserHostId ? $r('app.color.button_primary') : $r('app.color.background_surface'))
                .fontColor(host.hostId === this.selectedBrowserHostId ? $r('app.color.text_white') : $r('app.color.text_body'))
                .enabled(!this.browserAutomationPending && host.hostId !== this.selectedBrowserHostId)
                .onClick((): void => { this.selectBrowserHost(host.hostId); })
              Text(host.platform + (host.connected ? '' : ' · ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_host_offline'))))
                .width(120)
                .fontSize(9)
                .fontColor(this.browserHostIsReady(host) ? $r('app.color.text_secondary') : $r('app.color.tag_red'))
                .maxLines(1)
                .textOverflow({ overflow: TextOverflow.Ellipsis })
            }
            .width('100%')
            if (this.browserCapabilityMetadataEnabled() && this.browserHostMetadataText(host).length > 0) {
              Text(this.browserHostMetadataText(host))
                .width('100%')
                .fontSize(8)
                .fontColor($r('app.color.text_secondary'))
                .maxLines(1)
                .textOverflow({ overflow: TextOverflow.Ellipsis })
            }
            if (this.browserCapabilityMetadataEnabled() && host.capabilityWarnings.length > 0) {
              Row({ space: 4 }) {
                SymbolGlyph($r('sys.symbol.exclamationmark_triangle'))
                  .fontSize(11)
                  .fontColor([$r('app.color.tag_amber')])
                Text($r('app.string.agent_home_browser_host_warning_count'))
                  .fontSize(8)
                  .fontColor($r('app.color.tag_amber'))
                Text(String(host.capabilityWarnings.length))
                  .fontSize(8)
                  .fontColor($r('app.color.tag_amber'))
              }
              .width('100%')
            }
            if ((this.browserCapabilityMetadataEnabled() || AgentHomeBrowserCapabilityPolicy.requiresVerifiedCapability(host)) &&
              host.connected && !this.browserHostIsReady(host)) {
              Text($r('app.string.agent_home_browser_host_not_ready'))
                .width('100%')
                .fontSize(8)
                .fontColor($r('app.color.tag_red'))
                .maxLines(1)
                .textOverflow({ overflow: TextOverflow.Ellipsis })
            }
          }
          .width('100%')
        }, (host: AgentBridgeBrowserHostRecord): string => host.hostId)
      }
      if (this.browserHosts.length > 0 && !this.browserHasReadyHost()) {
        Text($r('app.string.agent_home_browser_no_ready_host'))
          .width('100%')
          .fontSize(10)
          .fontColor($r('app.color.tag_amber'))
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }

      Row({ space: 6 }) {
        Text($r('app.string.agent_home_browser_instances'))
          .layoutWeight(1)
          .fontSize(11)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.text_body'))
        Button($r('app.string.agent_home_browser_create_instance'))
          .height(30)
          .fontSize(9)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_surface'))
          .enabled(!this.browserAutomationPending && this.browserSupportsBrowserCommand('instance.create'))
          .onClick((): void => { this.createBrowserInstanceFromPanel(); })
      }
      .width('100%')
      if (this.browserInstances.length === 0) {
        Text($r('app.string.agent_home_browser_no_instances'))
          .width('100%')
          .fontSize(10)
          .fontColor($r('app.color.text_secondary'))
      } else {
        ForEach(this.browserInstances, (instance: AgentBridgeBrowserInstanceRecord) => {
          Row({ space: 6 }) {
            Button(instance.name.length > 0 ? instance.name : instance.instanceId)
              .layoutWeight(1)
              .height(32)
              .fontSize(10)
              .borderRadius(8)
              .backgroundColor(instance.instanceId === this.selectedBrowserInstanceId ? $r('app.color.button_primary') : $r('app.color.background_surface'))
              .fontColor(instance.instanceId === this.selectedBrowserInstanceId ? $r('app.color.text_white') : $r('app.color.text_body'))
              .enabled(!this.browserAutomationPending && instance.instanceId !== this.selectedBrowserInstanceId)
              .onClick((): void => { this.selectBrowserInstance(instance.instanceId); })
            Text(instance.engine + (instance.connected ? '' : ' · ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_host_offline'))))
              .width(120)
              .fontSize(9)
              .fontColor(instance.connected ? $r('app.color.text_secondary') : $r('app.color.tag_red'))
              .maxLines(1)
              .textOverflow({ overflow: TextOverflow.Ellipsis })
            Button($r('app.string.agent_home_browser_close_instance'))
              .height(30)
              .fontSize(9)
              .borderRadius(8)
              .backgroundColor($r('app.color.background_surface'))
              .enabled(!this.browserAutomationPending && this.browserSupportsBrowserCommand('instance.close'))
              .onClick((): void => { this.previewCloseBrowserInstance(instance); })
          }
          .width('100%')
        }, (instance: AgentBridgeBrowserInstanceRecord): string => instance.instanceId)
      }

      Row({ space: 6 }) {
        TextInput({ placeholder: $r('app.string.agent_home_browser_url_placeholder'), text: this.browserUrlDraft })
          .layoutWeight(1)
          .height(36)
          .fontSize(11)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_surface'))
          .onChange((value: string): void => { this.browserUrlDraft = value; })
        Button($r('app.string.agent_home_browser_open_page'))
          .height(36)
          .fontSize(10)
          .borderRadius(8)
          .enabled(!this.browserAutomationPending && this.browserUrlDraft.trim().length > 0 && this.browserSupportsBrowserCommand('page.create'))
          .onClick((): void => { this.createBrowserPageFromDraft(); })
      }
      .width('100%')

      Text($r('app.string.agent_home_browser_pages'))
        .width('100%')
        .fontSize(11)
        .fontWeight(FontWeight.Medium)
        .fontColor($r('app.color.text_body'))

      Row({ space: 6 }) {
        TextInput({ placeholder: $r('app.string.agent_home_browser_domain_placeholder'), text: this.browserDomainDraft })
          .layoutWeight(1)
          .height(36)
          .fontSize(11)
          .borderRadius(8)
          .backgroundColor($r('app.color.background_surface'))
          .onChange((value: string): void => { this.browserDomainDraft = value; })
        Button($r('app.string.agent_home_browser_allow_domain'))
          .height(36)
          .fontSize(10)
          .borderRadius(8)
          .enabled(!this.browserAutomationPending && this.browserDomainDraft.trim().length > 0)
          .onClick((): void => { this.previewBrowserPermissionUpdate(); })
      }
      .width('100%')

      Column({ space: 3 }) {
        Row({ space: 4 }) {
          SymbolGlyph($r('sys.symbol.checkmark_circle'))
            .fontSize(12)
            .fontColor([$r('app.color.text_secondary')])
          Text($r('app.string.agent_home_browser_permission_current'))
            .fontSize(10)
            .fontWeight(FontWeight.Medium)
            .fontColor($r('app.color.text_body'))
        }
        Text(this.browserPermissionDomainsSummary())
          .width('100%')
          .fontSize(9)
          .fontColor($r('app.color.text_secondary'))
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
        Text(this.browserPermission.downloadDirectoryConfigured
          ? $r('app.string.agent_home_browser_permission_download_managed')
          : $r('app.string.agent_home_browser_permission_download_unavailable'))
          .width('100%')
          .fontSize(9)
          .fontColor(this.browserPermission.downloadDirectoryConfigured ? $r('app.color.text_secondary') : $r('app.color.tag_amber'))
        if (this.browserPermission.updatedAt.length > 0) {
          Text(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_browser_permission_updated')) +
            ': ' + this.browserPermission.updatedAt)
            .width('100%')
            .fontSize(8)
            .fontColor($r('app.color.text_secondary'))
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
      }
      .width('100%')

      if (this.browserHosts.length === 0) {
        Text($r('app.string.agent_home_browser_no_host'))
