    if (title.length === 0) {
      title = item.providerId;
    }
    const source = item.cloneFromProfileId.length > 0 ? item.cloneFromProfileId : item.baseProfileId;
    if (source.length > 0) {
      return title + ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_profile_source')) + ': ' + source;
