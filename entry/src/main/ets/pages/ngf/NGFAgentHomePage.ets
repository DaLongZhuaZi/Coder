  private previewProviderDirectoryRollback(item: AgentBridgeProviderDirectoryEntry): void {
    if (!this.providerDirectoryPending) {
      this.providerDirectoryPending = true;
      this.client.rollbackRemoteProvider(item.providerId);
    }
  }

  private previewProviderDirectoryRemove(item: AgentBridgeProviderDirectoryEntry): void {
    if (!this.providerDirectoryPending) {
      this.providerDirectoryPending = true;
      this.client.removeRemoteProvider(item.providerId, item.profileId);
    }
  }

