      this.canUseBridgeAgentRelationships() && this.currentBridgeAgentId().length > 0, 'capability_unavailable', true
    ));
    items.push(new AgentHomeCommandDefinition(
      'checkpoint', 'agent', resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_create')),
      ['agent', 'checkpoint'], 'checkpoint', AgentHomeActionKey.CREATE_CHECKPOINT, '',
