class AgentHomeSessionWindowLifecycleObserver implements IPlatformSubWindowLifecycleObserver {
  private readonly handler: (windowName: string) => void;

  constructor(handler: (windowName: string) => void) {
    this.handler = handler;
  }

  onSubWindowDestroyed(windowName: string): void {
    this.handler(windowName);
  }
}

class AgentHomeVoiceListener implements NGFVoicePlatformListener {
  private readonly snapshotHandler: (snapshot: NGFVoicePlatformSnapshot) => void;
  private readonly chunkHandler: (sessionId: string, sequence: number, chunk: Uint8Array) => void;
  private readonly transcriptHandler: (sessionId: string, text: string, isFinal: boolean, isLast: boolean) => void;

  constructor(
    snapshotHandler: (snapshot: NGFVoicePlatformSnapshot) => void,
    chunkHandler: (sessionId: string, sequence: number, chunk: Uint8Array) => void,
    transcriptHandler: (sessionId: string, text: string, isFinal: boolean, isLast: boolean) => void
  ) {
    this.snapshotHandler = snapshotHandler;
    this.chunkHandler = chunkHandler;
    this.transcriptHandler = transcriptHandler;
  }

  onSnapshotChanged(snapshot: NGFVoicePlatformSnapshot): void {
    this.snapshotHandler(snapshot);
  }

  onAudioChunk(sessionId: string, sequence: number, chunk: Uint8Array): void {
    this.chunkHandler(sessionId, sequence, chunk);
  }

  onTranscript(sessionId: string, text: string, isFinal: boolean, isLast: boolean): void {
    this.transcriptHandler(sessionId, text, isFinal, isLast);
  }
}

