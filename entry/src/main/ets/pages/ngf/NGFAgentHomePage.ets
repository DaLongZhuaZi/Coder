          })
      }
      .width('100%')
      this.buildPushDiagnosticRow($r('app.string.agent_home_push_client_status'), this.localPushStatusText())
      this.buildPushDiagnosticRow($r('app.string.agent_home_push_bridge_status'), this.bridgePushStatusText())
      this.buildPushDiagnosticRow($r('app.string.agent_home_push_subscription_count'), String(this.bridgePushStatus.activeCount))
      if (this.localPushStatus.message.length > 0) {
        this.buildPushDiagnosticRow($r('app.string.agent_home_push_client_message'), this.localPushStatus.message)
      }
      if (this.localPushStatus.remediation.length > 0) {
        this.buildPushDiagnosticRow($r('app.string.agent_home_push_client_remediation'), this.localPushStatus.remediation)
      }
      if (this.currentPushSubscription() !== null) {
        this.buildPushDiagnosticRow(
          $r('app.string.agent_home_push_token_fingerprint'),
          this.currentPushSubscriptionFingerprint()
        )
        this.buildPushDiagnosticRow($r('app.string.agent_home_push_last_attempt'), this.currentPushSubscriptionLastAttempt())
        this.buildPushDiagnosticRow($r('app.string.agent_home_push_last_success'), this.currentPushSubscriptionLastSuccess())
        this.buildPushDiagnosticRow($r('app.string.agent_home_push_delivery_count'), this.currentPushSubscriptionDeliveryCount())
        if (this.currentPushSubscriptionLastFailure().length > 0) {
          this.buildPushDiagnosticRow($r('app.string.agent_home_push_last_failure'), this.currentPushSubscriptionLastFailure())
        }
      }
      if (this.bridgePushStatus.message.length > 0) {
        this.buildPushDiagnosticRow($r('app.string.agent_home_push_message'), this.bridgePushStatus.message)
      }
      if (this.bridgePushStatus.remediation.length > 0) {
        this.buildPushDiagnosticRow($r('app.string.agent_home_push_remediation'), this.bridgePushStatus.remediation)
      }
    }
    .width('100%')
    .padding(10)
    .backgroundColor($r('app.color.background_secondary'))
    .borderRadius(12)
  }

