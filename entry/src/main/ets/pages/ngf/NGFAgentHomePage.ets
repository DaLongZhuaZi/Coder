  private checkpointManifestSummaryText(checkpoint: AgentBridgeCheckpointRecord): string {
    const hostContext = this.getUIContext().getHostContext();
    const parts: Array<string> = [];
    parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_manifest_summary')) + ': ' +
      resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_file_counts')) + ' ' +
      resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_files_verified')) + ' ' +
      (checkpoint.manifestVerified ? resolveResourceString(hostContext, $r('app.string.agent_home_daemon_doctor_ok')) :
        resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_manifest_failed'))));
    parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_file_counts')) + ': ' +
      resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_files_restored')) + ' ' + String(checkpoint.filesCaptured) + ', ' +
      resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_restore_files_skipped')) + ' ' + String(checkpoint.skippedCount));
    if (checkpoint.workspaceRoot.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_workspace_root')) + ': ' + checkpoint.workspaceRoot);
    }
    if (checkpoint.filePolicyJson.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_file_policy')) + ': ' +
        this.compactCheckpointText(checkpoint.filePolicyJson, 120));
    }
    const skippedReasons = this.checkpointSkippedReasonsText(checkpoint.skippedReasons);
    if (skippedReasons.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_skipped_reasons')) + ': ' + skippedReasons);
    }
    parts.push(this.checkpointRuntimeBoundaryText(checkpoint.runtimeRestoreReason));
    return parts.join('\n');
  }

  private checkpointSkippedReasonsText(items: Array<AgentBridgeCheckpointSkippedReason>): string {
    const parts: Array<string> = [];
    const limit = items.length > 3 ? 3 : items.length;
    for (let index = 0; index < limit; index++) {
      const item = items[index];
      parts.push(item.reason + ' ' + String(item.count));
    }
    if (items.length > limit) {
      parts.push('+' + String(items.length - limit));
    }
    return parts.join(', ');
  }

  private checkpointRuntimeBoundaryText(reason: string): string {
    const hostContext = this.getUIContext().getHostContext();
    const detail = reason.length > 0 ? reason : 'provider_runtime_state_is_recorded_not_rewound';
    return resolveResourceString(hostContext, $r('app.string.agent_home_checkpoint_runtime_not_restored')) + ': ' + detail;
  }

  private compactCheckpointText(value: string, maxLength: number): string {
    if (value.length <= maxLength) {
      return value;
    }
    if (maxLength <= 3) {
      return value.substring(0, maxLength);
    }
    return value.substring(0, maxLength - 3) + '...';
  }

