      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_profile_env_invalid')));
      return;
    }
    this.client.upsertProviderProfile(
      '',
      providerId,
      displayName,
      '',
      this.providerProfileEndpointDraft.trim(),
      this.providerProfileBinaryDraft.trim(),
      this.providerProfileArgsDraft.trim(),
      this.providerProfileCwdDraft.trim(),
      this.normalizedProviderProfileRuntimeMode(),
      true,
      envObject,
      envProvided
    );
    this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_profile_saved_runtime_pending')));
