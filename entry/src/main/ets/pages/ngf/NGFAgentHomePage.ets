  private countJsonStringArrayItems(value: string): number {
    if (value.length === 0 || value === '[]') {
      return 0;
    }
    let count = 0;
    let insideString = false;
    let escaped = false;
    for (let index = 0; index < value.length; index++) {
      const charCode = value.charCodeAt(index);
      if (escaped) {
        escaped = false;
        continue;
      }
      if (charCode === 92) {
        escaped = true;
        continue;
      }
      if (charCode === 34) {
        if (insideString) {
          count = count + 1;
        }
        insideString = !insideString;
      }
    }
    return count;
  }

  private countJsonObjectArrayItems(value: string): number {
    if (value.length === 0 || value === '[]') {
      return 0;
    }
    let count = 0;
    for (let index = 0; index < value.length; index++) {
      if (value.charCodeAt(index) === 123) {
        count = count + 1;
      }
    }
    return count;
  }

