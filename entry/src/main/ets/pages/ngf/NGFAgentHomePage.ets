  private applyGitDiffSubscriptionStatus(source: string): void {
    const result: AgentBridgeGitDiffSubscriptionStatus = AgentBridgeIncomingParser.parseGitDiffSubscriptionStatus(source);
    const subscriptionId = result.subscriptionId;
    if (subscriptionId.length === 0) {
      return;
    }
    if (this.gitDiffSubscriptionId.length === 0) {
      this.gitDiffSubscriptionId = subscriptionId;
    }
    if (subscriptionId !== this.gitDiffSubscriptionId) {
      return;
    }
    const status = result.status;
    if (status.length > 0) {
      this.gitDiffSubscriptionStatus = status;
    }
    this.gitDiffSubscriptionPaused = result.paused;
    this.gitDiffSubscriptionLastError = result.lastError;
    this.gitDiffSubscriptionLastSuccessAt = result.lastSuccessAt;
    this.gitDiffSubscriptionBackoffMs = result.backoffMs;
    this.gitDiffSubscriptionChangesCount = result.changesCount;
    this.gitDiffSubscriptionChangedFiles = result.changedFiles;
    this.gitDiffSubscriptionBranchName = result.branchName;
    this.gitDiffSubscriptionLastFingerprint = result.lastFingerprint;
    const subscribed = result.subscribed;
    if (subscribed || status === 'active' || status === 'paused' || status === 'error') {
      this.gitDiffSubscribed = true;
    }
    if (status === 'removed') {
      this.gitDiffSubscribed = false;
      this.gitDiffSubscriptionPaused = false;
      this.gitDiffSubscriptionBackoffMs = 0;
    }
  }

  private isBridgeGitActionResult(source: string): boolean {
    if (source.indexOf('"exitCode"') < 0 || source.indexOf('"command"') < 0 || source.indexOf('"action"') < 0) {
      return false;
    }
    const action = AgentBridgeIncomingParser.extractStringProperty(source, 'action');
    return action === 'pull' ||
      action === 'push' ||
      action === 'branch' ||
      action === 'create' ||
      action === 'checkout' ||
      action === 'switch' ||
      action === 'delete' ||
      action === 'stash' ||
      action === 'list' ||
      action === 'pop' ||
      action === 'apply' ||
      action === 'drop' ||
      action === 'merge' ||
      action === 'status';
  }

  private isBridgeGitHubResult(source: string): boolean {
    if (source.indexOf('"action"') < 0 || source.indexOf('"repository"') < 0 && source.indexOf('"failureCategory"') < 0) {
      return false;
    }
    const action = AgentBridgeIncomingParser.extractStringProperty(source, 'action');
    return action === 'github.pr.create' ||
      action === 'github.pr.list' ||
      action === 'github.pr.update' ||
      action === 'github.pr.reviewers.update' ||
      action === 'github.pr.labels.update' ||
      action === 'github.pr.status' ||
      action === 'github.pr.merge' ||
      action === 'github.checks.list' ||
      action === 'github.issue.search' ||
      action === 'github.issue.attachment.list' ||
      action === 'github.auth.device.start' ||
      action === 'github.auth.device.poll' ||
      action === 'github.auth.status' ||
      action === 'github.auth.logout' ||
      action === 'github.account.list' ||
      action === 'github.binding.get' ||
      action === 'github.binding.set' ||
      action === 'github.watch.start' ||
      action === 'github.watch.stop' ||
      action === 'github.attachment.preview' ||
      action === 'github.attachment.upload';
  }

  private applyBridgeGitHubResult(source: string): void {
    if (!this.canUseBridgeGitHubIntegration()) {
      return;
    }
    const result = AgentBridgeIncomingParser.parseGitHubResult(source);
    if (result.action.length === 0) {
      return;
    }
    if (result.accountId.length > 0) this.githubAccountId = result.accountId;
    this.lastGitHubResult = result;
    if (result.action === AgentBridgeRequestType.GITHUB_AUTH_DEVICE_START && result.authSessionId.length > 0) {
      const authSessionId = result.authSessionId;
      const delayMs = Math.max(5000, result.interval * 1000);
      setTimeout((): void => {
        this.client.pollGitHubDeviceAuthorization(authSessionId);
      }, delayMs);
    } else if (result.action === AgentBridgeRequestType.GITHUB_AUTH_DEVICE_POLL &&
      (result.failureCategory === 'authorization_pending' || result.failureCategory === 'slow_down')) {
      const authSessionId = result.authSessionId;
      if (authSessionId.length > 0) {
        setTimeout((): void => {
          this.client.pollGitHubDeviceAuthorization(authSessionId);
        }, Math.max(5000, result.interval * 1000));
      }
    }
    if (result.number > 0) {
      this.githubPrNumberDraft = String(result.number);
    }
    if (result.preview && result.planId.length > 0) {
      this.confirmGitHubPreviewResult(result);
    }
    this.showTransientStatus(this.gitHubStatusText());
  }

  private signOutGitHub(): void {
    if (!this.canUseBridgeGitHubIntegration() || this.githubAccountId.length === 0) {
      return;
    }
    const accountId: string = this.githubAccountId;
    this.client.logoutGitHub(accountId);
    this.githubAccountId = '';
    this.githubWatchEnabled = false;
    this.githubOwnerDraft = '';
    this.githubRepoDraft = '';
    this.githubReviewerDraft = '';
    this.githubLabelDraft = '';
    this.githubAttachmentPathDraft = '';
    this.githubPrNumberDraft = '';
    this.githubHeadDraft = '';
    this.githubBaseDraft = '';
    this.githubTitleDraft = '';
    this.githubBodyDraft = '';
    this.lastGitHubResult = new AgentBridgeGitHubResult();
    this.showTransientStatus(resolveResourceString(
      this.getUIContext().getHostContext(), $r('app.string.agent_home_github_sign_out')
    ));
  }

  private applyBridgeGitActionResult(source: string): void {
    if (!this.canUseBridgeGitAdvanced()) {
      return;
    }
    const result = AgentBridgeIncomingParser.parseGitActionResult(source);
    if (result.action.length === 0) {
      return;
    }
    this.lastGitActionResult = result;
    if (result.preview && result.planId.length > 0) {
      this.showGitPlanPreviewDialog(result);
      return;
    }
    if (result.failureCategory === 'git_plan_expired' || result.failureCategory === 'git_plan_stale' ||
      result.failureCategory === 'git_plan_required') {
      this.clearPendingGitPlan();
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_git_plan_expired')
      ));
      return;
    }
    if (result.confirmed) {
      this.clearPendingGitPlan();
      this.refreshWorkspaceChanges();
      this.showTransientStatus(resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_git_plan_confirmed')
      ));
      return;
    }
    if (this.pendingGitPlanOperation.length > 0) {
      this.clearPendingGitPlan();
    }
    this.showTransientStatus(this.gitActionStatusText());
  }

