    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.daemonAutostartInstaller;
  }

  private canUseBridgeDaemonSelfUpdate(): boolean {
    if (!this.hasTrustedBridgeV2Server()) {
      return false;
    }
    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.daemonSelfUpdate;
  }

  private canInstallBridgeDaemonUpdate(): boolean {
    return this.canUseBridgeDaemonSelfUpdate() &&
      this.daemonUpdateResult.installationKind !== 'development' &&
      !this.daemonUpdateResult.busy &&
      (this.daemonUpdateResult.available || this.daemonUpdateResult.targetVersion.length > 0);
  }

  private canUseBridgeSecurityDeviceTrust(): boolean {
    if (!this.hasTrustedBridgeV2Server()) {
      return false;
    }
    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.securityDeviceTrust;
  }

  private canUseBridgeOfflineNotifications(): boolean {
    if (!this.hasTrustedBridgeV2Server()) {
      return false;
    }
    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.offlineNotifications;
  }

  private canUseBridgePushSubscriptions(): boolean {
    if (!this.hasTrustedBridgeV2Server()) {
      return false;
    }
    const serverInfo = this.currentBridgeServerInfo;
    return serverInfo !== null && serverInfo.features.pushKitSubscriptions;
  }

  private resetPushRegistrationForConnection(): void {
    this.clearPendingPushRequest();
    this.registeredPushToken = '';
    this.registeredPushServerId = '';
  }

  private clearPendingPushRequest(): void {
    this.pushRegistrationPending = false;
    this.pendingPushRegistrationToken = '';
    this.pendingPushRequestId = '';
    this.pendingPushAction = '';
  }

  private applyBridgeTerminalList(terminals: Array<AgentBridgeTerminalState>): void {
    if (!this.canUseBridgeTerminalBinary()) {
      return;
    }
    const nextItems: Array<AgentBridgeTerminalSession> = [];
    for (let index = 0; index < terminals.length; index++) {
      const existing = this.findTerminalSession(terminals[index].terminalId);
      const session = new AgentBridgeTerminalSession();
      session.terminal = terminals[index];
      if (existing !== null) {
        session.slot = existing.slot;
        session.transcript = existing.transcript;
        session.subscribed = existing.subscribed;
        session.desiredSubscription = existing.desiredSubscription;
        session.restoreState = existing.restoreState;
        session.lastAppliedRestoreSeq = existing.lastAppliedRestoreSeq;
        session.lastAppliedSnapshotSeq = existing.lastAppliedSnapshotSeq;
        session.pendingOutput = existing.pendingOutput;
        session.renderer = existing.renderer;
        session.renderedText = existing.renderedText;
        session.renderRuns = existing.renderRuns;
      }
      nextItems.push(session);
    }
    this.bridgeTerminals = nextItems;
    if (this.activeTerminalId.length === 0 && nextItems.length > 0) {
      this.activeTerminalId = nextItems[0].terminal.terminalId;
    }
    this.syncTerminalDraftsFromActiveSession();
    this.persistTerminalSnapshots();
    this.resubscribeDesiredTerminals();
    this.subscribeActiveTerminalIfNeeded();
  }

  private applyBridgeTerminalState(terminal: AgentBridgeTerminalState, slot: number, subscribed: boolean): void {
    if (!this.canUseBridgeTerminalBinary() || terminal.terminalId.length === 0) {
      return;
    }
    const nextItems: Array<AgentBridgeTerminalSession> = [];
    let replaced = false;
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      const existing = this.bridgeTerminals[index];
      if (existing.terminal.terminalId === terminal.terminalId) {
        const nextSession = new AgentBridgeTerminalSession();
        nextSession.terminal = terminal;
        nextSession.slot = slot > 0 ? slot : existing.slot;
        nextSession.transcript = existing.transcript;
        nextSession.subscribed = subscribed ? true : existing.subscribed;
        nextSession.desiredSubscription = subscribed ? true : existing.desiredSubscription;
        nextSession.restoreState = subscribed
          ? this.restoreStateAfterSubscribe()
          : existing.restoreState;
        nextSession.lastAppliedRestoreSeq = existing.lastAppliedRestoreSeq;
        nextSession.lastAppliedSnapshotSeq = existing.lastAppliedSnapshotSeq;
        nextSession.pendingOutput = existing.pendingOutput;
        nextSession.renderer = existing.renderer;
        nextSession.renderedText = existing.renderedText;
        nextSession.renderRuns = existing.renderRuns;
        nextItems.push(nextSession);
        replaced = true;
      } else {
        nextItems.push(existing);
      }
    }
    if (!replaced) {
      const nextSession = new AgentBridgeTerminalSession();
      nextSession.terminal = terminal;
      nextSession.slot = slot;
      nextSession.subscribed = subscribed && slot > 0;
      nextSession.desiredSubscription = subscribed && slot > 0;
      nextSession.restoreState = subscribed ? this.restoreStateAfterSubscribe() : AgentBridgeTerminalRestoreState.IDLE;
      nextItems.push(nextSession);
    }
    this.bridgeTerminals = nextItems;
    if (this.activeTerminalId.length === 0) {
      this.activeTerminalId = terminal.terminalId;
    }
    this.syncTerminalDraftsFromActiveSession();
    this.persistTerminalSnapshots();
  }

  private applyBridgeTerminalCapture(terminalId: string, text: string): void {
    if (terminalId.length === 0 || text.length === 0) {
      return;
    }
    this.updateTerminalTranscript(terminalId, text, true);
  }

  private applyBridgeTerminalClosed(terminalId: string): void {
    if (terminalId.length === 0) {
      return;
    }
    const existing = this.findTerminalSession(terminalId);
    if (existing === null) {
      return;
    }
    const terminal = existing.terminal;
    terminal.status = 'closed';
    terminal.updatedAt = Date.now();
    this.applyBridgeTerminalState(terminal, existing.slot, existing.subscribed);
  }

  private handleBridgeTerminalFrame(frame: AgentBridgeTerminalFrame): void {
    if (!this.canUseBridgeTerminalBinary()) {
      return;
    }
    const terminalId = this.terminalIdForSlot(frame.slot);
    if (terminalId.length === 0) {
      return;
    }
    if (
      frame.opcode === AgentBridgeTerminalFrameOpcode.RESTORE ||
        frame.opcode === AgentBridgeTerminalFrameOpcode.SNAPSHOT
    ) {
      const streamProtocolVersion = this.terminalStreamProtocolVersion();
      const envelope = streamProtocolVersion >= 2
        ? AgentBridgeBinaryFrameCodec.decodeTerminalSnapshotEnvelope(frame)
        : new AgentBridgeTerminalSnapshotEnvelope();
      if (streamProtocolVersion < 2) {
        envelope.text = AgentBridgeBinaryFrameCodec.terminalFrameText(frame);
      }
      if (this.applyTerminalRestoreEnvelope(terminalId, envelope)) {
        this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_snapshot_restored')));
      }
      return;
    }
    if (frame.opcode === AgentBridgeTerminalFrameOpcode.OUTPUT) {
      this.appendTerminalOutput(terminalId, AgentBridgeBinaryFrameCodec.terminalFrameText(frame));
    }
  }

  private applyTerminalRestoreEnvelope(
    terminalId: string,
    envelope: AgentBridgeTerminalSnapshotEnvelope
  ): boolean {
    const nextItems: Array<AgentBridgeTerminalSession> = [];
    let applied = false;
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      const item = this.bridgeTerminals[index];
      if (item.terminal.terminalId !== terminalId) {
        nextItems.push(item);
        continue;
      }
      if (envelope.sequenced && envelope.restoreSeq <= item.lastAppliedRestoreSeq) {
        nextItems.push(item);
        continue;
      }
      const nextSession = this.copyTerminalClientSession(item);
      nextSession.transcript = this.normalizeTerminalTranscript(envelope.text + item.pendingOutput);
      nextSession.renderer.replace(nextSession.transcript);
      nextSession.renderedText = nextSession.renderer.plainText();
      nextSession.renderRuns = nextSession.renderer.renderRuns();
      nextSession.pendingOutput = '';
      nextSession.restoreState = AgentBridgeTerminalRestoreState.READY;
      if (envelope.sequenced) {
        nextSession.lastAppliedRestoreSeq = envelope.restoreSeq;
        nextSession.lastAppliedSnapshotSeq = envelope.snapshotSeq;
      }
      nextItems.push(nextSession);
      applied = true;
    }
    if (applied) {
      this.bridgeTerminals = nextItems;
      this.persistTerminalSnapshots();
    }
    return applied;
  }

  private appendTerminalOutput(terminalId: string, text: string): void {
    if (text.length === 0) {
      return;
    }
    const nextItems: Array<AgentBridgeTerminalSession> = [];
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      const item = this.bridgeTerminals[index];
      if (item.terminal.terminalId === terminalId) {
        const nextSession = this.copyTerminalClientSession(item);
        if (item.restoreState === AgentBridgeTerminalRestoreState.AWAITING) {
          nextSession.pendingOutput = this.normalizeTerminalTranscript(item.pendingOutput + text);
        } else {
          nextSession.transcript = this.normalizeTerminalTranscript(item.transcript + text);
          if (item.transcript.length + text.length > 64000) {
            nextSession.renderer.replace(nextSession.transcript);
          } else {
            nextSession.renderer.feed(text);
          }
          nextSession.renderedText = nextSession.renderer.plainText();
          nextSession.renderRuns = nextSession.renderer.renderRuns();
        }
        nextItems.push(nextSession);
      } else {
        nextItems.push(item);
      }
    }
    this.bridgeTerminals = nextItems;
  }

  private handleBridgeFileTransferFrame(frame: AgentBridgeFileTransferFrame): void {
    if (!this.canUseBridgeFileTransferBinary()) {
      return;
    }
    if (frame.opcode === AgentBridgeFileTransferOpcode.BEGIN) {
      this.beginIncomingFileTransfer(frame);
      return;
    }
    if (frame.opcode === AgentBridgeFileTransferOpcode.CHUNK) {
      this.appendIncomingFileTransferChunk(frame);
      return;
    }
    if (frame.opcode === AgentBridgeFileTransferOpcode.END) {
      this.completeIncomingFileTransfer(frame.requestId).catch((error: Error): void => {
        this.failIncomingFileTransfer(frame.requestId, this.errorToString(error));
      });
      return;
    }
    if (frame.opcode === AgentBridgeFileTransferOpcode.CANCEL) {
      this.failIncomingFileTransfer(frame.requestId, AgentBridgeBinaryFrameCodec.fileFrameText(frame));
    }
  }

  private beginIncomingFileTransfer(frame: AgentBridgeFileTransferFrame): void {
    const metadata = frame.metadata;
    const localPath = this.fileTransferLocalPath(metadata);
    if (localPath.length === 0) {
      this.failIncomingFileTransfer(frame.requestId, 'invalid file transfer path');
      return;
    }
    const parentPath = this.parentPathForFile(localPath);
    if (parentPath.length > 0) {
      FileUtils.createDirectory(parentPath, true);
    }
    FileUtils.writeBytes(localPath, new ArrayBuffer(0));
    const state = new AgentBridgeFileTransferState();
    state.requestId = frame.requestId;
    state.direction = metadata.direction.length > 0 ? metadata.direction : 'download';
    state.status = 'running';
    state.path = metadata.path;
    state.fileName = metadata.fileName;
    state.mediaType = metadata.mediaType;
    state.totalBytes = metadata.sizeBytes;
    state.sha256 = metadata.sha256;
    state.localPath = localPath;
    state.updatedAt = Date.now();
    this.upsertFileTransferState(state);
  }

  private appendIncomingFileTransferChunk(frame: AgentBridgeFileTransferFrame): void {
    const state = this.findFileTransferState(frame.requestId);
    if (state === null || state.localPath.length === 0) {
      return;
    }
    FileUtils.appendBytes(state.localPath, frame.payload);
    state.transferredBytes = state.transferredBytes + frame.payload.byteLength;
    state.status = 'running';
    state.updatedAt = Date.now();
    this.upsertFileTransferState(state);
  }

  private async completeIncomingFileTransfer(requestId: string): Promise<void> {
    const state = this.findFileTransferState(requestId);
    if (state === null) {
      return;
    }
    if (state.localPath.length > 0) {
      const actualSize = FileUtils.getFileSize(state.localPath);
      if (state.totalBytes > 0 && actualSize !== state.totalBytes) {
        this.failIncomingFileTransfer(
          requestId,
          resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_size_mismatch'))
        );
        return;
      }
      if (state.sha256.length > 0) {
        const data = FileUtils.readBytes(state.localPath);
        const digest = await securityToolkit.shaHashBytes(data);
        if (digest.toLowerCase() !== state.sha256.toLowerCase()) {
          this.failIncomingFileTransfer(
            requestId,
            resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_file_transfer_sha_mismatch'))
          );
          return;
        }
      }
      state.transferredBytes = actualSize;
    }
    state.status = 'completed';
    state.updatedAt = Date.now();
    this.upsertFileTransferState(state);
  }

  private failIncomingFileTransfer(requestId: string, message: string): void {
    const state = this.findFileTransferState(requestId);
    if (state !== null) {
      state.status = 'failed';
      state.errorMessage = message;
      state.updatedAt = Date.now();
      this.upsertFileTransferState(state);
      return;
    }
    const failed = new AgentBridgeFileTransferState();
    failed.requestId = requestId;
    failed.status = 'failed';
    failed.errorMessage = message;
    failed.updatedAt = Date.now();
    this.upsertFileTransferState(failed);
  }

  private applyBridgeFileTransferEvent(eventType: string, state: AgentBridgeFileTransferState): void {
    if (!this.canUseBridgeFileTransferBinary() || state.requestId.length === 0) {
      return;
    }
    if (eventType === AgentBridgeEventType.FILE_TRANSFER_COMPLETED) {
      state.status = 'completed';
    } else if (eventType === AgentBridgeEventType.FILE_TRANSFER_FAILED) {
      state.status = 'failed';
    } else {
      state.status = 'running';
    }
    this.upsertFileTransferState(state);
  }

  private upsertFileTransferState(state: AgentBridgeFileTransferState): void {
    const nextItems: Array<AgentBridgeFileTransferState> = [];
    let replaced = false;
    for (let index = 0; index < this.bridgeFileTransfers.length; index++) {
      if (this.bridgeFileTransfers[index].requestId === state.requestId) {
        nextItems.push(this.mergeFileTransferState(this.bridgeFileTransfers[index], state));
        replaced = true;
      } else {
        nextItems.push(this.bridgeFileTransfers[index]);
      }
    }
    if (!replaced) {
      nextItems.push(state);
    }
    this.bridgeFileTransfers = nextItems;
  }

  private mergeFileTransferState(existing: AgentBridgeFileTransferState, incoming: AgentBridgeFileTransferState): AgentBridgeFileTransferState {
    const item = new AgentBridgeFileTransferState();
    item.requestId = incoming.requestId.length > 0 ? incoming.requestId : existing.requestId;
    item.direction = incoming.direction.length > 0 ? incoming.direction : existing.direction;
    item.status = incoming.status.length > 0 ? incoming.status : existing.status;
    item.path = incoming.path.length > 0 ? incoming.path : existing.path;
    item.fileName = incoming.fileName.length > 0 ? incoming.fileName : existing.fileName;
    item.mediaType = incoming.mediaType.length > 0 ? incoming.mediaType : existing.mediaType;
    item.transferredBytes = incoming.transferredBytes > 0 ? incoming.transferredBytes : existing.transferredBytes;
    item.totalBytes = incoming.totalBytes > 0 ? incoming.totalBytes : existing.totalBytes;
    item.sha256 = incoming.sha256.length > 0 ? incoming.sha256 : existing.sha256;
    item.localPath = incoming.localPath.length > 0 ? incoming.localPath : existing.localPath;
    item.errorMessage = incoming.errorMessage.length > 0 ? incoming.errorMessage : existing.errorMessage;
    item.updatedAt = incoming.updatedAt > 0 ? incoming.updatedAt : Date.now();
    return item;
  }

  private updateTerminalTranscript(terminalId: string, text: string, replace: boolean): void {
    const nextItems: Array<AgentBridgeTerminalSession> = [];
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      const item = this.bridgeTerminals[index];
      if (item.terminal.terminalId === terminalId) {
        const nextSession = new AgentBridgeTerminalSession();
        nextSession.terminal = item.terminal;
        nextSession.slot = item.slot;
        nextSession.subscribed = item.subscribed;
        nextSession.transcript = this.normalizeTerminalTranscript(replace ? text : item.transcript + text);
        if (replace || item.transcript.length + text.length > 64000) {
          nextSession.renderer.replace(nextSession.transcript);
        } else {
          nextSession.renderer.feed(text);
        }
        nextSession.renderedText = nextSession.renderer.plainText();
        nextSession.renderRuns = nextSession.renderer.renderRuns();
        nextSession.desiredSubscription = item.desiredSubscription;
        nextSession.restoreState = item.restoreState;
        nextSession.lastAppliedRestoreSeq = item.lastAppliedRestoreSeq;
        nextSession.lastAppliedSnapshotSeq = item.lastAppliedSnapshotSeq;
        nextSession.pendingOutput = item.pendingOutput;
        nextSession.renderer = item.renderer;
        nextSession.renderedText = item.renderedText;
        nextSession.renderRuns = item.renderRuns;
        nextItems.push(nextSession);
      } else {
        nextItems.push(item);
      }
    }
    this.bridgeTerminals = nextItems;
  }

  private copyTerminalClientSession(source: AgentBridgeTerminalSession): AgentBridgeTerminalSession {
    const target = new AgentBridgeTerminalSession();
    target.terminal = source.terminal;
    target.slot = source.slot;
    target.transcript = source.transcript;
    target.subscribed = source.subscribed;
    target.desiredSubscription = source.desiredSubscription;
    target.restoreState = source.restoreState;
    target.lastAppliedRestoreSeq = source.lastAppliedRestoreSeq;
    target.lastAppliedSnapshotSeq = source.lastAppliedSnapshotSeq;
    target.pendingOutput = source.pendingOutput;
    target.renderer = source.renderer;
    target.renderedText = source.renderedText;
    target.renderRuns = source.renderRuns;
    return target;
  }

  private normalizeTerminalTranscript(text: string): string {
    const maxChars = 64000;
    if (text.length <= maxChars) {
      return text;
    }
    return text.substring(text.length - maxChars);
  }

  private stripTerminalAnsi(text: string): string {
    return this.renderTerminalAnsiText(text);
  }

  private renderTerminalAnsiText(text: string): string {
    const lines: Array<string> = [];
    lines.push('');
    let row = 0;
    let col = 0;
    let escapeMode = 0;
    let csiText = '';
    for (let index = 0; index < text.length; index++) {
      const ch = text.charAt(index);
      const code = ch.charCodeAt(0);
      if (escapeMode === 1) {
        if (ch === '[') {
          escapeMode = 2;
          csiText = '';
        } else {
          escapeMode = 0;
        }
        continue;
      }
      if (escapeMode === 2) {
        if (code >= 64 && code <= 126) {
          const cursor = this.applyTerminalCsi(lines, csiText, ch, row, col);
          row = cursor.row;
          col = cursor.col;
          escapeMode = 0;
          csiText = '';
        } else {
          csiText = csiText + ch;
        }
        continue;
      }
      if (code === 27) {
        escapeMode = 1;
        continue;
      }
      if (ch === '\r') {
        col = 0;
        continue;
      }
      if (ch === '\n') {
        row = row + 1;
        col = 0;
        this.ensureTerminalLine(lines, row);
        continue;
      }
      if (ch === '\b') {
        if (col > 0) {
          col = col - 1;
        }
        continue;
      }
      if (ch === '\t') {
        const nextTab = col + (4 - (col % 4));
        while (col < nextTab) {
          this.writeTerminalChar(lines, row, col, ' ');
          col = col + 1;
        }
        continue;
      }
      if (code < 32) {
        continue;
      }
      this.writeTerminalChar(lines, row, col, ch);
      col = col + 1;
    }
    return this.joinTerminalLines(lines);
  }

  private ensureTerminalLine(lines: Array<string>, row: number): void {
    while (lines.length <= row) {
      lines.push('');
    }
  }

  private writeTerminalChar(lines: Array<string>, row: number, col: number, ch: string): void {
    this.ensureTerminalLine(lines, row);
    let line = lines[row];
    while (line.length < col) {
      line = line + ' ';
    }
    if (line.length === col) {
      line = line + ch;
    } else {
      line = line.substring(0, col) + ch + line.substring(col + 1);
    }
    lines[row] = line;
  }

  private joinTerminalLines(lines: Array<string>): string {
    let end = lines.length;
    while (end > 1 && lines[end - 1].length === 0) {
      end = end - 1;
    }
    let result = '';
    for (let index = 0; index < end; index++) {
      if (index > 0) {
        result = result + '\n';
      }
      result = result + this.trimTerminalLineEnd(lines[index]);
    }
    return result;
  }

  private trimTerminalLineEnd(value: string): string {
    let end = value.length;
    while (end > 0 && value.charAt(end - 1) === ' ') {
      end = end - 1;
    }
    return value.substring(0, end);
  }

  private applyTerminalCsi(lines: Array<string>, sequence: string, finalChar: string, row: number, col: number): AgentHomeTerminalCursor {
    let nextRow = row;
    let nextCol = col;
    if (finalChar === 'A') {
      nextRow = Math.max(0, row - this.terminalCsiParam(sequence, 0, 1));
    } else if (finalChar === 'B') {
      nextRow = row + this.terminalCsiParam(sequence, 0, 1);
      this.ensureTerminalLine(lines, nextRow);
    } else if (finalChar === 'C') {
      nextCol = col + this.terminalCsiParam(sequence, 0, 1);
    } else if (finalChar === 'D') {
      nextCol = Math.max(0, col - this.terminalCsiParam(sequence, 0, 1));
    } else if (finalChar === 'G') {
      nextCol = Math.max(0, this.terminalCsiParam(sequence, 0, 1) - 1);
    } else if (finalChar === 'H' || finalChar === 'f') {
      nextRow = Math.max(0, this.terminalCsiParam(sequence, 0, 1) - 1);
      nextCol = Math.max(0, this.terminalCsiParam(sequence, 1, 1) - 1);
      this.ensureTerminalLine(lines, nextRow);
    } else if (finalChar === 'J') {
      const mode = this.terminalCsiParam(sequence, 0, 0);
      if (mode === 2 || mode === 3) {
        lines.splice(0, lines.length);
        lines.push('');
        nextRow = 0;
        nextCol = 0;
      } else if (mode === 0) {
        this.eraseTerminalLine(lines, row, col, 0);
        while (lines.length > row + 1) {
          lines.pop();
        }
      } else if (mode === 1) {
        for (let lineIndex = 0; lineIndex < row; lineIndex++) {
          lines[lineIndex] = '';
        }
        this.eraseTerminalLine(lines, row, col, 1);
      }
    } else if (finalChar === 'K') {
      this.eraseTerminalLine(lines, row, col, this.terminalCsiParam(sequence, 0, 0));
    }
    return new AgentHomeTerminalCursor(nextRow, nextCol);
  }

  private terminalCsiParam(sequence: string, paramIndex: number, fallback: number): number {
    const cleaned = this.cleanTerminalCsiParams(sequence);
    const parts = cleaned.split(';');
    if (paramIndex < 0 || paramIndex >= parts.length) {
      return fallback;
    }
    const value = Number(parts[paramIndex]);
    if (Number.isNaN(value) || value <= 0) {
      return fallback;
    }
    return Math.floor(value);
  }

  private cleanTerminalCsiParams(sequence: string): string {
    let result = '';
    for (let index = 0; index < sequence.length; index++) {
      const ch = sequence.charAt(index);
      const code = ch.charCodeAt(0);
      if ((code >= 48 && code <= 57) || ch === ';') {
        result = result + ch;
      }
    }
    return result;
  }

  private eraseTerminalLine(lines: Array<string>, row: number, col: number, mode: number): void {
    this.ensureTerminalLine(lines, row);
    const line = lines[row];
    if (mode === 2) {
      lines[row] = '';
      return;
    }
    if (mode === 1) {
      if (col + 1 >= line.length) {
        lines[row] = '';
      } else {
        let prefix = '';
        for (let index = 0; index <= col; index++) {
          prefix = prefix + ' ';
        }
        lines[row] = prefix + line.substring(col + 1);
      }
      return;
    }
    if (col < line.length) {
      lines[row] = line.substring(0, col);
    }
  }

  private terminalIdForSlot(slot: number): string {
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      const item = this.bridgeTerminals[index];
      if (item.slot === slot && item.terminal.terminalId.length > 0) {
        return item.terminal.terminalId;
      }
    }
    return '';
  }

  private findTerminalSession(terminalId: string): AgentBridgeTerminalSession | null {
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      if (this.bridgeTerminals[index].terminal.terminalId === terminalId) {
        return this.bridgeTerminals[index];
      }
    }
    return null;
  }

  private activeTerminalSession(): AgentBridgeTerminalSession | null {
    if (this.activeTerminalId.length > 0) {
      const active = this.findTerminalSession(this.activeTerminalId);
      if (active !== null) {
        return active;
      }
    }
    if (this.bridgeTerminals.length > 0) {
      return this.bridgeTerminals[0];
    }
    return null;
  }

  private terminalSessionReady(session: AgentBridgeTerminalSession | null): boolean {
    return session !== null && session.slot > 0 && session.restoreState === AgentBridgeTerminalRestoreState.READY;
  }

  private activeTerminalTranscriptText(): string {
    const active = this.activeTerminalSession();
    if (active !== null) {
      return active.renderedText;
    }
    return '';
  }

  private activeTerminalRenderRuns(): Array<AgentBridgeTerminalRenderRun> {
    const active = this.activeTerminalSession();
    if (active !== null) {
      return active.renderRuns;
    }
    return [];
  }

  private terminalRunForegroundColor(color: string): ResourceColor {
    if (color.startsWith('#')) {
      return color;
    }
    if (color === AgentBridgeTerminalColor.BLACK) {
      return '#FF1B1F23';
    }
    if (color === AgentBridgeTerminalColor.RED) {
      return '#FFE05252';
    }
    if (color === AgentBridgeTerminalColor.GREEN) {
      return '#FF2E9D65';
    }
    if (color === AgentBridgeTerminalColor.YELLOW) {
      return '#FFC58A1B';
    }
    if (color === AgentBridgeTerminalColor.BLUE) {
      return '#FF3B82D0';
    }
    if (color === AgentBridgeTerminalColor.MAGENTA) {
      return '#FF9B59B6';
    }
    if (color === AgentBridgeTerminalColor.CYAN) {
      return '#FF2A9D8F';
    }
    if (color === AgentBridgeTerminalColor.WHITE) {
      return '#FFF3F5F7';
    }
    return $r('app.color.text_body');
  }

  private terminalRunBackgroundStyle(color: string): TextBackgroundStyle {
    const style: TextBackgroundStyle = {
      color: color === AgentBridgeTerminalColor.DEFAULT
        ? Color.Transparent
        : this.terminalRunForegroundColor(color),
      radius: 0
    };
    return style;
  }

  private activeTerminalTranscriptWidth(): number {
    const text = this.activeTerminalTranscriptText();
    let currentLength = 0;
    let maxLength = 80;
    for (let index = 0; index < text.length; index++) {
      const ch = text.charAt(index);
      if (ch === '\n') {
        if (currentLength > maxLength) {
          maxLength = currentLength;
        }
        currentLength = 0;
        continue;
      }
      currentLength = currentLength + 1;
    }
    if (currentLength > maxLength) {
      maxLength = currentLength;
    }
    const width = maxLength * 7 + 28;
    if (width < 640) {
      return 640;
    }
    if (width > 3600) {
      return 3600;
    }
    return width;
  }

  private copyActiveTerminalTranscript(): void {
    const text = this.activeTerminalTranscriptText();
    if (text.trim().length === 0) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_copy_empty')));
      return;
    }
    pasteboard.getSystemPasteboard().setData(
      pasteboard.createData(pasteboard.MIMETYPE_TEXT_PLAIN, text)
    ).then((): void => {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_copied')));
    }).catch((error: Error): void => {
      logger.error(TAG, 'copy terminal transcript failed: ' + this.errorToString(error));
    });
  }

  private canSendTerminalMouseMode(): boolean {
    const session = this.activeTerminalSession();
    return this.canUseBridgeTerminalMouse() && this.terminalSessionReady(session);
  }

  private isTerminalMouseModeSelected(mode: string): boolean {
    const session = this.activeTerminalSession();
    if (session !== null && session.terminal.mouseMode.length > 0) {
      return session.terminal.mouseMode === mode;
    }
    return this.terminalMouseModeDraft === mode;
  }

  private activeTerminalMouseStatusText(): string {
    const session = this.activeTerminalSession();
    const hostContext = this.getUIContext().getHostContext();
    if (session === null || session.slot <= 0) {
      return resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_mouse_unavailable'));
    }
    const mode = session.terminal.mouseMode.length > 0 ? session.terminal.mouseMode : this.terminalMouseModeDraft;
    let text = resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_mouse_status')) + ': ' + mode;
    if (session.terminal.lastMouseError.length > 0) {
      text = text + ' / ' + resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_mouse_error')) + ': ' + session.terminal.lastMouseError;
    }
    return text;
  }

  private applyTerminalMouseMode(mode: string): void {
    const session = this.activeTerminalSession();
    if (!this.canUseBridgeTerminalMouse() || session === null || !this.terminalSessionReady(session)) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_mouse_unavailable')));
      return;
    }
    const sequence = this.terminalMouseModeSequence(mode);
    if (sequence.length === 0) {
      return;
    }
    if (this.client.sendTerminalMouse(session.slot, sequence)) {
      this.terminalMouseModeDraft = mode;
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_mouse_mode_applied')));
    }
  }

  private terminalMouseModeSequence(mode: string): string {
    const disable = '\u001b[?9l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006l';
    if (mode === AgentHomeTerminalMouseMode.OFF) {
      return disable;
    }
    if (mode === AgentHomeTerminalMouseMode.CLICK) {
      return disable + '\u001b[?1000h';
    }
    if (mode === AgentHomeTerminalMouseMode.DRAG) {
      return disable + '\u001b[?1000h\u001b[?1002h';
    }
    if (mode === AgentHomeTerminalMouseMode.ALL) {
      return disable + '\u001b[?1000h\u001b[?1003h';
    }
    if (mode === AgentHomeTerminalMouseMode.SGR) {
      return disable + '\u001b[?1000h\u001b[?1002h\u001b[?1006h';
    }
    return '';
  }

  private terminalRowSubtitle(item: AgentBridgeTerminalSession): string {
    const hostContext = this.getUIContext().getHostContext();
    let text = item.terminal.status.length > 0 ? item.terminal.status : item.terminal.cwd;
    if (item.terminal.activity.length > 0) {
      text = text + ' / ' +
        resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_activity')) +
        ': ' + item.terminal.activity;
    }
    if (item.terminal.requiresAttention) {
      const reason = item.terminal.attentionReason.length > 0
        ? item.terminal.attentionReason
        : resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_attention_required'));
      text = text + ' / ' +
        resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_attention')) +
        ': ' + reason;
    }
    return text;
  }

  private findFileTransferState(requestId: string): AgentBridgeFileTransferState | null {
    for (let index = 0; index < this.bridgeFileTransfers.length; index++) {
      if (this.bridgeFileTransfers[index].requestId === requestId) {
        return this.bridgeFileTransfers[index];
      }
    }
    return null;
  }

  private fileTransferLocalPath(metadata: AgentBridgeFileTransferMetadata): string {
    if (metadata.fileName.length === 0 && metadata.path.length === 0) {
      return '';
    }
    const fileName = metadata.fileName.length > 0 ? metadata.fileName : this.lastPathSegment(metadata.path);
    const directory = this.fileTransferCacheDirectoryPath();
    if (directory.length === 0 || fileName.length === 0) {
      return '';
    }
    return directory + '/' + this.safeIdPart(metadata.requestId.length > 0 ? metadata.requestId : String(Date.now())) + '_' + this.safeFileName(fileName);
  }

  private fileTransferCacheDirectoryPath(): string {
    if (!this.hasTrustedBridgeV2Server()) {
      return '';
    }
    return 'agent_bridge_files/' + this.safeIdPart(this.activeDeviceId) + '/' + this.safeIdPart(this.currentBridgeServerId);
  }

  private parentPathForFile(filePath: string): string {
    const separatorIndex = filePath.lastIndexOf('/');
    if (separatorIndex <= 0) {
      return '';
    }
    return filePath.substring(0, separatorIndex);
  }

  private safeFileName(fileName: string): string {
    let result = '';
    for (let index = 0; index < fileName.length; index++) {
      const ch = fileName.charAt(index);
      const code = ch.charCodeAt(0);
      const isAlpha = (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
      const isDigit = code >= 48 && code <= 57;
      if (isAlpha || isDigit || ch === '.' || ch === '_' || ch === '-') {
        result = result + ch;
      } else {
        result = result + '_';
      }
    }
    return result.length > 0 ? result : 'download.bin';
  }

  private persistTerminalSnapshots(): void {
    if (!this.hasTrustedBridgeV2Server()) {
      return;
    }
    this.persistence.saveTerminalSnapshots(this.activeDeviceId, this.currentBridgeServerId, this.bridgeTerminals).catch((error: Error): void => {
      logger.error(TAG, 'persist terminal snapshots failed: ' + this.errorToString(error));
    });
  }

  private terminalStreamProtocolVersion(): number {
    const serverInfo = this.currentBridgeServerInfo;
    if (
      serverInfo !== null && serverInfo.features.terminalSequencedRestore &&
        serverInfo.terminalStreamProtocolVersion >= 2
    ) {
      return 2;
    }
    return 1;
  }

  private restoreStateAfterSubscribe(): string {
    return this.terminalStreamProtocolVersion() >= 2
      ? AgentBridgeTerminalRestoreState.AWAITING
      : AgentBridgeTerminalRestoreState.READY;
  }

  private resubscribeDesiredTerminals(): void {
    for (let index = 0; index < this.bridgeTerminals.length; index++) {
      const session = this.bridgeTerminals[index];
      if (
        session.desiredSubscription && session.slot <= 0 &&
          session.terminal.status !== 'closed'
      ) {
        this.subscribeTerminalSession(session, true);
      }
    }
  }

  private subscribeTerminalSession(session: AgentBridgeTerminalSession, preserveAttention: boolean): void {
    session.restoreState = AgentBridgeTerminalRestoreState.AWAITING;
    this.client.subscribeTerminal(
      session.terminal.terminalId,
      this.currentBridgeAgentId(),
      this.terminalStreamProtocolVersion(),
      session.lastAppliedRestoreSeq,
      session.lastAppliedSnapshotSeq,
      preserveAttention
    );
  }

  private createRuntimeTerminal(): void {
    if (!this.canUseBridgeTerminalBinary()) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_unavailable')));
      return;
    }
    const cwd = this.currentWorkspacePath();
    if (cwd.length === 0 && this.currentBridgeSessionId().length === 0) {
      return;
    }
    const requestId = this.client.createTerminal('', cwd, this.currentBridgeAgentId(), this.currentBridgeSessionId(), '', 24, 96);
    this.trackPendingTerminalCreateRequest(requestId);
  }

  private selectRuntimeTerminal(terminalId: string): void {
    if (terminalId.length === 0) {
      return;
    }
    this.activeTerminalId = terminalId;
    const session = this.findTerminalSession(terminalId);
    if (session !== null) {
      session.desiredSubscription = true;
    }
    this.syncTerminalDraftsFromActiveSession();
    this.subscribeActiveTerminalIfNeeded();
  }

  private syncTerminalDraftsFromActiveSession(): void {
    const session = this.activeTerminalSession();
    if (session === null) {
      return;
    }
    this.terminalRenameDraft = session.terminal.name.length > 0 ? session.terminal.name : session.terminal.terminalId;
    this.terminalRowsDraft = session.terminal.rows > 0 ? String(session.terminal.rows) : '24';
    this.terminalColsDraft = session.terminal.cols > 0 ? String(session.terminal.cols) : '96';
  }

  private subscribeActiveTerminalIfNeeded(): void {
    const session = this.activeTerminalSession();
    if (
      session !== null &&
        session.slot <= 0 &&
        session.restoreState !== AgentBridgeTerminalRestoreState.AWAITING &&
        session.terminal.status !== 'closed' &&
        this.canUseBridgeTerminalBinary()
    ) {
      session.desiredSubscription = true;
      this.subscribeTerminalSession(session, false);
    }
  }

  private renameActiveTerminalFromDraft(): void {
    const session = this.activeTerminalSession();
    if (session === null || session.terminal.terminalId.length === 0) {
      return;
    }
    const name = this.terminalRenameDraft.trim();
    if (name.length === 0) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_rename_required')));
      return;
    }
    this.client.renameTerminal(session.terminal.terminalId, name, this.currentBridgeAgentId());
  }

  private resizeActiveTerminalFromDraft(): void {
    const session = this.activeTerminalSession();
    if (session === null || !this.terminalSessionReady(session)) {
      return;
    }
    const rows = Number(this.terminalRowsDraft.trim());
    const cols = Number(this.terminalColsDraft.trim());
    if (Number.isNaN(rows) || Number.isNaN(cols) || rows < 8 || cols < 20) {
      this.showTransientStatus(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_resize_invalid')));
      return;
    }
    this.client.sendTerminalResize(session.slot, Math.floor(rows), Math.floor(cols));
  }

  private sendRuntimeTerminalShortcut(text: string): void {
    const session = this.activeTerminalSession();
    if (session === null || !this.terminalSessionReady(session) || text.length === 0) {
      return;
    }
    this.client.sendTerminalInput(session.slot, text);
  }

  private canSendRuntimeTerminalInput(): boolean {
    const session = this.activeTerminalSession();
    return this.canUseBridgeTerminalBinary() &&
      session !== null &&
      session.slot > 0 &&
      session.restoreState === AgentBridgeTerminalRestoreState.READY &&
      this.terminalInputText.trim().length > 0;
  }

  private sendRuntimeTerminalInput(): void {
    const session = this.activeTerminalSession();
    if (session === null || !this.terminalSessionReady(session)) {
      return;
    }
    const text = this.terminalInputText;
    if (text.trim().length === 0) {
      return;
    }
    if (this.client.sendTerminalInput(session.slot, text + '\r\n')) {
      this.terminalInputText = '';
    }
  }

  private activeTerminalCaptureStatusText(): string {
    const session = this.activeTerminalSession();
    if (session === null) {
      return '';
    }
    const status = session.terminal.capturePersisted
      ? resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_capture_persisted'))
      : resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_capture_memory'));
    const source = session.terminal.snapshotSource.length > 0 ? session.terminal.snapshotSource : 'memory';
    const captureStatus = session.terminal.captureStatus.length > 0 ? session.terminal.captureStatus : (session.terminal.capturePersisted ? 'persisted' : 'memory');
    const snapshotBytes = session.terminal.snapshotBytes > 0 ? session.terminal.snapshotBytes : session.terminal.captureBytes;
    const persistedBytes = session.terminal.capturePersistedBytes > 0 ? session.terminal.capturePersistedBytes : session.terminal.snapshotPersistedBytes;
    let text = status + ' ' + String(session.terminal.captureBytes) + ' / seq ' + String(session.terminal.snapshotSeq) +
      ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_capture_status')) +
      ': ' + captureStatus +
      ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_capture_source')) +
      ': ' + source +
      ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_capture_snapshot_bytes')) +
      ': ' + String(snapshotBytes) +
      ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_capture_persisted_bytes')) +
      ': ' + String(persistedBytes) +
      ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_capture_restore_seq')) +
      ': ' + String(session.terminal.restoreSeq);
    if (session.terminal.snapshotTruncated) {
      text = text + ' / ' + resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_runtime_terminal_capture_truncated'));
    }
    return text;
  }

  private activeTerminalCaptureDetailText(): string {
    const session = this.activeTerminalSession();
    if (session === null) {
      return '';
    }
    const hostContext = this.getUIContext().getHostContext();
    let text = '';
    const warning = session.terminal.captureWarning.length > 0 ? session.terminal.captureWarning : session.terminal.snapshotWarning;
    if (warning.length > 0) {
      text = resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_capture_warning')) + ': ' + warning;
    }
    if (session.terminal.capturePath.length > 0) {
      const pathText = resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_capture_path')) + ': ' + session.terminal.capturePath;
      text = text.length > 0 ? text + ' / ' + pathText : pathText;
    }
    if (session.terminal.lastInputError.length > 0) {
      const label = resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_input_error'));
      text = text.length > 0 ? text + ' / ' + label + ': ' + session.terminal.lastInputError : label + ': ' + session.terminal.lastInputError;
    }
    if (session.terminal.lastResizeError.length > 0) {
      const label = resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_resize_error'));
      text = text.length > 0 ? text + ' / ' + label + ': ' + session.terminal.lastResizeError : label + ': ' + session.terminal.lastResizeError;
    }
    if (session.terminal.mouseMode.length > 0) {
      const label = resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_mouse_status'));
      text = text.length > 0 ? text + ' / ' + label + ': ' + session.terminal.mouseMode : label + ': ' + session.terminal.mouseMode;
    }
    if (session.terminal.lastMouseError.length > 0) {
      const label = resolveResourceString(hostContext, $r('app.string.agent_home_runtime_terminal_mouse_error'));
      text = text.length > 0 ? text + ' / ' + label + ': ' + session.terminal.lastMouseError : label + ': ' + session.terminal.lastMouseError;
    }
    return text;
