        this.buildRelayDiagnosticRow(
          $r('app.string.agent_home_relay_encryption'),
          this.relayBooleanText(this.relayStatus.encrypted)
        )
        this.buildRelayDiagnosticRow(
          $r('app.string.agent_home_relay_forward_secrecy'),
          this.relayBooleanText(this.relayStatus.forwardSecrecy)
        )
      } else {
        this.buildRelayNotice(
          $r('app.string.agent_home_relay_e2e_unavailable'),
          $r('sys.symbol.exclamationmark_triangle'),
          $r('app.color.tag_red')
        )
      }
      this.buildRelayDiagnosticRow(
        $r('app.string.agent_home_relay_reconnect_attempt'),
        String(this.relayStatus.reconnectAttempt)
      )
      this.buildRelayDiagnosticRow(
        $r('app.string.agent_home_relay_offline_queue'),
        String(this.relayStatus.offlineQueueDepth)
      )
      this.buildRelayDiagnosticRow(
        $r('app.string.agent_home_relay_last_heartbeat'),
        this.relayStatus.lastHeartbeatAt
      )

      this.buildRelayNotice(
        $r('app.string.agent_home_relay_queue_risk'),
        $r('sys.symbol.exclamationmark_triangle'),
        $r('app.color.text_secondary')
      )

      this.buildRelayNotice(
        $r('app.string.agent_home_relay_metadata_risk'),
        $r('sys.symbol.info_circle'),
        $r('app.color.text_secondary')
      )

      if (this.relayPairingOfferAvailable) {
        Divider().color($r('app.color.card_border')).margin({ top: 2, bottom: 2 })
