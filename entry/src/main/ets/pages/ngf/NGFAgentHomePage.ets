    .width('100%')
    .padding(8)
    .backgroundColor($r('app.color.background_secondary'))
    .borderRadius(8)
  }

  @Builder
  private buildDaemonFleetRow(item: AgentHomeDaemonFleetQueryResult): void {
    Column({ space: 2 }) {
      Row({ space: 6 }) {
        Text(this.hostProfileDisplayName(item.hostProfileId))
          .fontSize(11)
          .fontWeight(FontWeight.Medium)
          .fontColor($r('app.color.text_body'))
          .layoutWeight(1)
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
        Text(item.snapshot.health)
          .fontSize(10)
          .fontColor(this.daemonFleetHealthColor(item.snapshot.health))
      }
      Text(item.snapshot.instanceId + ' · ' + item.snapshot.bridgeVersion)
        .width('100%')
        .fontSize(10)
        .fontColor($r('app.color.text_secondary'))
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
      Text(item.snapshot.configVersion.length > 0 ? item.snapshot.configVersion : this.resolveDetailEmptyText())
        .width('100%')
        .fontSize(10)
        .fontColor($r('app.color.text_secondary'))
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
      Text(resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_daemon_heartbeat')) + ': ' +
        (item.snapshot.lastHeartbeatAt.length > 0 ? item.snapshot.lastHeartbeatAt : this.resolveDetailEmptyText()))
        .width('100%')
        .fontSize(10)
        .fontColor($r('app.color.text_secondary'))
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
      if (item.message.length > 0) {
        Text(item.message)
          .width('100%')
          .fontSize(10)
          .fontColor($r('app.color.button_warning'))
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }
      if (item.ok && item.snapshot.rollingEligible) {
        Button(this.isDaemonFleetHostIsolated(item.hostProfileId) ?
          $r('app.string.agent_home_daemon_fleet_reenable') :
          $r('app.string.agent_home_daemon_fleet_isolate'))
          .height(28)
          .fontSize(10)
          .borderRadius(7)
          .backgroundColor($r('app.color.background_primary'))
          .fontColor($r('app.color.text_body'))
          .enabled(!this.daemonFleetBusy)
          .onClick((): void => {
            this.toggleDaemonFleetIsolation(item.hostProfileId);
          })
      }
    }
    .width('100%')
    .padding(8)
    .backgroundColor($r('app.color.background_secondary'))
    .borderRadius(8)
  }

  @Builder
  private buildWorkspaceServicePanel(): void {
    Column({ space: 8 }) {
      Row({ space: 8 }) {
        SymbolGlyph($r('sys.symbol.square_stack_3d'))
          .fontSize(18)
          .fontColor([$r('app.color.text_body')])
        Column({ space: 2 }) {
          Text($r('app.string.agent_home_service_proxy_title'))
            .fontSize(14)
            .fontWeight(FontWeight.Medium)
            .fontColor($r('app.color.text_body'))
          Text($r('app.string.agent_home_service_proxy_desc'))
            .fontSize(10)
            .fontColor($r('app.color.text_secondary'))
            .maxLines(2)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .layoutWeight(1)
