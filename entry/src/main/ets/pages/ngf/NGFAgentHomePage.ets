  private bridgeCompatibilityStatus(): string {
    const info = this.currentBridgeServerInfo;
    if (info === null) {
      return 'unknown';
    }
    return info.compatibility.status;
  }

  private bridgeCompatibilityText(): string {
    const info = this.currentBridgeServerInfo;
    if (info === null) {
      return resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_compatibility_unknown'));
    }
    const hostContext = this.getUIContext().getHostContext();
    const appVersion = this.appBuildVersion.length > 0 ? this.appBuildVersion :
      resolveResourceString(hostContext, $r('app.string.agent_home_usage_unavailable'));
    const bridgeVersion = info.bridgeVersion.length > 0 ? info.bridgeVersion :
      resolveResourceString(hostContext, $r('app.string.agent_home_usage_unavailable'));
    let text = resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_app_version')) + ' ' +
      appVersion + ' · ' + resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_bridge_version')) +
      ' ' + bridgeVersion;
    if (info.compatibility.reason.length > 0) {
      text = text + ' · ' + info.compatibility.reason;
    }
    return text;
  }

  private bridgeCompatibilityTitleText(): string {
    const hostContext = this.getUIContext().getHostContext();
    const status = this.bridgeCompatibilityStatus();
    if (status === 'upgradeRecommended') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_status_upgrade'));
    }
    if (status === 'appTooOld') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_status_app_old'));
    }
    if (status === 'bridgeTooOld') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_status_bridge_old'));
    }
    return resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_status_unknown'));
  }

  private bridgeCompatibilityRequirementText(): string {
    const info = this.currentBridgeServerInfo;
    if (info === null) {
      return '';
    }
    const hostContext = this.getUIContext().getHostContext();
    const appLabel = resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_app_version'));
    const bridgeLabel = resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_bridge_version'));
    const protocolLabel = resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_protocol_version'));
    const supportedProtocolsLabel = resolveResourceString(
      hostContext, $r('app.string.agent_home_compatibility_supported_protocols')
    );
    const parts: Array<string> = [];
    if (info.compatibility.minimumAppVersion.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_minimum')) +
        ' ' + appLabel + ' ' + info.compatibility.minimumAppVersion);
    }
    if (info.compatibility.minimumBridgeVersion.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_minimum')) +
        ' ' + bridgeLabel + ' ' + info.compatibility.minimumBridgeVersion);
    }
    if (info.compatibility.recommendedAppVersion.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_recommended')) +
        ' ' + appLabel + ' ' + info.compatibility.recommendedAppVersion);
    }
    if (info.compatibility.recommendedBridgeVersion.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_recommended')) +
        ' ' + bridgeLabel + ' ' + info.compatibility.recommendedBridgeVersion);
    }
    if (info.compatibility.minimumProtocolVersion.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_minimum')) +
        ' ' + protocolLabel + ' ' + info.compatibility.minimumProtocolVersion);
    }
    if (info.compatibility.recommendedProtocolVersion.length > 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_compatibility_recommended')) +
        ' ' + protocolLabel + ' ' + info.compatibility.recommendedProtocolVersion);
    }
    if (info.compatibility.supportedProtocolVersions.length > 0) {
      parts.push(supportedProtocolsLabel + ' ' + info.compatibility.supportedProtocolVersions.join(', '));
    }
    return parts.join(' · ');
  }

  private bridgeCompatibilityRemediationText(): string {
    const info = this.currentBridgeServerInfo;
    if (info === null || info.compatibility.remediation.length === 0) {
      return '';
    }
    return resolveResourceString(
      this.getUIContext().getHostContext(), $r('app.string.agent_home_compatibility_remediation')
    ) + ': ' + info.compatibility.remediation;
  }

  private bridgeCompatibilityColor(): ResourceColor {
    const info = this.currentBridgeServerInfo;
    if (info !== null && info.compatibility.blocking) {
      return $r('app.color.tag_red');
    }
    return $r('app.color.tag_amber');
  }

