  @Builder
  private buildRuntimeTerminalSection(): void {
    Column({ space: 10 }) {
      Row({ space: 8 }) {
        Button() {
          Row({ space: 6 }) {
            SymbolGlyph($r('sys.symbol.plus'))
              .fontSize(16)
              .fontColor([this.canUseBridgeTerminalBinary() ? $r('app.color.text_body') : $r('app.color.text_tertiary')])
            Text($r('app.string.agent_home_runtime_terminal_create'))
              .fontSize(12)
              .fontColor(this.canUseBridgeTerminalBinary() ? $r('app.color.text_body') : $r('app.color.text_tertiary'))
          }
        }
        .height(36)
        .layoutWeight(1)
        .borderRadius(10)
        .backgroundColor($r('app.color.background_secondary'))
        .enabled(this.canUseBridgeTerminalBinary())
        .onClick((): void => {
          this.createRuntimeTerminal();
        })

        Button() {
          SymbolGlyph($r('sys.symbol.arrow_clockwise'))
            .fontSize(18)
            .fontColor([this.canUseBridgeTerminalBinary() ? $r('app.color.text_body') : $r('app.color.text_tertiary')])
        }
        .width(42)
        .height(36)
        .borderRadius(10)
        .backgroundColor($r('app.color.background_secondary'))
        .enabled(this.canUseBridgeTerminalBinary())
        .onClick((): void => {
          this.refreshBridgeTerminalsIfAvailable();
        })
      }
      .width('100%')

      if (!this.canUseBridgeTerminalBinary()) {
        Text($r('app.string.agent_home_runtime_terminal_unavailable'))
          .width('100%')
          .fontSize(12)
          .fontColor($r('app.color.text_secondary'))
          .padding(12)
          .backgroundColor($r('app.color.background_surface'))
          .borderRadius(12)
      } else if (this.bridgeTerminals.length === 0) {
        Text($r('app.string.agent_home_runtime_terminal_empty'))
          .width('100%')
          .height(64)
          .fontSize(13)
          .fontColor($r('app.color.text_secondary'))
          .textAlign(TextAlign.Center)
          .backgroundColor($r('app.color.background_surface'))
          .borderRadius(12)
      } else {
        Column({ space: 8 }) {
          ForEach(this.bridgeTerminals, (item: AgentBridgeTerminalSession) => {
            this.buildRuntimeTerminalRow(item)
          }, (item: AgentBridgeTerminalSession): string => item.terminal.terminalId)

          this.buildRuntimeTerminalTranscript()
          this.buildRuntimeTerminalInputRow()
        }
        .width('100%')
      }
    }
    .width('100%')
  }

