  private visibleUsageEvents(): Array<AgentBridgeUsageEventRecord> {
    const items: Array<AgentBridgeUsageEventRecord> = [];
    const start = Math.max(0, this.usageEventItems.length - 8);
    for (let index = start; index < this.usageEventItems.length; index++) {
      items.push(this.usageEventItems[index]);
    }
    return items;
  }

  private regularUsageEventText(item: AgentBridgeUsageEventRecord): string {
    const hostContext = this.getUIContext().getHostContext();
    const parts: Array<string> = [];
    parts.push(item.estimated ? resolveResourceString(hostContext, $r('app.string.agent_home_usage_estimated')) :
      resolveResourceString(hostContext, $r('app.string.agent_home_usage_real')));
    if (item.inputTokens >= 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_detail_input_tokens')) + ': ' +
        this.usageNumberText(item.inputTokens));
    }
    if (item.outputTokens >= 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_detail_output_tokens')) + ': ' +
        this.usageNumberText(item.outputTokens));
    }
    if (item.totalTokens >= 0) {
      parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_detail_total_tokens')) + ': ' +
        this.usageNumberText(item.totalTokens));
    }
    if (item.cost >= 0) {
      const currency = item.currency.length > 0 ? item.currency :
        resolveResourceString(hostContext, $r('app.string.agent_home_usage_unavailable'));
      parts.push(currency + ' ' + String(item.cost));
    }
    if (item.providerId.length > 0) {
      parts.push(item.providerId);
    }
    if (item.occurredAt.length > 0) {
      parts.push(this.usageIsoTimeText(item.occurredAt));
    }
    return parts.join(' · ');
  }

  private compactionUsageText(item: AgentBridgeUsageEventRecord): string {
    const parts: Array<string> = [];
    parts.push(this.usageNumberText(item.beforeTokens) + ' → ' + this.usageNumberText(item.afterTokens));
    if (item.providerId.length > 0) {
      parts.push(item.providerId);
    }
    if (item.occurredAt.length > 0) {
      parts.push(this.usageIsoTimeText(item.occurredAt));
    }
    if (item.reason.length > 0) {
      parts.push(item.reason);
    }
    return parts.join(' · ');
  }

  private usageNumberText(value: number): string {
    if (value < 0 || !Number.isFinite(value)) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_unavailable')
      );
    }
    return this.formatTokenCount(value);
  }

  private providerUsageNumberText(value: number): string {
    if (value < 0 || !Number.isFinite(value)) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_unavailable')
      );
    }
    return String(value);
  }

  private providerUsageStatusText(): string {
    if (this.providerUsageLoading) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_usage_loading')
      );
    }
    const availabilityState: string = this.providerUsageResult.availabilityState;
    if (availabilityState === AgentBridgeProviderUsageAvailabilityState.LOADING) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_usage_loading')
      );
    }
    if (availabilityState === AgentBridgeProviderUsageAvailabilityState.UNSUPPORTED) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_usage_unsupported')
      );
    }
    if (availabilityState === AgentBridgeProviderUsageAvailabilityState.AVAILABLE_EMPTY) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_usage_empty')
      );
    }
    if (availabilityState === AgentBridgeProviderUsageAvailabilityState.FAILED) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_usage_failed')
      );
    }
    if (availabilityState === AgentBridgeProviderUsageAvailabilityState.STALE || this.providerUsageResult.stale) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_provider_usage_stale')
      );
    }
    if (this.providerUsageResult.status.length > 0) {
      return this.providerUsageResult.status;
    }
    return resolveResourceString(
      this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_unavailable')
    );
  }

  private usageCostsText(items: Array<AgentBridgeUsageCostRecord>): string {
    if (items.length === 0) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_unavailable')
      );
    }
    const parts: Array<string> = [];
    for (let index = 0; index < items.length; index++) {
      const item = items[index];
      if (item.amount < 0 || !Number.isFinite(item.amount)) {
        continue;
      }
      const currency = item.currency.length > 0 ? item.currency :
        resolveResourceString(this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_unavailable'));
      parts.push(currency + ' ' + String(item.amount));
    }
    return parts.length > 0 ? parts.join(' · ') : resolveResourceString(
      this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_unavailable')
    );
  }

  private usageWindowSummaryText(): string {
    const parts: Array<string> = [this.usageWindowLabel(this.usageSummary.window)];
    if (this.usageSummary.windowStartAt.length > 0) {
      parts.push(this.usageIsoTimeText(this.usageSummary.windowStartAt));
    }
    if (this.usageSummary.windowEndAt.length > 0) {
      parts.push(this.usageIsoTimeText(this.usageSummary.windowEndAt));
    }
    return parts.join(' · ');
  }

  private usageWindowLabel(windowName: string): string {
    const hostContext = this.getUIContext().getHostContext();
    if (windowName === 'day') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_usage_window_day'));
    }
    if (windowName === 'month') {
      return resolveResourceString(hostContext, $r('app.string.agent_home_usage_window_month'));
    }
    if (windowName.length > 0 && windowName !== 'session') {
      return windowName;
    }
    return resolveResourceString(hostContext, $r('app.string.agent_home_usage_window_session'));
  }

  private usageIsoTimeText(value: string): string {
    const timestamp = Date.parse(value);
    if (!Number.isFinite(timestamp)) {
      return resolveResourceString(
        this.getUIContext().getHostContext(), $r('app.string.agent_home_usage_unavailable')
      );
    }
    return this.formatDateTime(timestamp);
  }

  private visibleUsageCompactions(): Array<AgentBridgeUsageCompactionRecord> {
    const items: Array<AgentBridgeUsageCompactionRecord> = [];
    const start = Math.max(0, this.usageSummary.compactionEvents.length - 5);
    for (let index = start; index < this.usageSummary.compactionEvents.length; index++) {
      items.push(this.usageSummary.compactionEvents[index]);
    }
    return items;
  }

  private usageCompactionMetadataText(item: AgentBridgeUsageCompactionRecord): string {
    const parts: Array<string> = [];
    if (item.providerId.length > 0) {
      parts.push(item.providerId);
    }
    if (item.occurredAt.length > 0) {
      parts.push(this.usageIsoTimeText(item.occurredAt));
    }
    if (item.reason.length > 0) {
      parts.push(item.reason);
    }
    return parts.join(' · ');
  }

  private visibleUsageBudgetWarnings(): Array<AgentBridgeUsageBudgetWarningRecord> {
    const matching: Array<AgentBridgeUsageBudgetWarningRecord> = [];
    for (let index = 0; index < this.usageBudgetWarnings.length; index++) {
      const item = this.usageBudgetWarnings[index];
      if (this.isUsageBudgetWarningForCurrentScope(item) && item.window === this.usageBudgetWindowDraft) {
        matching.push(item);
      }
    }
    const visible: Array<AgentBridgeUsageBudgetWarningRecord> = [];
    const start = Math.max(0, matching.length - 3);
    for (let index = start; index < matching.length; index++) {
      visible.push(matching[index]);
    }
    return visible;
  }

  private usageBudgetWarningText(item: AgentBridgeUsageBudgetWarningRecord): string {
    const hostContext = this.getUIContext().getHostContext();
    const parts: Array<string> = [];
    for (let index = 0; index < item.reasons.length; index++) {
      if (item.reasons[index] === 'token') {
        parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_usage_budget_warning_token')));
      } else if (item.reasons[index] === 'cost') {
        parts.push(resolveResourceString(hostContext, $r('app.string.agent_home_usage_budget_warning_cost')));
      }
    }
    if (item.actualTokens >= 0) {
      parts.push(this.usageNumberText(item.actualTokens));
    }
    if (item.actualCost >= 0) {
      parts.push((item.currency.length > 0 ? item.currency :
        resolveResourceString(hostContext, $r('app.string.agent_home_usage_unavailable'))) + ' ' +
        String(item.actualCost));
    }
    if (item.emittedAt.length > 0) {
      parts.push(this.usageIsoTimeText(item.emittedAt));
    }
    return parts.length > 0 ? parts.join(' · ') :
      resolveResourceString(hostContext, $r('app.string.agent_home_usage_budget_warning'));
  }

  private selectUsageWindow(windowName: string): void {
    if (windowName !== 'session' && windowName !== 'day' && windowName !== 'month') {
      return;
    }
    this.usageBudgetWindowDraft = windowName;
    this.usageSummary = new AgentBridgeUsageSummaryRecord();
    this.usageSummaryAvailable = false;
    this.usageEventItems = [];
    this.usageBudget = new AgentBridgeUsageBudgetRecord();
    this.providerUsageResult = new AgentBridgeProviderUsageResult();
    this.providerUsageLoading = false;
    this.pendingProviderUsageRequestId = '';
    this.usageTokenBudgetDraft = '';
    this.usageCostBudgetDraft = '';
    this.usageBudgetCurrencyDraft = '';
    this.refreshCurrentUsageScope();
  }

  private refreshCurrentUsageScope(): void {
    const sessionId = this.currentBridgeSessionId();
    if (sessionId.length === 0) {
      return;
    }
    const agentId = this.currentBridgeAgentId();
    this.client.requestUsageSummary(sessionId, agentId, this.usageBudgetWindowDraft);
    this.client.requestUsageEvents(sessionId, agentId, this.usageBudgetWindowDraft);
    this.client.requestUsageBudget(sessionId, agentId, this.usageBudgetWindowDraft);
    this.refreshCurrentProviderUsage(sessionId, agentId);
  }

  private refreshCurrentProviderUsage(sessionId: string, agentId: string): void {
    if (this.supportsProviderUsage()) {
      this.providerUsageLoading = true;
      this.pendingProviderUsageRequestId = this.client.requestProviderUsage(
        this.currentProviderOption().id, sessionId, agentId, this.usageBudgetWindowDraft
      );
      if (this.pendingProviderUsageRequestId.length === 0) {
        this.providerUsageLoading = false;
      }
    } else {
      this.providerUsageLoading = false;
      this.pendingProviderUsageRequestId = '';
      this.providerUsageResult = new AgentBridgeProviderUsageResult();
    }
  }

  private clearCurrentUsageBudget(): void {
    this.usageTokenBudgetDraft = '';
    this.usageCostBudgetDraft = '';
    this.usageBudgetCurrencyDraft = '';
    this.usageBudget = new AgentBridgeUsageBudgetRecord();
    const nextWarnings: Array<AgentBridgeUsageBudgetWarningRecord> = [];
    for (let index = 0; index < this.usageBudgetWarnings.length; index++) {
      if (this.usageBudgetWarnings[index].window !== this.usageBudgetWindowDraft) {
        nextWarnings.push(this.usageBudgetWarnings[index]);
      }
    }
    this.usageBudgetWarnings = nextWarnings;
    this.client.clearUsageBudget(
      this.currentBridgeSessionId(), this.currentBridgeAgentId(), this.usageBudgetWindowDraft
    );
  }

  private resetCurrentUsageScope(): void {
    this.usageSummary = new AgentBridgeUsageSummaryRecord();
    this.usageSummaryAvailable = false;
    this.usageEventItems = [];
    this.usageBudget = new AgentBridgeUsageBudgetRecord();
    this.usageBudgetWarnings = [];
    this.providerUsageResult = new AgentBridgeProviderUsageResult();
    this.providerUsageLoading = false;
    this.pendingProviderUsageRequestId = '';
    this.usageTokenBudgetDraft = '';
    this.usageCostBudgetDraft = '';
    this.usageBudgetCurrencyDraft = '';
  }

  private experienceResultMatchesCurrentUsageScope(result: AgentBridgeExperienceResult): boolean {
    return (result.hostProfileId.length === 0 || result.hostProfileId === this.activeHostProfileId) &&
      (result.sessionId.length === 0 || result.sessionId === this.currentBridgeSessionId()) &&
      (result.agentId.length === 0 || result.agentId === this.currentBridgeAgentId());
  }

  private providerUsageMatchesCurrentUsageScope(result: AgentBridgeExperienceResult): boolean {
    const providerUsage = result.providerUsage;
    return (providerUsage.providerId.length === 0 || providerUsage.providerId === this.currentProviderOption().id) &&
      (providerUsage.hostProfileId.length === 0 || providerUsage.hostProfileId === this.activeHostProfileId) &&
      (providerUsage.sessionId.length === 0 || providerUsage.sessionId === this.currentBridgeSessionId()) &&
      (providerUsage.agentId.length === 0 || providerUsage.agentId === this.currentBridgeAgentId());
  }

