  private previewChatRoomArchive(room: AgentBridgeChatRoom): void {
    if (!this.canUseBridgeChatRooms() || this.m7Busy || room.id.length === 0) {
      return;
    }
    this.pendingM7Action = AgentBridgeRequestType.CHAT_ROOM_ARCHIVE;
