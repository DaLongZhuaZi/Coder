{
  "name": "ngf-engineering-tools",
  "version": "1.0.0",
  "description": "Node.js engineering tools for NGF Framework",
  "scripts": {
    "cli": "node tools/ngf-cli/index.js",
    "agent-bridge": "node tools/agent-bridge/src/desktop-launcher.js",
    "agent-bridge:setup": "node tools/agent-bridge/src/desktop-launcher.js --setup",
    "agent-bridge:start": "node tools/agent-bridge/src/desktop-launcher.js",
    "agent-bridge:ui": "node tools/agent-bridge/src/desktop-launcher.js",
    "agent-bridge:doctor": "node tools/agent-bridge/src/desktop-launcher.js --doctor",
    "agent-bridge:start:opencode": "node tools/agent-bridge/src/desktop-launcher.js --start opencode",
    "agent-bridge:check": "npm --prefix tools/agent-bridge run check",
    "docs": "typedoc",
    "release": "standard-version"
  },
  "devDependencies": {
    "standard-version": "^9.5.0",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  }
}
